<%- include('../_portal_header', {portalColor:'success', portalLabel:'BKK', dashUrl:'/bkk/dashboard', logoutUrl:'/bkk/logout'}) %>
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Dashboard BKK</h1>
    <a href="/bkk/create" class="btn btn-sm btn-success shadow-sm"><i class="fas fa-plus fa-sm text-white-50"></i> Tambah Lowongan</a>
</div>
<% if (success == 1) { %><div class="alert alert-success alert-dismissible fade show">Berhasil ditambahkan.<button type="button" class="close" data-dismiss="alert">&times;</button></div><% } %>
<% if (success == 2) { %><div class="alert alert-success alert-dismissible fade show">Berhasil diperbarui.<button type="button" class="close" data-dismiss="alert">&times;</button></div><% } %>
<% if (success == 3) { %><div class="alert alert-danger alert-dismissible fade show">Berhasil dihapus.<button type="button" class="close" data-dismiss="alert">&times;</button></div><% } %>
<div class="card shadow mb-4">
    <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-success">Daftar Lowongan / Info BKK</h6></div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable">
                <thead><tr><th>#</th><th>Judul</th><th>Perusahaan</th><th>Kategori</th><th>Deadline</th><th>Status</th><th>Aksi</th></tr></thead>
                <tbody>
                <% if (!lowongan||lowongan.length===0) { %>
                <tr><td colspan="7" class="text-center">Belum ada data</td></tr>
                <% } else { lowongan.forEach((l,i)=>{ %>
                <tr>
                    <td><%= i+1 %></td>
                    <td><%= l.judul %></td>
                    <td><%= l.perusahaan %></td>
                    <td><span class="badge badge-info"><%= l.kategori %></span></td>
                    <td><%= l.deadline ? new Date(l.deadline).toLocaleDateString('id-ID') : '-' %></td>
                    <td><span class="badge badge-<%= l.status==='aktif'?'success':'secondary' %>"><%= l.status %></span></td>
                    <td>
                        <a href="/bkk/edit/<%= l.id %>" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i></a>
                        <form method="POST" action="/bkk/delete/<%= l.id %>" style="display:inline" onsubmit="return confirm('Hapus?')">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></button>
                        </form>
                    </td>
                </tr>
                <% }) } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
<%- include('../_portal_footer', {portalLabel:'BKK'}) %>

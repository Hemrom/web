<%- include('../_portal_header', {portalColor:'warning', portalLabel:'Pecinta Alam', dashUrl:'/pecinta-alam/dashboard', logoutUrl:'/pecinta-alam/logout', portalStyle:'background:linear-gradient(180deg,#451a03,#78350f)!important'}) %>
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Dashboard Pecinta Alam</h1>
    <a href="/pecinta-alam/create" class="btn btn-sm shadow-sm" style="background:#78350f;color:white;"><i class="fas fa-plus fa-sm"></i> Tambah Kegiatan</a>
</div>
<% if (success == 1) { %><div class="alert alert-success alert-dismissible fade show">Berhasil ditambahkan.<button type="button" class="close" data-dismiss="alert">&times;</button></div><% } %>
<% if (success == 2) { %><div class="alert alert-success alert-dismissible fade show">Berhasil diperbarui.<button type="button" class="close" data-dismiss="alert">&times;</button></div><% } %>
<% if (success == 3) { %><div class="alert alert-danger alert-dismissible fade show">Berhasil dihapus.<button type="button" class="close" data-dismiss="alert">&times;</button></div><% } %>
<div class="card shadow mb-4">
    <div class="card-header py-3"><h6 class="m-0 font-weight-bold" style="color:#78350f;">Kegiatan & Pengumuman Pecinta Alam</h6></div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable">
                <thead><tr><th>#</th><th>Judul</th><th>Kategori</th><th>Status</th><th>Tanggal</th><th>Aksi</th></tr></thead>
                <tbody>
                <% if (!kegiatan||kegiatan.length===0) { %><tr><td colspan="6" class="text-center">Belum ada data</td></tr>
                <% } else { kegiatan.forEach((k,i)=>{ %>
                <tr>
                    <td><%= i+1 %></td>
                    <td><%= k.judul %></td>
                    <td><span class="badge badge-info"><%= k.kategori %></span></td>
                    <td><span class="badge badge-<%= k.status==='published'?'success':'secondary' %>"><%= k.status %></span></td>
                    <td><%= new Date(k.created_at).toLocaleDateString('id-ID') %></td>
                    <td>
                        <a href="/pecinta-alam/edit/<%= k.id %>" class="btn btn-sm" style="background:#78350f;color:white;"><i class="fas fa-edit"></i></a>
                        <form method="POST" action="/pecinta-alam/delete/<%= k.id %>" style="display:inline" onsubmit="return confirm('Hapus?')">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button class="btn btn-secondary btn-sm"><i class="fas fa-trash"></i></button>
                        </form>
                    </td>
                </tr>
                <% }) } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
<%- include('../_portal_footer', {portalLabel:'Pecinta Alam'}) %>

<%- include('../_portal_header', {portalColor:'info', portalLabel:'Jurusan', dashUrl:'/jurusan-portal/dashboard', logoutUrl:'/jurusan-portal/logout'}) %>

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
        <i class="fas fa-building text-info mr-2"></i>Fasilitas Jurusan <%= jurusan %>
    </h1>
    <a href="/jurusan/<%= jurusan.toLowerCase() %>" target="_blank" class="btn btn-sm btn-info text-white">
        <i class="fas fa-eye fa-sm mr-1"></i> Lihat di Website
    </a>
</div>

<% if (success==1) { %><div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle mr-2"></i>Fasilitas berhasil ditambahkan.<button type="button" class="close" data-dismiss="alert">&times;</button></div><% } %>
<% if (success==2) { %><div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle mr-2"></i>Fasilitas berhasil diperbarui.<button type="button" class="close" data-dismiss="alert">&times;</button></div><% } %>
<% if (success==3) { %><div class="alert alert-warning alert-dismissible fade show"><i class="fas fa-trash mr-2"></i>Fasilitas berhasil dihapus.<button type="button" class="close" data-dismiss="alert">&times;</button></div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="alert alert-danger alert-dismissible fade show"><i class="fas fa-exclamation-circle mr-2"></i><%= error %><button type="button" class="close" data-dismiss="alert">&times;</button></div><% } %>

<div class="alert alert-info small mb-4">
    <i class="fas fa-info-circle mr-1"></i>
    Foto fasilitas akan tampil di kartu <strong>Fasilitas Pendukung</strong> pada halaman jurusan.
    Ukuran foto ideal: <strong>800×500 px</strong> atau lebih, format JPG/PNG/WebP, maks <strong>10 MB</strong>.
</div>

<!-- ── Form Tambah Fasilitas ─────────────────────────────────────────── -->
<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-info">
            <i class="fas fa-plus-circle mr-1"></i> Tambah Fasilitas Baru
        </h6>
        <button class="btn btn-sm btn-outline-info" type="button" data-toggle="collapse" data-target="#formTambah">
            <i class="fas fa-chevron-down"></i>
        </button>
    </div>
    <div class="collapse show" id="formTambah">
        <div class="card-body">
            <form method="POST" action="/jurusan-portal/fasilitas/create" enctype="multipart/form-data">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="row">
                    <div class="col-md-5">
                        <div class="form-group">
                            <label class="font-weight-bold">Nama Fasilitas <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="nama" placeholder="Contoh: Lab Jaringan Komputer" required maxlength="100">
                        </div>
                        <div class="form-group">
                            <label class="font-weight-bold">Deskripsi Singkat</label>
                            <textarea class="form-control" name="deskripsi" rows="3" placeholder="Deskripsi singkat fasilitas ini..."></textarea>
                        </div>
                        <div class="row">
                            <div class="col-md-7">
                                <div class="form-group">
                                    <label class="font-weight-bold">Icon <small class="text-muted">(Font Awesome)</small></label>
                                    <input type="text" class="form-control" name="icon" value="fas fa-building" placeholder="fas fa-network-wired" id="iconInput">
                                    <small class="text-muted">
                                        Contoh: <code>fas fa-network-wired</code>, <code>fas fa-desktop</code>, <code>fas fa-server</code>
                                    </small>
                                </div>
                            </div>
                            <div class="col-md-5">
                                <div class="form-group">
                                    <label class="font-weight-bold">Urutan</label>
                                    <input type="number" class="form-control" name="urutan" value="0" min="0" max="99">
                                    <small class="text-muted">Angka kecil tampil duluan</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-7">
                        <div class="form-group">
                            <label class="font-weight-bold">
                                <i class="fas fa-camera mr-1 text-info"></i>
                                Foto Fasilitas
                                <span class="badge badge-info ml-1">Rekomendasi: 800×500px</span>
                            </label>
                            <div class="custom-file mb-2">
                                <input type="file" class="custom-file-input" name="gambar"
                                       accept=".jpg,.jpeg,.png,.webp" id="fotoTambah">
                                <label class="custom-file-label" for="fotoTambah">Pilih foto...</label>
                            </div>
                            <small class="text-muted d-block mb-2">Format: JPG, PNG, WebP. Maksimal 10 MB.</small>
                            <!-- Preview -->
                            <div id="previewTambah" style="display:none;">
                                <img id="previewImgTambah" src="" alt="Preview"
                                     style="max-width:100%;max-height:220px;border-radius:10px;object-fit:cover;border:2px solid #e3f2fd;">
                            </div>
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn btn-info text-white">
                    <i class="fas fa-plus mr-1"></i> Tambah Fasilitas
                </button>
            </form>
        </div>
    </div>
</div>

<!-- ── Daftar Fasilitas ──────────────────────────────────────────────── -->
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-info">
            <i class="fas fa-list mr-1"></i> Daftar Fasilitas (<%= fasilitas.length %> item)
        </h6>
    </div>
    <div class="card-body">
        <% if (!fasilitas || fasilitas.length === 0) { %>
        <div class="text-center py-5 text-muted">
            <i class="fas fa-building fa-3x mb-3"></i>
            <p>Belum ada fasilitas. Tambahkan di form di atas.</p>
        </div>
        <% } else { %>
        <div class="row" id="fasilitasList">
            <% fasilitas.forEach(function(f){ %>
            <div class="col-md-6 mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <!-- Foto -->
                    <% if (f.gambar) { %>
                    <img src="/uploads/<%= f.gambar %>" class="card-img-top"
                         style="height:200px;object-fit:cover;border-radius:.35rem .35rem 0 0;"
                         onerror="this.style.display='none'">
                    <% } else { %>
                    <div style="height:140px;background:linear-gradient(135deg,#e0f2fe,#bae6fd);display:flex;align-items:center;justify-content:center;border-radius:.35rem .35rem 0 0;position:relative;">
                        <i class="<%= f.icon || 'fas fa-building' %>" style="font-size:3rem;color:#0ea5e9;opacity:.5;"></i>
                    </div>
                    <% } %>

                    <div class="card-body">
                        <div class="d-flex align-items-start justify-content-between mb-2">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span style="background:#e0f2fe;color:#0284c7;padding:.2rem .6rem;border-radius:20px;font-size:.75rem;font-weight:700;">
                                        <i class="<%= f.icon||'fas fa-building' %> mr-1"></i>#<%= f.urutan %>
                                    </span>
                                </div>
                                <h6 class="font-weight-bold mb-1"><%= f.nama %></h6>
                                <p class="text-muted small mb-0"><%= f.deskripsi || '-' %></p>
                                <% if (!f.gambar) { %>
                                <span class="badge badge-warning mt-2" style="font-size:.7rem;">
                                    <i class="fas fa-camera mr-1"></i>Belum ada foto
                                </span>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- Edit & Delete -->
                    <div class="card-footer bg-transparent d-flex gap-2">
                        <button class="btn btn-info btn-sm text-white flex-fill btn-edit"
                                data-id="<%= f.id %>"
                                data-nama="<%= (f.nama||'').replace(/"/g,'&quot;') %>"
                                data-deskripsi="<%= (f.deskripsi||'').replace(/"/g,'&quot;') %>"
                                data-icon="<%= f.icon||'fas fa-building' %>"
                                data-urutan="<%= f.urutan %>"
                                data-gambar="<%= f.gambar||'' %>">
                            <i class="fas fa-edit mr-1"></i> Edit
                        </button>
                        <form method="POST" action="/jurusan-portal/fasilitas/delete/<%= f.id %>"
                              style="flex:1" onsubmit="return confirm('Hapus fasilitas ini?')">
                            <button class="btn btn-danger btn-sm btn-block">
                                <i class="fas fa-trash mr-1"></i> Hapus
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            <% }) %>
        </div>
        <% } %>
    </div>
</div>

<!-- ── Modal Edit ────────────────────────────────────────────────────── -->
<div class="modal fade" id="editModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-edit mr-2"></i>Edit Fasilitas</h5>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <form id="editForm" method="POST" enctype="multipart/form-data">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-5">
                            <div class="form-group">
                                <label class="font-weight-bold">Nama Fasilitas *</label>
                                <input type="text" class="form-control" name="nama" id="editNama" required maxlength="100">
                            </div>
                            <div class="form-group">
                                <label class="font-weight-bold">Deskripsi</label>
                                <textarea class="form-control" name="deskripsi" id="editDeskripsi" rows="3"></textarea>
                            </div>
                            <div class="row">
                                <div class="col-8">
                                    <div class="form-group">
                                        <label class="font-weight-bold">Icon</label>
                                        <input type="text" class="form-control" name="icon" id="editIcon">
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="form-group">
                                        <label class="font-weight-bold">Urutan</label>
                                        <input type="number" class="form-control" name="urutan" id="editUrutan" min="0" max="99">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-7">
                            <div class="form-group">
                                <label class="font-weight-bold">
                                    <i class="fas fa-camera mr-1 text-info"></i> Foto Fasilitas
                                    <span class="badge badge-info ml-1">800×500px ideal</span>
                                </label>
                                <!-- Foto saat ini -->
                                <div id="currentPhotoWrap" class="mb-2" style="display:none;">
                                    <p class="small text-muted mb-1">Foto saat ini:</p>
                                    <img id="currentPhoto" src="" alt="Foto saat ini"
                                         style="max-width:100%;max-height:180px;border-radius:8px;object-fit:cover;border:2px solid #e3f2fd;">
                                    <p class="small text-muted mt-1">Upload foto baru untuk mengganti</p>
                                </div>
                                <div class="custom-file mb-2">
                                    <input type="file" class="custom-file-input" name="gambar"
                                           accept=".jpg,.jpeg,.png,.webp" id="fotoEdit">
                                    <label class="custom-file-label" for="fotoEdit">Pilih foto baru (opsional)...</label>
                                </div>
                                <small class="text-muted">Format: JPG, PNG, WebP. Maks 10 MB.</small>
                                <div id="previewEdit" style="display:none;margin-top:.5rem;">
                                    <img id="previewImgEdit" src="" alt="Preview baru"
                                         style="max-width:100%;max-height:180px;border-radius:8px;object-fit:cover;border:2px solid #bae6fd;">
                                    <p class="small text-success mt-1"><i class="fas fa-check-circle mr-1"></i>Foto baru siap diupload</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-info text-white">
                        <i class="fas fa-save mr-1"></i> Simpan Perubahan
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../_portal_footer', {portalLabel:'Jurusan'}) %>

<script>
// ── Preview foto baru di form tambah ──────────────────────────────────
document.getElementById('fotoTambah').addEventListener('change', function() {
    var file = this.files[0];
    if (!file) return;
    this.nextElementSibling.textContent = file.name;
    var reader = new FileReader();
    reader.onload = function(e) {
        document.getElementById('previewImgTambah').src = e.target.result;
        document.getElementById('previewTambah').style.display = 'block';
    };
    reader.readAsDataURL(file);
});

// ── Bootstrap custom-file label ───────────────────────────────────────
document.querySelectorAll('.custom-file-input').forEach(function(input) {
    input.addEventListener('change', function() {
        var label = this.nextElementSibling;
        if (this.files.length > 0) label.textContent = this.files[0].name;
    });
});

// ── Preview foto baru di modal edit ──────────────────────────────────
document.getElementById('fotoEdit').addEventListener('change', function() {
    var file = this.files[0];
    if (!file) return;
    var reader = new FileReader();
    reader.onload = function(e) {
        document.getElementById('previewImgEdit').src = e.target.result;
        document.getElementById('previewEdit').style.display = 'block';
    };
    reader.readAsDataURL(file);
});

// ── Buka modal edit via data attributes ──────────────────────────────
document.querySelectorAll('.btn-edit').forEach(function(btn) {
    btn.addEventListener('click', function() {
        var id        = this.dataset.id;
        var nama      = this.dataset.nama;
        var deskripsi = this.dataset.deskripsi;
        var icon      = this.dataset.icon;
        var urutan    = this.dataset.urutan;
        var gambar    = this.dataset.gambar;

        document.getElementById('editForm').action = '/jurusan-portal/fasilitas/edit/' + id;
        document.getElementById('editNama').value      = nama;
        document.getElementById('editDeskripsi').value = deskripsi;
        document.getElementById('editIcon').value      = icon;
        document.getElementById('editUrutan').value    = urutan;

        // Reset upload preview
        document.getElementById('previewEdit').style.display = 'none';
        document.getElementById('fotoEdit').value = '';
        document.querySelector('#fotoEdit + label').textContent = 'Pilih foto baru (opsional)...';

        // Tampilkan foto saat ini jika ada
        if (gambar) {
            document.getElementById('currentPhoto').src = '/uploads/' + gambar;
            document.getElementById('currentPhotoWrap').style.display = 'block';
        } else {
            document.getElementById('currentPhotoWrap').style.display = 'none';
        }
        $('#editModal').modal('show');
    });
});
</script>

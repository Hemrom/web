<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <link rel="icon" type="image/png" href="/assets/img/favicon.png?v=4">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        <%
        const colors = {
            bkk: {bg:'linear-gradient(135deg,#0f172a,#1e3a5f)', accent:'#10b981', dark:'#059669', label:'BKK', icon:'fa-briefcase'},
            osis: {bg:'linear-gradient(135deg,#1e1b4b,#312e81)', accent:'#f59e0b', dark:'#d97706', label:'OSIS', icon:'fa-users'},
            jurusan: {bg:'linear-gradient(135deg,#0c4a6e,#0369a1)', accent:'#0ea5e9', dark:'#0284c7', label:'JURUSAN', icon:'fa-graduation-cap'}
        };
        const c = colors[role] || colors.bkk;
        %>
        body { background: <%= c.bg %>; min-height: 100vh; display: flex; align-items: center; }
        .login-card { background: white; border-radius: 20px; box-shadow: 0 20px 60px rgba(0,0,0,.35); overflow: hidden; border: none; }
        .logo-side { background: <%= c.bg %>; display: flex; align-items: center; justify-content: center; padding: 3rem 2rem; min-height: 300px; }
        .logo-box { background: rgba(255,255,255,.1); border-radius: 20px; padding: 2rem 1.5rem; text-align: center; width: 100%; border: 1px solid rgba(255,255,255,.2); backdrop-filter: blur(10px); }
        .logo-box img { width: 80px; height: 80px; object-fit: contain; border-radius: 12px; background: white; padding: 6px; margin-bottom: 1rem; }
        .logo-fallback { width: 80px; height: 80px; background: rgba(255,255,255,.2); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; color: white; font-size: 2rem; }
        .badge-portal { background: rgba(255,255,255,.2); color: white; padding: .35rem .9rem; border-radius: 20px; font-size: .75rem; font-weight: 700; border: 1px solid rgba(255,255,255,.3); }
        .btn-portal { background: linear-gradient(135deg, <%= c.accent %>, <%= c.dark %>); border: none; font-weight: 600; padding: .75rem; }
        .btn-portal:hover { opacity: .9; }
        .form-control:focus { border-color: <%= c.accent %>; box-shadow: 0 0 0 .2rem <%= c.accent %>33; }
        @media (max-width: 991px) { .logo-side { display: none !important; } }
    </style>
</head>
<body>
<div class="container py-4">
    <div class="row justify-content-center align-items-center" style="min-height:calc(100vh - 2rem);">
        <div class="col-xl-9 col-lg-11 col-md-10 col-sm-12">
            <div class="card login-card">
                <div class="card-body p-0">
                    <div class="row g-0">
                        <div class="col-lg-5 logo-side">
                            <div class="logo-box">
                                <img src="/uploads/logo-sekolah.png" alt="Logo" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
                                <div class="logo-fallback" style="display:none;"><i class="fas <%= c.icon %>"></i></div>
                                <div style="color:white;font-weight:700;font-size:1.1rem;margin-bottom:.25rem;">SMK Negeri 1 Kras</div>
                                <div style="color:rgba(255,255,255,.75);font-size:.8rem;margin-bottom:.75rem;">Kediri, Jawa Timur</div>
                                <span class="badge-portal"><i class="fas <%= c.icon %> me-1"></i>PORTAL <%= c.label %></span>
                            </div>
                        </div>
                        <div class="col-lg-7 bg-white">
                            <div class="p-5">
                                <div class="text-center mb-4">
                                    <h4 class="fw-bold text-dark mb-1"><%= title %></h4>
                                    <p class="text-muted small">Masuk dengan akun <%= c.label %> Anda</p>
                                </div>
                                <% if (error) { %>
                                <div class="alert alert-danger py-2 small"><i class="fas fa-exclamation-circle me-1"></i><%= error %></div>
                                <% } %>
                                <form method="POST">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold small">Username</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light"><i class="fas fa-user text-muted"></i></span>
                                            <input type="text" name="username" class="form-control" placeholder="Username" required autofocus>
                                        </div>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label fw-semibold small">Password</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light"><i class="fas fa-lock text-muted"></i></span>
                                            <input type="password" name="password" class="form-control" placeholder="Password" required>
                                        </div>
                                    </div>
                                    <button type="submit" class="btn btn-portal btn-primary w-100 text-white">
                                        <i class="fas fa-sign-in-alt me-2"></i>Masuk
                                    </button>
                                </form>
                                <hr class="my-4">
                                <div class="text-center">
                                    <a href="/" class="text-muted small"><i class="fas fa-arrow-left me-1"></i>Kembali ke Website</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

<%- include('../_portal_header', {portalColor:'success', portalLabel:'PRAMUKA', dashUrl:'/pramuka/dashboard', logoutUrl:'/pramuka/logout'}) %>
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Berita & Informasi Pramuka</h1>
    <a href="/pramuka/berita/create" class="btn btn-sm btn-success shadow-sm"><i class="fas fa-plus fa-sm"></i> Tambah Berita</a>
</div>
<% if (success == 1) { %><div class="alert alert-success alert-dismissible fade show">Berhasil ditambahkan.<button type="button" class="close" data-dismiss="alert">&times;</button></div><% } %>
<% if (success == 2) { %><div class="alert alert-success alert-dismissible fade show">Berhasil diperbarui.<button type="button" class="close" data-dismiss="alert">&times;</button></div><% } %>
<% if (success == 3) { %><div class="alert alert-danger alert-dismissible fade show">Berhasil dihapus.<button type="button" class="close" data-dismiss="alert">&times;</button></div><% } %>
<div class="card shadow mb-4">
    <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-success">Daftar Berita & Informasi</h6></div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable">
                <thead><tr><th>#</th><th>Judul</th><th>Kategori</th><th>Status</th><th>Tanggal</th><th>Aksi</th></tr></thead>
                <tbody>
                <% if (!berita||berita.length===0) { %><tr><td colspan="6" class="text-center">Belum ada berita</td></tr>
                <% } else { berita.forEach((b,i)=>{ %>
                <tr>
                    <td><%= i+1 %></td>
                    <td><%= b.judul %></td>
                    <td><span class="badge badge-info"><%= b.kategori %></span></td>
                    <td><span class="badge badge-<%= b.status==='published'?'success':'secondary' %>"><%= b.status %></span></td>
                    <td><%= new Date(b.created_at).toLocaleDateString('id-ID') %></td>
                    <td>
                        <a href="/pramuka/berita/edit/<%= b.id %>" class="btn btn-success btn-sm"><i class="fas fa-edit"></i></a>
                        <form method="POST" action="/pramuka/berita/delete/<%= b.id %>" style="display:inline" onsubmit="return confirm('Hapus?')">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></button>
                        </form>
                    </td>
                </tr>
                <% }) } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
<%- include('../_portal_footer', {portalLabel:'PRAMUKA'}) %>

<%- include('../_portal_header', {portalColor:'danger', portalLabel:'Pencak Silat', dashUrl:'/pencak-silat/dashboard', logoutUrl:'/pencak-silat/logout', portalStyle:'background:linear-gradient(180deg,#7f1d1d,#b91c1c)!important'}) %>
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Galeri Pencak Silat</h1>
</div>
<% if (success == 1) { %><div class="alert alert-success alert-dismissible fade show">Foto berhasil diupload.<button type="button" class="close" data-dismiss="alert">&times;</button></div><% } %>
<% if (success == 3) { %><div class="alert alert-danger alert-dismissible fade show">Foto berhasil dihapus.<button type="button" class="close" data-dismiss="alert">&times;</button></div><% } %>
<% if (typeof errorMsg !== 'undefined' && errorMsg) { %><div class="alert alert-danger"><%= errorMsg %></div><% } %>
<div class="card shadow mb-4">
    <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-danger">Upload Foto</h6></div>
    <div class="card-body">
        <form method="POST" action="/pencak-silat/galeri/upload" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="row">
                <div class="col-md-4"><div class="form-group"><label>Judul Album</label><input type="text" class="form-control" name="judul" placeholder="Nama kegiatan/album" required></div></div>
                <div class="col-md-4"><div class="form-group"><label>Keterangan (opsional)</label><input type="text" class="form-control" name="keterangan" placeholder="Keterangan foto"></div></div>
                <div class="col-md-4"><div class="form-group"><label>Pilih Foto (maks 20)</label><input type="file" class="form-control-file" name="gambar" accept=".jpg,.jpeg,.png,.webp" multiple required></div></div>
            </div>
            <button type="submit" class="btn btn-danger"><i class="fas fa-upload mr-1"></i>Upload</button>
        </form>
    </div>
</div>
<div class="card shadow mb-4">
    <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-danger">Foto Galeri (<%= galeri.length %> foto)</h6></div>
    <div class="card-body">
        <% if (!galeri||galeri.length===0) { %><p class="text-center text-muted">Belum ada foto</p>
        <% } else { %>
        <div class="row">
            <% galeri.forEach(g=>{ %>
            <div class="col-md-3 col-sm-4 col-6 mb-3">
                <div class="card h-100">
                    <img src="/uploads/<%= g.gambar %>" class="card-img-top" style="height:150px;object-fit:cover;" alt="<%= g.judul %>">
                    <div class="card-body p-2">
                        <p class="card-text small text-truncate mb-1"><%= g.judul %></p>
                        <% if (g.keterangan) { %><p class="card-text small text-muted text-truncate mb-1"><%= g.keterangan %></p><% } %>
                        <form method="POST" action="/pencak-silat/galeri/delete/<%= g.id %>" onsubmit="return confirm('Hapus foto ini?')">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button class="btn btn-danger btn-sm w-100"><i class="fas fa-trash"></i> Hapus</button>
                        </form>
                    </div>
                </div>
            </div>
            <% }) %>
        </div>
        <% } %>
    </div>
</div>
<%- include('../_portal_footer', {portalLabel:'Pencak Silat'}) %>

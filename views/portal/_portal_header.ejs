    <link href="/assets/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">
    <link href="/assets/css/sb-admin-2.min.css" rel="stylesheet">
    <style>body,h1,h2,h3,h4,h5,h6,.sidebar-brand-text,.nav-link{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif!important;}</style>
    <link href="/assets/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">
    <link href="/assets/vendor/summernote/summernote-bs4.min.css" rel="stylesheet">
    <style>
        /* Fix summernote toolbar icon boxes */
        .note-icon-caret:before { font-family: inherit !important; }
        .note-editor .note-toolbar { background: #f8f9fa; border-bottom: 1px solid #dee2e6; padding: 4px; }
        .note-editor .note-editing-area .note-editable { min-height: 250px; font-size: 14px; line-height: 1.7; }
        .note-editor.note-frame { border: 1px solid #ced4da; border-radius: 6px; }
        .note-btn { border-radius: 4px !important; }
    </style>
</head>

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title><%= title %> - Website Sekolah</title>
    <link rel="icon" type="image/png" href="/assets/img/favicon.png">
    <link href="/assets/vendor/bootstrap5/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/vendor/fontawesome6/all.min.css" rel="stylesheet">    <style>
        :root {
            --primary-blue: #0ea5e9;
            --primary-blue-dark: #0284c7;
            --secondary-blue: #0369a1;
            --light-blue: #e0f2fe;
            --gray-50: #f8fafc;
            --gray-100: #f1f5f9;
            --gray-600: #475569;
            --gray-700: #334155;
            --gray-800: #1e293b;
            --gray-900: #0f172a;
            --gray-300: #cbd5e1;
            --gray-400: #94a3b8;
            --accent-blue: #7dd3fc;
        }
        * { font-family: 'Inter', sans-serif; margin: 0; padding: 0; box-sizing: border-box; }
        body { line-height: 1.6; color: var(--gray-700); }
        .navbar-modern {
            background: rgba(255,255,255,0.95) !important;
            backdrop-filter: blur(10px);
            box-shadow: 0 2px 20px rgba(14,165,233,0.1);
            padding: 1rem 0;
        }
        .navbar-brand { font-weight: 700; color: var(--primary-blue) !important; font-size: 1.5rem; text-decoration: none; }
        .nav-link { font-weight: 500; color: var(--gray-600) !important; padding: 0.75rem 1rem !important; border-radius: 8px; transition: all 0.3s; }
        .nav-link:hover, .nav-link.active { color: var(--primary-blue) !important; background-color: var(--light-blue); }
        .page-header {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--secondary-blue) 100%);
            padding: 10rem 0 4rem;
            color: white;
            text-align: center;
        }
        .page-title { font-size: 3rem; font-weight: 800; margin-bottom: 0.5rem; }
        .content-section { padding: 4rem 0; background: var(--gray-50); }
        /* Sub-menu profil */
        .profil-submenu {
            background: white;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(14,165,233,0.08);
            overflow: hidden;
            margin-bottom: 2rem;
        }
        .profil-submenu a {
            display: block;
            padding: 1rem 1.5rem;
            color: var(--gray-700);
            text-decoration: none;
            border-left: 4px solid transparent;
            transition: all 0.2s;
            font-weight: 500;
        }
        .profil-submenu a:hover { background: var(--light-blue); color: var(--primary-blue); border-left-color: var(--primary-blue); }
        .profil-submenu a.active { background: var(--light-blue); color: var(--primary-blue); border-left-color: var(--primary-blue); font-weight: 600; }
        .profil-submenu a + a { border-top: 1px solid var(--gray-100); }
        .content-card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(14,165,233,0.08);
            padding: 2.5rem;
        }
        .content-card h2 { font-size: 2rem; font-weight: 700; color: var(--gray-800); margin-bottom: 1.5rem; }
        .content-card img { max-width: 200px; border-radius: 12px; margin-bottom: 1.5rem; }
        .empty-state { text-align: center; padding: 3rem; color: var(--gray-400); }
        /* Styling konten dari rich text editor Summernote */
        .sambutan-konten {
            font-size: 1.05rem;
            line-height: 1.9;
            color: var(--gray-700);
        }
        .sambutan-konten p {
            margin-bottom: 1.2rem;
            text-align: justify;
        }
        .sambutan-konten b, .sambutan-konten strong { font-weight: 700; }
        .sambutan-konten i, .sambutan-konten em { font-style: italic; }
        .sambutan-konten u { text-decoration: underline; }
        .sambutan-konten ul, .sambutan-konten ol { padding-left: 1.5rem; margin-bottom: 1rem; }
        .sambutan-konten li { margin-bottom: 0.4rem; }
        .sambutan-konten br { display: block; content: ''; margin-bottom: 0.5rem; }
        /* Konten biasa (visi misi, sejarah) */
        .content-card .ck-content p,
        .content-card > p { margin-bottom: 1rem; line-height: 1.8; }
        .footer { background: var(--gray-900); color: white; padding: 4rem 0 2rem; }
        .footer-title { font-size: 1.25rem; font-weight: 600; margin-bottom: 1.5rem; }
        .footer-link { color: var(--gray-300); text-decoration: none; margin-bottom: 0.5rem; display: block; }
        .footer-link:hover { color: var(--accent-blue); }
        .footer-bottom { border-top: 1px solid #334155; margin-top: 3rem; padding-top: 2rem; text-align: center; color: var(--gray-400); }
        @media (max-width: 991px) {
            .navbar-collapse { background: white; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); margin-top: 1rem; padding: 1rem; }
            .page-title { font-size: 2rem; }
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <section class="page-header">
        <div class="container">
            <h1 class="page-title"><%= konten.judul || title %></h1>
            <% if (konten.tipe === 'sambutan') { %>
            <p style="opacity:0.9">Kepala Sekolah <%= profil.nama_sekolah || '' %></p>
            <% } else { %>
            <p style="opacity:0.9"><%= profil.nama_sekolah || 'Profil Sekolah' %></p>
            <% } %>
        </div>
    </section>

    <section class="content-section">
        <div class="container">
            <div class="row">
                <!-- Konten utama - full width -->
                <div class="col-lg-12">
                    <div class="content-card">
                        <% if (konten.tipe === 'sambutan') { %>
                        <!-- Layout sambutan modern: 2 kolom -->
                        <style>
                            .sambutan-wrap { display: flex; gap: 3rem; align-items: flex-start; }
                            .sambutan-foto-col { flex-shrink: 0; width: 380px; }
                            .sambutan-foto-outer { display: none; }
                            .sambutan-foto-bg { display: none; }
                            .sambutan-foto-accent { display: none; }
                            .sambutan-foto-frame { display: none; }
                            .sambutan-foto-frame img { display: none; }
                            /* Card foto portrait */
                            .kepsek-card {
                                position: relative;
                                width: 420px;
                                border-radius: 24px;
                                overflow: hidden;
                                box-shadow: 0 20px 60px rgba(14,165,233,.2);
                            }
                            .kepsek-card img {
                                width: 100%;
                                display: block;
                                object-fit: cover;
                                object-position: top center;
                            }
                            .kepsek-card-accent { display: none; }
                            .kepsek-card-badge {
                                position: absolute; bottom: 0; left: 0; right: 0;
                                background: linear-gradient(to top, rgba(3,105,161,.95) 0%, rgba(14,165,233,.5) 60%, transparent 100%);
                                padding: 2.5rem 1.25rem 1.25rem;
                                color: white;
                                z-index: 1;
                            }
                            .kepsek-card-badge .nama { font-weight: 800; font-size: 1.2rem; line-height: 1.3; }
                            .kepsek-card-badge .jabatan { font-size: .85rem; opacity: .9; margin-top: .3rem; }
                            /* Ornamen daun - kecil */
                            .kepsek-card-leaf1 {
                                position: absolute; top: 8px; right: 8px;
                                width: 45px; opacity: .2; z-index: 1; pointer-events: none;
                            }
                            .kepsek-card-leaf2 {
                                position: absolute; bottom: 80px; left: 6px;
                                width: 35px; opacity: .15; z-index: 1; pointer-events: none;
                            }
                            .sambutan-foto-badge {
                                position: absolute; bottom: 0; left: 0; right: 0;
                                background: linear-gradient(to top, rgba(3,105,161,.95) 0%, rgba(14,165,233,.6) 60%, transparent 100%);
                                padding: 2.5rem 1.25rem 1.25rem;
                                color: white;
                            }
                            .sambutan-foto-badge .nama { font-weight: 800; font-size: 1.15rem; line-height: 1.3; text-shadow: 0 1px 4px rgba(0,0,0,.3); }
                            .sambutan-foto-badge .jabatan { font-size: .85rem; opacity: .9; margin-top: .3rem; }
                            .sambutan-konten-col { flex: 1; min-width: 0; }
                            .sambutan-quote {
                                background: linear-gradient(135deg, #e0f2fe, #f0f9ff);
                                border-left: 4px solid var(--primary-blue, #0ea5e9);
                                border-radius: 0 12px 12px 0;
                                padding: 1rem 1.5rem;
                                margin-bottom: 1.5rem;
                                font-style: italic;
                                color: #0369a1;
                                font-size: .95rem;
                            }
                            .sambutan-profil-table { width: 100%; border-collapse: collapse; margin-top: 2rem; }
                            .sambutan-profil-table thead tr { background: var(--secondary-blue, #0369a1); color: white; }
                            .sambutan-profil-table th, .sambutan-profil-table td { padding: 0.6rem 1rem; border: 1px solid #e2e8f0; font-size: 0.9rem; }
                            .sambutan-profil-table tbody tr:nth-child(even) { background: #f8fafc; }
                            @media (max-width: 768px) {
                                .sambutan-wrap { flex-direction: column; gap: 1.5rem; }
                                .sambutan-foto-col { width: 100%; max-width: 320px; margin: 0 auto; }
                            }
                        </style>

                        <div class="sambutan-wrap">
                            <!-- Foto -->
                            <div class="sambutan-foto-col">
                                <div class="kepsek-card">
                                    <!-- Ornamen daun -->
                                    <svg class="kepsek-card-leaf1" viewBox="0 0 100 120" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M50 5 C20 5 5 30 5 60 C5 90 20 115 50 115" stroke="#0369a1" stroke-width="3" fill="none"/>
                                        <path d="M50 5 C80 5 95 30 95 60" stroke="#0369a1" stroke-width="3" fill="none"/>
                                        <path d="M50 30 C35 30 25 45 25 60" stroke="#0369a1" stroke-width="2" fill="none"/>
                                    </svg>
                                    <svg class="kepsek-card-leaf2" viewBox="0 0 80 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M40 5 C15 5 5 25 5 50 C5 75 15 95 40 95" stroke="#0369a1" stroke-width="3" fill="none"/>
                                        <path d="M40 5 C65 5 75 25 75 50" stroke="#0369a1" stroke-width="3" fill="none"/>
                                    </svg>
                                    <!-- Foto -->
                                    <% if (konten.foto) { %>
                                    <img src="/uploads/<%= konten.foto %>" alt="<%= konten.judul %>">
                                    <% } else { %>
                                    <div style="min-height:420px;display:flex;align-items:center;justify-content:center;">
                                        <i class="fas fa-user-tie fa-6x" style="color:#0ea5e9"></i>
                                    </div>
                                    <% } %>
                                    <!-- Aksen teal pojok kanan bawah - dihapus -->
                                    <!-- Badge nama -->
                                    <div class="kepsek-card-badge">
                                        <div class="nama"><%= konten.judul || 'Kepala Sekolah' %></div>
                                        <div class="jabatan">Kepala <%= profil.nama_sekolah || 'Sekolah' %></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Teks sambutan -->
                            <div class="sambutan-konten-col">
                                <div class="sambutan-quote">
                                    <i class="fas fa-quote-left me-2"></i>Sambutan Kepala Sekolah
                                </div>
                                <div style="font-size:1rem;line-height:1.9;color:#334155;">
                                    <% if (konten.konten && konten.konten.trim()) { %>
                                        <%- konten.konten %>
                                    <% } else { %>
                                        <p class="text-muted py-4">Sambutan kepala sekolah belum tersedia.</p>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <!-- Tabel Profil Sekolah di bawah sambutan -->
                        <% if (profil && profil.nama_sekolah) { %>
                        <div style="margin-top:3rem;">
                            <h3 style="font-size:1.5rem;font-weight:700;color:var(--gray-800);margin-bottom:1rem;">Profil Sekolah</h3>
                            <table class="sambutan-profil-table">
                                <thead>
                                    <tr><th colspan="3"><%= profil.nama_sekolah %></th></tr>
                                </thead>
                                <tbody>
                                    <% if (profil.alamat) { %><tr><td>Alamat</td><td>:</td><td><%= profil.alamat %></td></tr><% } %>
                                    <% if (profil.npsn) { %><tr><td>NPSN</td><td>:</td><td><%= profil.npsn %></td></tr><% } %>
                                    <% if (profil.akreditasi) { %><tr><td>Akreditasi</td><td>:</td><td><%= profil.akreditasi %></td></tr><% } %>
                                    <% if (profil.status) { %><tr><td>Status</td><td>:</td><td><%= profil.status %></td></tr><% } %>
                                    <% if (profil.jenjang) { %><tr><td>Jenjang Pendidikan</td><td>:</td><td><%= profil.jenjang %></td></tr><% } %>
                                    <% if (profil.telepon) { %><tr><td>Telepon</td><td>:</td><td><%= profil.telepon %></td></tr><% } %>
                                    <% if (profil.email) { %><tr><td>Email</td><td>:</td><td><%= profil.email %></td></tr><% } %>
                                    <% if (profil.website) { %><tr><td>Website</td><td>:</td><td><%= profil.website %></td></tr><% } %>
                                </tbody>
                            </table>
                        </div>
                        <% } %>
                        <% } else { %>
                        <!-- Layout konten biasa (visi misi, sejarah, dll) -->
                        <% if (konten.konten && konten.konten.trim()) { %>
                            <%- konten.konten %>
                        <% } else { %>
                            <div class="empty-state">
                                <i class="fas fa-file-alt fa-3x mb-3" style="color:#cbd5e1"></i>
                                <% if (konten.tipe === 'visi_misi') { %>
                                <p>Konten visi misi belum tersedia.</p>
                                <% } else { %>
                                <p>Konten belum tersedia. Silakan isi melalui panel admin.</p>
                                <% } %>
                            </div>
                        <% } %>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <%- include('partials/related') %>
    <%- include('partials/footer') %>

    <script src="/assets/vendor/bootstrap5/bootstrap.bundle.min.js"></script>
    <script src="/assets/vendor/jquery3/jquery.min.js"></script>
    <script>
        $(window).scroll(function() {
            if ($(window).scrollTop() > 50) $('.navbar-modern').css('box-shadow','0 4px 30px rgba(14,165,233,0.15)');
            else $('.navbar-modern').css('box-shadow','0 2px 20px rgba(14,165,233,0.1)');
        });
    </script>
</body>
</html>




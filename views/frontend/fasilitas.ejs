<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <% seoTitle='Fasilitas Sekolah'; seoDesc='Fasilitas lengkap dan modern SMK Negeri 1 Kras, Kediri. Laboratorium komputer, bengkel otomotif, dapur praktik kuliner, perpustakaan, dan fasilitas olahraga.'; seoUrl='/fasilitas'; %>
    <%- include('partials/_seo') %>
    <link href="/assets/vendor/bootstrap5/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/vendor/fontawesome6/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/theme.css">
    <style>
        :root{--primary-blue:#0ea5e9;--primary-blue-dark:#0284c7;--secondary-blue:#0369a1;--light-blue:#e0f2fe;--gray-50:#f8fafc;--gray-100:#f1f5f9;--gray-600:#475569;--gray-700:#334155;--gray-800:#1e293b;}
        *{font-family:'Inter',sans-serif;box-sizing:border-box;margin:0;padding:0;}
        body{color:var(--gray-700);line-height:1.6;}
        .page-header{background:linear-gradient(135deg,var(--primary-blue),var(--secondary-blue));padding:10rem 0 5rem;color:white;text-align:center;}
        .page-title{font-size:3rem;font-weight:800;}
        .content-section{padding:5rem 0;background:var(--gray-50);}

        /* Filter */
        .filter-btn{border-radius:50px;padding:.4rem 1.2rem;font-size:.85rem;font-weight:600;border:2px solid #e2e8f0;color:var(--gray-600);background:white;transition:all .2s;text-decoration:none;display:inline-block;}
        .filter-btn.active,.filter-btn:hover{background:var(--primary-blue);color:white;border-color:var(--primary-blue);}

        /* Card */
        .fasilitas-card{background:white;border-radius:20px;overflow:hidden;box-shadow:0 4px 20px rgba(14,165,233,.08);border:1px solid var(--gray-100);transition:all .3s;height:100%;}
        .fasilitas-card:hover{transform:translateY(-6px);box-shadow:0 16px 40px rgba(14,165,233,.15);}

        /* Foto slider dalam card */
        .card-slider{position:relative;overflow:hidden;height:220px;background:#f1f5f9;}
        .card-slider-track{display:flex;height:100%;transition:transform .35s ease;}
        .card-slide{min-width:100%;height:100%;flex-shrink:0;position:relative;}
        .card-slide img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s ease;}
        .card-slide-placeholder{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:3rem;color:white;}

        /* Foto clickable */
        .card-slide-clickable{cursor:zoom-in;display:block;width:100%;height:100%;}
        .card-slide-clickable:hover img{transform:scale(1.04);}
        .card-slide-hover-overlay{position:absolute;inset:0;background:rgba(0,0,0,0);display:flex;align-items:center;justify-content:center;transition:background .25s;pointer-events:none;}
        .card-slide-hover-overlay i{color:white;font-size:2rem;opacity:0;transform:scale(.7);transition:all .25s;}
        .card-slide-clickable:hover ~ .card-slide-hover-overlay,
        .card-slide-clickable:hover + .card-slide-hover-overlay{background:rgba(0,0,0,.3);}
        .card-slide-clickable:hover + .card-slide-hover-overlay i{opacity:1;transform:scale(1);}
        /* fallback: parent hover */
        .card-slide:hover .card-slide-hover-overlay{background:rgba(0,0,0,.3);}
        .card-slide:hover .card-slide-hover-overlay i{opacity:1;transform:scale(1);}

        /* Slider controls */
        .slider-ctrl{position:absolute;top:50%;transform:translateY(-50%);background:rgba(0,0,0,.45);color:white;border:none;width:32px;height:32px;border-radius:50%;font-size:.8rem;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .2s;z-index:3;}
        .slider-ctrl:hover{background:rgba(0,0,0,.7);}
        .slider-ctrl.prev{left:8px;}
        .slider-ctrl.next{right:8px;}
        .slider-dots{position:absolute;bottom:8px;left:50%;transform:translateX(-50%);display:flex;gap:5px;z-index:3;}
        .slider-dot{width:7px;height:7px;border-radius:50%;background:rgba(255,255,255,.6);cursor:pointer;transition:all .2s;}
        .slider-dot.active{background:white;transform:scale(1.3);}

        /* Badge & foto count */
        .badge-kategori{position:absolute;top:.75rem;left:.75rem;font-size:.72rem;padding:.3rem .75rem;border-radius:50px;font-weight:700;color:white;z-index:3;}
        .foto-count{position:absolute;top:.75rem;right:.75rem;background:rgba(0,0,0,.5);color:white;font-size:.72rem;padding:.25rem .6rem;border-radius:50px;z-index:3;backdrop-filter:blur(4px);}

        .card-body-inner{padding:1.25rem;}
        .card-nama{font-size:1.05rem;font-weight:700;color:var(--gray-800);margin-bottom:.4rem;}
        .card-desc{font-size:.85rem;color:var(--gray-600);line-height:1.5;}

        /* ── Lightbox ── */
        .lightbox-overlay{position:fixed;inset:0;background:rgba(0,0,0,0);z-index:9999;display:none;align-items:center;justify-content:center;flex-direction:column;transition:background .3s;}
        .lightbox-overlay.open{display:flex;background:rgba(0,0,0,.93);}
        .lightbox-img-wrap{position:relative;display:flex;align-items:center;justify-content:center;max-width:92vw;max-height:75vh;}
        .lightbox-img-wrap img{max-width:92vw;max-height:75vh;object-fit:contain;border-radius:10px;box-shadow:0 24px 80px rgba(0,0,0,.6);display:block;transition:opacity .2s;}
        .lightbox-img-wrap img.loading{opacity:.4;}
        .lightbox-close{position:fixed;top:1.25rem;right:1.25rem;background:rgba(255,255,255,.12);color:white;border:none;width:46px;height:46px;border-radius:50%;font-size:1.1rem;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s;backdrop-filter:blur(6px);}
        .lightbox-close:hover{background:rgba(255,255,255,.25);transform:scale(1.1);}
        .lightbox-nav{position:fixed;top:50%;transform:translateY(-50%);background:rgba(255,255,255,.12);color:white;border:none;width:50px;height:50px;border-radius:50%;font-size:1.2rem;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s;backdrop-filter:blur(6px);}
        .lightbox-nav:hover{background:rgba(255,255,255,.28);transform:translateY(-50%) scale(1.08);}
        .lightbox-prev{left:1.25rem;}
        .lightbox-next{right:1.25rem;}
        .lightbox-info{color:rgba(255,255,255,.85);margin-top:.85rem;text-align:center;}
        .lightbox-info h4{font-size:1.05rem;font-weight:700;color:white;margin-bottom:.2rem;}
        .lightbox-info p{font-size:.82rem;color:rgba(255,255,255,.6);}
        .lightbox-thumbs{display:flex;gap:.5rem;margin-top:.85rem;max-width:92vw;overflow-x:auto;padding:.25rem;scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.3) transparent;}
        .lightbox-thumbs::-webkit-scrollbar{height:4px;}
        .lightbox-thumbs::-webkit-scrollbar-thumb{background:rgba(255,255,255,.3);border-radius:2px;}
        .lightbox-thumb{width:64px;height:48px;object-fit:cover;border-radius:7px;cursor:pointer;opacity:.55;transition:all .2s;border:2px solid transparent;flex-shrink:0;}
        .lightbox-thumb.active{opacity:1;border-color:white;transform:scale(1.05);}
        .lightbox-thumb:hover{opacity:.9;}
        /* swipe hint on mobile */
        @media(max-width:600px){
            .lightbox-nav{width:40px;height:40px;font-size:1rem;}
            .lightbox-prev{left:.5rem;}
            .lightbox-next{right:.5rem;}
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>
    <section class="page-header">
        <div class="container">
            <h1 class="page-title"><i class="fas fa-building me-3"></i>Fasilitas</h1>
            <p style="font-size:1.1rem;opacity:.9;margin-top:.5rem;">Sarana dan prasarana pendukung kegiatan belajar mengajar</p>
        </div>
    </section>
    <section class="content-section">
        <div class="container">
            <!-- Filter -->
            <div class="d-flex flex-wrap gap-2 mb-5 justify-content-center">
                <a href="/fasilitas" class="filter-btn <%= !kategori ? 'active' : '' %>">Semua</a>
                <% ['ruang-kelas','laboratorium','perpustakaan','olahraga','kantin','kesehatan','ibadah','lainnya'].forEach(k => { %>
                <a href="/fasilitas?kategori=<%= k %>" class="filter-btn <%= kategori === k ? 'active' : '' %>">
                    <%= k.charAt(0).toUpperCase() + k.slice(1).replace('-', ' ') %>
                </a>
                <% }) %>
            </div>

            <% if (!fasilitas || fasilitas.length === 0) { %>
            <div class="text-center py-5">
                <i class="fas fa-building fa-4x text-muted mb-3 d-block"></i>
                <p class="text-muted">Belum ada data fasilitas<% if (kategori) { %> untuk kategori "<%= kategori %>"<% } %>.</p>
            </div>
            <% } else { %>
            <div class="row g-4">
                <% fasilitas.forEach((f, fi) => {
                    const iconMap = {
                        'ruang-kelas': { icon: 'fa-chalkboard-teacher', color: '#0ea5e9', bg: '#e0f2fe' },
                        'laboratorium': { icon: 'fa-flask', color: '#8b5cf6', bg: '#ede9fe' },
                        'perpustakaan': { icon: 'fa-book-open', color: '#10b981', bg: '#d1fae5' },
                        'olahraga': { icon: 'fa-running', color: '#f59e0b', bg: '#fef3c7' },
                        'kantin': { icon: 'fa-utensils', color: '#ef4444', bg: '#fee2e2' },
                        'kesehatan': { icon: 'fa-heartbeat', color: '#ec4899', bg: '#fce7f3' },
                        'ibadah': { icon: 'fa-mosque', color: '#14b8a6', bg: '#ccfbf1' },
                        'lainnya': { icon: 'fa-building', color: '#64748b', bg: '#f1f5f9' }
                    };
                    const meta = iconMap[f.kategori] || iconMap['lainnya'];
                    const fotos = (fotoMap && fotoMap[f.id]) ? fotoMap[f.id] : [];
                    const hasMulti = fotos.length > 1;
                %>
                <div class="col-md-6 col-lg-4">
                    <div class="fasilitas-card">
                        <!-- Foto Slider -->
                        <div class="card-slider" id="slider-<%= fi %>">
                            <div class="card-slider-track" id="track-<%= fi %>">
                                <% if (fotos.length > 0) { %>
                                    <% fotos.forEach((foto, fotoIdx) => { %>
                                    <div class="card-slide">
                                        <a class="card-slide-clickable" onclick="openLightbox(<%= fi %>, <%= fotoIdx %>)" href="javascript:void(0)" aria-label="Lihat foto <%= f.nama %>">
                                            <img src="/uploads/<%= foto.gambar %>" alt="<%= f.nama %>">
                                        </a>
                                        <div class="card-slide-hover-overlay">
                                            <i class="fas fa-search-plus"></i>
                                        </div>
                                    </div>
                                    <% }) %>
                                <% } else { %>
                                <div class="card-slide">
                                    <div class="card-slide-placeholder" style="background:linear-gradient(135deg,<%= meta.color %>,<%= meta.color %>cc)">
                                        <i class="fas <%= meta.icon %>"></i>
                                    </div>
                                </div>
                                <% } %>
                            </div>

                            <!-- Badge kategori -->
                            <span class="badge-kategori" style="background:<%= meta.color %>">
                                <i class="fas <%= meta.icon %> me-1"></i><%= f.kategori.replace('-', ' ') %>
                            </span>

                            <!-- Jumlah foto -->
                            <% if (fotos.length > 1) { %>
                            <span class="foto-count" id="fcount-<%= fi %>">
                                <i class="fas fa-images me-1"></i>1 / <%= fotos.length %>
                            </span>
                            <% } %>

                            <!-- Slider controls -->
                            <% if (hasMulti) { %>
                            <button class="slider-ctrl prev" onclick="event.stopPropagation();slideCard(<%= fi %>,-1)"><i class="fas fa-chevron-left"></i></button>
                            <button class="slider-ctrl next" onclick="event.stopPropagation();slideCard(<%= fi %>,1)"><i class="fas fa-chevron-right"></i></button>
                            <div class="slider-dots" id="dots-<%= fi %>">
                                <% fotos.forEach((_, di) => { %>
                                <div class="slider-dot <%= di===0?'active':'' %>" onclick="event.stopPropagation();goSlide(<%= fi %>,<%= di %>)"></div>
                                <% }) %>
                            </div>
                            <% } %>
                        </div>

                        <!-- Info -->
                        <div class="card-body-inner">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <div style="width:34px;height:34px;border-radius:10px;background:<%= meta.bg %>;color:<%= meta.color %>;display:flex;align-items:center;justify-content:center;font-size:.95rem;flex-shrink:0;">
                                    <i class="fas <%= meta.icon %>"></i>
                                </div>
                                <h3 class="card-nama mb-0"><%= f.nama %></h3>
                            </div>
                            <% if (f.deskripsi) { %>
                            <p class="card-desc"><%= f.deskripsi.length > 100 ? f.deskripsi.substring(0, 100) + '...' : f.deskripsi %></p>
                            <% } %>
                            <% if (fotos.length > 1) { %>
                            <button class="btn btn-sm mt-2" style="border-radius:50px;font-size:.78rem;font-weight:600;background:var(--light-blue);color:var(--primary-blue);border:none;" onclick="openLightbox(<%= fi %>)">
                                <i class="fas fa-images me-1"></i>Lihat <%= fotos.length %> Foto
                            </button>
                            <% } %>
                        </div>
                    </div>
                </div>
                <% }) %>
            </div>
            <% } %>
        </div>
    </section>

    <!-- Lightbox -->
    <div class="lightbox-overlay" id="lightbox">
        <button class="lightbox-close" onclick="closeLightbox()"><i class="fas fa-times"></i></button>
        <button class="lightbox-nav lightbox-prev" onclick="lightboxNav(-1)"><i class="fas fa-chevron-left"></i></button>
        <button class="lightbox-nav lightbox-next" onclick="lightboxNav(1)"><i class="fas fa-chevron-right"></i></button>
        <div class="lightbox-img-wrap">
            <img id="lightboxImg" src="" alt="" loading="lazy">
        </div>
        <div class="lightbox-info">
            <h4 id="lightboxNama"></h4>
            <p id="lightboxCounter"></p>
        </div>
        <div class="lightbox-thumbs" id="lightboxThumbs"></div>
    </div>

    <%- include('partials/footer') %>
    <script src="/assets/vendor/bootstrap5/bootstrap.bundle.min.js"></script>
    <script>
    // ── Data fasilitas untuk JS ──
    const fasilitasData = <%- JSON.stringify(fasilitas.map((f, fi) => ({
        fi,
        nama: f.nama,
        fotos: (fotoMap && fotoMap[f.id]) ? fotoMap[f.id].map(x => '/uploads/' + x.gambar) : []
    }))) %>;

    // ── Card Slider ──
    const cardState = {};
    fasilitasData.forEach(f => { cardState[f.fi] = 0; });

    function slideCard(fi, dir) {
        const fotos = fasilitasData[fi].fotos;
        if (!fotos.length) return;
        cardState[fi] = (cardState[fi] + dir + fotos.length) % fotos.length;
        updateCardSlider(fi);
    }
    function goSlide(fi, idx) {
        cardState[fi] = idx;
        updateCardSlider(fi);
    }
    function updateCardSlider(fi) {
        const idx = cardState[fi];
        const track = document.getElementById('track-' + fi);
        if (track) track.style.transform = `translateX(-${idx * 100}%)`;
        const dotsEl = document.getElementById('dots-' + fi);
        if (dotsEl) dotsEl.querySelectorAll('.slider-dot').forEach((d, i) => d.classList.toggle('active', i === idx));
        const cnt = document.getElementById('fcount-' + fi);
        if (cnt) cnt.innerHTML = `<i class="fas fa-images me-1"></i>${idx+1} / ${fasilitasData[fi].fotos.length}`;
    }

    // ── Lightbox ──
    let lbFi = 0, lbIdx = 0;
    const lbImg = document.getElementById('lightboxImg');

    function openLightbox(fi, idx) {
        lbFi = fi;
        lbIdx = (idx !== undefined) ? idx : (cardState[fi] || 0);
        renderLightbox();
        document.getElementById('lightbox').classList.add('open');
        document.body.style.overflow = 'hidden';
    }
    function closeLightbox() {
        document.getElementById('lightbox').classList.remove('open');
        document.body.style.overflow = '';
    }
    function lightboxNav(dir) {
        const fotos = fasilitasData[lbFi].fotos;
        lbIdx = (lbIdx + dir + fotos.length) % fotos.length;
        renderLightbox();
    }
    function lightboxGoto(idx) {
        lbIdx = idx;
        renderLightbox();
    }
    function renderLightbox() {
        const f = fasilitasData[lbFi];
        const fotos = f.fotos;
        // loading state
        lbImg.classList.add('loading');
        const newSrc = fotos[lbIdx];
        const tmp = new Image();
        tmp.onload = () => { lbImg.src = newSrc; lbImg.classList.remove('loading'); };
        tmp.src = newSrc;

        document.getElementById('lightboxNama').textContent = f.nama;
        document.getElementById('lightboxCounter').textContent = fotos.length > 1 ? `Foto ${lbIdx+1} dari ${fotos.length}` : '';
        // thumbs
        const thumbsEl = document.getElementById('lightboxThumbs');
        thumbsEl.innerHTML = fotos.map((src, i) =>
            `<img src="${src}" class="lightbox-thumb ${i===lbIdx?'active':''}" onclick="lightboxGoto(${i})" loading="lazy">`
        ).join('');
        // scroll active thumb into view
        const activeThumb = thumbsEl.querySelector('.active');
        if (activeThumb) activeThumb.scrollIntoView({ inline: 'center', behavior: 'smooth' });
        // nav visibility
        document.querySelector('.lightbox-prev').style.display = fotos.length > 1 ? '' : 'none';
        document.querySelector('.lightbox-next').style.display = fotos.length > 1 ? '' : 'none';
    }

    // Keyboard
    document.addEventListener('keydown', e => {
        if (!document.getElementById('lightbox').classList.contains('open')) return;
        if (e.key === 'ArrowLeft') lightboxNav(-1);
        if (e.key === 'ArrowRight') lightboxNav(1);
        if (e.key === 'Escape') closeLightbox();
    });

    // Click backdrop to close
    document.getElementById('lightbox').addEventListener('click', e => {
        if (e.target === document.getElementById('lightbox')) closeLightbox();
    });

    // Touch swipe support
    let tsX = 0;
    document.getElementById('lightbox').addEventListener('touchstart', e => { tsX = e.touches[0].clientX; }, { passive: true });
    document.getElementById('lightbox').addEventListener('touchend', e => {
        const dx = e.changedTouches[0].clientX - tsX;
        if (Math.abs(dx) > 50) lightboxNav(dx < 0 ? 1 : -1);
    });

    // Navbar scroll
    window.addEventListener('scroll', () => {
        document.querySelector('.navbar-modern')?.classList.toggle('scrolled', window.scrollY > 50);
    });
    </script>
</body>
</html>


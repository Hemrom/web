<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title><%= title %> - Website Sekolah</title>
    <link rel="icon" type="image/png" href="/assets/img/favicon.png">
    <link href="/assets/vendor/bootstrap5/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/vendor/fontawesome6/all.min.css" rel="stylesheet">    <link rel="stylesheet" href="/theme.css">
    <style>
        *{font-family:'Inter',sans-serif;box-sizing:border-box;margin:0;padding:0;}
        body{color:#334155;line-height:1.6;background:#f8fafc;}
        .page-header{padding:10rem 0 4rem;color:white;text-align:center;position:relative;}
        .content-section{padding:4rem 0;}
        .content-card{background:white;border-radius:16px;box-shadow:0 4px 20px rgba(0,0,0,.06);padding:3rem;}
        .content-card img{max-width:100%;border-radius:12px;margin:1rem 0;}
        .meta-badge{display:inline-flex;align-items:center;gap:.4rem;padding:.3rem .8rem;border-radius:20px;font-size:.78rem;font-weight:600;}
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <section class="page-header" style="background:<%= jurusan.warna||'linear-gradient(135deg,#0ea5e9,#0369a1)' %>;">
        <div class="container" style="position:relative;z-index:1;">
            <div style="margin-bottom:.75rem;">
                <a href="/jurusan/<%= jurusan.kode.toLowerCase() %>" style="color:rgba(255,255,255,.8);text-decoration:none;font-size:.9rem;">
                    <i class="fas fa-arrow-left me-2"></i><%= jurusan.kode %>
                </a>
            </div>
            <span class="meta-badge" style="background:rgba(255,255,255,.2);color:white;margin-bottom:.75rem;"><%= berita.kategori %></span>
            <h1 style="font-size:2.2rem;font-weight:800;margin-bottom:.5rem;"><%= berita.judul %></h1>
            <p style="opacity:.8;font-size:.9rem;">
                <i class="fas fa-calendar me-1"></i><%= new Date(berita.created_at).toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'}) %>
                <% if (berita.penulis) { %> &nbsp;�&nbsp; <i class="fas fa-user me-1"></i><%= berita.penulis %><% } %>
            </p>
        </div>
    </section>

    <section class="content-section">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-9">
                    <div class="content-card">
                        <% if (berita.gambar) { %>
                        <img src="/uploads/<%= berita.gambar %>" alt="<%= berita.judul %>" style="width:100%;max-height:400px;object-fit:cover;">
                        <% } %>
                        <div style="font-size:1rem;line-height:1.8;margin-top:<%= berita.gambar?'1.5rem':'0' %>;">
                            <%- berita.konten || '' %>
                        </div>
                        <% shareTitle = berita.judul; shareUrl = '/jurusan/' + jurusan.kode.toLowerCase() + '/berita/' + berita.slug; %>
                        <%- include('partials/share-buttons') %>
                        <div class="mt-4 pt-3" style="border-top:1px solid #f1f5f9;">
                            <a href="/jurusan/<%= jurusan.kode.toLowerCase() %>" style="color:var(--primary-blue,#0ea5e9);font-weight:600;text-decoration:none;">
                                <i class="fas fa-arrow-left me-2"></i>Kembali ke <%= jurusan.nama %>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <%- include('partials/footer') %>
    <script src="/assets/vendor/bootstrap5/bootstrap.bundle.min.js"></script>
    <script src="/assets/vendor/jquery3/jquery.min.js"></script>
    <script>$(window).scroll(function(){if($(window).scrollTop()>50)$('.navbar-modern').addClass('scrolled');else$('.navbar-modern').removeClass('scrolled');});</script>
</body>
</html>


<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <% seoTitle = 'Guru & Staff'; seoDesc = 'Daftar guru dan tenaga kependidikan profesional SMK Negeri 1 Kras, Kediri. Didukung oleh pendidik berpengalaman dan berkompeten di bidangnya.'; seoUrl = '/guru'; %>
    <%- include('partials/_seo') %>

    <!-- Bootstrap CSS -->
    <link href="/assets/vendor/bootstrap5/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="/assets/vendor/fontawesome6/all.min.css" rel="stylesheet">
    <!-- Google Fonts -->    <!-- Dynamic Theme -->
    <link rel="stylesheet" href="/theme.css">
    
    <style>
        /* Color Variables - Same as home page */
        :root {
            --primary-blue: #0ea5e9;
            --primary-blue-dark: #0284c7;
            --primary-blue-light: #38bdf8;
            --secondary-blue: #0369a1;
            --accent-blue: #7dd3fc;
            --light-blue: #e0f2fe;
            --dark-blue: #0c4a6e;
            --gray-50: #f8fafc;
            --gray-100: #f1f5f9;
            --gray-200: #e2e8f0;
            --gray-300: #cbd5e1;
            --gray-400: #94a3b8;
            --gray-500: #64748b;
            --gray-600: #475569;
            --gray-700: #334155;
            --gray-800: #1e293b;
            --gray-900: #0f172a;
        }
        
        * { 
            font-family: 'Inter', sans-serif; 
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            line-height: 1.6;
            color: var(--gray-700);
        }
        
        /* Header & Navigation - Same as home page */
        .navbar-modern {
            background: rgba(255, 255, 255, 0.95) !important;
            backdrop-filter: blur(10px);
            box-shadow: 0 2px 20px rgba(14, 165, 233, 0.1);
            padding: 1rem 0;
            transition: all 0.3s ease;
        }
        .navbar-modern.scrolled {
            background: rgba(255, 255, 255, 0.98) !important;
            box-shadow: 0 4px 30px rgba(14, 165, 233, 0.15);
        }
        .navbar-brand { 
            font-weight: 700; 
            color: var(--primary-blue) !important; 
            font-size: 1.5rem;
            text-decoration: none;
        }
        .navbar-brand:hover {
            color: var(--primary-blue-dark) !important;
            text-decoration: none;
        }
        .navbar-toggler {
            border: none;
            padding: 0.25rem 0.5rem;
        }
        .navbar-toggler:focus {
            box-shadow: none;
        }
        .navbar-nav {
            align-items: center;
        }
        .nav-item {
            margin: 0 0.25rem;
        }
        .nav-link { 
            font-weight: 500; 
            color: var(--gray-600) !important; 
            padding: 0.75rem 1rem !important;
            border-radius: 8px;
            transition: all 0.3s ease;
            position: relative;
            text-decoration: none;
        }
        .nav-link:hover { 
            color: var(--primary-blue) !important;
            background-color: var(--light-blue);
            text-decoration: none;
        }
        .nav-link.active {
            color: var(--primary-blue) !important;
            background-color: var(--light-blue);
        }
        
        /* Page Header */
        .page-header {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--secondary-blue) 100%);
            padding: 10rem 0 6rem;
            color: white;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        .page-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000"><polygon fill="rgba(255,255,255,0.05)" points="0,1000 1000,0 1000,1000"/></svg>');
        }
        .page-title {
            font-size: 3.5rem;
            font-weight: 800;
            margin-bottom: 1rem;
            position: relative;
            z-index: 1;
        }
        .page-subtitle {
            font-size: 1.3rem;
            opacity: 0.9;
            position: relative;
            z-index: 1;
        }
        
        /* Content Section */
        .content-section {
            padding: 6rem 0;
            background: var(--gray-50);
        }
        
        /* Teacher Cards */
        .teacher-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 4px 20px rgba(14, 165, 233, 0.08);
            transition: all 0.3s ease;
            border: 1px solid var(--gray-100);
            margin-bottom: 2rem;
            overflow: hidden;
        }
        .teacher-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(14, 165, 233, 0.15);
        }
        .teacher-photo {
            width: 100%;
            height: 320px;
            object-fit: contain;
            object-position: center top;
            background: var(--gray-100);
        }
        .teacher-photo-placeholder {
            width: 100%;
            height: 320px;
            background: linear-gradient(135deg, var(--gray-100), var(--gray-200));
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--gray-400);
            font-size: 3rem;
        }
        .teacher-content {
            padding: 2rem;
            text-align: center;
        }
        .teacher-name {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--gray-800);
            margin-bottom: 0.5rem;
        }
        .teacher-subject {
            color: var(--primary-blue);
            font-weight: 600;
            font-size: 1rem;
            margin-bottom: 0.5rem;
        }
        .teacher-position {
            color: var(--gray-600);
            font-size: 0.9rem;
            margin-bottom: 1rem;
        }
        .teacher-nip {
            color: var(--gray-500);
            font-size: 0.8rem;
            margin-bottom: 1.5rem;
        }
        .teacher-contact {
            display: flex;
            justify-content: center;
            gap: 1rem;
            flex-wrap: wrap;
        }
        .contact-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--gray-600);
            font-size: 0.9rem;
        }
        .contact-item i {
            color: var(--primary-blue);
        }
        
        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            color: var(--gray-600);
        }
        .empty-state i {
            font-size: 4rem;
            margin-bottom: 2rem;
            color: var(--gray-300);
        }
        .empty-state h3 {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 1rem;
            color: var(--gray-700);
        }
        
        /* Footer */
        .footer {
            background: var(--gray-900);
            color: white;
            padding: 4rem 0 2rem;
        }
        .footer-title {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
            color: white;
        }
        .footer-link {
            color: var(--gray-300);
            text-decoration: none;
            margin-bottom: 0.5rem;
            display: block;
            transition: color 0.3s ease;
        }
        .footer-link:hover {
            color: var(--accent-blue);
            text-decoration: none;
        }
        .footer-bottom {
            border-top: 1px solid var(--gray-700);
            margin-top: 3rem;
            padding-top: 2rem;
            text-align: center;
            color: var(--gray-400);
        }
        
        /* Responsive */
        @media (max-width: 991px) {
            .navbar-collapse {
                background: white;
                border-radius: 15px;
                box-shadow: 0 10px 30px rgba(0,0,0,0.1);
                margin-top: 1rem;
                padding: 1rem;
            }
            .nav-item {
                margin: 0.25rem 0;
            }
            .nav-link {
                padding: 0.75rem 1rem !important;
                border-radius: 8px;
            }
            .page-title { font-size: 2.5rem; }
        }
        
        @media (max-width: 768px) {
            .page-title { font-size: 2rem; }
            .page-subtitle { font-size: 1rem; }
            .teacher-content {
                padding: 1.5rem;
            }
            .teacher-contact {
                flex-direction: column;
                align-items: center;
            }
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <%- include('partials/navbar') %>

    <!-- Page Header -->
    <section class="page-header">
        <div class="container">
            <h1 class="page-title">Guru & Staff</h1>
            <p class="page-subtitle">Tenaga pendidik dan kependidikan yang berpengalaman dan berkualitas</p>
        </div>
    </section>

    <!-- Content Section -->
    <section class="content-section">
        <div class="container">
            <% if (guru.length === 0) { %>
                <div class="empty-state">
                    <i class="fas fa-users"></i>
                    <h3>Belum Ada Data Guru</h3>
                    <p>Informasi guru dan staff akan segera hadir di sini.</p>
                </div>
            <% } else { %>
                <% jabatanOrder.forEach(function(kelompok) { %>
                <% if (grouped[kelompok.key] && grouped[kelompok.key].length > 0) { %>
                <div class="mb-5">
                    <h4 style="font-size:1.3rem;font-weight:700;color:var(--gray-800);border-left:4px solid var(--primary-blue);padding-left:1rem;margin-bottom:1.5rem;">
                        <%= kelompok.label %>
                        <span style="font-size:0.85rem;font-weight:400;color:var(--gray-400);margin-left:0.5rem;">(<%= grouped[kelompok.key].length %> orang)</span>
                    </h4>
                    <div class="row">
                        <% grouped[kelompok.key].forEach(function(teacher) { %>
                        <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                            <div class="teacher-card">
                                <% if (teacher.foto) { %>
                                    <img src="/uploads/<%= teacher.foto %>" alt="<%= teacher.nama %>" class="teacher-photo">
                                <% } else { %>
                                    <div class="teacher-photo-placeholder">
                                        <i class="fas fa-user"></i>
                                    </div>
                                <% } %>
                                <div class="teacher-content">
                                    <h3 class="teacher-name"><%= teacher.nama %></h3>
                                    <% if (teacher.mata_pelajaran) { %>
                                        <div class="teacher-subject"><%= teacher.mata_pelajaran %></div>
                                    <% } %>
                                    <% if (teacher.jabatan) { %>
                                        <div class="teacher-position"><%= teacher.jabatan %></div>
                                    <% } %>
                                    <% if (teacher.email) { %>
                                        <div class="contact-item mt-2">
                                            <i class="fas fa-envelope"></i>
                                            <span><%= teacher.email %></span>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                </div>
                <% } %>
                <% }); %>
            <% } %>
        </div>
    </section>

    <!-- Footer -->
    <%- include('partials/related') %>
    <%- include('partials/footer') %>

    <!-- Bootstrap JS -->
    <script src="/assets/vendor/bootstrap5/bootstrap.bundle.min.js"></script>
    <!-- jQuery -->
    <script src="/assets/vendor/jquery3/jquery.min.js"></script>
    
    <script>
        // Navbar background on scroll
        $(window).scroll(function() {
            if ($(window).scrollTop() > 50) {
                $('.navbar-modern').addClass('scrolled');
            } else {
                $('.navbar-modern').removeClass('scrolled');
            }
        });
    </script>
</body>
</html>



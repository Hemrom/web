<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title><%= title %> - Website Sekolah</title>
    <link rel="icon" type="image/png" href="/assets/img/favicon.png">
    <link href="/assets/vendor/bootstrap5/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/vendor/fontawesome6/all.min.css" rel="stylesheet">    <link rel="stylesheet" href="/theme.css">
    <style>
        * { font-family:'Inter',sans-serif; box-sizing:border-box; }
        body { background:#f8fafc; }
        .reg-wrapper { min-height:100vh; display:flex; align-items:center; justify-content:center; padding:6rem 1rem 3rem; }
        .reg-card { background:white; border-radius:24px; box-shadow:0 8px 40px rgba(14,165,233,.12); padding:3rem; max-width:700px; width:100%; }
        .reg-header { text-align:center; margin-bottom:2rem; }
        .reg-header .icon { width:80px; height:80px; background:linear-gradient(135deg,#f59e0b,#d97706); border-radius:20px; display:flex; align-items:center; justify-content:center; margin:0 auto 1rem; color:white; font-size:2rem; }
        .reg-header h2 { font-size:1.8rem; font-weight:800; color:#1e293b; }
        .reg-header p { color:#64748b; }
        .form-label { font-weight:600; color:#334155; font-size:.9rem; }
        .form-control, .form-select { border-radius:10px; border:1px solid #e2e8f0; padding:.7rem 1rem; }
        .form-control:focus, .form-select:focus { border-color:#0ea5e9; box-shadow:0 0 0 3px rgba(14,165,233,.15); }
        .btn-submit { background:linear-gradient(135deg,#f59e0b,#d97706); color:white; border:none; border-radius:50px; padding:.9rem 3rem; font-weight:700; font-size:1rem; width:100%; transition:all .3s; }
        .btn-submit:hover { transform:translateY(-2px); box-shadow:0 8px 20px rgba(245,158,11,.4); color:white; }
        .section-divider { font-size:.8rem; font-weight:700; color:#94a3b8; text-transform:uppercase; letter-spacing:.1em; margin:1.5rem 0 1rem; padding-bottom:.5rem; border-bottom:2px solid #f1f5f9; }
        .foto-preview { width:100px; height:100px; border-radius:50%; object-fit:cover; border:3px solid #e0f2fe; display:none; }
        .foto-placeholder { width:100px; height:100px; border-radius:50%; background:#f1f5f9; display:flex; align-items:center; justify-content:center; color:#94a3b8; font-size:2rem; }
        .success-box { background:linear-gradient(135deg,#10b981,#059669); color:white; border-radius:16px; padding:2rem; text-align:center; }
        .token-box { background:rgba(255,255,255,.2); border-radius:10px; padding:1rem; margin:1rem 0; font-family:monospace; font-size:.9rem; word-break:break-all; }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="reg-wrapper">
        <div class="reg-card">
            <div class="reg-header">
                <div class="icon"><i class="fas fa-user-graduate"></i></div>
                <h2>Daftar Alumni</h2>
                <p>Bergabunglah dan bagikan cerita suksesmu</p>
            </div>

            <% if (success) { %>
            <div class="success-box">
                <i class="fas fa-check-circle fa-3x mb-3 d-block"></i>
                <h4 class="fw-bold">Pendaftaran Berhasil!</h4>
                <p>Data kamu sudah diterima dan sedang menunggu verifikasi admin. Kamu akan ditampilkan di halaman alumni setelah disetujui.</p>
                <div class="token-box">
                    <small>Simpan link ini untuk update biodata nanti:</small><br>
                    <strong>/alumni/edit/<%= token %></strong>
                </div>
                <a href="/alumni" class="btn btn-light mt-2 fw-bold">Lihat Halaman Alumni</a>
            </div>
            <% } else { %>

            <% if (error) { %>
            <div class="alert alert-danger rounded-3"><i class="fas fa-exclamation-circle me-2"></i><%= error %></div>
            <% } %>

            <form method="POST" action="/alumni/daftar" enctype="multipart/form-data">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="text-center mb-3">
                    <div class="foto-placeholder" id="fotoPlaceholder"><i class="fas fa-camera"></i></div>
                    <img id="fotoPreview" class="foto-preview" src="" alt="Preview">
                    <div class="mt-2">
                        <label for="fotoInput" class="btn btn-sm btn-outline-secondary rounded-pill">
                            <i class="fas fa-upload me-1"></i>Upload Foto
                        </label>
                        <input type="file" id="fotoInput" name="foto" accept=".jpg,.jpeg,.png,.webp" class="d-none">
                    </div>
                </div>

                <div class="section-divider">Data Diri</div>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label">Nama Lengkap *</label>
                        <input type="text" class="form-control" name="nama" required placeholder="Nama sesuai ijazah">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">NIS</label>
                        <input type="text" class="form-control" name="nis" placeholder="Nomor Induk Siswa">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Tahun Lulus *</label>
                        <input type="number" class="form-control" name="tahun_lulus" required min="1990" max="2099" placeholder="2020">
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">Jurusan</label>
                        <input type="text" class="form-control" name="jurusan" placeholder="TKJ / TKRO / Kuliner / TPTUP">
                    </div>
                </div>

                <div class="section-divider">Pekerjaan & Domisili</div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Pekerjaan / Profesi</label>
                        <input type="text" class="form-control" name="pekerjaan" placeholder="Software Engineer, Wirausaha, dll">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Perusahaan / Instansi</label>
                        <input type="text" class="form-control" name="perusahaan" placeholder="Nama perusahaan atau kampus">
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Kota Domisili</label>
                        <input type="text" class="form-control" name="kota" placeholder="Kediri, Surabaya, Jakarta...">
                    </div>
                </div>

                <div class="section-divider">Kontak & Media Sosial</div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" name="email" placeholder="email@contoh.com">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Telepon / WhatsApp</label>
                        <input type="text" class="form-control" name="telepon" placeholder="08xxxxxxxxxx">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Instagram</label>
                        <div class="input-group">
                            <span class="input-group-text">@</span>
                            <input type="text" class="form-control" name="instagram" placeholder="username">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">LinkedIn</label>
                        <input type="url" class="form-control" name="linkedin" placeholder="https://linkedin.com/in/...">
                    </div>
                </div>

                <div class="section-divider">Cerita Alumni</div>
                <div class="mb-4">
                    <label class="form-label">Pengalaman / Cerita Terbaik Selama di Sekolah</label>
                    <textarea class="form-control" name="cerita" rows="4" placeholder="Ceritakan momen berkesan, prestasi, atau pesan untuk adik kelas..."></textarea>
                    <small class="text-muted">Ceritamu akan ditampilkan di halaman alumni sebagai inspirasi</small>
                </div>

                <button type="submit" class="btn-submit"><i class="fas fa-paper-plane me-2"></i>Kirim Pendaftaran</button>
                <div class="text-center mt-3">
                    <a href="/alumni" class="text-muted small">← Kembali ke halaman alumni</a>
                </div>
            </form>
            <% } %>
        </div>
    </div>

    <script src="/assets/vendor/bootstrap5/bootstrap.bundle.min.js"></script>
    <script>
    document.getElementById('fotoInput').addEventListener('change', function() {
        const file = this.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = e => {
            document.getElementById('fotoPreview').src = e.target.result;
            document.getElementById('fotoPreview').style.display = 'block';
            document.getElementById('fotoPlaceholder').style.display = 'none';
        };
        reader.readAsDataURL(file);
    });
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <% seoTitle = 'Prestasi Siswa'; seoDesc = 'Prestasi membanggakan siswa SMK Negeri 1 Kras di bidang akademik, non-akademik, olahraga, dan teknologi tingkat kabupaten, provinsi, hingga nasional.'; seoUrl = '/prestasi'; %>
    <%- include('partials/_seo') %>
    <link href="/assets/vendor/bootstrap5/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/vendor/fontawesome6/all.min.css" rel="stylesheet">    <link rel="stylesheet" href="/theme.css">
    <style>
        :root{--primary-blue:#0ea5e9;--primary-blue-dark:#0284c7;--secondary-blue:#0369a1;--light-blue:#e0f2fe;--gray-50:#f8fafc;--gray-100:#f1f5f9;--gray-600:#475569;--gray-700:#334155;--gray-800:#1e293b;--gray-900:#0f172a;}
        *{font-family:'Inter',sans-serif;box-sizing:border-box;margin:0;padding:0;}
        body{color:var(--gray-700);line-height:1.6;}
        .page-header{background:linear-gradient(135deg,var(--primary-blue),var(--secondary-blue));padding:10rem 0 5rem;color:white;text-align:center;}
        .page-title{font-size:3rem;font-weight:800;}
        .content-section{padding:5rem 0;background:var(--gray-50);}
        .prestasi-card{background:white;border-radius:20px;overflow:hidden;box-shadow:0 4px 20px rgba(14,165,233,.08);border:1px solid var(--gray-100);transition:all .3s;height:100%;}
        .prestasi-card:hover{transform:translateY(-8px);box-shadow:0 16px 40px rgba(14,165,233,.15);}
        .prestasi-img{height:200px;object-fit:cover;width:100%;}
        .prestasi-img-placeholder{height:200px;background:linear-gradient(135deg,var(--primary-blue),var(--secondary-blue));display:flex;align-items:center;justify-content:center;color:white;font-size:3rem;}
        .badge-tingkat{font-size:.75rem;padding:.35rem .75rem;border-radius:20px;font-weight:600;}
        .badge-nasional{background:#fef3c7;color:#92400e;}
        .badge-provinsi{background:#dbeafe;color:#1e40af;}
        .badge-kabupaten{background:#d1fae5;color:#065f46;}
        .badge-sekolah{background:#f3f4f6;color:#374151;}
        .filter-btn{border-radius:50px;padding:.4rem 1.2rem;font-size:.85rem;font-weight:600;border:2px solid var(--gray-200);color:var(--gray-600);background:white;transition:all .2s;}
        .filter-btn.active,.filter-btn:hover{background:var(--primary-blue);color:white;border-color:var(--primary-blue);}
    </style>
</head>
<body>
    <%- include('partials/navbar') %>
    <section class="page-header">
        <div class="container">
            <h1 class="page-title"><i class="fas fa-trophy me-3"></i>Prestasi</h1>
            <p style="font-size:1.1rem;opacity:.9;margin-top:.5rem;">Pencapaian membanggakan siswa-siswi kami</p>
        </div>
    </section>
    <section class="content-section">
        <div class="container">
            <!-- Filter -->
            <div class="d-flex flex-wrap gap-2 mb-4 justify-content-center">
                <a href="/prestasi" class="filter-btn <%= !kategori?'active':'' %>">Semua</a>
                <% ['akademik','non-akademik','olahraga','seni','teknologi'].forEach(k=>{ %>
                <a href="/prestasi?kategori=<%= k %>" class="filter-btn <%= kategori===k?'active':'' %>"><%= k.charAt(0).toUpperCase()+k.slice(1) %></a>
                <% }) %>
            </div>

            <% if (!prestasi||prestasi.length===0) { %>
            <div class="text-center py-5">
                <i class="fas fa-trophy fa-4x text-muted mb-3 d-block"></i>
                <h4 class="text-muted">Belum ada data prestasi</h4>
            </div>
            <% } else { %>
            <div class="row g-4">
                <% prestasi.forEach(p=>{ %>
                <div class="col-lg-4 col-md-6">
                    <div class="prestasi-card">
                        <% if (p.gambar) { %>
                        <img src="/uploads/<%= p.gambar %>" class="prestasi-img" alt="<%= p.judul %>" loading="lazy" decoding="async" width="400" height="200">
                        <% } else { %>
                        <div class="prestasi-img-placeholder"><i class="fas fa-trophy"></i></div>
                        <% } %>
                        <div class="p-4">
                            <div class="d-flex gap-2 mb-2 flex-wrap">
                                <span class="badge-tingkat badge-<%= p.tingkat %>"><%= p.tingkat.charAt(0).toUpperCase()+p.tingkat.slice(1) %></span>
                                <span style="background:var(--light-blue);color:var(--primary-blue-dark);padding:.2rem .6rem;border-radius:10px;font-size:.75rem;font-weight:600;"><%= p.kategori %></span>
                                <% if (p.tahun) { %><span style="background:#f3f4f6;color:#374151;padding:.2rem .6rem;border-radius:10px;font-size:.75rem;font-weight:600;"><%= p.tahun %></span><% } %>
                            </div>
                            <h5 style="font-weight:700;color:var(--gray-800);margin-bottom:.5rem;line-height:1.4;"><%= p.judul %></h5>
                            <% if (p.jurusan) { %><p style="font-size:.8rem;color:var(--primary-blue);font-weight:600;margin-bottom:.5rem;"><i class="fas fa-graduation-cap me-1"></i><%= p.jurusan %></p><% } %>
                            <% if (p.deskripsi) { %><p style="font-size:.85rem;color:var(--gray-600);line-height:1.5;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;"><%= p.deskripsi %></p><% } %>
                        </div>
                    </div>
                </div>
                <% }) %>
            </div>
            <% } %>
        </div>
    </section>
    <%- include('partials/footer') %>
    <script src="/assets/vendor/bootstrap5/bootstrap.bundle.min.js"></script>
    <script src="/assets/vendor/jquery3/jquery.min.js"></script>
    <script>$(window).scroll(function(){if($(window).scrollTop()>50)$('.navbar-modern').addClass('scrolled');else$('.navbar-modern').removeClass('scrolled');});</script>
</body>
</html>


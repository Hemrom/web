<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title><%= title %> - Website Sekolah</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
    <link rel="alternate icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><circle cx='16' cy='16' r='16' fill='%230ea5e9'/><rect x='8' y='18' width='16' height='3' rx='1' fill='white'/><polygon points='6,18 22,18 20,14 8,14' fill='white'/><circle cx='20' cy='16' r='1' fill='%230284c7'/><line x1='20' y1='17' x2='20' y2='22' stroke='%230284c7' stroke-width='1'/><circle cx='20' cy='22' r='1.5' fill='%230284c7'/><text x='16' y='28' text-anchor='middle' font-family='Arial' font-size='5' font-weight='bold' fill='white'>SMK</text></svg>">
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        /* Color Variables - Same as home page */
        :root {
            --primary-blue: #0ea5e9;
            --primary-blue-dark: #0284c7;
            --primary-blue-light: #38bdf8;
            --secondary-blue: #0369a1;
            --accent-blue: #7dd3fc;
            --light-blue: #e0f2fe;
            --dark-blue: #0c4a6e;
            --gray-50: #f8fafc;
            --gray-100: #f1f5f9;
            --gray-200: #e2e8f0;
            --gray-300: #cbd5e1;
            --gray-400: #94a3b8;
            --gray-500: #64748b;
            --gray-600: #475569;
            --gray-700: #334155;
            --gray-800: #1e293b;
            --gray-900: #0f172a;
        }
        
        * { 
            font-family: 'Inter', sans-serif; 
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            line-height: 1.6;
            color: var(--gray-700);
        }
        
        /* Header & Navigation - Same as home page */
        .navbar-modern {
            background: rgba(255, 255, 255, 0.95) !important;
            backdrop-filter: blur(10px);
            box-shadow: 0 2px 20px rgba(14, 165, 233, 0.1);
            padding: 1rem 0;
            transition: all 0.3s ease;
        }
        .navbar-modern.scrolled {
            background: rgba(255, 255, 255, 0.98) !important;
            box-shadow: 0 4px 30px rgba(14, 165, 233, 0.15);
        }
        .navbar-brand { 
            font-weight: 700; 
            color: var(--primary-blue) !important; 
            font-size: 1.5rem;
            text-decoration: none;
        }
        .navbar-brand:hover {
            color: var(--primary-blue-dark) !important;
            text-decoration: none;
        }
        .navbar-toggler {
            border: none;
            padding: 0.25rem 0.5rem;
        }
        .navbar-toggler:focus {
            box-shadow: none;
        }
        .navbar-nav {
            align-items: center;
        }
        .nav-item {
            margin: 0 0.25rem;
        }
        .nav-link { 
            font-weight: 500; 
            color: var(--gray-600) !important; 
            padding: 0.75rem 1rem !important;
            border-radius: 8px;
            transition: all 0.3s ease;
            position: relative;
            text-decoration: none;
        }
        .nav-link:hover { 
            color: var(--primary-blue) !important;
            background-color: var(--light-blue);
            text-decoration: none;
        }
        .nav-link.active {
            color: var(--primary-blue) !important;
            background-color: var(--light-blue);
        }
        
        /* Content Section */
        .content-section {
            padding: 8rem 0 4rem;
            background: var(--gray-50);
        }
        
        /* Article */
        .article-container {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(14, 165, 233, 0.08);
            border: 1px solid var(--gray-100);
        }
        .article-image {
            width: 100%;
            height: 400px;
            object-fit: cover;
        }
        .article-content {
            padding: 3rem;
        }
        .article-meta {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 2rem;
            color: var(--gray-500);
            font-size: 0.9rem;
        }
        .article-meta i {
            color: var(--primary-blue);
        }
        .article-title {
            font-size: 2.5rem;
            font-weight: 800;
            color: var(--gray-800);
            margin-bottom: 2rem;
            line-height: 1.2;
        }
        .article-body {
            font-size: 1.1rem;
            line-height: 1.8;
            color: var(--gray-700);
        }
        .article-body p {
            margin-bottom: 1.5rem;
        }
        .article-body h2, .article-body h3, .article-body h4 {
            color: var(--gray-800);
            margin: 2rem 0 1rem;
        }
        .article-body ul, .article-body ol {
            margin-bottom: 1.5rem;
            padding-left: 2rem;
        }
        .article-body li {
            margin-bottom: 0.5rem;
        }
        
        /* Related Articles */
        .related-section {
            padding: 4rem 0;
            background: white;
        }
        .section-title {
            font-size: 2rem;
            font-weight: 700;
            color: var(--gray-800);
            text-align: center;
            margin-bottom: 3rem;
        }
        .related-card {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(14, 165, 233, 0.08);
            border: 1px solid var(--gray-100);
            transition: all 0.3s ease;
            text-decoration: none;
            color: inherit;
        }
        .related-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(14, 165, 233, 0.15);
            text-decoration: none;
            color: inherit;
        }
        .related-image {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }
        .related-content {
            padding: 1.5rem;
        }
        .related-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--gray-800);
            margin-bottom: 0.5rem;
            line-height: 1.4;
        }
        .related-excerpt {
            color: var(--gray-600);
            font-size: 0.9rem;
            line-height: 1.5;
        }
        
        /* Back Button */
        .back-button {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: var(--primary-blue);
            color: white;
            padding: 0.75rem 1.5rem;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
            margin-bottom: 2rem;
        }
        .back-button:hover {
            background: var(--primary-blue-dark);
            transform: translateY(-2px);
            color: white;
            text-decoration: none;
        }
        
        /* Footer */
        .footer {
            background: var(--gray-900);
            color: white;
            padding: 4rem 0 2rem;
        }
        .footer-title {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
            color: white;
        }
        .footer-link {
            color: var(--gray-300);
            text-decoration: none;
            margin-bottom: 0.5rem;
            display: block;
            transition: color 0.3s ease;
        }
        .footer-link:hover {
            color: var(--accent-blue);
            text-decoration: none;
        }
        .footer-bottom {
            border-top: 1px solid var(--gray-700);
            margin-top: 3rem;
            padding-top: 2rem;
            text-align: center;
            color: var(--gray-400);
        }
        
        /* Responsive */
        @media (max-width: 991px) {
            .navbar-collapse {
                background: white;
                border-radius: 15px;
                box-shadow: 0 10px 30px rgba(0,0,0,0.1);
                margin-top: 1rem;
                padding: 1rem;
            }
            .nav-item {
                margin: 0.25rem 0;
            }
            .nav-link {
                padding: 0.75rem 1rem !important;
                border-radius: 8px;
            }
            .article-content { padding: 2rem; }
            .article-title { font-size: 2rem; }
        }
        
        @media (max-width: 768px) {
            .article-content { padding: 1.5rem; }
            .article-title { font-size: 1.75rem; }
            .article-body { font-size: 1rem; }
            .article-meta {
                flex-direction: column;
                align-items: flex-start;
                gap: 0.5rem;
            }
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-modern fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="fas fa-graduation-cap me-2"></i>SMK Negeri 1 Kras
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Beranda</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/profil">Profil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/berita">Berita</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/galeri">Galeri</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/guru">Guru</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/media-sosial">Media Sosial</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/kontak">Kontak</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Content Section -->
    <section class="content-section">
        <div class="container">
            <a href="/berita" class="back-button">
                <i class="fas fa-arrow-left"></i>
                Kembali ke Berita
            </a>
            
            <div class="article-container">
                <% if (berita.gambar) { %>
                    <img src="/uploads/<%= berita.gambar %>" alt="<%= berita.judul %>" class="article-image">
                <% } %>
                <div class="article-content">
                    <div class="article-meta">
                        <span><i class="fas fa-calendar"></i> <%= new Date(berita.created_at).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                        <% if (berita.penulis) { %>
                            <span><i class="fas fa-user"></i> <%= berita.penulis %></span>
                        <% } %>
                        <% if (berita.kategori) { %>
                            <span><i class="fas fa-tag"></i> <%= berita.kategori %></span>
                        <% } %>
                    </div>
                    <h1 class="article-title"><%= berita.judul %></h1>
                    <div class="article-body">
                        <%- berita.konten %>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Related Articles -->
    <% if (beritaTerkait && beritaTerkait.length > 0) { %>
        <section class="related-section">
            <div class="container">
                <h2 class="section-title">Berita Terkait</h2>
                <div class="row">
                    <% beritaTerkait.forEach(item => { %>
                        <div class="col-lg-4 col-md-6 mb-4">
                            <a href="/berita/<%= item.slug %>" class="related-card d-block">
                                <% if (item.gambar) { %>
                                    <img src="/uploads/<%= item.gambar %>" alt="<%= item.judul %>" class="related-image">
                                <% } %>
                                <div class="related-content">
                                    <h3 class="related-title"><%= item.judul %></h3>
                                    <% if (item.excerpt) { %>
                                        <p class="related-excerpt"><%= item.excerpt %></p>
                                    <% } %>
                                </div>
                            </a>
                        </div>
                    <% }); %>
                </div>
            </div>
        </section>
    <% } %>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 col-md-6 mb-4">
                    <h3 class="footer-title">SMK Negeri 1 Kras</h3>
                    <p class="text-muted">Memberikan pendidikan kejuruan berkualitas untuk menciptakan generasi yang cerdas, berkarakter, dan siap kerja.</p>
                </div>
                <div class="col-lg-2 col-md-6 mb-4">
                    <h4 class="footer-title">Menu</h4>
                    <a href="/" class="footer-link">Beranda</a>
                    <a href="/profil" class="footer-link">Profil</a>
                    <a href="/berita" class="footer-link">Berita</a>
                    <a href="/galeri" class="footer-link">Galeri</a>
                </div>
                <div class="col-lg-2 col-md-6 mb-4">
                    <h4 class="footer-title">Informasi</h4>
                    <a href="/guru" class="footer-link">Guru & Staff</a>
                    <a href="/kontak" class="footer-link">Kontak</a>
                </div>
                <div class="col-lg-4 col-md-6 mb-4">
                    <h4 class="footer-title">Kontak Kami</h4>
                    <p class="text-muted">
                        <i class="fas fa-map-marker-alt mr-2"></i>
                        Jl. Raya Kras, Kediri, Jawa Timur
                    </p>
                    <p class="text-muted">
                        <i class="fas fa-phone mr-2"></i>
                        (0354) 123456
                    </p>
                    <p class="text-muted">
                        <i class="fas fa-envelope mr-2"></i>
                        info@smkn1kras.sch.id
                    </p>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2024 SMK Negeri 1 Kras. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    
    <script>
        // Navbar background on scroll
        $(window).scroll(function() {
            if ($(window).scrollTop() > 50) {
                $('.navbar-modern').addClass('scrolled');
            } else {
                $('.navbar-modern').removeClass('scrolled');
            }
        });
    </script>
</body>
</html>
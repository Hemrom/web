                                </div>
                                <div class="news-content">
                                    <h3 class="news-title"><%= b.judul %></h3>
                                    <p class="news-excerpt"><%= (b.konten || '').replace(/<[^>]*>/g, '').substring(0, 120) %>...</p>
                                    <div class="news-meta">
                                        <span><i class="fas fa-calendar-alt me-1"></i><%= new Date(b.created_at).toLocaleDateString('id-ID', {day:'numeric',month:'short',year:'numeric'}) %></span>
                                        <span style="color:var(--primary-blue);font-weight:700;display:inline-flex;align-items:center;gap:.3rem;">Selengkapnya <i class="fas fa-arrow-right" style="font-size:.75rem;"></i></span>
                                    </div>
                                </div>
                            </div>
                            </a>
                        </div>
                    <% }); %>
                <% } %>
            </div>
            
            <div class="text-center mt-5">
                <a href="/berita" class="btn btn-primary btn-lg" style="border-radius:50px;padding:.85rem 2.5rem;font-weight:700;"><i class="fas fa-newspaper me-2"></i>Lihat Semua Berita</a>
            </div>
        </div>
    </section>

    <!-- Artikel & File Download Section -->

                <p style="color:#64748b;font-size:1rem;max-width:520px;margin:0 auto;">Ikuti perkembangan terbaru dari sekolah kami</p>
            </div>
            
            <div class="row g-4">
                <% if (berita.length === 0) { %>
                    <div class="col-12 text-center">

                                <span style="font-weight:900;font-size:1.2rem;color:white;font-family:Arial,sans-serif;">@</span>
                                <% } else { %>
                                <i class="fab <%= platformIcons[ms.platform]||'fa-globe' %>"></i>
                                <% } %>
                            </div>
                            <div class="medsos-list-content">
                                <div class="medsos-list-platform"><%= ms.platform.charAt(0).toUpperCase()+ms.platform.slice(1) %></div>
                                <div class="medsos-list-title"><%= ms.judul %></div>
                            </div>
                            <div class="medsos-list-arrow"><i class="fas fa-arrow-right"></i></div>
                        </a>
                        <% }) %>

                        <!-- Ajakan follow -->
                        <div class="medsos-follow-cta">
                            <div style="font-size:1.1rem;font-weight:700;color:white;margin-bottom:.5rem;">
                                <i class="fas fa-bell me-2" style="color:#fbbf24;"></i>Jangan Lewatkan Update Kami!
                            </div>
                            <p style="color:rgba(255,255,255,.75);font-size:.9rem;margin-bottom:1rem;">Follow semua akun media sosial kami untuk mendapatkan informasi terbaru seputar kegiatan sekolah.</p>
                            <a href="/media-sosial" class="btn btn-light btn-sm" style="border-radius:50px;font-weight:700;color:var(--primary-blue);">
                                <i class="fas fa-share-alt me-2"></i>Lihat Semua Media Sosial

        <div class="container-fluid px-0">
            <div class="link-terkait-wrapper">
                <div class="link-terkait-header">
                    <i class="fas fa-link me-2"></i> Link Terkait
                </div>
                <div class="link-terkait-track-container">
                    <div class="link-terkait-track" id="linkTrack">
                        <% linkTerkait.forEach(function(l) { %>

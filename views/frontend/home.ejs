            <div class="row g-5">
                <!-- Artikel Terbaru -->
                <% if (typeof artikelHome !== 'undefined' && artikelHome && artikelHome.length > 0) { %>
                <div class="col-lg-7 reveal reveal-left">
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;flex-wrap:wrap;gap:.75rem;">
                        <div>
                            <div style="display:inline-flex;align-items:center;gap:.5rem;background:rgba(99,102,241,.2);border:1px solid rgba(99,102,241,.4);color:#a5b4fc;padding:.3rem .9rem;border-radius:50px;font-size:.75rem;font-weight:700;margin-bottom:.5rem;">
                                <i class="fas fa-pen-nib"></i> Artikel
                            </div>
                            <h3 style="font-size:1.5rem;font-weight:800;color:white;margin:0;">Artikel Terbaru</h3>

                    const iconMap = {
                        'ruang-kelas': { icon: 'fa-chalkboard-teacher', color: '#0ea5e9', bg: '#e0f2fe' },
                        'laboratorium': { icon: 'fa-flask', color: '#8b5cf6', bg: '#ede9fe' },
                        'perpustakaan': { icon: 'fa-book-open', color: '#10b981', bg: '#d1fae5' },
                        'olahraga': { icon: 'fa-running', color: '#f59e0b', bg: '#fef3c7' },
                        'kantin': { icon: 'fa-utensils', color: '#ef4444', bg: '#fee2e2' },
                        'kesehatan': { icon: 'fa-heartbeat', color: '#ec4899', bg: '#fce7f3' },
                        'ibadah': { icon: 'fa-mosque', color: '#14b8a6', bg: '#ccfbf1' },
                        'lainnya': { icon: 'fa-building', color: '#64748b', bg: '#f1f5f9' }
                    };
                    const meta = iconMap[f.kategori] || iconMap['lainnya'];
                    const isFeatured = idx === 0;
                %>
                <a href="/fasilitas" style="text-decoration:none;color:inherit;" class="fasilitas-item <%= isFeatured ? 'fasilitas-item--featured' : '' %>">
                    <% if (f.cover) { %>
                    <div class="fasilitas-item-img-wrap">
                        <img src="/uploads/<%= f.cover %>" alt="<%= f.nama %>" class="fasilitas-item-img">
                        <div class="fasilitas-item-overlay"></div>
                        <span class="fasilitas-item-badge" style="background:<%- meta.color %>">
                            <i class="fas <%= meta.icon %> me-1"></i><%= f.kategori.replace('-', ' ') %>
                        </span>
                    </div>
                    <% } else { %>
                    <div class="fasilitas-item-placeholder" style="background:linear-gradient(135deg,<%- meta.color %>,<%- meta.color %>cc)">
                        <i class="fas <%= meta.icon %>"></i>
                        <span class="fasilitas-item-badge" style="background:rgba(255,255,255,.2)">
                            <%= f.kategori.replace('-', ' ') %>
                        </span>
                    </div>
                    <% } %>
                    <div class="fasilitas-item-body">
                        <div class="fasilitas-item-icon-wrap" style="background:<%- meta.bg %>;color:<%- meta.color %>">
                            <i class="fas <%= meta.icon %>"></i>
                        </div>
                        <div class="fasilitas-item-info">
                            <h3 class="fasilitas-item-nama"><%= f.nama %></h3>
                            <% if (f.deskripsi) { %>
                            <p class="fasilitas-item-desc"><%= f.deskripsi.length > 80 ? f.deskripsi.substring(0, 80) + '...' : f.deskripsi %></p>
                            <% } %>
                        </div>
                    </div>
                </a>
                <% }) %>
            </div>
        </div>
    </section>
    <% } %>

    <!-- News Section -->

                            <span style="background:#fef3c7;color:#92400e;padding:.3rem .9rem;border-radius:20px;font-size:.75rem;font-weight:600;">✓ Regional</span>
                            <span style="background:#fef3c7;color:#92400e;padding:.3rem .9rem;border-radius:20px;font-size:.75rem;font-weight:600;">✓ Nasional</span>
                        </div>

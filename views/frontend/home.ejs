                <div class="col-lg-5 reveal reveal-right">
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;flex-wrap:wrap;gap:.75rem;">
                        <div>
                            <div style="display:inline-flex;align-items:center;gap:.5rem;background:rgba(14,165,233,.2);border:1px solid rgba(14,165,233,.4);color:#7dd3fc;padding:.3rem .9rem;border-radius:50px;font-size:.75rem;font-weight:700;margin-bottom:.5rem;">
                                <i class="fas fa-download"></i> Unduhan
                            </div>
                            <h3 style="font-size:1.5rem;font-weight:800;color:white;margin:0;">File Download</h3>
                            <p style="color:rgba(255,255,255,.55);font-size:.85rem;margin:.25rem 0 0;">Materi dan dokumen untuk diunduh</p>
                        </div>
                        <a href="/file-download" style="display:inline-flex;align-items:center;gap:.4rem;background:rgba(14,165,233,.2);border:1px solid rgba(14,165,233,.4);color:#7dd3fc;padding:.5rem 1.1rem;border-radius:50px;text-decoration:none;font-size:.82rem;font-weight:700;transition:all .2s;" onmouseover="this.style.background='rgba(14,165,233,.4)';this.style.color='white'" onmouseout="this.style.background='rgba(14,165,233,.2)';this.style.color='#7dd3fc'">Lihat Semua <i class="fas fa-arrow-right"></i></a>
                    </div>
                    <div style="background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:18px;overflow:hidden;backdrop-filter:blur(8px);">
                        <%
                            const tipeColorHome = { PDF:'#ef4444',DOC:'#3b82f6',DOCX:'#3b82f6',XLS:'#22c55e',XLSX:'#22c55e',PPT:'#f59e0b',PPTX:'#f59e0b',ZIP:'#6b7280',RAR:'#6b7280' };
                        %>
                        <% fileDownloadHome.forEach((item, idx) => { %>
                        <a href="/file-download/<%= item.id %>" style="display:flex;align-items:center;gap:1rem;padding:1rem 1.25rem;text-decoration:none;color:inherit;border-bottom:<%= idx < fileDownloadHome.length - 1 ? '1px solid rgba(255,255,255,.08)' : 'none' %>;transition:background .2s;" onmouseover="this.style.background='rgba(255,255,255,.08)'" onmouseout="this.style.background='transparent'">
                            <div style="width:44px;height:44px;border-radius:12px;background:<%= tipeColorHome[item.tipe_file] || '#6366f1' %>;display:flex;align-items:center;justify-content:center;color:white;font-size:.72rem;font-weight:800;flex-shrink:0;box-shadow:0 4px 12px rgba(0,0,0,.3);">
                                <%= item.tipe_file ? item.tipe_file.substring(0,3) : 'FILE' %>
                            </div>
                            <div style="flex:1;min-width:0;">
                                <div style="font-weight:600;color:white;font-size:.875rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= item.judul %></div>
                                <div style="font-size:.72rem;color:rgba(255,255,255,.45);margin-top:.2rem;"><%= item.kategori %> · <%= item.ukuran_file %> · <i class="fas fa-download me-1"></i><%= item.jumlah_download %>x</div>
                            </div>
                            <i class="fas fa-download" style="color:#7dd3fc;flex-shrink:0;font-size:.85rem;"></i>
                        </a>
                        <% }) %>
                        <div style="padding:1rem 1.25rem;border-top:1px solid rgba(255,255,255,.08);">
                            <a href="/file-download" style="display:block;text-align:center;background:linear-gradient(135deg,#0ea5e9,#6366f1);color:white;padding:.7rem;border-radius:12px;text-decoration:none;font-size:.875rem;font-weight:700;transition:opacity .2s;box-shadow:0 4px 15px rgba(14,165,233,.3);" onmouseover="this.style.opacity='.85'" onmouseout="this.style.opacity='1'">
                                <i class="fas fa-folder-open me-2"></i>Lihat Semua File
                            </a>
                        </div>
                    </div>
                </div>
                <% } %>
            </div>
        </div>
    </section>
    <% } %>

    <!-- BKK Home Section -->
    <% if (typeof bkkHome !== 'undefined' && bkkHome && bkkHome.length > 0) { %>
    <section class="bkk-home-section">
        <div class="container">
            <div class="d-flex align-items-end justify-content-between mb-4 flex-wrap gap-3">
                <div>
                    <div style="display:inline-flex;align-items:center;gap:.5rem;background:#d1fae5;color:#065f46;padding:.35rem 1rem;border-radius:50px;font-size:.8rem;font-weight:700;margin-bottom:.75rem;">
                        <i class="fas fa-briefcase"></i> BKK — Bursa Kerja Khusus
                    </div>
                    <h2 style="font-size:2rem;font-weight:800;color:#1e293b;margin-bottom:.25rem;">Lowongan Terbaru</h2>
                    <p style="color:#64748b;font-size:.95rem;margin:0;">Peluang kerja, magang, dan beasiswa untuk lulusan</p>
                </div>
                <a href="/bkk" style="display:inline-flex;align-items:center;gap:.5rem;background:#10b981;color:white;padding:.65rem 1.5rem;border-radius:50px;text-decoration:none;font-weight:700;font-size:.875rem;transition:all .2s;white-space:nowrap;" onmouseover="this.style.background='#059669'" onmouseout="this.style.background='#10b981'">
                    Lihat Semua <i class="fas fa-arrow-right"></i>
                </a>
            </div>
            <div class="bkk-scroll-track" id="bkkTrack">
                <% bkkHome.forEach(function(l) { %>
                <% var isExp = l.deadline && new Date(l.deadline) < new Date(); %>
                <% var kat = l.kategori || 'lainnya'; %>
                <div class="bkk-home-card">
                    <% if (l.gambar) { %>
                    <img src="/uploads/<%= l.gambar %>" class="bkk-home-img" alt="<%= l.judul %>">
                    <% } else { %>
                    <div class="bkk-home-placeholder"><i class="fas fa-building"></i></div>
                    <% } %>
                    <div class="bkk-home-body">
                        <span class="bkk-home-kat <%= kat %>"><%= kat.charAt(0).toUpperCase()+kat.slice(1) %></span>
                        <div class="bkk-home-title"><%= l.judul %></div>
                        <div class="bkk-home-co"><i class="fas fa-building me-1"></i><%= l.perusahaan %></div>
                        <% if (l.lokasi) { %><div class="bkk-home-loc"><i class="fas fa-map-marker-alt me-1"></i><%= l.lokasi %></div><% } %>
                        <% if (l.deadline && !isExp) { %>
                        <div style="background:#fef2f2;color:#991b1b;padding:.25rem .65rem;border-radius:8px;font-size:.7rem;font-weight:600;display:inline-flex;align-items:center;gap:.3rem;margin-bottom:.75rem;width:fit-content;">
                            <i class="fas fa-clock"></i>Deadline: <%= new Date(l.deadline).toLocaleDateString('id-ID',{day:'numeric',month:'short',year:'numeric'}) %>
                        </div>
                        <% } %>
                        <div class="bkk-home-actions">
                            <a href="/bkk/<%= l.slug %>" class="bkk-home-btn-det"><i class="fas fa-eye me-1"></i>Detail</a>
                            <% if (l.kontak && !isExp) { %>
                            <a href="<%= l.kontak.startsWith('http') ? l.kontak : 'https://wa.me/'+l.kontak.replace(/[^0-9]/g,'') %>" target="_blank" rel="noopener" class="bkk-home-btn-daf"><i class="fas fa-paper-plane me-1"></i>Daftar</a>
                            <% } %>
                        </div>
                    </div>
                </div>
                <% }); %>
            </div>
            <!-- Scroll indicator dots -->
            <div style="display:flex;justify-content:center;gap:.5rem;margin-top:1.25rem;" id="bkkDots">
                <% bkkHome.forEach(function(l, i) { %>
                <div style="width:<%= i===0?'24px':'8px' %>;height:8px;border-radius:4px;background:<%= i===0?'#10b981':'#d1fae5' %>;transition:all .3s;cursor:pointer;" onclick="scrollBkk(<%= i %>)" class="bkk-dot"></div>
                <% }); %>
            </div>
        </div>
    </section>
    <% } %>

    <!-- Gallery Section -->
    <section class="gallery-section">
        <div class="container">
            <div class="d-flex align-items-end justify-content-between mb-4 flex-wrap gap-3 reveal">
                <div>
                    <div style="display:inline-flex;align-items:center;gap:.5rem;background:#e0f2fe;color:#0369a1;padding:.35rem 1rem;border-radius:50px;font-size:.8rem;font-weight:700;margin-bottom:.75rem;">
                        <i class="fas fa-images"></i> Dokumentasi
                    </div>
                    <h2 style="font-size:2rem;font-weight:800;color:#1e293b;margin-bottom:.25rem;">Galeri Kegiatan</h2>
                    <p style="color:#64748b;font-size:.95rem;margin:0;">Momen berharga dari kegiatan dan prestasi siswa-siswi kami</p>
                </div>
                <a href="/galeri" style="display:inline-flex;align-items:center;gap:.5rem;border:2px solid #0ea5e9;color:#0ea5e9;padding:.6rem 1.4rem;border-radius:50px;text-decoration:none;font-weight:600;font-size:.875rem;transition:all .2s;white-space:nowrap;" onmouseover="this.style.background='#0ea5e9';this.style.color='white'" onmouseout="this.style.background='transparent';this.style.color='#0ea5e9'">
                    Lihat Semua <i class="fas fa-arrow-right"></i>
                </a>
            </div>
            <% if (galeri && galeri.length > 0) { %>
            <div class="gallery-masonry">
                <% galeri.forEach(function(album, idx) { %>
                <div class="g-item" onclick="window.location='/galeri'" title="<%= album.judul %>">
                    <img src="/uploads/<%= album.gambar %>" alt="<%= album.judul %>" onerror="this.src='/assets/img/undraw_posting_photo.svg'">
                    <% if (album.jumlah > 1) { %>
                    <div class="g-count-badge"><i class="fas fa-images me-1"></i><%= album.jumlah %></div>
                    <% } %>
                    <div class="g-overlay">
                        <div>
                            <div class="g-overlay-title"><%= album.judul %></div>
                            <% if (album.jumlah > 1) { %><div class="g-overlay-count"><%= album.jumlah %> foto</div><% } %>
                        </div>
                    </div>
                </div>
                <% }); %>
            </div>
            <% } else { %>
            <div class="text-center py-5 text-muted">
                <i class="fas fa-images fa-3x mb-3 d-block" style="opacity:.3;"></i>
                <p>Belum ada foto galeri</p>
            </div>
            <% } %>
        </div>
    </section>

    <!-- Media Sosial Section -->
    <% if (mediaSosialFooter && mediaSosialFooter.length > 0) { %>
    <section class="medsos-section">
        <div class="container">
            <div class="medsos-header">
                <div>
                    <h2 class="section-title" style="color:white;text-align:left;margin-bottom:.5rem;">Ikuti Kami</h2>
                    <p style="color:rgba(255,255,255,.8);font-size:1rem;margin:0;">Update terbaru dari media sosial kami</p>
                </div>
                <div class="medsos-platforms">
                    <% const platformColors = {instagram:'#E1306C',youtube:'#FF0000',facebook:'#1877F2',tiktok:'#010101',twitter:'#000000',threads:'#101010'}; %>
                    <% const platformIcons = {instagram:'fa-instagram',youtube:'fa-youtube',facebook:'fa-facebook-f',tiktok:'fa-tiktok',twitter:'_x_icon',threads:'_threads_icon'}; %>
                    <% const platformLabels = {instagram:'Instagram',youtube:'YouTube',facebook:'Facebook',tiktok:'TikTok',twitter:'X/Twitter',threads:'Threads'}; %>
                    <% mediaSosialFooter.forEach(function(ms) { %>
                    <a href="<%= ms.embed_url %>" target="_blank" rel="noopener" class="medsos-platform-btn" style="background:<%= platformColors[ms.platform]||'#333' %>;" title="<%= ms.judul %>">
                        <% if (ms.platform === 'twitter') { %>
                        <span style="font-weight:900;font-size:1rem;line-height:1;font-family:Arial,sans-serif;">𝕏</span>
                        <% } else if (ms.platform === 'threads') { %>
                        <span style="font-weight:900;font-size:1.1rem;line-height:1;font-family:Arial,sans-serif;">@</span>
                        <% } else { %>
                        <i class="fab <%= platformIcons[ms.platform]||'fa-globe' %>"></i>
                        <% } %>
                    </a>
                    <% }) %>
                </div>
            </div>

            <div class="row g-4 align-items-start">
                <!-- Kiri: Post terbaru (besar) -->
                <div class="col-lg-5">
                    <% const featured = mediaSosialFooter[0]; %>
                    <div class="medsos-featured">
                        <div class="medsos-featured-badge">
                            <% if (featured.platform === 'twitter') { %><span style="font-weight:900;font-size:.9rem;font-family:Arial,sans-serif;margin-right:.3rem;">𝕏</span>
                            <% } else if (featured.platform === 'threads') { %><span style="font-weight:900;font-size:1rem;font-family:Arial,sans-serif;margin-right:.3rem;">@</span>
                            <% } else { %><i class="fab <%= platformIcons[featured.platform]||'fa-globe' %> me-1"></i><% } %>
                            <%= featured.platform === 'twitter' ? 'X/Twitter' : featured.platform.charAt(0).toUpperCase()+featured.platform.slice(1) %>
                        </div>
                        <h3 class="medsos-featured-title"><%= featured.judul %></h3>
                        <div class="medsos-embed-wrap">
                            <%
                            const ytMatch = featured.embed_url.match(/(?:v=|youtu\.be\/)([^&\n?#]+)/);
                            const ytId = ytMatch ? ytMatch[1] : null;
                            const bgMap = {instagram:'linear-gradient(135deg,#833ab4,#fd1d1d,#fcb045)',facebook:'linear-gradient(135deg,#1877F2,#0d5dbf)',tiktok:'linear-gradient(135deg,#010101,#69C9D0)',twitter:'linear-gradient(135deg,#000,#333)',threads:'linear-gradient(135deg,#101010,#444)'};
                            const iconMap = {instagram:'fa-instagram',facebook:'fa-facebook-f',tiktok:'fa-tiktok',twitter:'fa-twitter',threads:'fa-at'};
                            const labelMap = {instagram:'Lihat di Instagram',facebook:'Lihat di Facebook',tiktok:'Lihat di TikTok',twitter:'Lihat di X/Twitter',threads:'Lihat di Threads'};
                            %>
                            <% if (featured.platform === 'youtube' && ytId) { %>
                                <!-- YouTube: embed langsung -->
                                <div class="ratio ratio-16x9" style="border-radius:16px;overflow:hidden;">
                                    <iframe src="https://www.youtube.com/embed/<%= ytId %>?rel=0&modestbranding=1" allowfullscreen style="border:0;"></iframe>
                                </div>
                            <% } else if (featured.platform === 'instagram') { %>
                                <!-- Instagram post: embed iframe, reel pakai card thumbnail -->
                                <% const igPostId = (featured.embed_url.match(/instagram\.com\/(?:p|reel)\/([^\/\?]+)/)||[])[1]; %>
                                <% const isReel = featured.embed_url.includes('/reel/'); %>
                                <% if (igPostId && !isReel) { %>
                                <!-- Post biasa: iframe embed (tampil utuh seperti IG asli) -->
                                <div style="border-radius:16px;overflow:hidden;background:#fafafa;">
                                    <iframe src="https://www.instagram.com/p/<%= igPostId %>/embed/" style="width:100%;min-height:700px;border:0;display:block;" scrolling="no" allowfullscreen loading="lazy"></iframe>

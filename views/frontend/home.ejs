                            <i class="fas fa-chalkboard-teacher" style="color:white;"></i>
                        </div>
                        <h3 class="feature-title">Guru Berkualitas</h3>
                        <p class="feature-desc">Tenaga pengajar berpengalaman dan bersertifikat yang siap membimbing siswa mencapai prestasi terbaik.</p>
                        <div style="margin-top:1.25rem;display:flex;flex-wrap:wrap;gap:.5rem;justify-content:center;">
                            <span style="background:#e0f2fe;color:#0369a1;padding:.3rem .9rem;border-radius:20px;font-size:.75rem;font-weight:600;">✓ Bersertifikat</span>
                            <span style="background:#e0f2fe;color:#0369a1;padding:.3rem .9rem;border-radius:20px;font-size:.75rem;font-weight:600;">✓ Berpengalaman</span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 reveal reveal-delay-2">
                    <div class="feature-card feature-card-indigo" style="border-color:#e0e7ff;box-shadow:0 8px 32px rgba(99,102,241,0.12);">
                        <div style="position:absolute;top:1.25rem;left:50%;transform:translateX(-50%);background:linear-gradient(90deg,#6366f1,#818cf8);color:white;padding:.2rem .9rem;border-radius:20px;font-size:.7rem;font-weight:700;white-space:nowrap;">⭐ UNGGULAN</div>
                        <div class="feature-icon" style="background:linear-gradient(135deg,#6366f1,#4f46e5);box-shadow:0 12px 28px rgba(99,102,241,0.35);margin-top:1.5rem;">

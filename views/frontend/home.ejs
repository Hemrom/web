                            <% if (l.logo) { %><img src="/uploads/<%= l.logo %>" alt="<%= l.nama %>">
                            <% } else { %><span class="link-terkait-text"><%= l.nama %></span><% } %>
                        </a>
                        <% }) %>
                        <% linkTerkait.forEach(function(l) { %>
                        <a href="<%= l.url %>" target="_blank" rel="noopener noreferrer" class="link-terkait-item" title="<%= l.nama %>" aria-hidden="true">
                            <% if (l.logo) { %><img src="/uploads/<%= l.logo %>" alt="<%= l.nama %>">

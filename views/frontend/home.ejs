            </div>
        </div>
    </section>
    <% } %>

    <!-- Alumni Section -->
    <section style="padding:5rem 0;background:white;">
        <div class="container">
            <h2 class="section-title">Alumni Kami</h2>
            <p class="section-subtitle">Kebanggaan kami yang telah meraih kesuksesan di berbagai bidang</p>

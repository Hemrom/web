                    </div>
                    <div class="row g-3">
                        <% artikelHome.forEach((item, idx) => { %>
                        <div class="col-<%= idx === 0 ? '12' : '6' %>">
                            <a href="/artikel/<%= item.slug %>" style="text-decoration:none;display:block;">
                                <div style="background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:18px;overflow:hidden;backdrop-filter:blur(8px);transition:all .3s;" onmouseover="this.style.transform='translateY(-5px)';this.style.background='rgba(255,255,255,.13)';this.style.borderColor='rgba(255,255,255,.3)'" onmouseout="this.style.transform='translateY(0)';this.style.background='rgba(255,255,255,.07)';this.style.borderColor='rgba(255,255,255,.12)'">
                                    <% if (item.gambar) { %>
                                    <div style="height:<%= idx === 0 ? '200px' : '130px' %>;background:url('/uploads/<%= item.gambar %>') center/cover;position:relative;">
                                        <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.4) 0%,transparent 60%);"></div>
                                    </div>
                                    <% } %>
                                    <div style="padding:1.25rem;">
                                        <span style="background:rgba(99,102,241,.25);color:#c7d2fe;padding:.2rem .7rem;border-radius:50px;font-size:.72rem;font-weight:700;"><%= item.kategori %></span>
                                        <h3 style="font-size:<%= idx === 0 ? '1.05rem' : '.88rem' %>;font-weight:700;color:white;margin:.65rem 0 .4rem;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;"><%= item.judul %></h3>
                                        <p style="font-size:.75rem;color:rgba(255,255,255,.5);margin:0;"><i class="fas fa-user me-1"></i><%= item.penulis_nama %> · <i class="fas fa-calendar ms-1 me-1"></i><%= new Date(item.created_at).toLocaleDateString('id-ID',{day:'numeric',month:'short',year:'numeric'}) %></p>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <% }) %>
                    </div>
                </div>
                <% } %>

                <!-- File Download -->

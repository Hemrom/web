                            <% } else { %><div style="width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,var(--primary-blue),var(--secondary-blue));display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-user" style="color:white;font-size:1.2rem;"></i></div><% } %>
                            <div>
                                <div style="font-weight:700;color:var(--gray-800);font-size:.95rem;"><%= a.nama %></div>
                                <div style="font-size:.78rem;color:var(--gray-500);">
                                    <% if (a.tahun_lulus) { %><span style="background:var(--light-blue);color:var(--primary-blue-dark);padding:.1rem .5rem;border-radius:10px;font-weight:600;">Angkatan <%= a.tahun_lulus %></span><% } %>
                                    <% if (a.jurusan) { %> · <%= a.jurusan %><% } %>
                                </div>
                                <% if (a.pekerjaan) { %><div style="font-size:.8rem;color:var(--primary-blue);font-weight:600;margin-top:.2rem;"><i class="fas fa-briefcase me-1"></i><%= a.pekerjaan %><% if(a.perusahaan){%> · <%=a.perusahaan%><% } %></div><% } %>
                            </div>
                        </div>
                        <% if (a.cerita) { %><div style="flex:1;font-size:.83rem;color:var(--gray-600);font-style:italic;line-height:1.6;border-left:3px solid var(--accent-blue);padding-left:.9rem;">"<%= a.cerita.substring(0,160) %><%= a.cerita.length>160?'...':'' %>"</div><% } %>
                    </div>

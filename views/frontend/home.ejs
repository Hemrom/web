                                <!-- Reel: card dengan thumbnail -->
                                <a href="<%= featured.embed_url %>" target="_blank" rel="noopener" style="display:block;text-decoration:none;">
                                    <div style="border-radius:16px;overflow:hidden;position:relative;background:#000;width:100%;">
                                        <% if (featured.thumbnail) { %>
                                        <img src="/uploads/<%= featured.thumbnail %>" alt="<%= featured.judul %>" style="width:100%;height:auto;display:block;border-radius:16px;" onerror="this.style.display='none'">
                                        <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.6) 0%,transparent 40%);border-radius:16px;"></div>
                                        <% } else { %>
                                        <div style="aspect-ratio:9/16;background:linear-gradient(135deg,#833ab4,#fd1d1d,#fcb045);"></div>
                                        <% } %>
                                        <!-- Play button -->
                                        <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:56px;height:56px;background:rgba(255,255,255,.22);border-radius:50%;display:flex;align-items:center;justify-content:center;backdrop-filter:blur(4px);border:2px solid rgba(255,255,255,.45);">
                                            <i class="fas fa-play" style="color:white;font-size:1.1rem;margin-left:3px;"></i>
                                        </div>
                                        <!-- Bottom label -->
                                        <div style="position:absolute;bottom:0;left:0;right:0;padding:1.1rem;z-index:1;">
                                            <div style="display:flex;align-items:center;gap:.4rem;margin-bottom:.3rem;">
                                                <i class="fab fa-instagram" style="color:white;font-size:.85rem;"></i>
                                                <span style="color:rgba(255,255,255,.8);font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;">Instagram Reel</span>
                                            </div>
                                            <div style="color:white;font-weight:700;font-size:.9rem;line-height:1.35;text-shadow:0 1px 4px rgba(0,0,0,.6);"><%= featured.judul %></div>
                                        </div>
                                    </div>
                                </a>
                                <% } %>
                            <% } else { %>
                                <!-- Non-YouTube non-Instagram: card dengan thumbnail -->
                                <%
                                const bg = bgMap[featured.platform] || 'linear-gradient(135deg,#334155,#1e293b)';
                                const icon = iconMap[featured.platform] || 'fa-globe';
                                const label = labelMap[featured.platform] || 'Lihat Postingan';
                                const thumbSrc = featured.thumbnail ? '/uploads/' + featured.thumbnail : null;
                                %>
                                <a href="<%= featured.embed_url %>" target="_blank" rel="noopener" style="display:block;text-decoration:none;">
                                    <div style="background:<%= bg %>;border-radius:16px;overflow:hidden;position:relative;width:100%;">
                                        <% if (thumbSrc) { %>
                                        <img src="<%= thumbSrc %>" alt="<%= featured.judul %>" style="width:100%;height:auto;display:block;border-radius:16px;" onerror="this.style.display='none'">
                                        <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.6) 0%,transparent 40%);border-radius:16px;"></div>
                                        <% } else { %>
                                        <div style="aspect-ratio:1/1;"></div>
                                        <% } %>
                                        <!-- Center icon -->
                                        <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:56px;height:56px;background:rgba(255,255,255,.22);border-radius:50%;display:flex;align-items:center;justify-content:center;backdrop-filter:blur(4px);border:2px solid rgba(255,255,255,.45);">
                                            <i class="fab <%= icon %>" style="color:white;font-size:1.4rem;"></i>
                                        </div>
                                        <!-- Bottom label -->
                                        <div style="position:absolute;bottom:0;left:0;right:0;padding:1.1rem;z-index:1;">
                                            <div style="color:white;font-weight:700;font-size:.9rem;line-height:1.35;text-shadow:0 1px 4px rgba(0,0,0,.6);margin-bottom:.4rem;"><%= featured.judul %></div>
                                            <div style="display:inline-flex;align-items:center;gap:.4rem;background:rgba(255,255,255,.2);color:white;padding:.3rem .9rem;border-radius:50px;font-size:.75rem;font-weight:600;border:1px solid rgba(255,255,255,.3);">
                                                <i class="fas fa-external-link-alt" style="font-size:.65rem;"></i><%= label %>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            <% } %>
                        </div>
                        <a href="<%= featured.embed_url %>" target="_blank" rel="noopener" class="medsos-featured-link">
                            <i class="fas fa-external-link-alt me-2"></i>Buka di <%= featured.platform.charAt(0).toUpperCase()+featured.platform.slice(1) %>

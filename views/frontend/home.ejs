                <i class="fas fa-user-graduate fa-3x mb-3 d-block" style="color:var(--accent-blue);"></i>
                <p style="color:var(--gray-600);font-size:1rem;margin:0;">Jadilah alumni pertama yang berbagi cerita sukses!</p>
            </div>
            <% } %>
            <div style="text-align:center;display:flex;flex-wrap:wrap;gap:.75rem;justify-content:center;">
                <a href="/alumni" class="btn btn-primary btn-lg" style="border-radius:50px;"><i class="fas fa-users me-2"></i>Lihat Semua Alumni</a>
                <a href="/alumni/daftar" class="btn btn-outline-primary btn-lg" style="border-radius:50px;"><i class="fas fa-user-plus me-2"></i>Daftar Alumni</a>
                <a href="/alumni/update" class="btn btn-outline-secondary btn-lg" style="border-radius:50px;"><i class="fas fa-edit me-2"></i>Update Biodata</a>
            </div>
        </div>
    </section>

    <!-- Link Terkait Section -->
    <% if (linkTerkait && linkTerkait.length > 0) { %>

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <% seoTitle='File Download'; seoDesc='Download file, dokumen, dan materi penting dari SMK Negeri 1 Kras. Formulir, panduan, dan berkas resmi sekolah.'; seoUrl='/file-download'; %>
    <%- include('partials/_seo') %>
    <link href="/assets/vendor/bootstrap5/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/vendor/fontawesome6/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/theme.css">
    <style>
        :root {
            --primary-blue: #0ea5e9; --primary-blue-dark: #0284c7;
            --light-blue: #e0f2fe; --dark-blue: #0c4a6e;
            --gray-50: #f8fafc; --gray-100: #f1f5f9; --gray-200: #e2e8f0;
            --gray-500: #64748b; --gray-600: #475569; --gray-700: #334155;
            --gray-800: #1e293b; --gray-900: #0f172a;
        }
        * { font-family: 'Inter', sans-serif; box-sizing: border-box; }
        body { line-height: 1.6; color: var(--gray-700); }
        .navbar-modern { background: rgba(255,255,255,0.95) !important; backdrop-filter: blur(10px); box-shadow: 0 2px 20px rgba(14,165,233,0.1); padding: 1rem 0; transition: all 0.3s; }
        .navbar-modern.scrolled { box-shadow: 0 4px 30px rgba(14,165,233,0.15); }
        .navbar-brand { font-weight: 700; color: var(--primary-blue) !important; font-size: 1.5rem; text-decoration: none; }
        .nav-link { font-weight: 500; color: var(--gray-600) !important; padding: 0.75rem 1rem !important; border-radius: 8px; transition: all 0.3s; text-decoration: none; }
        .nav-link:hover, .nav-link.active { color: var(--primary-blue) !important; background: var(--light-blue); }
        .page-header { background: linear-gradient(135deg, #0369a1 0%, var(--dark-blue) 100%); padding: 5rem 0 2.5rem; color: white; text-align: center; position: relative; overflow: hidden; }
        .page-header::before { content: ''; position: absolute; inset: 0; background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000"><polygon fill="rgba(255,255,255,0.05)" points="0,1000 1000,0 1000,1000"/></svg>'); }
        .page-title { font-size: 2.2rem; font-weight: 800; margin-bottom: 1rem; position: relative; z-index: 1; }
        .page-subtitle { font-size: 1.1rem; opacity: 0.9; position: relative; z-index: 1; }
        .content-section { padding: 5rem 0; background: var(--gray-50); }
        .filter-bar { background: white; border-radius: 16px; padding: 1.5rem; box-shadow: 0 2px 12px rgba(0,0,0,0.06); margin-bottom: 2.5rem; }
        .filter-btn { border: 2px solid var(--gray-200); background: white; color: var(--gray-600); padding: 0.5rem 1.25rem; border-radius: 50px; font-size: 0.875rem; font-weight: 500; text-decoration: none; transition: all 0.2s; display: inline-block; margin: 0.25rem; }
        .filter-btn:hover, .filter-btn.active { border-color: var(--primary-blue); background: var(--primary-blue); color: white; text-decoration: none; }
        .file-card { background: white; border-radius: 16px; padding: 1.75rem; box-shadow: 0 4px 20px rgba(14,165,233,0.07); transition: all 0.3s; border: 1px solid var(--gray-100); display: flex; align-items: flex-start; gap: 1.25rem; }
        .file-card:hover { transform: translateY(-3px); box-shadow: 0 12px 30px rgba(14,165,233,0.15); }
        .file-icon-box { width: 56px; height: 56px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; font-weight: 800; color: white; flex-shrink: 0; letter-spacing: -0.5px; }
        .file-info { flex: 1; min-width: 0; }
        .file-title { font-size: 1rem; font-weight: 700; color: var(--gray-800); margin-bottom: 0.4rem; line-height: 1.4; }
        .file-desc { font-size: 0.85rem; color: var(--gray-500); margin-bottom: 0.75rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .file-meta { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; font-size: 0.8rem; color: var(--gray-500); }
        .file-meta span { display: flex; align-items: center; gap: 0.3rem; }
        .download-btn { display: inline-flex; align-items: center; gap: 0.5rem; background: var(--primary-blue); color: white; padding: 0.6rem 1.25rem; border-radius: 50px; font-size: 0.875rem; font-weight: 600; text-decoration: none; transition: all 0.2s; white-space: nowrap; flex-shrink: 0; }
        .download-btn:hover { background: var(--primary-blue-dark); color: white; text-decoration: none; transform: translateY(-1px); }
        .footer { background: var(--gray-900); color: white; padding: 4rem 0 2rem; }
        .footer-title { font-size: 1.1rem; font-weight: 600; margin-bottom: 1.25rem; color: white; }
        .footer-link { color: rgba(255,255,255,0.7); text-decoration: none; margin-bottom: 0.5rem; display: block; transition: color 0.3s; }
        .footer-link:hover { color: #7dd3fc; text-decoration: none; }
        @media (max-width: 991px) { .navbar-collapse { background: white; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); margin-top: 1rem; padding: 1rem; } .page-title { font-size: 2.5rem; } .file-card { flex-direction: column; } }
        @media (max-width: 768px) { .page-title { font-size: 2rem; } }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <section class="page-header">
        <div class="container">
            <h1 class="page-title"><i class="fas fa-download me-3"></i>File Download</h1>
            <p class="page-subtitle">Unduh materi, formulir, dan dokumen penting sekolah</p>
        </div>
    </section>

    <section class="content-section">
        <div class="container">
            <% if (kategoriList.length > 0) { %>
            <div class="filter-bar">
                <div class="d-flex align-items-center flex-wrap gap-1">
                    <span class="text-muted small me-2 fw-semibold">Filter:</span>
                    <a href="/file-download" class="filter-btn <%= !kategoriAktif ? 'active' : '' %>">Semua</a>
                    <% kategoriList.forEach(k => { %>
                    <a href="/file-download?kategori=<%= encodeURIComponent(k.kategori) %>" class="filter-btn <%= kategoriAktif === k.kategori ? 'active' : '' %>"><%= k.kategori %></a>
                    <% }) %>
                </div>
            </div>
            <% } %>

            <% if (!files.length) { %>
            <div class="text-center py-5">
                <i class="fas fa-folder-open fa-4x text-muted mb-4" style="opacity:0.3;"></i>
                <h4 class="text-muted">Belum ada file tersedia</h4>
                <p class="text-muted">File download akan segera tersedia.</p>
            </div>
            <% } else { %>
            <%
                const tipeColor = {
                    PDF: '#ef4444', DOC: '#3b82f6', DOCX: '#3b82f6',
                    XLS: '#22c55e', XLSX: '#22c55e', PPT: '#f59e0b', PPTX: '#f59e0b',
                    ZIP: '#6b7280', RAR: '#6b7280', TXT: '#94a3b8'
                };
            %>
            <div class="row g-3">
                <% files.forEach(item => { %>
                <div class="col-12">
                    <div class="file-card">
                        <div class="file-icon-box" style="background:<%= tipeColor[item.tipe_file] || '#0ea5e9' %>">
                            <%= item.tipe_file ? item.tipe_file.substring(0,3) : 'FILE' %>
                        </div>
                        <div class="file-info">
                            <div class="file-title"><%= item.judul %></div>
                            <% if (item.deskripsi) { %><div class="file-desc"><%= item.deskripsi %></div><% } %>
                            <div class="file-meta">
                                <span><i class="fas fa-tag"></i><%= item.kategori %></span>
                                <span><i class="fas fa-file"></i><%= item.tipe_file %></span>
                                <span><i class="fas fa-weight-hanging"></i><%= item.ukuran_file %></span>
                                <span><i class="fas fa-download"></i><%= item.jumlah_download %> unduhan</span>
                                <span><i class="fas fa-user"></i><%= item.penulis_nama %></span>
                                <span><i class="fas fa-calendar"></i><%= new Date(item.created_at).toLocaleDateString('id-ID', {day:'numeric',month:'short',year:'numeric'}) %></span>
                            </div>
                        </div>
                        <a href="/file-download/<%= item.id %>" class="download-btn">
                            <i class="fas fa-download"></i> Unduh
                        </a>
                    </div>
                </div>
                <% }) %>
            </div>
            <% } %>
        </div>
    </section>

    <%- include('partials/footer') %>
    <script src="/assets/vendor/bootstrap5/bootstrap.bundle.min.js"></script>
    <script src="/assets/vendor/jquery3/jquery.min.js"></script>
    <script>
        $(window).scroll(function() {
            if ($(window).scrollTop() > 50) $('.navbar-modern').addClass('scrolled');
            else $('.navbar-modern').removeClass('scrolled');
        });
    </script>
</body>
</html>

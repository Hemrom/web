    <style>
        /* ── Reset & Base ───────────────────────────────────────────────── */
        :root {
            --accent: <%= accentHex %>;
            --grad: <%= jWarna %>;
            --grad-light: linear-gradient(135deg,<%= accentHex %>22,<%= accentHex %>08);
            --card-radius: 20px;
        }
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body { color: #334155; line-height: 1.6; overflow-x: hidden; }
        a { text-decoration: none; }
        img { max-width: 100%; }

        /* ── Hero Section ───────────────────────────────────────────────── */
        .hero {
            min-height: 100vh;
            background: <%= jWarna %>;
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            padding: 100px 0 60px;
        }
        /* Animated grid bg */
        .hero-grid {
            position: absolute; inset: 0;
            background-image:
                linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px);
            background-size: 60px 60px;
            animation: gridMove 20s linear infinite;
        }
        @keyframes gridMove { from { background-position: 0 0; } to { background-position: 60px 60px; } }

        /* Floating orbs */
        .orb {
            position: absolute;
            border-radius: 50%;
            background: rgba(255,255,255,.07);
            animation: float 8s ease-in-out infinite;
        }
        .orb-1 { width: 500px; height: 500px; top: -150px; right: -100px; animation-delay: 0s; }
        .orb-2 { width: 300px; height: 300px; bottom: -80px; left: -80px; animation-delay: 3s; }
        .orb-3 { width: 200px; height: 200px; top: 40%; left: 30%; animation-delay: 5s; }
        @keyframes float {
            0%, 100% { transform: translate(0, 0) scale(1); }
            33% { transform: translate(30px, -30px) scale(1.05); }
            66% { transform: translate(-20px, 20px) scale(.95); }
        }

        /* Animated nodes (network effect) */
        .nodes-canvas { position: absolute; inset: 0; pointer-events: none; }

        .hero-content { position: relative; z-index: 5; color: white; }
        .hero-kode-badge {
            display: inline-flex; align-items: center; gap: .6rem;
            background: rgba(255,255,255,.2); backdrop-filter: blur(8px);
            color: white; padding: .5rem 1.2rem; border-radius: 50px;
            font-size: .85rem; font-weight: 700; letter-spacing: 1px;
            border: 1px solid rgba(255,255,255,.3);
            margin-bottom: 1.5rem;
            animation: fadeInDown .6s ease both;
        }
        .hero-title {
            font-size: clamp(2rem, 5vw, 3.5rem);
            font-weight: 900;
            line-height: 1.1;
            margin-bottom: 1rem;
            animation: fadeInUp .7s ease .1s both;
        }
        .hero-subtitle {
            font-size: clamp(1rem, 2vw, 1.3rem);
            opacity: .85;
            margin-bottom: 1.5rem;
            animation: fadeInUp .7s ease .2s both;
        }
        .hero-desc {
            font-size: .95rem;
            opacity: .8;
            max-width: 520px;
            line-height: 1.7;
            margin-bottom: 2rem;
            animation: fadeInUp .7s ease .3s both;
        }
        .hero-tags {
            display: flex; flex-wrap: wrap; gap: .5rem;
            margin-bottom: 2.5rem;
            animation: fadeInUp .7s ease .4s both;
        }
        .hero-tag {
            background: rgba(255,255,255,.15); backdrop-filter: blur(4px);
            border: 1px solid rgba(255,255,255,.25);
            color: white; padding: .3rem .9rem; border-radius: 50px;
            font-size: .78rem; font-weight: 600;
        }
        .hero-cta {
            display: flex; flex-wrap: wrap; gap: 1rem;
            animation: fadeInUp .7s ease .5s both;
        }
        .btn-hero-primary {
            background: white; color: var(--accent); font-weight: 700;
            padding: .9rem 2rem; border-radius: 50px; border: none;
            font-size: .95rem; cursor: pointer; transition: all .3s;
            display: inline-flex; align-items: center; gap: .5rem;
            box-shadow: 0 8px 25px rgba(0,0,0,.2);
        }
        .btn-hero-primary:hover { transform: translateY(-3px); box-shadow: 0 15px 35px rgba(0,0,0,.3); color: var(--accent); }
        .btn-hero-outline {
            background: transparent; color: white; font-weight: 700;
            padding: .9rem 2rem; border-radius: 50px;
            border: 2px solid rgba(255,255,255,.5);
            font-size: .95rem; cursor: pointer; transition: all .3s;
            display: inline-flex; align-items: center; gap: .5rem;
        }
        .btn-hero-outline:hover { background: rgba(255,255,255,.1); border-color: white; transform: translateY(-3px); color: white; }

        /* Hero stats */
        .hero-stats {
            display: flex; flex-wrap: wrap; gap: 2rem;
            padding: 1.5rem 2rem;
            background: rgba(255,255,255,.1); backdrop-filter: blur(10px);
            border-radius: var(--card-radius); border: 1px solid rgba(255,255,255,.2);
            animation: fadeInUp .7s ease .6s both;
        }
        .stat-item { text-align: center; }
        .stat-num { font-size: 2rem; font-weight: 900; color: white; line-height: 1; }
        .stat-label { font-size: .78rem; color: rgba(255,255,255,.8); font-weight: 500; margin-top: .2rem; }

        /* Hero visual side */
        .hero-visual {
            position: relative; z-index: 5;
            animation: fadeInRight .9s ease .3s both;
        }
        .hero-device {
            background: rgba(255,255,255,.12); backdrop-filter: blur(15px);
            border: 1px solid rgba(255,255,255,.25);
            border-radius: 24px; padding: 2rem;
            position: relative;
        }
        .device-header {
            display: flex; gap: .5rem; margin-bottom: 1.5rem;
        }
        .device-dot {
            width: 12px; height: 12px; border-radius: 50%;
        }
        .device-dot:nth-child(1){ background: #ff6b6b; }
        .device-dot:nth-child(2){ background: #ffd93d; }
        .device-dot:nth-child(3){ background: #6bcb77; }
        .device-terminal {
            background: rgba(0,0,0,.4); border-radius: 12px;
            padding: 1.5rem; font-family: 'Courier New', monospace;
            font-size: .8rem; color: #a8ff78;
            min-height: 200px;
        }
        .terminal-line { margin-bottom: .4rem; line-height: 1.5; }
        .terminal-prompt { color: #7dd3fc; }
        .terminal-cmd { color: #ffd93d; }
        .terminal-output { color: #a8ff78; opacity: .8; }
        .cursor {
            display: inline-block; width: 8px; height: 14px;
            background: #a8ff78; animation: blink 1s infinite;
            vertical-align: middle; margin-left: 2px;
        }
        @keyframes blink { 0%,50%{ opacity:1 } 51%,100%{ opacity:0 } }

        /* Network topology mini */
        .net-topo {
            margin-top: 1.5rem;
            background: rgba(0,0,0,.3); border-radius: 12px;
            padding: 1rem; display: flex; align-items: center; justify-content: center; gap: .5rem;
        }
        .net-node {
            width: 40px; height: 40px; border-radius: 50%;
            background: rgba(255,255,255,.15); border: 2px solid rgba(255,255,255,.3);
            display: flex; align-items: center; justify-content: center;
            color: white; font-size: .8rem;
            position: relative;
        }
        .net-node.active { background: rgba(255,255,255,.3); animation: pulse 2s infinite; }
        @keyframes pulse {
            0%,100%{ box-shadow:0 0 0 0 rgba(255,255,255,.4); }
            50%{ box-shadow:0 0 0 10px rgba(255,255,255,0); }
        }
        .net-line {
            flex: 1; height: 2px; background: linear-gradient(90deg, rgba(255,255,255,.3), rgba(255,255,255,.6), rgba(255,255,255,.3));
            position: relative; overflow: hidden;
        }
        .net-line::after {
            content: ''; position: absolute;
            top: 0; left: -100%; width: 100%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,.8), transparent);
            animation: dataFlow 2s linear infinite;
        }
        @keyframes dataFlow { from{ left:-100% } to{ left:100% } }

        /* ── Section utility ───────────────────────────────────────────── */
        .section { padding: 5rem 0; }
        .section-alt { background: #f8fafc; }
        .section-dark { background: #0f172a; color: white; }
        .section-accent { background: var(--grad-light); }

        .section-tag {
            display: inline-flex; align-items: center; gap: .5rem;
            background: var(--grad-light); color: var(--accent);
            padding: .35rem 1rem; border-radius: 50px;
            font-size: .78rem; font-weight: 700; letter-spacing: .5px;
            margin-bottom: 1rem; border: 1px solid <%= accentHex %>33;
        }
        .section-title-main {
            font-size: clamp(1.6rem, 3vw, 2.4rem);
            font-weight: 800; color: #1e293b; line-height: 1.2;
            margin-bottom: .75rem;
        }
        .section-title-main.white { color: white; }
        .section-lead {
            font-size: 1rem; color: #64748b; max-width: 560px; line-height: 1.7;
        }
        .section-lead.white { color: rgba(255,255,255,.7); }
        .divider {
            width: 60px; height: 4px; border-radius: 2px;
            background: var(--grad); margin-bottom: 1.5rem;
        }

        /* ── Info Jurusan ───────────────────────────────────────────────── */
        .info-card {
            background: white;
            border-radius: var(--card-radius);
            padding: 2.5rem;
            box-shadow: 0 4px 30px rgba(0,0,0,.07);
            border: 1px solid #f1f5f9;
        }
        .info-row {
            display: flex; justify-content: space-between; align-items: center;
            padding: .8rem 0; border-bottom: 1px solid #f1f5f9;
        }
        .info-row:last-child { border-bottom: none; }
        .info-label { color: #64748b; font-size: .88rem; }
        .info-value { font-weight: 700; color: #1e293b; font-size: .9rem; }

        /* ── Feature Cards ─────────────────────────────────────────────── */
        .feature-card {
            background: white; border-radius: var(--card-radius);
            overflow: hidden; border: 1px solid #f1f5f9;
            box-shadow: 0 2px 15px rgba(0,0,0,.05);
            transition: all .3s; height: 100%;
        }
        .feature-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 15px 40px rgba(0,0,0,.1);
            border-color: <%= accentHex %>44;
        }
        .feature-img {
            width: 100%; height: 160px; overflow: hidden;
            display: block; position: relative;
        }
        .feature-img svg { width: 100%; height: 100%; display: block; }
        .feature-body { padding: 1.5rem; }
        .feature-icon {
            width: 44px; height: 44px; border-radius: 12px;
            background: var(--grad); display: inline-flex; align-items: center;
            justify-content: center; color: white; font-size: 1.1rem;
            margin-bottom: 1rem;
        }
        .feature-title { font-size: 1rem; font-weight: 700; color: #1e293b; margin-bottom: .5rem; }
        .feature-desc { font-size: .85rem; color: #64748b; line-height: 1.6; }

        /* ── Kurikulum Timeline ────────────────────────────────────────── */
        .timeline-wrap { position: relative; padding-left: 2.5rem; }
        .timeline-wrap::before {
            content: ''; position: absolute; left: 0; top: 0; bottom: 0;
            width: 3px; background: linear-gradient(180deg, var(--accent), transparent);
            border-radius: 2px;
        }
        .timeline-item { position: relative; margin-bottom: 2.5rem; }
        .timeline-item:last-child { margin-bottom: 0; }
        .timeline-dot {
            position: absolute; left: -2.5rem;
            width: 18px; height: 18px; border-radius: 50%;
            background: var(--grad); border: 3px solid white;
            box-shadow: 0 0 0 3px <%= accentHex %>44;
            top: .3rem;
        }
        .timeline-sem {
            font-size: .75rem; font-weight: 700; color: var(--accent);
            text-transform: uppercase; letter-spacing: .5px; margin-bottom: .4rem;
        }
        .timeline-card {
            background: white; border-radius: 16px; padding: 1.5rem;
            box-shadow: 0 2px 15px rgba(0,0,0,.06); border: 1px solid #f1f5f9;
            transition: all .3s;
        }
        .timeline-card:hover { box-shadow: 0 8px 25px rgba(0,0,0,.1); transform: translateX(6px); }
        .timeline-card-title { font-weight: 700; color: #1e293b; margin-bottom: .4rem; display: flex; align-items: center; gap: .5rem; }
        .timeline-card-desc { font-size: .88rem; color: #64748b; line-height: 1.6; }

        /* ── Karir Cards ───────────────────────────────────────────────── */
        .karir-card {
            background: white; border-radius: var(--card-radius);
            padding: 1.75rem; border: 1px solid #f1f5f9;
            box-shadow: 0 2px 12px rgba(0,0,0,.05);
            transition: all .3s; text-align: center; height: 100%;
        }
        .karir-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0,0,0,.12);
            border-color: <%= accentHex %>55;
        }
        .karir-icon {
            width: 64px; height: 64px; border-radius: 50%;
            background: var(--grad-light); display: flex; align-items: center;
            justify-content: center; color: var(--accent); font-size: 1.6rem;
            margin: 0 auto 1rem; border: 2px solid <%= accentHex %>22;
        }
        .karir-title { font-weight: 700; font-size: 1rem; color: #1e293b; margin-bottom: .4rem; }
        .karir-gaji {
            display: inline-block; background: var(--grad-light);
            color: var(--accent); padding: .2rem .75rem; border-radius: 50px;
            font-size: .75rem; font-weight: 600; border: 1px solid <%= accentHex %>22;
        }

        /* ── Guru Cards ────────────────────────────────────────────────── */
        .guru-card-new {
            background: white; border-radius: var(--card-radius);
            padding: 1.75rem 1.25rem; text-align: center;
            border: 1px solid #f1f5f9; box-shadow: 0 2px 12px rgba(0,0,0,.05);
            transition: all .3s; height: 100%;
        }
        .guru-card-new:hover { transform: translateY(-6px); box-shadow: 0 15px 35px rgba(0,0,0,.1); border-color: <%= accentHex %>44; }
        .guru-avatar {
            width: 90px; height: 90px; border-radius: 50%;
            object-fit: cover; object-position: top;
            border: 3px solid transparent;
            background: var(--grad); padding: 3px;
            margin: 0 auto 1rem; display: block;
        }
        .guru-avatar-wrap {
            width: 90px; height: 90px; border-radius: 50%;
            background: var(--grad); display: flex; align-items: center;
            justify-content: center; color: white; font-size: 2rem;
            margin: 0 auto 1rem;
        }
        .guru-nama { font-weight: 700; font-size: .9rem; color: #1e293b; line-height: 1.3; margin-bottom: .25rem; }
        .guru-jabatan { font-size: .75rem; color: #64748b; }
        .guru-mapel {
            display: inline-block; margin-top: .5rem;
            background: var(--grad-light); color: var(--accent);
            padding: .15rem .6rem; border-radius: 50px; font-size: .7rem; font-weight: 600;
        }

        /* ── Galeri ────────────────────────────────────────────────────── */
        .galeri-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem; }
        .galeri-item-new {
            border-radius: 16px; overflow: hidden; position: relative;
            aspect-ratio: 1; cursor: pointer;
        }
        .galeri-item-new img {
            width: 100%; height: 100%; object-fit: cover;
            transition: transform .4s;
        }
        .galeri-item-new:hover img { transform: scale(1.08); }
        .galeri-overlay {
            position: absolute; inset: 0;
            background: linear-gradient(transparent 50%, rgba(0,0,0,.7));
            opacity: 0; transition: opacity .3s;
            display: flex; align-items: flex-end; padding: .75rem;
        }
        .galeri-item-new:hover .galeri-overlay { opacity: 1; }
        .galeri-caption { color: white; font-size: .78rem; font-weight: 600; }

        /* ── Berita ────────────────────────────────────────────────────── */
        .berita-card {
            background: white; border-radius: var(--card-radius);
            overflow: hidden; border: 1px solid #f1f5f9;
            box-shadow: 0 2px 12px rgba(0,0,0,.05);
            transition: all .3s; height: 100%;
        }
        .berita-card:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(0,0,0,.1); }
        .berita-img { width: 100%; height: 180px; object-fit: cover; }
        .berita-img-placeholder {
            width: 100%; height: 180px;
            background: var(--grad-light);
            display: flex; align-items: center; justify-content: center;
            font-size: 3rem; color: var(--accent);
        }
        .berita-body { padding: 1.25rem; }
        .berita-cat {
            background: var(--grad-light); color: var(--accent);
            padding: .2rem .7rem; border-radius: 50px;
            font-size: .7rem; font-weight: 700; display: inline-block; margin-bottom: .5rem;
        }
        .berita-judul { font-weight: 700; font-size: .95rem; color: #1e293b; line-height: 1.4; margin-bottom: .5rem; }
        .berita-date { font-size: .75rem; color: #94a3b8; }

        /* ── Prestasi ──────────────────────────────────────────────────── */
        .prestasi-card {
            background: white; border-radius: 16px;
            padding: 1.25rem 1.5rem;
            border: 1px solid #f1f5f9; border-left: 4px solid var(--accent);
            box-shadow: 0 2px 10px rgba(0,0,0,.05);
            display: flex; align-items: center; gap: 1rem;
            transition: all .3s;
        }
        .prestasi-card:hover { transform: translateX(5px); box-shadow: 0 8px 20px rgba(0,0,0,.1); }
        .prestasi-trophy {
            width: 48px; height: 48px; border-radius: 12px;
            background: var(--grad); display: flex; align-items: center;
            justify-content: center; color: white; font-size: 1.2rem; flex-shrink: 0;
        }
        .prestasi-judul { font-weight: 700; font-size: .88rem; color: #1e293b; line-height: 1.3; }
        .prestasi-meta { font-size: .75rem; color: #64748b; margin-top: .25rem; }

        /* ── Sertifikasi ───────────────────────────────────────────────── */
        .sertif-badge {
            display: inline-flex; align-items: center; gap: .5rem;
            background: white; border: 1px solid #e2e8f0;
            padding: .6rem 1.2rem; border-radius: 50px;
            font-size: .85rem; font-weight: 600; color: #334155;
            box-shadow: 0 2px 8px rgba(0,0,0,.06);
            transition: all .3s; cursor: default;
        }
        .sertif-badge:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0,0,0,.12); border-color: var(--accent); color: var(--accent); }
        .sertif-badge i { color: var(--accent); }

        /* ── Sticky Sidebar ────────────────────────────────────────────── */
        .sticky-sidebar { position: sticky; top: 90px; }
        .sidebar-card {
            background: white; border-radius: var(--card-radius);
            padding: 1.75rem; box-shadow: 0 4px 20px rgba(0,0,0,.07);
            border: 1px solid #f1f5f9; margin-bottom: 1.5rem;
        }
        .sidebar-title {
            font-size: .95rem; font-weight: 700; color: #1e293b;
            margin-bottom: 1rem; display: flex; align-items: center; gap: .6rem;
        }
        .sidebar-title-icon {
            width: 32px; height: 32px; border-radius: 8px;
            background: var(--grad); display: flex; align-items: center;
            justify-content: center; color: white; font-size: .8rem; flex-shrink: 0;
        }

        /* ── Back to top / breadcrumb ──────────────────────────────────── */
        .breadcrumb-bar {
            background: white; padding: .75rem 0;
            border-bottom: 1px solid #f1f5f9;
            position: sticky; top: 72px; z-index: 100;
        }
        .breadcrumb-bar a { color: #64748b; font-size: .82rem; }
        .breadcrumb-bar a:hover { color: var(--accent); }
        .breadcrumb-bar span { color: #94a3b8; margin: 0 .4rem; }
        .breadcrumb-bar .current { color: var(--accent); font-weight: 600; font-size: .82rem; }

        /* ── Scroll reveal ─────────────────────────────────────────────── */
        .reveal { opacity: 0; transform: translateY(30px); transition: all .6s ease; }
        .reveal.visible { opacity: 1; transform: translateY(0); }

        /* ── Animations ────────────────────────────────────────────────── */
        @keyframes fadeInDown { from{ opacity:0; transform:translateY(-20px) } to{ opacity:1; transform:translateY(0) } }
        @keyframes fadeInUp   { from{ opacity:0; transform:translateY(30px) } to{ opacity:1; transform:translateY(0) } }
        @keyframes fadeInRight{ from{ opacity:0; transform:translateX(40px) } to{ opacity:1; transform:translateX(0) } }
        @keyframes countUp { from{ opacity:0 } to{ opacity:1 } }

        /* ── Responsive ────────────────────────────────────────────────── */
        @media (max-width: 991.98px) {
            .hero { min-height: auto; padding: 100px 0 60px; }
            .hero-visual { margin-top: 3rem; }
            .sticky-sidebar { position: static; }
        }
        @media (max-width: 575.98px) {
            .section { padding: 3rem 0; }
            .hero-cta { flex-direction: column; }
            .btn-hero-primary, .btn-hero-outline { justify-content: center; }
            .hero-stats { gap: 1rem; justify-content: center; }
            .galeri-grid { grid-template-columns: repeat(2, 1fr); }
        }

        /* ── Nav scroll indicator ─────────────────────────────────────── */
        .progress-bar-top {
            position: fixed; top: 0; left: 0; height: 3px;
            background: var(--grad); z-index: 9999;
            transition: width .1s linear; width: 0%;
        }

        /* ── Quick nav dots ────────────────────────────────────────────── */
        .section-nav {
            position: fixed; right: 1.5rem; top: 50%; transform: translateY(-50%);
            display: flex; flex-direction: column; gap: .75rem; z-index: 50;
        }
        .snav-dot {
            width: 10px; height: 10px; border-radius: 50%;
            background: #cbd5e1; cursor: pointer;
            transition: all .3s; border: 2px solid white;
            box-shadow: 0 2px 5px rgba(0,0,0,.2);
        }
        .snav-dot.active { background: var(--accent); transform: scale(1.4); }
        @media (max-width: 991.98px) { .section-nav { display: none; } }
    </style>
</head>
<body>
    <!-- Progress bar top -->
    <div class="progress-bar-top" id="scrollProgress"></div>

    <%- include('partials/navbar') %>

    <!-- Breadcrumb -->
    <div class="breadcrumb-bar">
        <div class="container d-flex align-items-center">
            <a href="/">Beranda</a>
            <span>›</span>
            <a href="/jurusan">Program Keahlian</a>
            <span>›</span>
            <span class="current"><%= jurusan.kode %></span>
        </div>
    </div>

    <!-- ════ HERO ════════════════════════════════════════════════════════ -->
    <section class="hero" id="sec-hero">
        <div class="hero-grid"></div>
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-3"></div>
        <canvas class="nodes-canvas" id="nodesCanvas"></canvas>

        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <div class="hero-content">
                        <div class="hero-kode-badge">
                            <i class="<%= jIcon %>"></i>
                            <%= jurusan.kode %> · SMK Negeri 1 Kras
                        </div>
                        <h1 class="hero-title"><%= jurusan.nama %></h1>
                        <p class="hero-subtitle"><%= ch.tagline %></p>
                        <p class="hero-desc"><%= jurusan.deskripsi || 'Program keahlian unggulan yang mempersiapkan siswa menjadi tenaga profesional di bidang teknologi informasi dan jaringan komputer.' %></p>
                        <div class="hero-tags">
                            <% ch.badges.forEach(b=>{ %><span class="hero-tag"><%= b %></span><% }) %>
                        </div>
                        <div class="hero-cta">
                            <a href="#sec-about" class="btn-hero-primary">
                                <i class="fas fa-info-circle"></i> Selengkapnya
                            </a>
                            <a href="#sec-guru" class="btn-hero-outline">
                                <i class="fas fa-users"></i> Tim Pengajar
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="hero-visual">
                        <div class="hero-device">
                            <div class="device-header">
                                <div class="device-dot"></div>
                                <div class="device-dot"></div>
                                <div class="device-dot"></div>
                            </div>
                            <div class="device-terminal" id="terminal">
                                <div class="terminal-line"><span class="terminal-prompt">student@<%= jurusan.kode.toLowerCase() %>:~$</span> <span class="terminal-cmd">ping 192.168.1.1</span></div>
                                <div class="terminal-line terminal-output">PING 192.168.1.1 (192.168.1.1) 56 bytes</div>
                                <div class="terminal-line terminal-output">64 bytes: icmp_seq=1 ttl=64 time=0.42ms</div>
                                <div class="terminal-line terminal-output">64 bytes: icmp_seq=2 ttl=64 time=0.38ms</div>
                                <div class="terminal-line terminal-output" style="color:#6bcb77;">-- ping statistics --</div>
                                <div class="terminal-line terminal-output">2 packets transmitted, 0% packet loss</div>
                                <div class="terminal-line"><span class="terminal-prompt">student@<%= jurusan.kode.toLowerCase() %>:~$</span> <span class="terminal-cmd">ip route show</span></div>
                                <div class="terminal-line terminal-output">default via 192.168.1.1 dev eth0</div>
                                <div class="terminal-line terminal-output">192.168.1.0/24 dev eth0 proto kernel</div>
                                <div class="terminal-line"><span class="terminal-prompt">student@<%= jurusan.kode.toLowerCase() %>:~$</span> <span class="cursor"></span></div>
                            </div>
                            <div class="net-topo">
                                <div class="net-node active"><i class="fas fa-desktop" style="font-size:.6rem"></i></div>
                                <div class="net-line"></div>
                                <div class="net-node active"><i class="fas fa-network-wired" style="font-size:.6rem"></i></div>
                                <div class="net-line"></div>
                                <div class="net-node"><i class="fas fa-server" style="font-size:.6rem"></i></div>
                                <div class="net-line"></div>
                                <div class="net-node active"><i class="fas fa-globe" style="font-size:.6rem"></i></div>
                            </div>
                        </div>

                        <div class="hero-stats mt-3">
                            <div class="stat-item">
                                <div class="stat-num" data-count="<%= guru.length %>">0</div>
                                <div class="stat-label">Guru Pengajar</div>
                            </div>
                            <div class="stat-item">
                                <div class="stat-num" data-count="<%= prestasi.length %>">0</div>
                                <div class="stat-label">Prestasi</div>
                            </div>
                            <div class="stat-item">
                                <div class="stat-num" data-count="3">0</div>
                                <div class="stat-label">Tahun Studi</div>
                            </div>
                            <div class="stat-item">
                                <div class="stat-num" data-count="<%= ch.karir.length %>">0</div>
                                <div class="stat-label">Prospek Karir</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Section nav dots -->
    <nav class="section-nav" id="sectionNav">
        <div class="snav-dot active" data-target="sec-hero" title="Hero"></div>
        <div class="snav-dot" data-target="sec-about" title="Tentang"></div>
        <div class="snav-dot" data-target="sec-kurikulum" title="Kurikulum"></div>
        <div class="snav-dot" data-target="sec-fasilitas" title="Fasilitas"></div>
        <div class="snav-dot" data-target="sec-karir" title="Karir"></div>
        <% if(guru && guru.length > 0){ %><div class="snav-dot" data-target="sec-guru" title="Guru"></div><% } %>
        <% if(galeriJurusan && galeriJurusan.length > 0){ %><div class="snav-dot" data-target="sec-galeri" title="Galeri"></div><% } %>
        <% if(jurusanBerita && jurusanBerita.length > 0){ %><div class="snav-dot" data-target="sec-berita" title="Berita"></div><% } %>
        <% if(prestasi && prestasi.length > 0){ %><div class="snav-dot" data-target="sec-prestasi" title="Prestasi"></div><% } %>
    </nav>

    <!-- ════ TENTANG ════════════════════════════════════════════════════ -->
    <section class="section section-alt" id="sec-about">
        <div class="container">
            <div class="row g-5 align-items-start">
                <div class="col-lg-8">
                    <div class="reveal">
                        <span class="section-tag"><i class="fas fa-info-circle"></i> Tentang Program</span>
                        <h2 class="section-title-main">Apa itu <span style="color:var(--accent)"><%= jurusan.nama %></span>?</h2>
                        <div class="divider"></div>
                    </div>

                    <% if (jurusan.deskripsi_lengkap) { %>

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title><%= title %> - Website Sekolah</title>
    <link rel="icon" type="image/png" href="/assets/img/favicon.png">
    <link href="/assets/vendor/bootstrap5/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/vendor/fontawesome6/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/theme.css">
    <style>
        body { color: #334155; background: #f8fafc; }
        .page-header {
            background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 100%);
            padding: 9rem 0 4rem;
            color: white;
            text-align: center;
        }
        .section { padding: 5rem 0; }

        /* Konten sambutan */
        .sambutan-nama {
            font-size: 2rem;
            font-weight: 900;
            color: #1e293b;
            margin-bottom: 1.5rem;
            border-bottom: 3px solid #1e3a5f;
            padding-bottom: .75rem;
        }
        .sambutan-body {
            font-size: 1rem;
            line-height: 1.85;
            text-align: justify;
            color: #334155;
        }
        .sambutan-body p { margin-bottom: 1.1rem; }
        .sambutan-body .salam { font-weight: 700; }
        .ttd-nama { font-weight: 700; margin-top: .25rem; }
        .ttd-nip { color: #64748b; font-size: .95rem; }

        /* Foto kepsek */
        .foto-wrapper {
            position: relative;
            display: inline-block;
        }
        .foto-frame {
            position: relative;
            width: 100%;
            max-width: 320px;
            margin: 0 auto;
        }
        /* Dekorasi sudut bawah kiri */
        .foto-frame::before {
            content: '';
            position: absolute;
            bottom: -14px;
            left: -14px;
            width: 60%;
            height: 60%;
            border-left: 5px solid #1e3a5f;
            border-bottom: 5px solid #1e3a5f;
            border-radius: 0 0 0 8px;
            z-index: 0;
        }
        /* Dekorasi sudut atas kanan */
        .foto-frame::after {
            content: '';
            position: absolute;
            top: -14px;
            right: -14px;
            width: 60%;
            height: 60%;
            border-right: 5px solid #1e3a5f;
            border-top: 5px solid #1e3a5f;
            border-radius: 0 8px 0 0;
            z-index: 0;
        }
        .foto-img {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 320px;
            height: 400px;
            object-fit: cover;
            object-position: top;
            border-radius: 8px;
            display: block;
            background: #e2e8f0;
        }
        /* Background dekoratif daun/motif di belakang foto */
        .foto-bg-deco {
            position: absolute;
            top: 0; right: 0; bottom: 0; left: 0;
            background: linear-gradient(135deg, #ddd6fe 0%, #bfdbfe 100%);
            border-radius: 8px;
            z-index: 0;
        }
        .foto-placeholder {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 320px;
            height: 400px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #ddd6fe 0%, #bfdbfe 100%);
        }

        /* Sidebar */
        .sidebar-widget { background: white; border-radius: 20px; padding: 1.5rem; box-shadow: 0 4px 20px rgba(14,165,233,.08); border: 1px solid #f1f5f9; margin-bottom: 1.5rem; }
        .widget-title { font-size: 1.05rem; font-weight: 800; color: #1e293b; margin-bottom: 1.25rem; padding-bottom: .75rem; border-bottom: 2px solid #e0f2fe; display: flex; align-items: center; gap: .5rem; }
        .widget-title span { color: #0ea5e9; }
        .berita-slider-wrap { position: relative; overflow: hidden; border-radius: 14px; }
        .berita-slider-track { display: flex; transition: transform .4s ease; }
        .berita-slide { flex: 0 0 100%; position: relative; }
        .berita-slide img { width: 100%; height: 180px; object-fit: cover; display: block; }
        .berita-slide-placeholder { width: 100%; height: 180px; background: linear-gradient(135deg, #0ea5e9, #0369a1); display: flex; align-items: center; justify-content: center; color: white; font-size: 2rem; }
        .berita-slide-caption { position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(to top, rgba(0,0,0,.75) 0%, transparent 100%); padding: 1rem .75rem .75rem; }
        .berita-slide-caption a { color: white; font-size: .82rem; font-weight: 600; text-decoration: none; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .berita-slide-caption a:hover { color: #bfdbfe; }
        .berita-slide-date { font-size: .72rem; color: rgba(255,255,255,.75); margin-top: .2rem; }
        .slider-dots { display: flex; justify-content: center; gap: 6px; margin-top: .75rem; }
        .slider-dot { width: 8px; height: 8px; border-radius: 50%; background: #e2e8f0; cursor: pointer; transition: all .2s; border: none; padding: 0; }
        .slider-dot.active { background: #0ea5e9; transform: scale(1.3); }
        .artikel-item { display: flex; gap: .75rem; padding: .75rem 0; border-bottom: 1px solid #f1f5f9; text-decoration: none; color: inherit; transition: all .2s; }
        .artikel-item:last-child { border-bottom: none; }
        .artikel-item:hover { color: #0ea5e9; }
        .artikel-item img { width: 65px; height: 50px; object-fit: cover; border-radius: 8px; flex-shrink: 0; }
        .artikel-item-placeholder { width: 65px; height: 50px; border-radius: 8px; background: #e0f2fe; display: flex; align-items: center; justify-content: center; color: #0ea5e9; flex-shrink: 0; }
        .artikel-item-title { font-size: .83rem; font-weight: 600; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .artikel-item-date { font-size: .73rem; color: #94a3b8; margin-top: .2rem; }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <section class="page-header">
        <div class="container">
            <div style="display:inline-flex;align-items:center;gap:.5rem;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.3);color:#bfdbfe;padding:.4rem 1.2rem;border-radius:50px;font-size:.85rem;font-weight:700;margin-bottom:1.5rem;">
                <i class="fas fa-user-tie"></i> SMKN 1 KRAS
            </div>
            <h1 style="font-size:clamp(2rem,5vw,3rem);font-weight:900;margin-bottom:.75rem;">Sambutan Kepala Sekolah</h1>
            <p style="opacity:.8;font-size:1rem;">Pesan dan harapan dari pimpinan sekolah</p>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <div class="row g-5 align-items-start">

                <!-- Kolom Teks (kiri) -->
                <div class="col-lg-7">
                    <h2 class="sambutan-nama">
                        <%= kepsek && kepsek.judul ? kepsek.judul : 'Kepala Sekolah' %>
                    </h2>
                    <div class="sambutan-body">
                        <% if (kepsek && kepsek.konten && kepsek.konten.trim()) { %>
                            <%- kepsek.konten %>
                        <% } else { %>
                            <p class="salam">Assalamu'alaikum Wr. Wb.</p>
                            <p>Puji syukur kita panjatkan kehadirat Allah SWT, yang senantiasa memberikan rahmat dan hidayah-Nya kepada kita semua. Shalawat serta salam semoga tetap tercurahkan kepada junjungan kita Nabi Muhammad SAW, keluarga, sahabat, dan seluruh umat Islam yang senantiasa mengikuti petunjuk-Nya.</p>
                            <p>Sambutan kepala sekolah belum tersedia. Silakan tambahkan konten melalui panel admin.</p>
                            <p class="salam">Wassalamu'alaikum Wr. Wb.</p>
                            <div class="mt-3">
                                <div class="ttd-nama"><%= kepsek && kepsek.judul ? kepsek.judul.toUpperCase() : 'KEPALA SEKOLAH' %></div>
                                <div class="ttd-nip">NIP. -</div>
                            </div>
                        <% } %>
                    </div>

                    <!-- Share di bawah teks -->
                    <% shareTitle = kepsek && kepsek.judul ? kepsek.judul : 'Sambutan Kepala Sekolah'; shareUrl = '/profil/sambutan'; %>
                    <%- include('partials/share-buttons') %>
                </div>

                <!-- Kolom Kanan: Foto + Sidebar -->
                <div class="col-lg-5">
                    <!-- Foto -->
                    <div class="d-flex justify-content-center mb-4">
                        <div class="foto-frame">
                            <% if (kepsek && kepsek.foto) { %>
                                <img src="/uploads/<%= kepsek.foto %>" class="foto-img" alt="<%= kepsek.judul || 'Kepala Sekolah' %>" loading="lazy">
                            <% } else { %>
                                <div class="foto-placeholder">
                                    <i class="fas fa-user-tie fa-5x" style="color:#1e3a5f;opacity:.4;"></i>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- Sidebar di bawah foto -->
                    <%- include('partials/sidebar-info-vertical') %>
                </div>

            </div>
        </div>
    </section>

    <%- include('partials/related') %>
    <%- include('partials/footer') %>

    <script src="/assets/vendor/bootstrap5/bootstrap.bundle.min.js"></script>
    <script src="/assets/vendor/jquery3/jquery.min.js"></script>
    <script>
        $(window).scroll(function(){
            if($(window).scrollTop()>50) $('.navbar-modern').addClass('scrolled');
            else $('.navbar-modern').removeClass('scrolled');
        });
    </script>
</body>
</html>


<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Update Biodata Alumni - Website Sekolah</title>
    <link rel="icon" type="image/png" href="/assets/img/favicon.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/theme.css">
    <style>
        * { font-family:'Inter',sans-serif; box-sizing:border-box; }
        body { background:#f8fafc; }
        .wrapper { min-height:100vh; display:flex; align-items:center; justify-content:center; padding:6rem 1rem; }
        .card-box { background:white; border-radius:24px; box-shadow:0 8px 40px rgba(14,165,233,.12); padding:3rem; max-width:480px; width:100%; text-align:center; }
        .icon { width:80px; height:80px; background:linear-gradient(135deg,#0ea5e9,#0369a1); border-radius:20px; display:flex; align-items:center; justify-content:center; margin:0 auto 1.5rem; color:white; font-size:2rem; }
        .form-control { border-radius:10px; border:1px solid #e2e8f0; padding:.8rem 1rem; }
        .btn-go { background:linear-gradient(135deg,#0ea5e9,#0369a1); color:white; border:none; border-radius:50px; padding:.9rem 2rem; font-weight:700; width:100%; transition:all .3s; }
        .btn-go:hover { transform:translateY(-2px); box-shadow:0 8px 20px rgba(14,165,233,.4); color:white; }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>
    <div class="wrapper">
        <div class="card-box">
            <div class="icon"><i class="fas fa-key"></i></div>
            <h2 class="fw-bold mb-1" style="color:#1e293b;">Update Biodata</h2>
            <p class="text-muted mb-4">Masukkan token yang kamu terima saat mendaftar</p>
            <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger rounded-3 text-start"><i class="fas fa-exclamation-circle me-2"></i><%= error %></div>
            <% } %>
            <form method="GET" action="/alumni/update">
                <div class="mb-3 text-start">
                    <label class="form-label fw-semibold">Token Alumni</label>
                    <input type="text" class="form-control" name="token" placeholder="Masukkan token 64 karakter..." required>
                    <small class="text-muted">Token diberikan saat kamu mendaftar pertama kali</small>
                </div>
                <button type="submit" class="btn-go"><i class="fas fa-arrow-right me-2"></i>Lanjutkan</button>
            </form>
            <div class="mt-3">
                <a href="/alumni" class="text-muted small">← Kembali ke halaman alumni</a>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

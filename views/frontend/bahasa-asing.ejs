<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <% seoTitle='Bahasa Asing'; seoDesc='Ekstrakurikuler Bahasa Asing SMK Negeri 1 Kras. Pelatihan bahasa Inggris, Jepang, dan bahasa asing lainnya untuk mempersiapkan siswa di dunia kerja global.'; seoUrl='/bahasa-asing'; %>
    <%- include('partials/_seo') %>
    <link href="/assets/vendor/bootstrap5/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/vendor/fontawesome6/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/vendor/lightbox2/lightbox.min.css">
    <link rel="stylesheet" href="/theme.css">
    <style>
        :root {
            --teal: #0f766e;
            --teal-dark: #134e4a;
            --teal-light: #ccfbf1;
            --cyan: #0d9488;
            --cyan-mid: #0f766e;
            --accent: #2dd4bf;
            --gray-50: #f8fafc;
            --gray-100: #f1f5f9;
            --gray-600: #475569;
            --gray-700: #334155;
            --gray-800: #1e293b;
        }
        body { color: var(--gray-700); line-height: 1.6; background: #fff; }
        .hero {
            background: linear-gradient(135deg, var(--teal-dark) 0%, var(--cyan-mid) 50%, #0f766e 100%);
            padding: 5rem 0 2.5rem;
            color: white;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        .hero::before {
            content: '';
            position: absolute;
            top: -100px; right: -100px;
            width: 500px; height: 500px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(45,212,191,.2) 0%, transparent 70%);
        }
        .hero-badge {
            display: inline-flex; align-items: center; gap: .5rem;
            background: rgba(45,212,191,.2);
            border: 1px solid rgba(45,212,191,.4);
            color: #99f6e4;
            padding: .4rem 1.2rem;
            border-radius: 50px;
            font-size: .85rem; font-weight: 700;
            margin-bottom: 1.5rem;
        }
        .hero-title { font-size: clamp(2.2rem, 5vw, 3.5rem); font-weight: 900; line-height: 1.1; position: relative; z-index: 1; }
        .hero-title span { color: var(--accent); }
        .hero-sub { font-size: 1.05rem; opacity: .8; margin-top: .75rem; position: relative; z-index: 1; }
        .hero-stats { display: flex; justify-content: center; gap: 3rem; margin-top: 3rem; position: relative; z-index: 1; }
        .hero-stat { text-align: center; }
        .hero-stat-num { font-size: 2rem; font-weight: 900; color: var(--accent); line-height: 1; }
        .hero-stat-label { font-size: .78rem; opacity: .7; margin-top: .2rem; }
        .section { padding: 5rem 0; }
        .section-alt { background: var(--gray-50); }
        .section-label {
            display: inline-flex; align-items: center; gap: .5rem;
            background: var(--teal-light); color: var(--teal-dark);
            padding: .3rem .9rem; border-radius: 50px;
            font-size: .78rem; font-weight: 700; margin-bottom: .75rem;
        }
        .section-title { font-size: 1.9rem; font-weight: 800; color: var(--gray-800); margin-bottom: .5rem; }
        .section-title span { color: var(--teal); }
        .section-desc { color: var(--gray-600); font-size: .95rem; margin-bottom: 2.5rem; }
        .divider { width: 60px; height: 4px; background: linear-gradient(to right, var(--teal), var(--accent)); border-radius: 2px; margin: .75rem 0 1.5rem; }
        .kegiatan-card {
            background: white; border-radius: 20px; overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,.06);
            border: 1px solid var(--gray-100);
            transition: all .3s; height: 100%;
            text-decoration: none; display: block; color: inherit;
        }
        .kegiatan-card:hover { transform: translateY(-8px); box-shadow: 0 20px 50px rgba(15,118,110,.18); color: inherit; text-decoration: none; }
        .kegiatan-img { height: 200px; object-fit: cover; width: 100%; }
        .kegiatan-placeholder { height: 200px; background: linear-gradient(135deg, var(--teal-dark), var(--accent)); display: flex; align-items: center; justify-content: center; color: white; font-size: 2.5rem; }
        .kegiatan-body { padding: 1.5rem; }
        .tag { display: inline-block; background: var(--teal-light); color: var(--teal-dark); padding: .2rem .7rem; border-radius: 8px; font-size: .72rem; font-weight: 700; text-transform: uppercase; }
        .kegiatan-title { font-size: 1rem; font-weight: 700; color: var(--gray-800); margin: .6rem 0 .4rem; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .kegiatan-meta { font-size: .75rem; color: var(--gray-600); }
        .kegiatan-excerpt { font-size: .84rem; color: var(--gray-600); line-height: 1.6; margin-top: .5rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
        .galeri-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
        .galeri-grid .g-tall { grid-row: span 2; }
        .galeri-grid .g-wide { grid-column: span 2; }
        @media (max-width: 768px) { .galeri-grid { grid-template-columns: repeat(2, 1fr); } .galeri-grid .g-tall, .galeri-grid .g-wide { grid-row: span 1; grid-column: span 1; } }
        .galeri-item { border-radius: 12px; overflow: hidden; position: relative; cursor: pointer; }
        .galeri-item img { width: 100%; height: 100%; min-height: 140px; object-fit: cover; transition: transform .4s; display: block; }
        .galeri-item:hover img { transform: scale(1.07); }
        .galeri-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(19,78,74,.7) 0%, transparent 60%); opacity: 0; transition: opacity .3s; display: flex; align-items: flex-end; padding: .75rem; }
        .galeri-item:hover .galeri-overlay { opacity: 1; }
        .galeri-caption { color: white; font-size: .78rem; font-weight: 600; }
        .empty-box { text-align: center; padding: 3rem; background: var(--gray-50); border-radius: 16px; border: 2px dashed var(--gray-100); color: var(--gray-600); }
        .empty-box i { font-size: 2.5rem; color: var(--accent); margin-bottom: .75rem; display: block; }
        .berita-item { display: flex; gap: 1.25rem; background: white; border-radius: 16px; padding: 1.25rem; box-shadow: 0 2px 12px rgba(0,0,0,.05); border: 1px solid var(--gray-100); transition: all .25s; margin-bottom: 1rem; }
        .berita-item:hover { box-shadow: 0 8px 25px rgba(15,118,110,.12); transform: translateX(4px); }
        .berita-thumb { width: 100px; height: 80px; border-radius: 10px; object-fit: cover; flex-shrink: 0; }
        .berita-thumb-placeholder { width: 100px; height: 80px; border-radius: 10px; background: linear-gradient(135deg, var(--teal), var(--teal-dark)); display: flex; align-items: center; justify-content: center; color: white; font-size: 1.5rem; flex-shrink: 0; }
        .berita-content { flex: 1; min-width: 0; }
        .berita-title { font-weight: 700; font-size: .95rem; color: var(--gray-800); line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: .3rem; }
        .berita-excerpt { font-size: .8rem; color: var(--gray-600); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .cta-strip { background: linear-gradient(135deg, var(--teal-dark), var(--cyan-mid)); padding: 3rem 0; text-align: center; color: white; }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <section class="hero">
        <div class="container">
            <div class="hero-badge"><i class="fas fa-language"></i> BAHASA ASING SMKN 1 KRAS</div>
            <h1 class="hero-title" style="position:relative;z-index:1;">
                Ekstrakurikuler <span>Bahasa Asing</span><br>SMKN 1 Kras
            </h1>
            <p class="hero-sub">Ekstrakurikuler Bahasa Asing SMKN 1 Kras</p>
            <div class="hero-stats">
                <div class="hero-stat">
                    <div class="hero-stat-num"><%= kegiatan.length %></div>
                    <div class="hero-stat-label">Kegiatan</div>
                </div>
                <div class="hero-stat">
                    <div class="hero-stat-num"><%= galeri.length %></div>
                    <div class="hero-stat-label">Foto Galeri</div>
                </div>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <div class="section-label"><i class="fas fa-calendar-alt"></i> Program Kegiatan</div>
            <h2 class="section-title">Kegiatan <span>Bahasa Asing</span></h2>
            <div class="divider"></div>
            <p class="section-desc">Berbagai kegiatan dan program yang diselenggarakan Bahasa Asing SMKN 1 Kras</p>
            <% if (!kegiatan || kegiatan.length === 0) { %>
            <div class="empty-box"><i class="fas fa-language"></i><p>Belum ada kegiatan yang dipublikasikan</p></div>
            <% } else { %>
            <div class="row g-4">
                <% kegiatan.forEach((k) => { %>
                <div class="col-lg-4 col-md-6">
                    <a href="/bahasa-asing/<%= k.slug %>" class="kegiatan-card">
                        <% if (k.gambar) { %>
                        <img src="/uploads/<%= k.gambar %>" class="kegiatan-img" alt="<%= k.judul %>" onerror="this.style.display='none'">
                        <% } else { %>
                        <div class="kegiatan-placeholder"><i class="fas fa-language"></i></div>
                        <% } %>
                        <div class="kegiatan-body">
                            <span class="tag"><%= k.kategori %></span>
                            <div class="kegiatan-title"><%= k.judul %></div>
                            <div class="kegiatan-meta"><i class="fas fa-clock me-1"></i><%= new Date(k.created_at).toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'}) %></div>
                            <% if (k.konten) { %><div class="kegiatan-excerpt"><%- (k.konten||'').replace(/<[^>]*>/g,'').substring(0,120) %></div><% } %>
                        </div>
                    </a>
                </div>
                <% }) %>
            </div>
            <% } %>
        </div>
    </section>

    <% if (berita && berita.length > 0) { %>
    <section class="section section-alt">
        <div class="container">
            <div class="row align-items-start">
                <div class="col-lg-4 mb-4 mb-lg-0">
                    <div class="section-label"><i class="fas fa-newspaper"></i> Informasi Terkini</div>
                    <h2 class="section-title">Berita & <span>Pengumuman</span></h2>
                    <div class="divider"></div>
                    <p class="section-desc">Update terbaru dari Bahasa Asing SMKN 1 Kras.</p>
                    <div style="background:linear-gradient(135deg,var(--teal-dark),var(--cyan-mid));border-radius:16px;padding:1.5rem;color:white;margin-top:1.5rem;">
                        <i class="fas fa-bullhorn fa-2x mb-2" style="color:var(--accent);"></i>
                        <p style="font-size:.9rem;opacity:.85;margin:0;">Pantau terus informasi terbaru dari Bahasa Asing SMKN 1 Kras.</p>
                    </div>
                </div>
                <div class="col-lg-8">
                    <% berita.forEach(b => { %>
                    <a href="/bahasa-asing/berita/<%= b.slug %>" class="berita-item" style="text-decoration:none;color:inherit;">
                        <% if (b.gambar) { %>
                        <img src="/uploads/<%= b.gambar %>" class="berita-thumb" alt="<%= b.judul %>" onerror="this.style.display='none'">
                        <% } else { %>
                        <div class="berita-thumb-placeholder"><i class="fas fa-newspaper"></i></div>
                        <% } %>
                        <div class="berita-content">
                            <span class="tag" style="margin-bottom:.4rem;display:inline-block;"><%= b.kategori %></span>
                            <div class="berita-title"><%= b.judul %></div>
                            <% if (b.konten) { %><div class="berita-excerpt"><%- (b.konten||'').replace(/<[^>]*>/g,'').substring(0,100) %></div><% } %>
                            <div class="kegiatan-meta mt-1"><i class="fas fa-calendar me-1"></i><%= new Date(b.created_at).toLocaleDateString('id-ID',{day:'numeric',month:'short',year:'numeric'}) %></div>
                        </div>
                    </a>
                    <% }) %>
                </div>
            </div>
        </div>
    </section>
    <% } %>

    <% if (galeri && galeri.length > 0) { %>
    <section class="section section-alt">
        <div class="container">
            <div class="text-center mb-4">
                <div class="section-label" style="justify-content:center;"><i class="fas fa-images"></i> Dokumentasi</div>
                <h2 class="section-title">Galeri <span>Foto Bahasa Asing</span></h2>
                <div class="divider mx-auto"></div>
            </div>
            <div class="galeri-grid">
                <% galeri.forEach((g, i) => { %>
                <div class="galeri-item<% if(i===0){%> g-tall g-wide<%}else if(i===3){%> g-wide<%}%>">
                    <a href="/uploads/<%= g.gambar %>" data-lightbox="bahasa-asing-galeri" data-title="<%= g.judul %>">
                        <img src="/uploads/<%= g.gambar %>" alt="<%= g.judul %>" onerror="this.parentElement.parentElement.style.display='none'">
                        <div class="galeri-overlay"><span class="galeri-caption"><i class="fas fa-search-plus me-1"></i><%= g.judul %></span></div>
                    </a>
                </div>
                <% }) %>
            </div>
        </div>
    </section>
    <% } %>

    <div class="cta-strip">
        <div class="container">
            <i class="fas fa-language fa-2x mb-2" style="color:var(--accent);display:block;"></i>
            <h3 style="font-weight:800;margin-bottom:.5rem;">Bergabung dengan Bahasa Asing</h3>
            <p style="opacity:.75;font-size:.95rem;margin:0;">Jadilah bagian dari ekstrakurikuler bahasa asing kebanggaan SMKN 1 Kras</p>
        </div>
    </div>

    <%- include('partials/footer') %>
    <script src="/assets/vendor/bootstrap5/bootstrap.bundle.min.js"></script>
    <script src="/assets/vendor/jquery3/jquery.min.js"></script>
    <script src="/assets/vendor/lightbox2/lightbox.min.js"></script>
    <script>
        lightbox.option({ resizeDuration: 200, wrapAround: true });
        $(window).scroll(function(){ if($(window).scrollTop()>50) $('.navbar-modern').addClass('scrolled'); else $('.navbar-modern').removeClass('scrolled'); });
    </script>
</body>
</html>


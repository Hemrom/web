<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title><%= title %> - Website Sekolah</title>
    <link rel="icon" type="image/png" href="/assets/img/favicon.png">
    <link href="/assets/vendor/bootstrap5/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/vendor/fontawesome6/all.min.css" rel="stylesheet">    <link rel="stylesheet" href="/theme.css">
    <style>
        :root{--primary:#10b981;--primary-dark:#059669;--gray-50:#f8fafc;--gray-100:#f1f5f9;--gray-600:#475569;--gray-700:#334155;--gray-800:#1e293b;}
        *{font-family:'Inter',sans-serif;box-sizing:border-box;margin:0;padding:0;}
        body{color:var(--gray-700);line-height:1.6;}
        .page-header{background:linear-gradient(135deg,#064e3b,#10b981);padding:10rem 0 5rem;color:white;text-align:center;}
        .page-title{font-size:3rem;font-weight:800;}
        .content-section{padding:5rem 0;background:var(--gray-50);}
        .bkk-card{background:white;border-radius:20px;overflow:hidden;box-shadow:0 4px 20px rgba(16,185,129,.08);border:1px solid var(--gray-100);transition:all .3s;height:100%;}
        .bkk-card:hover{transform:translateY(-8px);box-shadow:0 16px 40px rgba(16,185,129,.15);}
        .bkk-img{height:180px;object-fit:cover;width:100%;}
        .bkk-img-placeholder{height:180px;background:linear-gradient(135deg,#064e3b,#10b981);display:flex;align-items:center;justify-content:center;color:white;font-size:3rem;}
        .badge-kategori{font-size:.75rem;padding:.3rem .75rem;border-radius:20px;font-weight:600;}
        .badge-kerja{background:#d1fae5;color:#065f46;}
        .badge-magang{background:#dbeafe;color:#1e40af;}
        .badge-beasiswa{background:#fef3c7;color:#92400e;}
    </style>
</head>
<body>
    <%- include('partials/navbar') %>
    <section class="page-header">
        <div class="container">
            <h1 class="page-title"><i class="fas fa-briefcase me-3"></i>BKK</h1>
            <p style="font-size:1.1rem;opacity:.9;margin-top:.5rem;">Bursa Kerja Khusus — Lowongan Kerja & Magang</p>
        </div>
    </section>
    <section class="content-section">
        <div class="container">
            <% if (!lowongan||lowongan.length===0) { %>
            <div class="text-center py-5">
                <i class="fas fa-briefcase fa-4x text-muted mb-3 d-block"></i>
                <h4 class="text-muted">Belum ada lowongan tersedia</h4>
            </div>
            <% } else { %>
            <div class="row g-4">
                <% lowongan.forEach(l=>{ %>
                <div class="col-lg-4 col-md-6">
                    <div class="bkk-card">
                        <% if (l.gambar) { %>
                        <img src="/uploads/<%= l.gambar %>" class="bkk-img" alt="<%= l.judul %>">
                        <% } else { %>
                        <div class="bkk-img-placeholder"><i class="fas fa-building"></i></div>
                        <% } %>
                        <div class="p-4">
                            <div class="d-flex gap-2 mb-2 flex-wrap">
                                <span class="badge-kategori badge-<%= l.kategori %>"><%= l.kategori.charAt(0).toUpperCase()+l.kategori.slice(1) %></span>
                                <% if (l.deadline) { %>
                                <span style="background:#fef2f2;color:#991b1b;padding:.2rem .6rem;border-radius:10px;font-size:.75rem;font-weight:600;">
                                    <i class="fas fa-clock me-1"></i>Deadline: <%= new Date(l.deadline).toLocaleDateString('id-ID') %>
                                </span>
                                <% } %>
                            </div>
                            <h5 style="font-weight:700;color:var(--gray-800);margin-bottom:.25rem;"><%= l.judul %></h5>
                            <p style="font-size:.85rem;color:#10b981;font-weight:600;margin-bottom:.5rem;"><i class="fas fa-building me-1"></i><%= l.perusahaan %></p>
                            <% if (l.lokasi) { %><p style="font-size:.8rem;color:var(--gray-600);margin-bottom:.5rem;"><i class="fas fa-map-marker-alt me-1"></i><%= l.lokasi %></p><% } %>
                            <% if (l.deskripsi) { %><p style="font-size:.85rem;color:var(--gray-600);line-height:1.5;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;"><%= l.deskripsi %></p><% } %>
                            <% if (l.kontak) { %>
                            <div class="mt-3">
                                <a href="<%= l.kontak.startsWith('http')?l.kontak:'https://wa.me/'+l.kontak.replace(/[^0-9]/g,'') %>" target="_blank" rel="noopener" style="background:#10b981;color:white;padding:.5rem 1.25rem;border-radius:50px;text-decoration:none;font-size:.85rem;font-weight:600;display:inline-block;">
                                    <i class="fas fa-paper-plane me-1"></i>Daftar Sekarang
                                </a>
                            </div>
                            <% } %>
                        </div>
                    </div>
                </div>
                <% }) %>
            </div>
            <% } %>
        </div>
    </section>
    <%- include('partials/footer') %>
    <script src="/assets/vendor/bootstrap5/bootstrap.bundle.min.js"></script>
    <script src="/assets/vendor/jquery3/jquery.min.js"></script>
    <script>$(window).scroll(function(){if($(window).scrollTop()>50)$('.navbar-modern').addClass('scrolled');else$('.navbar-modern').removeClass('scrolled');});</script>
</body>
</html>

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <% seoTitle = 'Galeri Foto'; seoDesc = 'Galeri foto dokumentasi kegiatan dan momen berharga SMK Negeri 1 Kras, Kediri, Jawa Timur.'; seoUrl = '/galeri'; %>
    <%- include('partials/_seo') %>

    <!-- Bootstrap CSS -->
    <link href="/assets/vendor/bootstrap5/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="/assets/vendor/fontawesome6/all.min.css" rel="stylesheet">
    <!-- Google Fonts -->    <!-- Dynamic Theme -->
    <link rel="stylesheet" href="/theme.css">
    
    <style>
        /* Color Variables - Same as home page */
        :root {
            --primary-blue: #0ea5e9;
            --primary-blue-dark: #0284c7;
            --primary-blue-light: #38bdf8;
            --secondary-blue: #0369a1;
            --accent-blue: #7dd3fc;
            --light-blue: #e0f2fe;
            --dark-blue: #0c4a6e;
            --gray-50: #f8fafc;
            --gray-100: #f1f5f9;
            --gray-200: #e2e8f0;
            --gray-300: #cbd5e1;
            --gray-400: #94a3b8;
            --gray-500: #64748b;
            --gray-600: #475569;
            --gray-700: #334155;
            --gray-800: #1e293b;
            --gray-900: #0f172a;
        }
        
        * { 
            font-family: 'Inter', sans-serif; 
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            line-height: 1.6;
            color: var(--gray-700);
        }
        
        /* Header & Navigation - Same as home page */
        .navbar-modern {
            background: rgba(255, 255, 255, 0.95) !important;
            backdrop-filter: blur(10px);
            box-shadow: 0 2px 20px rgba(14, 165, 233, 0.1);
            padding: 1rem 0;
            transition: all 0.3s ease;
        }
        .navbar-modern.scrolled {
            background: rgba(255, 255, 255, 0.98) !important;
            box-shadow: 0 4px 30px rgba(14, 165, 233, 0.15);
        }
        .navbar-brand { 
            font-weight: 700; 
            color: var(--primary-blue) !important; 
            font-size: 1.5rem;
            text-decoration: none;
        }
        .navbar-brand:hover {
            color: var(--primary-blue-dark) !important;
            text-decoration: none;
        }
        .navbar-toggler {
            border: none;
            padding: 0.25rem 0.5rem;
        }
        .navbar-toggler:focus {
            box-shadow: none;
        }
        .navbar-nav {
            align-items: center;
        }
        .nav-item {
            margin: 0 0.25rem;
        }
        .nav-link { 
            font-weight: 500; 
            color: var(--gray-600) !important; 
            padding: 0.75rem 1rem !important;
            border-radius: 8px;
            transition: all 0.3s ease;
            position: relative;
            text-decoration: none;
        }
        .nav-link:hover { 
            color: var(--primary-blue) !important;
            background-color: var(--light-blue);
            text-decoration: none;
        }
        .nav-link.active {
            color: var(--primary-blue) !important;
            background-color: var(--light-blue);
        }
        
        /* Page Header */
        .page-header {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--secondary-blue) 100%);
            padding: 5rem 0 2.5rem;
            color: white;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        .page-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000"><polygon fill="rgba(255,255,255,0.05)" points="0,1000 1000,0 1000,1000"/></svg>');
        }
        .page-title {
            font-size: 2.2rem;
            font-weight: 800;
            margin-bottom: 1rem;
            position: relative;
            z-index: 1;
        }
        .page-subtitle {
            font-size: 1.1rem;
            opacity: 0.9;
            position: relative;
            z-index: 1;
        }
        
        /* Content Section */
        .content-section {
            padding: 6rem 0;
            background: var(--gray-50);
        }
        
        /* Gallery Grid */
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            margin-bottom: 3rem;
        }
        .gallery-item {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(14, 165, 233, 0.08);
            transition: all 0.3s ease;
            border: 1px solid var(--gray-100);
            cursor: pointer;
        }
        .gallery-item:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(14, 165, 233, 0.15);
        }
        .gallery-image {
            width: 100%;
            height: 250px;
            object-fit: cover;
            transition: transform 0.3s ease;
        }
        .gallery-item:hover .gallery-image {
            transform: scale(1.05);
        }
        .gallery-content {
            padding: 1.5rem;
        }
        .gallery-title {
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--gray-800);
            margin-bottom: 0.5rem;
        }
        .gallery-description {
            color: var(--gray-600);
            font-size: 0.9rem;
            line-height: 1.5;
            margin-bottom: 1rem;
        }
        .gallery-category {
            display: inline-block;
            background: var(--light-blue);
            color: var(--primary-blue);
            padding: 0.25rem 0.75rem;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 500;
        }
        
        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            color: var(--gray-600);
        }
        .empty-state i {
            font-size: 4rem;
            margin-bottom: 2rem;
            color: var(--gray-300);
        }
        .empty-state h3 {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 1rem;
            color: var(--gray-700);
        }
        
        /* Modal */
        .modal-content {
            border-radius: 20px;
            border: none;
            overflow: hidden;
        }
        .modal-header {
            background: var(--primary-blue);
            color: white;
            border: none;
        }
        .modal-title {
            font-weight: 600;
        }
        .btn-close {
            filter: invert(1);
        }
        .modal-body {
            padding: 0;
        }
        .modal-image {
            width: 100%;
            height: auto;
            max-height: 70vh;
            object-fit: contain;
        }
        .modal-info {
            padding: 1.5rem;
        }
        
        /* Footer */
        .footer {
            background: var(--gray-900);
            color: white;
            padding: 4rem 0 2rem;
        }
        .footer-title {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
            color: white;
        }
        .footer-link {
            color: var(--gray-300);
            text-decoration: none;
            margin-bottom: 0.5rem;
            display: block;
            transition: color 0.3s ease;
        }
        .footer-link:hover {
            color: var(--accent-blue);
            text-decoration: none;
        }
        .footer-bottom {
            border-top: 1px solid var(--gray-700);
            margin-top: 3rem;
            padding-top: 2rem;
            text-align: center;
            color: var(--gray-400);
        }
        
        /* Responsive */
        @media (max-width: 991px) {
            .navbar-collapse {
                background: white;
                border-radius: 15px;
                box-shadow: 0 10px 30px rgba(0,0,0,0.1);
                margin-top: 1rem;
                padding: 1rem;
            }
            .nav-item {
                margin: 0.25rem 0;
            }
            .nav-link {
                padding: 0.75rem 1rem !important;
                border-radius: 8px;
            }
            .page-title { font-size: 2.5rem; }
            .gallery-grid {
                grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
                gap: 1.5rem;
            }
        }
        
        @media (max-width: 768px) {
            .page-title { font-size: 2rem; }
            .page-subtitle { font-size: 1rem; }
            .gallery-grid {
                grid-template-columns: 1fr;
                gap: 1rem;
            }
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <%- include('partials/navbar') %>

    <!-- Page Header -->
    <section class="page-header">
        <div class="container">
            <h1 class="page-title">Galeri Kegiatan</h1>
            <p class="page-subtitle">Dokumentasi kegiatan dan prestasi siswa-siswi kami</p>
        </div>
    </section>

    <!-- Content Section -->
    <section class="content-section">
        <div class="container">
            <% if (!albums || albums.length === 0) { %>
                <div class="empty-state">
                    <i class="fas fa-images"></i>
                    <h3>Belum Ada Foto</h3>
                    <p>Galeri foto kegiatan sekolah akan segera hadir di sini.</p>
                </div>
            <% } else { %>
                <div class="gallery-grid">
                    <% albums.forEach(function(album, index) { %>
                        <div class="gallery-item" data-bs-toggle="modal" data-bs-target="#albumModal<%= index %>">
                            <div style="position:relative;overflow:hidden;">
                                <img src="/uploads/<%= album.cover %>" alt="<%= album.judul %>" class="gallery-image">
                                <% if (album.fotos.length > 1) { %>
                                <span style="position:absolute;top:10px;right:10px;background:rgba(0,0,0,0.6);color:white;border-radius:20px;padding:3px 10px;font-size:0.8rem;">
                                    <i class="fas fa-images mr-1"></i><%= album.fotos.length %> foto
                                </span>
                                <% } %>
                            </div>
                            <div class="gallery-content">
                                <h3 class="gallery-title"><%= album.judul %></h3>
                                <% if (album.deskripsi) { %>
                                <p class="gallery-description" style="overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;">
                                        <%= (album.deskripsi || '').replace(/<[^>]*>/g, '') %>
                                    </p>
                                <% } %>
                                <% if (album.kategori) { %>
                                    <span class="gallery-category"><%= album.kategori %></span>
                                <% } %>
                            </div>
                        </div>

                        <!-- Modal Album -->
                        <div class="modal fade" id="albumModal<%= index %>" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title"><%= album.judul %></h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body p-3">
                                        <% if (album.deskripsi) { %><p class="text-muted mb-3"><%= (album.deskripsi || '').replace(/<[^>]*>/g, '') %></p><% } %>
                                        <div class="row g-2">
                                            <% album.fotos.forEach(function(foto) { %>
                                            <div class="col-6 col-md-4 col-lg-3">
                                                <a href="/uploads/<%= foto.gambar %>" data-lightbox="album-<%= index %>" data-title="<%= foto.judul %>">
                                                    <img src="/uploads/<%= foto.gambar %>" style="width:100%;height:150px;object-fit:cover;border-radius:8px;cursor:pointer;" alt="<%= foto.judul %>">
                                                </a>
                                            </div>
                                            <% }) %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </section>

    <link rel="stylesheet" href="/assets/vendor/lightbox2/lightbox.min.css">

    <!-- Footer -->
    <%- include('partials/related') %>
    <%- include('partials/footer') %>

    <!-- Bootstrap JS -->
    <script src="/assets/vendor/bootstrap5/bootstrap.bundle.min.js"></script>
    <!-- jQuery -->
    <script src="/assets/vendor/jquery3/jquery.min.js"></script>
    <script src="/assets/vendor/lightbox2/lightbox.min.js"></script>
    
    <script>
        // Navbar background on scroll
        $(window).scroll(function() {
            if ($(window).scrollTop() > 50) {
                $('.navbar-modern').addClass('scrolled');
            } else {
                $('.navbar-modern').removeClass('scrolled');
            }
        });
    </script>
</body>
</html>



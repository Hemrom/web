<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title><%= title %> - Website Sekolah</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
    <link rel="alternate icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><circle cx='16' cy='16' r='16' fill='%230ea5e9'/><rect x='8' y='18' width='16' height='3' rx='1' fill='white'/><polygon points='6,18 22,18 20,14 8,14' fill='white'/><circle cx='20' cy='16' r='1' fill='%230284c7'/><line x1='20' y1='17' x2='20' y2='22' stroke='%230284c7' stroke-width='1'/><circle cx='20' cy='22' r='1.5' fill='%230284c7'/><text x='16' y='28' text-anchor='middle' font-family='Arial' font-size='5' font-weight='bold' fill='white'>SMK</text></svg>">
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        /* Color Variables - Same as home page */
        :root {
            --primary-blue: #0ea5e9;
            --primary-blue-dark: #0284c7;
            --primary-blue-light: #38bdf8;
            --secondary-blue: #0369a1;
            --accent-blue: #7dd3fc;
            --light-blue: #e0f2fe;
            --dark-blue: #0c4a6e;
            --gray-50: #f8fafc;
            --gray-100: #f1f5f9;
            --gray-200: #e2e8f0;
            --gray-300: #cbd5e1;
            --gray-400: #94a3b8;
            --gray-500: #64748b;
            --gray-600: #475569;
            --gray-700: #334155;
            --gray-800: #1e293b;
            --gray-900: #0f172a;
        }
        
        * { 
            font-family: 'Inter', sans-serif; 
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            line-height: 1.6;
            color: var(--gray-700);
        }
        
        /* Header & Navigation - Same as home page */
        .navbar-modern {
            background: rgba(255, 255, 255, 0.95) !important;
            backdrop-filter: blur(10px);
            box-shadow: 0 2px 20px rgba(14, 165, 233, 0.1);
            padding: 1rem 0;
            transition: all 0.3s ease;
        }
        .navbar-modern.scrolled {
            background: rgba(255, 255, 255, 0.98) !important;
            box-shadow: 0 4px 30px rgba(14, 165, 233, 0.15);
        }
        .navbar-brand { 
            font-weight: 700; 
            color: var(--primary-blue) !important; 
            font-size: 1.5rem;
            text-decoration: none;
        }
        .navbar-brand:hover {
            color: var(--primary-blue-dark) !important;
            text-decoration: none;
        }
        .navbar-toggler {
            border: none;
            padding: 0.25rem 0.5rem;
        }
        .navbar-toggler:focus {
            box-shadow: none;
        }
        .navbar-nav {
            align-items: center;
        }
        .nav-item {
            margin: 0 0.25rem;
        }
        .nav-link { 
            font-weight: 500; 
            color: var(--gray-600) !important; 
            padding: 0.75rem 1rem !important;
            border-radius: 8px;
            transition: all 0.3s ease;
            position: relative;
            text-decoration: none;
        }
        .nav-link:hover { 
            color: var(--primary-blue) !important;
            background-color: var(--light-blue);
            text-decoration: none;
        }
        .nav-link.active {
            color: var(--primary-blue) !important;
            background-color: var(--light-blue);
        }
        
        /* Page Header */
        .page-header {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--secondary-blue) 100%);
            padding: 10rem 0 6rem;
            color: white;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        .page-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000"><polygon fill="rgba(255,255,255,0.05)" points="0,1000 1000,0 1000,1000"/></svg>');
        }
        .page-title {
            font-size: 3.5rem;
            font-weight: 800;
            margin-bottom: 1rem;
            position: relative;
            z-index: 1;
        }
        .page-subtitle {
            font-size: 1.3rem;
            opacity: 0.9;
            position: relative;
            z-index: 1;
        }
        
        /* Content Section */
        .content-section {
            padding: 6rem 0;
            background: var(--gray-50);
        }
        
        /* Gallery Grid */
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            margin-bottom: 3rem;
        }
        .gallery-item {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(14, 165, 233, 0.08);
            transition: all 0.3s ease;
            border: 1px solid var(--gray-100);
            cursor: pointer;
        }
        .gallery-item:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(14, 165, 233, 0.15);
        }
        .gallery-image {
            width: 100%;
            height: 250px;
            object-fit: cover;
            transition: transform 0.3s ease;
        }
        .gallery-item:hover .gallery-image {
            transform: scale(1.05);
        }
        .gallery-content {
            padding: 1.5rem;
        }
        .gallery-title {
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--gray-800);
            margin-bottom: 0.5rem;
        }
        .gallery-description {
            color: var(--gray-600);
            font-size: 0.9rem;
            line-height: 1.5;
            margin-bottom: 1rem;
        }
        .gallery-category {
            display: inline-block;
            background: var(--light-blue);
            color: var(--primary-blue);
            padding: 0.25rem 0.75rem;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 500;
        }
        
        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            color: var(--gray-600);
        }
        .empty-state i {
            font-size: 4rem;
            margin-bottom: 2rem;
            color: var(--gray-300);
        }
        .empty-state h3 {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 1rem;
            color: var(--gray-700);
        }
        
        /* Modal */
        .modal-content {
            border-radius: 20px;
            border: none;
            overflow: hidden;
        }
        .modal-header {
            background: var(--primary-blue);
            color: white;
            border: none;
        }
        .modal-title {
            font-weight: 600;
        }
        .btn-close {
            filter: invert(1);
        }
        .modal-body {
            padding: 0;
        }
        .modal-image {
            width: 100%;
            height: auto;
            max-height: 70vh;
            object-fit: contain;
        }
        .modal-info {
            padding: 1.5rem;
        }
        
        /* Footer */
        .footer {
            background: var(--gray-900);
            color: white;
            padding: 4rem 0 2rem;
        }
        .footer-title {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
            color: white;
        }
        .footer-link {
            color: var(--gray-300);
            text-decoration: none;
            margin-bottom: 0.5rem;
            display: block;
            transition: color 0.3s ease;
        }
        .footer-link:hover {
            color: var(--accent-blue);
            text-decoration: none;
        }
        .footer-bottom {
            border-top: 1px solid var(--gray-700);
            margin-top: 3rem;
            padding-top: 2rem;
            text-align: center;
            color: var(--gray-400);
        }
        
        /* Responsive */
        @media (max-width: 991px) {
            .navbar-collapse {
                background: white;
                border-radius: 15px;
                box-shadow: 0 10px 30px rgba(0,0,0,0.1);
                margin-top: 1rem;
                padding: 1rem;
            }
            .nav-item {
                margin: 0.25rem 0;
            }
            .nav-link {
                padding: 0.75rem 1rem !important;
                border-radius: 8px;
            }
            .page-title { font-size: 2.5rem; }
            .gallery-grid {
                grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
                gap: 1.5rem;
            }
        }
        
        @media (max-width: 768px) {
            .page-title { font-size: 2rem; }
            .page-subtitle { font-size: 1rem; }
            .gallery-grid {
                grid-template-columns: 1fr;
                gap: 1rem;
            }
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-modern fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="fas fa-graduation-cap me-2"></i>SMK Negeri 1 Kras
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Beranda</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/profil">Profil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/berita">Berita</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/galeri">Galeri</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/guru">Guru</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/media-sosial">Media Sosial</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/kontak">Kontak</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Page Header -->
    <section class="page-header">
        <div class="container">
            <h1 class="page-title">Galeri Kegiatan</h1>
            <p class="page-subtitle">Dokumentasi kegiatan dan prestasi siswa-siswi kami</p>
        </div>
    </section>

    <!-- Content Section -->
    <section class="content-section">
        <div class="container">
            <% if (galeri.length === 0) { %>
                <div class="empty-state">
                    <i class="fas fa-images"></i>
                    <h3>Belum Ada Foto</h3>
                    <p>Galeri foto kegiatan sekolah akan segera hadir di sini.</p>
                </div>
            <% } else { %>
                <div class="gallery-grid">
                    <% galeri.forEach((item, index) => { %>
                        <div class="gallery-item" data-bs-toggle="modal" data-bs-target="#galleryModal<%= index %>">
                            <img src="/uploads/<%= item.gambar %>" alt="<%= item.judul %>" class="gallery-image">
                            <div class="gallery-content">
                                <h3 class="gallery-title"><%= item.judul %></h3>
                                <% if (item.deskripsi) { %>
                                    <p class="gallery-description"><%= item.deskripsi %></p>
                                <% } %>
                                <% if (item.kategori) { %>
                                    <span class="gallery-category"><%= item.kategori %></span>
                                <% } %>
                            </div>
                        </div>
                        
                        <!-- Modal -->
                        <div class="modal fade" id="galleryModal<%= index %>" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-lg modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title"><%= item.judul %></h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <img src="/uploads/<%= item.gambar %>" alt="<%= item.judul %>" class="modal-image">
                                        <% if (item.deskripsi || item.kategori) { %>
                                            <div class="modal-info">
                                                <% if (item.deskripsi) { %>
                                                    <p class="mb-2"><%= item.deskripsi %></p>
                                                <% } %>
                                                <% if (item.kategori) { %>
                                                    <span class="gallery-category"><%= item.kategori %></span>
                                                <% } %>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 col-md-6 mb-4">
                    <h3 class="footer-title">SMK Negeri 1 Kras</h3>
                    <p class="text-muted">Memberikan pendidikan kejuruan berkualitas untuk menciptakan generasi yang cerdas, berkarakter, dan siap kerja.</p>
                </div>
                <div class="col-lg-2 col-md-6 mb-4">
                    <h4 class="footer-title">Menu</h4>
                    <a href="/" class="footer-link">Beranda</a>
                    <a href="/profil" class="footer-link">Profil</a>
                    <a href="/berita" class="footer-link">Berita</a>
                    <a href="/galeri" class="footer-link">Galeri</a>
                </div>
                <div class="col-lg-2 col-md-6 mb-4">
                    <h4 class="footer-title">Informasi</h4>
                    <a href="/guru" class="footer-link">Guru & Staff</a>
                    <a href="/kontak" class="footer-link">Kontak</a>
                </div>
                <div class="col-lg-4 col-md-6 mb-4">
                    <h4 class="footer-title">Kontak Kami</h4>
                    <p class="text-muted">
                        <i class="fas fa-map-marker-alt mr-2"></i>
                        Jl. Raya Kras, Kediri, Jawa Timur
                    </p>
                    <p class="text-muted">
                        <i class="fas fa-phone mr-2"></i>
                        (0354) 123456
                    </p>
                    <p class="text-muted">
                        <i class="fas fa-envelope mr-2"></i>
                        info@smkn1kras.sch.id
                    </p>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2024 SMK Negeri 1 Kras. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    
    <script>
        // Navbar background on scroll
        $(window).scroll(function() {
            if ($(window).scrollTop() > 50) {
                $('.navbar-modern').addClass('scrolled');
            } else {
                $('.navbar-modern').removeClass('scrolled');
            }
        });
    </script>
</body>
</html>
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <% seoTitle='Ekstrakurikuler'; seoDesc='Daftar lengkap ekstrakurikuler SMK Negeri 1 Kras: OSIS, Pramuka, PMR, Paskibraka, Olahraga, Seni, Bahasa Asing, ROHIS, PIK-R, Pencinta Alam, Pencak Silat.'; seoUrl='/ekstrakurikuler'; %>
    <%- include('partials/_seo') %>
    <link href="/assets/vendor/bootstrap5/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/vendor/fontawesome6/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/theme.css">
    <style>
        body { color: #334155; background: #f8fafc; }
        .page-header {
            background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 100%);
            padding: 5rem 0 2.5rem;
            color: white;
            text-align: center;
        }
        .section { padding: 5rem 0; }
        .ekskul-card {
            display: block;
            text-decoration: none;
            color: inherit;
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,.07);
            border: 1px solid #f1f5f9;
            transition: all .3s;
            height: 100%;
            cursor: pointer;
        }
        .ekskul-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 50px rgba(0,0,0,.15);
            color: inherit;
            text-decoration: none;
        }
        .ekskul-img {
            height: 220px;
            object-fit: cover;
            width: 100%;
            display: block;
        }
        .ekskul-placeholder {
            height: 220px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3.5rem;
            color: white;
        }
        .ekskul-body {
            padding: 1.5rem;
        }
        .ekskul-name {
            font-size: 1.15rem;
            font-weight: 800;
            color: #1e293b;
            margin-bottom: .3rem;
        }
        .ekskul-desc {
            font-size: .85rem;
            color: #64748b;
            margin-bottom: 1rem;
        }
        .ekskul-btn {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            font-size: .82rem;
            font-weight: 700;
            padding: .4rem .9rem;
            border-radius: 50px;
            color: white;
            border: none;
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <section class="page-header">
        <div class="container">
            <div style="display:inline-flex;align-items:center;gap:.5rem;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.3);color:#bfdbfe;padding:.4rem 1.2rem;border-radius:50px;font-size:.85rem;font-weight:700;margin-bottom:1.5rem;">
                <i class="fas fa-star"></i> SMKN 1 KRAS
            </div>
            <h1 style="font-size:clamp(2rem,5vw,3rem);font-weight:900;margin-bottom:.75rem;">Ekstrakurikuler</h1>
            <p style="opacity:.8;font-size:1rem;">Kembangkan bakat dan minatmu bersama kami</p>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <div class="row g-4">
                <% ekskul.forEach(function(e) { %>
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <a href="<%= e.url %>" class="ekskul-card">
                        <% if (e.foto) { %>
                        <img src="/uploads/<%= e.foto %>" class="ekskul-img" alt="<%= e.nama %>" loading="lazy" decoding="async" onerror="this.style.display='none'">
                        <% } else { %>
                        <div class="ekskul-placeholder" style="background:<%= e.warna %>;">
                            <i class="<%= e.icon %>"></i>
                        </div>
                        <% } %>
                        <div class="ekskul-body">
                            <div class="ekskul-name"><%= e.nama %></div>
                            <div class="ekskul-desc"><%= e.deskripsi %></div>
                            <span class="ekskul-btn" style="background:<%= e.warna %>;">
                                <i class="fas fa-arrow-right" style="font-size:.7rem;"></i> Lihat Detail
                            </span>
                        </div>
                    </a>
                </div>
                <% }) %>
            </div>
        </div>
    </section>

    <%- include('partials/footer') %>
    <script src="/assets/vendor/bootstrap5/bootstrap.bundle.min.js"></script>
    <script src="/assets/vendor/jquery3/jquery.min.js"></script>
    <script>
        $(window).scroll(function(){
            if($(window).scrollTop()>50) $('.navbar-modern').addClass('scrolled');
            else $('.navbar-modern').removeClass('scrolled');
        });
    </script>
</body>
</html>


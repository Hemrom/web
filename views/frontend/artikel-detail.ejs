<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <%
    const _artDesc = (artikel.ringkasan || (artikel.konten || '').replace(/<[^>]*>/g, '').replace(/\s+/g,' ').trim()).substring(0, 160);
    const _artImg  = artikel.gambar ? 'https://smknegeri1kras.sch.id/uploads/' + artikel.gambar : 'https://smknegeri1kras.sch.id/assets/img/logo-sekolah.png';
    const _artUrl  = 'https://smknegeri1kras.sch.id/artikel/' + artikel.slug;
    const _artDate = artikel.created_at ? new Date(artikel.created_at).toISOString() : '';
    %>
    <title><%= artikel.judul %> - SMKN 1 Kras</title>
    <meta name="description" content="<%= _artDesc %>">
    <meta name="robots" content="index, follow">
    <meta name="author" content="<%= artikel.penulis_nama || 'SMKN 1 Kras' %>">
    <link rel="canonical" href="<%= _artUrl %>">

    <!-- Open Graph -->
    <meta property="og:type" content="article">
    <meta property="og:url" content="<%= _artUrl %>">
    <meta property="og:title" content="<%= artikel.judul %> - SMKN 1 Kras">
    <meta property="og:description" content="<%= _artDesc %>">
    <meta property="og:image" content="<%= _artImg %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:site_name" content="SMKN 1 Kras">
    <meta property="og:locale" content="id_ID">
    <meta property="article:published_time" content="<%= _artDate %>">
    <meta property="article:section" content="<%= artikel.kategori || 'Artikel' %>">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= artikel.judul %> - SMKN 1 Kras">
    <meta name="twitter:description" content="<%= _artDesc %>">
    <meta name="twitter:image" content="<%= _artImg %>">

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "<%= artikel.judul.replace(/"/g, '&quot;') %>",
      "description": "<%= _artDesc.replace(/"/g, '&quot;') %>",
      "image": "<%= _artImg %>",
      "datePublished": "<%= _artDate %>",
      "author": {
        "@type": "Person",
        "name": "<%= (artikel.penulis_nama || 'SMKN 1 Kras').replace(/"/g, '&quot;') %>"
      },
      "publisher": {
        "@type": "Organization",
        "name": "SMK Negeri 1 Kras",
        "logo": {
          "@type": "ImageObject",
          "url": "https://smknegeri1kras.sch.id/assets/img/logo-sekolah.png"
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "<%= _artUrl %>"
      }
    }
    </script>

    <link rel="icon" type="image/png" href="/assets/img/favicon.png">
    <link href="/assets/vendor/bootstrap5/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/vendor/fontawesome6/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/theme.css">
    <style>
        :root {
            --primary-blue: #0ea5e9; --primary-blue-dark: #0284c7;
            --light-blue: #e0f2fe; --dark-blue: #0c4a6e;
            --gray-50: #f8fafc; --gray-100: #f1f5f9;
            --gray-500: #64748b; --gray-600: #475569; --gray-700: #334155;
            --gray-800: #1e293b; --gray-900: #0f172a;
        }
        * { font-family: 'Inter', sans-serif; box-sizing: border-box; }
        body { line-height: 1.6; color: var(--gray-700); background: var(--gray-50); }
        .navbar-modern { background: rgba(255,255,255,0.95) !important; backdrop-filter: blur(10px); box-shadow: 0 2px 20px rgba(14,165,233,0.1); padding: 1rem 0; transition: all 0.3s; }
        .navbar-modern.scrolled { box-shadow: 0 4px 30px rgba(14,165,233,0.15); }
        .navbar-brand { font-weight: 700; color: var(--primary-blue) !important; font-size: 1.5rem; text-decoration: none; }
        .nav-link { font-weight: 500; color: var(--gray-600) !important; padding: 0.75rem 1rem !important; border-radius: 8px; transition: all 0.3s; text-decoration: none; }
        .nav-link:hover, .nav-link.active { color: var(--primary-blue) !important; background: var(--light-blue); }
        .article-hero { background: linear-gradient(135deg, var(--primary-blue) 0%, var(--dark-blue) 100%); padding: 9rem 0 4rem; color: white; position: relative; overflow: hidden; }
        .article-hero::before { content: ''; position: absolute; inset: 0; background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000"><polygon fill="rgba(255,255,255,0.04)" points="0,1000 1000,0 1000,1000"/></svg>'); }
        .article-hero .container { position: relative; z-index: 1; }
        .article-category { display: inline-block; background: rgba(255,255,255,0.2); color: white; padding: 0.4rem 1rem; border-radius: 50px; font-size: 0.85rem; font-weight: 600; margin-bottom: 1rem; }
        .article-title { font-size: 2.5rem; font-weight: 800; line-height: 1.3; margin-bottom: 1.5rem; }
        .article-meta-hero { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; font-size: 0.9rem; opacity: 0.9; }
        .content-area { padding: 4rem 0; }
        .article-body { background: white; border-radius: 20px; padding: 3rem; box-shadow: 0 4px 20px rgba(0,0,0,0.06); }
        .article-cover { width: 100%; max-height: 450px; object-fit: cover; border-radius: 16px; margin-bottom: 2.5rem; }
        .article-body .content { font-size: 1.05rem; line-height: 1.9; color: var(--gray-700); }
        .article-body .content h1, .article-body .content h2, .article-body .content h3 { color: var(--gray-800); margin-top: 2rem; margin-bottom: 1rem; font-weight: 700; }
        .article-body .content img { max-width: 100%; border-radius: 12px; margin: 1.5rem auto; display: block; }
        .article-body .content p { margin-bottom: 1.25rem; }
        .article-body .content ul, .article-body .content ol { padding-left: 1.5rem; margin-bottom: 1.25rem; }
        .article-body .content blockquote { border-left: 4px solid var(--primary-blue); padding: 1rem 1.5rem; background: var(--light-blue); border-radius: 0 12px 12px 0; margin: 1.5rem 0; color: var(--gray-700); font-style: italic; }
        .sidebar-card { background: white; border-radius: 16px; padding: 1.75rem; box-shadow: 0 4px 20px rgba(0,0,0,0.06); margin-bottom: 1.5rem; }
        .sidebar-card h6 { font-weight: 700; color: var(--gray-800); margin-bottom: 1.25rem; padding-bottom: 0.75rem; border-bottom: 2px solid var(--light-blue); }
        .related-item { display: flex; gap: 0.75rem; padding: 0.75rem 0; border-bottom: 1px solid var(--gray-100); text-decoration: none; color: inherit; transition: all 0.2s; }
        .related-item:last-child { border-bottom: none; }
        .related-item:hover { color: var(--primary-blue); text-decoration: none; }
        .related-thumb { width: 60px; height: 50px; border-radius: 8px; object-fit: cover; flex-shrink: 0; background: var(--gray-100); }
        .related-title { font-size: 0.875rem; font-weight: 600; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .related-date { font-size: 0.75rem; color: var(--gray-500); margin-top: 0.25rem; }
        .share-btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1.25rem; border-radius: 50px; font-size: 0.875rem; font-weight: 600; text-decoration: none; transition: all 0.2s; }
        .share-btn:hover { transform: translateY(-2px); text-decoration: none; }
        .footer { background: var(--gray-900); color: white; padding: 4rem 0 2rem; }
        .footer-title { font-size: 1.1rem; font-weight: 600; margin-bottom: 1.25rem; color: white; }
        .footer-link { color: rgba(255,255,255,0.7); text-decoration: none; margin-bottom: 0.5rem; display: block; transition: color 0.3s; }
        .footer-link:hover { color: #7dd3fc; text-decoration: none; }
        @media (max-width: 991px) { .navbar-collapse { background: white; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); margin-top: 1rem; padding: 1rem; } .article-title { font-size: 1.8rem; } }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <section class="article-hero">
        <div class="container">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb" style="background:none;padding:0;margin:0;">
                    <li class="breadcrumb-item"><a href="/" style="color:rgba(255,255,255,0.7);text-decoration:none;">Beranda</a></li>
                    <li class="breadcrumb-item"><a href="/artikel" style="color:rgba(255,255,255,0.7);text-decoration:none;">Artikel</a></li>
                    <li class="breadcrumb-item active" style="color:white;">Detail</li>
                </ol>
            </nav>
            <span class="article-category"><%= artikel.kategori %></span>
            <h1 class="article-title"><%= artikel.judul %></h1>
            <div class="article-meta-hero">
                <span><i class="fas fa-user-circle me-1"></i><%= artikel.penulis_nama || 'Admin' %></span>
                <span><i class="fas fa-calendar me-1"></i><%= new Date(artikel.created_at).toLocaleDateString('id-ID', {weekday:'long',day:'numeric',month:'long',year:'numeric'}) %></span>
                <span><i class="fas fa-eye me-1"></i><%= artikel.views %> views</span>
            </div>
        </div>
    </section>

    <section class="content-area">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="article-body">
                        <% if (artikel.gambar) { %>
                        <img src="/uploads/<%= artikel.gambar %>" alt="<%= artikel.judul %>" class="article-cover">
                        <% } %>
                        <div class="content"><%- artikel.konten %></div>
                        <% shareTitle = artikel.judul; shareUrl = '/artikel/' + artikel.slug; %>
                        <%- include('partials/share-buttons') %>
                    </div>
                    <div class="mt-3">
                        <a href="/artikel" class="btn btn-outline-primary rounded-pill"><i class="fas fa-arrow-left me-2"></i>Kembali ke Artikel</a>
                    </div>
                </div>
                <div class="col-lg-4">
                    <% if (related.length) { %>
                    <div class="sidebar-card">
                        <h6><i class="fas fa-newspaper text-primary me-2"></i>Artikel Terkait</h6>
                        <% related.forEach(r => { %>
                        <a href="/artikel/<%= r.slug %>" class="related-item">
                            <% if (r.gambar) { %>
                            <img src="/uploads/<%= r.gambar %>" class="related-thumb" alt="<%= r.judul %>">
                            <% } else { %>
                            <div class="related-thumb d-flex align-items-center justify-content-center"><i class="fas fa-file-alt text-muted"></i></div>
                            <% } %>
                            <div>
                                <div class="related-title"><%= r.judul %></div>
                                <div class="related-date"><%= new Date(r.created_at).toLocaleDateString('id-ID', {day:'numeric',month:'short',year:'numeric'}) %></div>
                            </div>
                        </a>
                        <% }) %>
                    </div>
                    <% } %>
                    <div class="sidebar-card">
                        <h6><i class="fas fa-download text-primary me-2"></i>File Download</h6>
                        <p class="small text-muted">Unduh materi dan dokumen yang tersedia.</p>
                        <a href="/file-download" class="btn btn-primary btn-sm rounded-pill w-100"><i class="fas fa-folder-open me-1"></i>Lihat Semua File</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <%- include('partials/footer') %>
    <script src="/assets/vendor/bootstrap5/bootstrap.bundle.min.js"></script>
    <script src="/assets/vendor/jquery3/jquery.min.js"></script>
    <script>
        $(window).scroll(function() {
            if ($(window).scrollTop() > 50) $('.navbar-modern').addClass('scrolled');
            else $('.navbar-modern').removeClass('scrolled');
        });
    </script>
</body>
</html>


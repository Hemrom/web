<%
  // Variabel yang dibutuhkan:
  // - beritaSidebar, artikelSidebar, agendaSidebar (dari controller)
  // - title (judul halaman, untuk share)
  // - reqUrl (req.path, untuk share URL)
%>
<style>
.sidebar-widget { background: white; border-radius: 20px; padding: 1.5rem; box-shadow: 0 4px 20px rgba(14,165,233,.08); border: 1px solid #f1f5f9; margin-bottom: 1.5rem; }
.widget-title { font-size: 1.05rem; font-weight: 800; color: #1e293b; margin-bottom: 1.25rem; padding-bottom: .75rem; border-bottom: 2px solid #e0f2fe; display: flex; align-items: center; gap: .5rem; }
.widget-title span { color: #0ea5e9; }
.sw-slider-wrap { position: relative; overflow: hidden; border-radius: 14px; }
.sw-slider-track { display: flex; transition: transform .4s ease; }
.sw-slide { flex: 0 0 100%; position: relative; }
.sw-slide img { width: 100%; height: 180px; object-fit: cover; display: block; }
.sw-slide-placeholder { width: 100%; height: 180px; display: flex; align-items: center; justify-content: center; color: white; font-size: 2rem; }
.sw-slide-caption { position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(to top, rgba(0,0,0,.75) 0%, transparent 100%); padding: 1rem .75rem .75rem; }
.sw-slide-caption a { color: white; font-size: .82rem; font-weight: 600; text-decoration: none; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.sw-slide-caption a:hover { color: #bfdbfe; }
.sw-slide-date { font-size: .72rem; color: rgba(255,255,255,.75); margin-top: .2rem; }
.sw-dots { display: flex; justify-content: center; gap: 6px; margin-top: .75rem; }
.sw-dot { width: 8px; height: 8px; border-radius: 50%; background: #e2e8f0; cursor: pointer; transition: all .2s; border: none; padding: 0; }
.sw-dot.active { background: #0ea5e9; transform: scale(1.3); }
.sw-artikel-item { display: flex; gap: .75rem; padding: .75rem 0; border-bottom: 1px solid #f1f5f9; text-decoration: none; color: inherit; transition: all .2s; }
.sw-artikel-item:last-child { border-bottom: none; }
.sw-artikel-item:hover { color: #0ea5e9; }
.sw-artikel-item img { width: 65px; height: 50px; object-fit: cover; border-radius: 8px; flex-shrink: 0; }
.sw-artikel-placeholder { width: 65px; height: 50px; border-radius: 8px; background: #e0f2fe; display: flex; align-items: center; justify-content: center; color: #0ea5e9; flex-shrink: 0; }
.sw-artikel-title { font-size: .83rem; font-weight: 600; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.sw-artikel-date { font-size: .73rem; color: #94a3b8; margin-top: .2rem; }
/* Share buttons */
.share-box { background: white; border-radius: 20px; padding: 1.25rem 1.5rem; box-shadow: 0 4px 20px rgba(14,165,233,.08); border: 1px solid #f1f5f9; margin-bottom: 1.5rem; }
.share-title { font-size: .9rem; font-weight: 700; color: #64748b; margin-bottom: .75rem; }
.share-btns { display: flex; gap: .5rem; flex-wrap: wrap; }
.share-btn-sidebar { display: inline-flex; align-items: center; gap: .4rem; padding: .45rem 1rem; border-radius: 50px; font-size: .78rem; font-weight: 700; text-decoration: none; transition: all .2s; border: none; cursor: pointer; }
.share-btn-sidebar:hover { transform: translateY(-2px); opacity: .9; }
.share-wa-s { background: #25D366; color: white; }
.share-fb-s { background: #1877F2; color: white; }
.share-tw-s { background: #000; color: white; }
.share-copy-s { background: #f1f5f9; color: #475569; }
</style>

<!-- Share -->
<div class="share-box">
    <div class="share-title"><i class="fas fa-share-alt me-1"></i> Bagikan Halaman Ini</div>
    <div class="share-btns">
        <a href="https://wa.me/?text=<%= encodeURIComponent(typeof title !== 'undefined' ? title : 'Info Sekolah') %>%20<%= encodeURIComponent('https://smknegeri1kras.sch.id' + (typeof reqUrl !== 'undefined' ? reqUrl : '')) %>" target="_blank" rel="noopener" class="share-btn-sidebar share-wa-s"><i class="fab fa-whatsapp"></i> WhatsApp</a>
        <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent('https://smknegeri1kras.sch.id' + (typeof reqUrl !== 'undefined' ? reqUrl : '')) %>" target="_blank" rel="noopener" class="share-btn-sidebar share-fb-s"><i class="fab fa-facebook-f"></i> Facebook</a>
        <a href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(typeof title !== 'undefined' ? title : 'Info Sekolah') %>&url=<%= encodeURIComponent('https://smknegeri1kras.sch.id' + (typeof reqUrl !== 'undefined' ? reqUrl : '')) %>" target="_blank" rel="noopener" class="share-btn-sidebar share-tw-s"><span style="font-weight:900;">X</span></a>
        <button onclick="navigator.clipboard.writeText(window.location.href).then(function(){alert('Link disalin!')}).catch(function(){alert('Link: '+window.location.href)})" class="share-btn-sidebar share-copy-s"><i class="fas fa-link"></i> Salin Link</button>
    </div>
</div>

<div class="row g-4">

<!-- Slider Berita -->
<% if (typeof beritaSidebar !== 'undefined' && beritaSidebar && beritaSidebar.length > 0) { %>
<div class="col-lg-4 col-md-6">
<div class="sidebar-widget">
    <div class="widget-title"><i class="fas fa-newspaper" style="color:#0ea5e9"></i> Berita <span>Terbaru</span></div>
    <div class="sw-slider-wrap">
        <div class="sw-slider-track" id="swBeritaTrack">
            <% beritaSidebar.forEach(function(b) { %>
            <div class="sw-slide">
                <% if (b.gambar) { %><img src="/uploads/<%= b.gambar %>" alt="<%= b.judul %>" loading="lazy">
                <% } else { %><div class="sw-slide-placeholder" style="background:linear-gradient(135deg,#0ea5e9,#0369a1);"><i class="fas fa-newspaper"></i></div><% } %>
                <div class="sw-slide-caption">
                    <a href="/berita/<%= b.slug %>"><%= b.judul %></a>
                    <div class="sw-slide-date"><i class="fas fa-calendar-alt me-1"></i><%= new Date(b.created_at).toLocaleDateString('id-ID', {day:'numeric',month:'short',year:'numeric'}) %></div>
                </div>
            </div>
            <% }) %>
        </div>
        <div class="sw-dots" id="swBeritaDots">
            <% beritaSidebar.forEach(function(b, i) { %><button class="sw-dot <%= i===0?'active':'' %>" onclick="swGoBerita(<%= i %>)"></button><% }) %>
        </div>
    </div>
    <div class="text-center mt-3"><a href="/berita" style="font-size:.82rem;color:#0ea5e9;font-weight:700;text-decoration:none;">Lihat Semua Berita <i class="fas fa-arrow-right"></i></a></div>
</div>
</div>
<% } %>

<!-- Slider Agenda -->
<% if (typeof agendaSidebar !== 'undefined' && agendaSidebar && agendaSidebar.length > 0) { %>
<div class="col-lg-4 col-md-6">
<div class="sidebar-widget">
    <div class="widget-title"><i class="fas fa-calendar-check" style="color:#0ea5e9"></i> Agenda <span>Sekolah</span></div>
    <div class="sw-slider-wrap">
        <div class="sw-slider-track" id="swAgendaTrack">
            <% agendaSidebar.forEach(function(a) { %>
            <div class="sw-slide">
                <% if (a.gambar) { %><img src="/uploads/<%= a.gambar %>" alt="<%= a.judul %>" loading="lazy">
                <% } else { %><div class="sw-slide-placeholder" style="background:linear-gradient(135deg,#f59e0b,#ef4444);"><i class="fas fa-calendar-alt"></i></div><% } %>
                <div class="sw-slide-caption">
                    <a href="/agenda/<%= a.slug %>"><%= a.judul %></a>
                    <div class="sw-slide-date"><i class="fas fa-calendar-alt me-1"></i><%= a.tanggal_mulai ? a.tanggal_mulai.toString().substring(0,10) : '' %></div>
                </div>
            </div>
            <% }) %>
        </div>
        <div class="sw-dots" id="swAgendaDots">
            <% agendaSidebar.forEach(function(a, i) { %><button class="sw-dot <%= i===0?'active':'' %>" onclick="swGoAgenda(<%= i %>)"></button><% }) %>
        </div>
    </div>
    <div class="text-center mt-3"><a href="/agenda" style="font-size:.82rem;color:#0ea5e9;font-weight:700;text-decoration:none;">Lihat Semua Agenda <i class="fas fa-arrow-right"></i></a></div>
</div>
</div>
<% } %>

<!-- List Artikel -->
<% if (typeof artikelSidebar !== 'undefined' && artikelSidebar && artikelSidebar.length > 0) { %>
<div class="col-lg-4 col-md-6">
<div class="sidebar-widget">
    <div class="widget-title"><i class="fas fa-pen-nib" style="color:#0ea5e9"></i> Artikel <span>Sekolah</span></div>
    <% artikelSidebar.forEach(function(a) { %>
    <a href="/artikel/<%= a.slug %>" class="sw-artikel-item">
        <% if (a.gambar) { %><img src="/uploads/<%= a.gambar %>" alt="<%= a.judul %>" loading="lazy">
        <% } else { %><div class="sw-artikel-placeholder"><i class="fas fa-pen-nib"></i></div><% } %>
        <div>
            <div class="sw-artikel-title"><%= a.judul %></div>
            <div class="sw-artikel-date"><i class="fas fa-calendar-alt me-1"></i><%= new Date(a.created_at).toLocaleDateString('id-ID', {day:'numeric',month:'short',year:'numeric'}) %></div>
        </div>
    </a>
    <% }) %>
    <div class="text-center mt-3"><a href="/artikel" style="font-size:.82rem;color:#0ea5e9;font-weight:700;text-decoration:none;">Lihat Semua Artikel <i class="fas fa-arrow-right"></i></a></div>
</div>
</div>
<% } %>

</div><!-- end row -->

<script>
(function(){
    var _swBeritaCur = 0, _swAgendaCur = 0;
    function _swGo(trackId, dotsId, n, curRef) {
        var t = document.getElementById(trackId);
        if (t) t.style.transform = 'translateX(-' + (n * 100) + '%)';
        var dots = document.getElementById(dotsId);
        if (dots) dots.querySelectorAll('.sw-dot').forEach(function(d, i){ d.classList.toggle('active', i === n); });
        return n;
    }
    window.swGoBerita = function(n) { _swBeritaCur = _swGo('swBeritaTrack', 'swBeritaDots', n); };
    window.swGoAgenda = function(n) { _swAgendaCur = _swGo('swAgendaTrack', 'swAgendaDots', n); };
    var _bTotal = <%= typeof beritaSidebar !== 'undefined' && beritaSidebar ? beritaSidebar.length : 0 %>;
    var _aTotal = <%= typeof agendaSidebar !== 'undefined' && agendaSidebar ? agendaSidebar.length : 0 %>;
    if (_bTotal > 1) setInterval(function(){ _swBeritaCur = (_swBeritaCur + 1) % _bTotal; window.swGoBerita(_swBeritaCur); }, 4000);
    if (_aTotal > 1) setInterval(function(){ _swAgendaCur = (_swAgendaCur + 1) % _aTotal; window.swGoAgenda(_swAgendaCur); }, 5000);
})();
</script>

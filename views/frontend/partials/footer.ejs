<footer class="footer">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 col-md-6 mb-4">
                <h3 class="footer-title"><%= profil.nama_sekolah || 'Sekolah Kita' %></h3>
                <p style="font-size:0.9rem;color:#fff;">Memberikan pendidikan berkualitas untuk menciptakan generasi yang cerdas dan berkarakter.</p>
                <div class="footer-sosmed mt-3">
                    <%
                        const sosmedList = [
                            { platform: 'instagram', icon: 'fa-instagram', label: 'Instagram', color: '#E1306C', bg: 'linear-gradient(45deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888)' },
                            { platform: 'youtube',   icon: 'fa-youtube',   label: 'YouTube',   color: '#FF0000', bg: '#FF0000' },
                            { platform: 'facebook',  icon: 'fa-facebook-f',label: 'Facebook',  color: '#1877F2', bg: '#1877F2' },
                            { platform: 'tiktok',    icon: 'fa-tiktok',    label: 'TikTok',    color: '#010101', bg: '#010101' },
                            { platform: 'twitter',   icon: 'fa-x-twitter', label: 'X/Twitter', color: '#000000', bg: '#000000' },
                            { platform: 'threads',   icon: 'fa-threads',   label: 'Threads',   color: '#101010', bg: '#101010' },
                        ];
                        const activeMap = {};
                        if (mediaSosialFooter) {
                            mediaSosialFooter.forEach(function(ms) { activeMap[ms.platform] = ms; });
                        }
                    %>
                    <% sosmedList.forEach(function(s) { %>
                        <% const active = activeMap[s.platform]; %>
                        <a href="<%= active ? active.embed_url : '#' %>"
                           target="<%= active ? '_blank' : '_self' %>"
                           rel="noopener"
                           title="<%= active ? active.judul : s.label %>"
                           class="footer-sosmed-btn <%= active ? '' : 'inactive' %>"
                           style="background:<%= s.bg %>;">
                            <i class="fab <%= s.icon %>"></i>
                        </a>
                    <% }) %>
                </div>
                <style>
                .footer-sosmed { display:flex; flex-wrap:wrap; gap:10px; margin-top:1rem; }
                .footer-sosmed-btn {
                    display:inline-flex; align-items:center; justify-content:center;
                    width:44px; height:44px; border-radius:12px;
                    color:white; font-size:1.25rem;
                    text-decoration:none; transition:transform 0.2s, opacity 0.2s;
                    box-shadow: 0 2px 8px rgba(0,0,0,0.3);
                }
                .footer-sosmed-btn:hover { transform:translateY(-3px); opacity:0.9; color:white; text-decoration:none; }
                .footer-sosmed-btn.inactive { opacity:0.35; cursor:default; }
                .footer-sosmed-btn.inactive:hover { transform:none; opacity:0.35; }
                </style>
            </div>
            <div class="col-lg-2 col-md-6 mb-4">
                <h4 class="footer-title">Menu</h4>
                <a href="/" class="footer-link">Beranda</a>
                <a href="/profil" class="footer-link">Profil</a>
                <a href="/berita" class="footer-link">Berita</a>
                <a href="/galeri" class="footer-link">Galeri</a>
            </div>
            <div class="col-lg-2 col-md-6 mb-4">
                <h4 class="footer-title">Informasi</h4>
                <a href="/guru" class="footer-link">Guru & Staff</a>
                <a href="/kontak" class="footer-link">Kontak</a>
                <a href="/media-sosial" class="footer-link">Media Sosial</a>
            </div>
            <div class="col-lg-4 col-md-6 mb-4 text-right">
                <h4 class="footer-title">Kontak Kami</h4>
                <% if (profil.alamat) { %>
                <p class="mb-1" style="color:#fff;font-size:0.9rem;">
                    <%= profil.alamat %> <i class="fas fa-map-marker-alt ml-2"></i>
                </p>
                <% } %>
                <% if (profil.telepon) { %>
                <p class="mb-1" style="color:#fff;font-size:0.9rem;">
                    <%= profil.telepon %> <i class="fas fa-phone ml-2"></i>
                </p>
                <% } %>
                <% if (profil.whatsapp) { %>
                <a href="https://wa.me/<%= profil.whatsapp.replace(/[^0-9]/g, '') %>" target="_blank" rel="noopener" class="wa-btn mb-2">
                    <span class="wa-icon"><i class="fab fa-whatsapp"></i></span>
                    <span class="wa-text">
                        <span class="wa-label">Chat WhatsApp</span>
                        <span class="wa-number"><%= profil.whatsapp %></span>
                    </span>
                </a>
                <style>
                .wa-btn {
                    display:inline-flex; align-items:center; gap:10px;
                    background:linear-gradient(135deg,#25d366,#128c7e);
                    color:white; text-decoration:none;
                    padding:10px 16px; border-radius:50px;
                    box-shadow:0 4px 15px rgba(37,211,102,0.35);
                    transition:transform 0.2s, box-shadow 0.2s;
                    max-width:100%;
                }
                .wa-btn:hover { transform:translateY(-2px); box-shadow:0 6px 20px rgba(37,211,102,0.5); color:white; text-decoration:none; }
                .wa-icon { font-size:1.6rem; line-height:1; flex-shrink:0; }
                .wa-text { display:flex; flex-direction:column; line-height:1.3; }
                .wa-label { font-size:0.7rem; opacity:0.85; font-weight:500; }
                .wa-number { font-size:0.9rem; font-weight:700; }
                </style>
                <% } %>
                <% if (profil.email) { %>
                <p class="mb-1" style="color:#fff;font-size:0.9rem;">
                    <%= profil.email %> <i class="fas fa-envelope ml-2"></i>
                </p>
                <% } %>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; <%= new Date().getFullYear() %> <%= profil.nama_sekolah || 'Website Sekolah' %>. All rights reserved.</p>
        </div>
    </div>
</footer>

<%- include('mobile-nav') %>

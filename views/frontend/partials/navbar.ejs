<!-- Navigation -->
<nav class="navbar navbar-expand-lg navbar-modern fixed-top">
    <div class="container">
        <a class="navbar-brand" href="/">
            <img src="/uploads/logo-sekolah.png" alt="Logo" style="height:36px;width:36px;object-fit:contain;margin-right:8px;vertical-align:middle;" onerror="this.style.display='none'"><%= typeof profil !== 'undefined' && profil && profil.nama_sekolah ? profil.nama_sekolah.toUpperCase() : 'SMKN 1 KRAS' %>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <% if (typeof menuItems !== 'undefined' && menuItems.length > 0) { %>
                    <% menuItems.forEach(function(item) { %>
                        <% if (item.children && item.children.length > 0) { %>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle <%= typeof currentPage !== 'undefined' && currentPage === item.url.replace('/','') ? 'active' : '' %>"
                               href="<%= item.url %>"
                               id="dropdown-<%= item.id %>"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false"
                               <% if (item.target === '_blank') { %>target="_blank" rel="noopener noreferrer"<% } %>>
                                <% if (item.icon) { %><i class="<%= item.icon %> me-1"></i><% } %>
                                <%= item.label %>
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="dropdown-<%= item.id %>">
                                <% item.children.forEach(function(child) { %>
                                <% if (child.children && child.children.length > 0) { %>
                                <li class="dropdown-submenu">
                                    <a class="dropdown-item" href="<%= child.url %>"
                                       <% if (child.target === '_blank') { %>target="_blank" rel="noopener noreferrer"<% } %>>
                                        <% if (child.icon) { %><i class="<%= child.icon %> me-1"></i><% } %>
                                        <%= child.label %>
                                    </a>
                                    <ul class="dropdown-menu dropdown-submenu-menu">
                                        <% child.children.forEach(function(grandchild) { %>
                                        <li>
                                            <a class="dropdown-item" href="<%= grandchild.url %>"
                                               <% if (grandchild.target === '_blank') { %>target="_blank" rel="noopener noreferrer"<% } %>>
                                                <% if (grandchild.icon) { %><i class="<%= grandchild.icon %> me-1"></i><% } %>
                                                <%= grandchild.label %>
                                            </a>
                                        </li>
                                        <% }) %>
                                    </ul>
                                </li>
                                <% } else { %>
                                <li>
                                    <a class="dropdown-item"
                                       href="<%= child.url %>"
                                       <% if (child.target === '_blank') { %>target="_blank" rel="noopener noreferrer"<% } %>>
                                        <% if (child.icon) { %><i class="<%= child.icon %> me-1"></i><% } %>
                                        <%= child.label %>
                                    </a>
                                </li>
                                <% } %>
                                <% }) %>
                            </ul>
                        </li>
                        <% } else { %>
                        <li class="nav-item">
                            <a class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === item.url.replace('/','') ? 'active' : '' %>"
                               href="<%= item.url %>"
                               <% if (item.target === '_blank') { %>target="_blank" rel="noopener noreferrer"<% } %>>
                                <% if (item.icon) { %><i class="<%= item.icon %> me-1"></i><% } %>
                                <%= item.label %>
                            </a>
                        </li>
                        <% } %>
                    <% }) %>
                <% } %>
            </ul>
        </div>
    </div>
</nav>

<style>
.navbar-modern {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    box-shadow: 0 2px 20px rgba(0,0,0,0.1);
    padding: 1rem 0;
    transition: all 0.3s ease;
}
.navbar-modern.scrolled {
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 4px 30px rgba(0,0,0,0.15);
}
.navbar-brand { 
    font-weight: 700; 
    color: #2563eb !important; 
    font-size: 1.5rem;
    text-decoration: none;
}
.navbar-brand:hover {
    color: #1d4ed8 !important;
    text-decoration: none;
}
.navbar-toggler { border: none; padding: 0.25rem 0.5rem; }
.navbar-toggler:focus { box-shadow: none; }
.navbar-toggler-icon {
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%2837, 65, 81, 0.75%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='m4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
}
.navbar-nav { align-items: center; }
.nav-item { margin: 0 0.25rem; }
.nav-link { 
    font-weight: 500; 
    color: #374151 !important; 
    padding: 0.75rem 1rem !important;
    border-radius: 8px;
    transition: all 0.3s ease;
    text-decoration: none;
}
.nav-link:hover, .nav-link.active { 
    color: #2563eb !important;
    background-color: rgba(37, 99, 235, 0.1);
    text-decoration: none;
}
.dropdown-menu {
    border: none;
    box-shadow: 0 8px 25px rgba(0,0,0,0.12);
    border-radius: 12px;
    padding: 0.5rem;
}
.dropdown-item {
    border-radius: 8px;
    padding: 0.6rem 1rem;
    font-weight: 500;
    color: #374151;
    transition: all 0.2s ease;
}
.dropdown-item:hover {
    background-color: rgba(37, 99, 235, 0.08);
    color: #2563eb;
}
/* Submenu bertingkat */
.dropdown-submenu { position: relative; }
.dropdown-submenu-menu {
    display: none;
    position: absolute;
    left: 100%;
    top: 0;
    min-width: 200px;
    border: none;
    box-shadow: 0 8px 25px rgba(0,0,0,0.12);
    border-radius: 12px;
    padding: 0.5rem;
}
.dropdown-submenu:hover > .dropdown-submenu-menu { display: block; }
.dropdown-submenu > .dropdown-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.dropdown-submenu > .dropdown-item::after {
    content: '\f054';
    font-family: 'Font Awesome 6 Free';
    font-weight: 900;
    font-size: 0.65rem;
    color: #94a3b8;
    border: none;
    margin: 0;
    vertical-align: middle;
}
/* Hilangkan tanda bawaan Bootstrap pada dropdown-toggle di dalam submenu */
.dropdown-submenu > .dropdown-item.dropdown-toggle::before { display: none; }
@media (max-width: 991px) {
    .navbar-collapse {
        background: white;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        margin-top: 1rem;
        padding: 1rem;
        max-height: 75vh;
        overflow-y: auto;
    }
    .nav-item { margin: 0.25rem 0; }
    .nav-link { padding: 0.75rem 1rem !important; border-radius: 8px; }
    .dropdown-menu { position: static !important; box-shadow: none; padding-left: 1rem; }
}
</style>

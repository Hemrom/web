<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title><%= title %> - Website Sekolah</title>
    <link rel="icon" type="image/png" href="/uploads/logo-sekolah.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-blue: #0ea5e9;
            --primary-blue-dark: #0284c7;
            --secondary-blue: #0369a1;
            --light-blue: #e0f2fe;
            --gray-50: #f8fafc;
            --gray-100: #f1f5f9;
            --gray-600: #475569;
            --gray-700: #334155;
            --gray-800: #1e293b;
            --gray-900: #0f172a;
            --gray-300: #cbd5e1;
            --gray-400: #94a3b8;
            --accent-blue: #7dd3fc;
        }
        * { font-family: 'Inter', sans-serif; margin: 0; padding: 0; box-sizing: border-box; }
        body { line-height: 1.6; color: var(--gray-700); }
        .page-header {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--secondary-blue) 100%);
            padding: 10rem 0 4rem;
            color: white;
            text-align: center;
        }
        .page-title { font-size: 3rem; font-weight: 800; margin-bottom: 0.5rem; }
        .content-section { padding: 5rem 0; background: var(--gray-50); }
        .content-card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(14,165,233,0.08);
            padding: 3rem;
        }
        .content-card img.halaman-foto { max-width: 300px; border-radius: 12px; margin-bottom: 2rem; }
        .footer { background: var(--gray-900); color: white; padding: 4rem 0 2rem; }
        .footer-title { font-size: 1.25rem; font-weight: 600; margin-bottom: 1.5rem; }
        .footer-link { color: var(--gray-300); text-decoration: none; margin-bottom: 0.5rem; display: block; }
        .footer-link:hover { color: var(--accent-blue); }
        .footer-bottom { border-top: 1px solid #334155; margin-top: 3rem; padding-top: 2rem; text-align: center; color: var(--gray-400); }
        @media (max-width: 991px) { .page-title { font-size: 2rem; } }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <section class="page-header">
        <div class="container">
            <h1 class="page-title"><%= halaman.judul %></h1>
        </div>
    </section>

    <section class="content-section">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-9">
                    <div class="content-card">
                        <% if (halaman.foto) { %>
                        <div class="text-center">
                            <img src="/uploads/<%= halaman.foto %>" class="halaman-foto" alt="<%= halaman.judul %>">
                        </div>
                        <% } %>
                        <%- halaman.konten %>
                    </div>

                    <% if (embeds && embeds.length > 0) { %>
                    <div style="margin-top:2.5rem;">
                        <h3 style="font-size:1.4rem;font-weight:700;color:#1e293b;margin-bottom:1.2rem;">
                            <i class="fas fa-share-alt mr-2" style="color:var(--primary-blue,#0ea5e9);"></i>Media Sosial
                        </h3>
                        <div class="row">
                            <% embeds.forEach(function(e) { %>
                            <div class="col-md-6 mb-4">
                                <% if (e.judul) { %><p style="font-weight:600;color:#1e293b;margin-bottom:0.5rem;"><%= e.judul %></p><% } %>
                                <% if (e.platform === 'youtube') { %>
                                    <% const ytMatch = e.embed_url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&\n?#]+)/); %>
                                    <% const ytId = ytMatch ? ytMatch[1] : e.embed_url; %>
                                    <div style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;border-radius:12px;">
                                        <iframe src="https://www.youtube.com/embed/<%= ytId %>" style="position:absolute;top:0;left:0;width:100%;height:100%;border:0;" allowfullscreen></iframe>
                                    </div>
                                <% } else if (e.platform === 'instagram') { %>
                                    <% const igMatch = e.embed_url.match(/instagram\.com\/(?:p|reel)\/([^\/]+)/); %>
                                    <% const igId = igMatch ? igMatch[1] : ''; %>
                                    <div style="border-radius:12px;overflow:hidden;">
                                        <iframe src="https://www.instagram.com/p/<%= igId %>/embed/" style="width:100%;min-height:400px;border:0;" allowfullscreen></iframe>
                                    </div>
                                <% } else if (e.platform === 'tiktok') { %>
                                    <blockquote class="tiktok-embed" cite="<%= e.embed_url %>" data-video-id="<%= e.embed_url.split('/').pop().split('?')[0] %>" style="max-width:100%;min-width:300px;">
                                        <section><a href="<%= e.embed_url %>" target="_blank">Lihat di TikTok</a></section>
                                    </blockquote>
                                <% } else if (e.platform === 'facebook') { %>
                                    <div style="border-radius:12px;overflow:hidden;">
                                        <iframe src="https://www.facebook.com/plugins/video.php?href=<%= encodeURIComponent(e.embed_url) %>&show_text=false&width=560" style="width:100%;height:315px;border:0;" allowfullscreen></iframe>
                                    </div>
                                <% } else if (e.platform === 'threads') { %>
                                    <div style="border-radius:12px;overflow:hidden;background:#f5f5f5;padding:1rem;text-align:center;">
                                        <i class="fab fa-threads" style="font-size:2rem;margin-bottom:0.5rem;display:block;"></i>
                                        <a href="<%= e.embed_url %>" target="_blank" rel="noopener" class="btn btn-dark btn-sm">
                                            <i class="fab fa-threads mr-1"></i>Lihat di Threads
                                        </a>
                                    </div>
                                <% } else { %>
                                    <a href="<%= e.embed_url %>" target="_blank" class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-external-link-alt mr-1"></i>Lihat di <%= e.platform %>
                                    </a>
                                <% } %>                            </div>
                            <% }) %>
                        </div>
                    </div>
                    <% } %>

                    <% if (galeri && galeri.length > 0) { %>                    <div style="margin-top:2.5rem;">
                        <h3 style="font-size:1.4rem;font-weight:700;color:#1e293b;margin-bottom:1.2rem;">
                            <i class="fas fa-images mr-2" style="color:var(--primary-blue,#0ea5e9);"></i>Galeri Foto
                        </h3>
                        <div class="row g-3">
                            <% galeri.forEach(function(g, idx) { %>
                            <div class="col-6 col-md-4 col-lg-3">
                                <a href="/uploads/<%= g.gambar %>" data-lightbox="halaman-galeri" data-title="<%= g.keterangan || halaman.judul %>">
                                    <div style="border-radius:12px;overflow:hidden;box-shadow:0 4px 15px rgba(0,0,0,0.1);transition:transform 0.3s;" onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'">
                                        <img src="/uploads/<%= g.gambar %>" alt="<%= g.keterangan || '' %>" style="width:100%;height:160px;object-fit:cover;display:block;">
                                        <% if (g.keterangan) { %>
                                        <div style="padding:0.5rem 0.75rem;background:white;font-size:0.8rem;color:#64748b;"><%= g.keterangan %></div>
                                        <% } %>
                                    </div>
                                </a>
                            </div>
                            <% }) %>
                        </div>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
    </section>

    <!-- Lightbox CSS/JS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.4/css/lightbox.min.css">

    <%- include('partials/related') %>
    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.4/js/lightbox.min.js"></script>
    <script async src="https://www.tiktok.com/embed.js"></script>
    <script>
        lightbox.option({ resizeDuration: 200, wrapAround: true, albumLabel: 'Foto %1 dari %2' });
        $(window).scroll(function() {
            if ($(window).scrollTop() > 50) $('.navbar-modern').css('box-shadow','0 4px 30px rgba(14,165,233,0.15)');
            else $('.navbar-modern').css('box-shadow','0 2px 20px rgba(14,165,233,0.1)');
        });
    </script>
</body>
</html>



<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title><%= title %> - Website Sekolah</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/uploads/logo-sekolah.png">
    
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Dynamic Theme -->
    <link rel="stylesheet" href="/theme.css">
    
    <style>
        /* Color Variables - Same as home page */
        :root {
            --primary-blue: #0ea5e9;
            --primary-blue-dark: #0284c7;
            --primary-blue-light: #38bdf8;
            --secondary-blue: #0369a1;
            --accent-blue: #7dd3fc;
            --light-blue: #e0f2fe;
            --dark-blue: #0c4a6e;
            --gray-50: #f8fafc;
            --gray-100: #f1f5f9;
            --gray-200: #e2e8f0;
            --gray-300: #cbd5e1;
            --gray-400: #94a3b8;
            --gray-500: #64748b;
            --gray-600: #475569;
            --gray-700: #334155;
            --gray-800: #1e293b;
            --gray-900: #0f172a;
        }
        
        * { 
            font-family: 'Inter', sans-serif; 
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            line-height: 1.6;
            color: var(--gray-700);
        }
        
        /* Header & Navigation - Same as home page */
        .navbar-modern {
            background: rgba(255, 255, 255, 0.95) !important;
            backdrop-filter: blur(10px);
            box-shadow: 0 2px 20px rgba(14, 165, 233, 0.1);
            padding: 1rem 0;
            transition: all 0.3s ease;
        }
        .navbar-modern.scrolled {
            background: rgba(255, 255, 255, 0.98) !important;
            box-shadow: 0 4px 30px rgba(14, 165, 233, 0.15);
        }
        .navbar-brand { 
            font-weight: 700; 
            color: var(--primary-blue) !important; 
            font-size: 1.5rem;
            text-decoration: none;
        }
        .navbar-brand:hover {
            color: var(--primary-blue-dark) !important;
            text-decoration: none;
        }
        .navbar-toggler {
            border: none;
            padding: 0.25rem 0.5rem;
        }
        .navbar-toggler:focus {
            box-shadow: none;
        }
        .navbar-nav {
            align-items: center;
        }
        .nav-item {
            margin: 0 0.25rem;
        }
        .nav-link { 
            font-weight: 500; 
            color: var(--gray-600) !important; 
            padding: 0.75rem 1rem !important;
            border-radius: 8px;
            transition: all 0.3s ease;
            position: relative;
            text-decoration: none;
        }
        .nav-link:hover { 
            color: var(--primary-blue) !important;
            background-color: var(--light-blue);
            text-decoration: none;
        }
        .nav-link.active {
            color: var(--primary-blue) !important;
            background-color: var(--light-blue);
        }
        
        /* Page Header */
        .page-header {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--secondary-blue) 100%);
            padding: 10rem 0 6rem;
            color: white;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        .page-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000"><polygon fill="rgba(255,255,255,0.05)" points="0,1000 1000,0 1000,1000"/></svg>');
        }
        .page-title {
            font-size: 3.5rem;
            font-weight: 800;
            margin-bottom: 1rem;
            position: relative;
            z-index: 1;
        }
        .page-subtitle {
            font-size: 1.3rem;
            opacity: 0.9;
            position: relative;
            z-index: 1;
        }
        
        /* Content Section */
        .content-section {
            padding: 6rem 0;
            background: var(--gray-50);
        }
        
        /* Social Media Grid */
        .social-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
            gap: 2rem;
            margin-bottom: 3rem;
        }
        .social-item {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(14, 165, 233, 0.08);
            border: 1px solid var(--gray-100);
            transition: all 0.3s ease;
        }
        .social-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(14, 165, 233, 0.15);
        }
        .social-header {
            padding: 1.5rem;
            border-bottom: 1px solid var(--gray-100);
        }
        .social-title {
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--gray-800);
            margin-bottom: 0.5rem;
        }
        .social-description {
            color: var(--gray-600);
            font-size: 0.9rem;
            line-height: 1.5;
            margin-bottom: 1rem;
        }
        .social-platform {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.25rem 0.75rem;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 500;
        }
        .platform-tiktok { background: #000; color: white; }
        .platform-youtube { background: #ff0000; color: white; }
        .platform-instagram { background: linear-gradient(45deg, #f09433 0%,#e6683c 25%,#dc2743 50%,#cc2366 75%,#bc1888 100%); color: white; }
        .platform-facebook { background: #1877f2; color: white; }
        .platform-twitter { background: #1da1f2; color: white; }
        .platform-threads { background: #000; color: white; }
        
        .social-embed {
            position: relative;
            width: 100%;
            height: 400px;
        }
        .social-embed iframe {
            width: 100%;
            height: 100%;
            border: none;
        }
        .social-embed .tiktok-embed {
            width: 100%;
            height: 100%;
        }
        
        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            color: var(--gray-600);
        }
        .empty-state i {
            font-size: 4rem;
            margin-bottom: 2rem;
            color: var(--gray-300);
        }
        .empty-state h3 {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 1rem;
            color: var(--gray-700);
        }
        
        /* Footer */
        .footer {
            background: var(--gray-900);
            color: white;
            padding: 4rem 0 2rem;
        }
        .footer-title {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
            color: white;
        }
        .footer-link {
            color: var(--gray-300);
            text-decoration: none;
            margin-bottom: 0.5rem;
            display: block;
            transition: color 0.3s ease;
        }
        .footer-link:hover {
            color: var(--accent-blue);
            text-decoration: none;
        }
        .footer-bottom {
            border-top: 1px solid var(--gray-700);
            margin-top: 3rem;
            padding-top: 2rem;
            text-align: center;
            color: var(--gray-400);
        }
        
        /* Responsive */
        @media (max-width: 991px) {
            .navbar-collapse {
                background: white;
                border-radius: 15px;
                box-shadow: 0 10px 30px rgba(0,0,0,0.1);
                margin-top: 1rem;
                padding: 1rem;
            }
            .nav-item {
                margin: 0.25rem 0;
            }
            .nav-link {
                padding: 0.75rem 1rem !important;
                border-radius: 8px;
            }
            .page-title { font-size: 2.5rem; }
            .social-grid {
                grid-template-columns: 1fr;
                gap: 1.5rem;
            }
        }
        
        @media (max-width: 768px) {
            .page-title { font-size: 2rem; }
            .page-subtitle { font-size: 1rem; }
            .social-grid {
                grid-template-columns: 1fr;
                gap: 1rem;
            }
            .social-embed {
                height: 300px;
            }
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <%- include('partials/navbar') %>

    <!-- Page Header -->
    <section class="page-header">
        <div class="container">
            <h1 class="page-title">Media Sosial</h1>
            <p class="page-subtitle">Ikuti kegiatan dan prestasi kami di berbagai platform media sosial</p>
        </div>
    </section>

    <!-- Content Section -->
    <section class="content-section">
        <div class="container">
            <% if (mediaSosial.length === 0) { %>
                <div class="empty-state">
                    <i class="fas fa-share-alt"></i>
                    <h3>Belum Ada Konten Media Sosial</h3>
                    <p>Konten media sosial akan segera hadir di sini.</p>
                </div>
            <% } else { %>
                <div class="social-grid">
                    <% mediaSosial.forEach((item, index) => { %>
                        <div class="social-item">
                            <div class="social-header">
                                <h3 class="social-title"><%= item.judul %></h3>
                                <% if (item.deskripsi) { %>
                                    <p class="social-description"><%= item.deskripsi %></p>
                                <% } %>
                                <span class="social-platform platform-<%= item.platform %>">
                                    <i class="fab fa-<%= item.platform %>"></i>
                                    <%= item.platform.toUpperCase() %>
                                </span>
                            </div>
                            <div class="social-embed">
                                <% if (item.platform === 'youtube') { %>
                                    <% 
                                        let embedUrl = item.embed_url;
                                        const youtubeMatch = embedUrl.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&\n?#]+)/);
                                        if (youtubeMatch) {
                                            embedUrl = `https://www.youtube.com/embed/${youtubeMatch[1]}`;
                                        }
                                    %>
                                    <iframe src="<%= embedUrl %>" allowfullscreen></iframe>
                                <% } else if (item.platform === 'tiktok') { %>
                                    <blockquote class="tiktok-embed" cite="<%= item.embed_url %>" data-video-id="<%= item.embed_url.split('/').pop() %>" style="max-width: 605px;min-width: 325px;">
                                        <section>
                                            <a target="_blank" title="<%= item.judul %>" href="<%= item.embed_url %>">
                                                Lihat di TikTok
                                            </a>
                                        </section>
                                    </blockquote>
                                <% } else if (item.platform === 'instagram') { %>
                                    <% 
                                        let instagramEmbedUrl = item.embed_url;
                                        const instagramMatch = instagramEmbedUrl.match(/instagram\.com\/p\/([^\/]+)/);
                                        if (instagramMatch) {
                                            instagramEmbedUrl = `https://www.instagram.com/p/${instagramMatch[1]}/embed/`;
                                        }
                                    %>
                                    <iframe src="<%= instagramEmbedUrl %>" allowtransparency="true" allowfullscreen="true"></iframe>
                                <% } else if (item.platform === 'facebook') { %>
                                    <iframe src="https://www.facebook.com/plugins/video.php?href=<%= encodeURIComponent(item.embed_url) %>&show_text=false&width=560" allowfullscreen="true" allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"></iframe>
                                <% } else if (item.platform === 'twitter') { %>
                                    <% 
                                        const twitterMatch = item.embed_url.match(/twitter\.com\/[^\/]+\/status\/(\d+)/);
                                        const tweetId = twitterMatch ? twitterMatch[1] : '';
                                    %>
                                    <% if (tweetId) { %>
                                        <blockquote class="twitter-tweet" data-theme="light">
                                            <a href="<%= item.embed_url %>">Lihat Tweet</a>
                                        </blockquote>
                                    <% } else { %>
                                        <div class="text-center p-4">
                                            <i class="fab fa-twitter fa-3x text-muted"></i>
                                            <p class="mt-2">
                                                <a href="<%= item.embed_url %>" target="_blank" class="btn btn-primary">
                                                    Lihat di Twitter
                                                </a>
                                            </p>
                                        </div>
                                    <% } %>
                                <% } else if (item.platform === 'threads') { %>
                                    <div class="text-center p-4" style="background:#f5f5f5;border-radius:12px;">
                                        <i class="fab fa-threads fa-3x mb-3" style="color:#000;"></i>
                                        <p class="mb-2 text-muted small"><%= item.judul %></p>
                                        <a href="<%= item.embed_url %>" target="_blank" rel="noopener" class="btn btn-dark btn-sm">
                                            <i class="fab fa-threads mr-1"></i>Lihat di Threads
                                        </a>
                                    </div>
                                <% } else { %>
                                    <div class="text-center p-4">
                                        <i class="fab fa-<%= item.platform %> fa-3x text-muted"></i>
                                        <p class="mt-2">
                                            <a href="<%= item.embed_url %>" target="_blank" class="btn btn-primary">
                                                Lihat Konten
                                            </a>
                                        </p>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </div>
    </section>

    <!-- Footer -->
    <%- include('partials/related') %>
    <%- include('partials/footer') %>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- TikTok Embed Script -->
    <script async src="https://www.tiktok.com/embed.js"></script>
    <!-- Twitter Embed Script -->
    <script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
    
    <script>
        // Navbar background on scroll
        $(window).scroll(function() {
            if ($(window).scrollTop() > 50) {
                $('.navbar-modern').addClass('scrolled');
            } else {
                $('.navbar-modern').removeClass('scrolled');
            }
        });
    </script>
</body>
</html>


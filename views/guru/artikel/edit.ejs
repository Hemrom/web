<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <link rel="icon" type="image/png" href="/assets/img/favicon.png?v=4">
    <link href="/assets/vendor/bootstrap5/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/vendor/fontawesome6/all.min.css" rel="stylesheet">
    <link href="/assets/vendor/summernote/summernote-bs4.min.css" rel="stylesheet">
    <style>body { background: #f1f5f9; font-family: 'Segoe UI', sans-serif; }</style>
</head>
<body>
<%- include('../partials/navbar') %>
<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h4 class="fw-bold mb-0">Edit Artikel</h4>
        <a href="/guru/artikel" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Kembali</a>
    </div>
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <form method="POST" action="/guru/artikel/edit/<%= artikel.id %>" enctype="multipart/form-data">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Judul Artikel *</label>
                            <input type="text" class="form-control" name="judul" value="<%= artikel.judul %>" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Ringkasan</label>
                            <textarea class="form-control" name="ringkasan" rows="2"><%= artikel.ringkasan || '' %></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Kategori</label>
                            <input type="text" class="form-control" name="kategori" value="<%= artikel.kategori %>">
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Konten Artikel *</label>
                            <textarea id="konten" name="konten" rows="10"><%- artikel.konten || '' %></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Gambar Cover</label>
                            <% if (artikel.gambar) { %>
                            <div class="mb-2"><img src="/uploads/<%= artikel.gambar %>" style="height:70px;border-radius:8px;object-fit:cover;"></div>
                            <% } %>
                            <input type="file" class="form-control" name="gambar" accept="image/*">
                            <small class="text-muted">Kosongkan jika tidak ingin mengganti gambar</small>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Status</label>
                            <select class="form-select" name="status">
                                <option value="draft" <%= artikel.status === 'draft' ? 'selected' : '' %>>Draft</option>
                                <option value="published" <%= artikel.status === 'published' ? 'selected' : '' %>>Published</option>
                            </select>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Update</button>
                            <a href="/guru/artikel" class="btn btn-outline-secondary">Batal</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3"><i class="fas fa-info-circle text-primary me-2"></i>Info Artikel</h6>
                    <div class="small text-muted">
                        <p class="mb-1"><strong>Views:</strong> <%= artikel.views %></p>
                        <p class="mb-1"><strong>Dibuat:</strong> <%= new Date(artikel.created_at).toLocaleDateString('id-ID') %></p>
                        <% if (artikel.status === 'published') { %>
                        <a href="/artikel/<%= artikel.slug %>" target="_blank" class="btn btn-outline-info btn-sm mt-2 w-100">
                            <i class="fas fa-external-link-alt me-1"></i>Lihat di Website
                        </a>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="/assets/vendor/jquery/jquery.min.js"></script>
<script src="/assets/vendor/bootstrap5/bootstrap.bundle.min.js"></script>
<script src="/assets/vendor/summernote/summernote-bs4.min.js"></script>
<script>
$('#konten').summernote({
    height: 350,
    toolbar: [
        ['style', ['style']],
        ['font', ['bold', 'italic', 'underline', 'clear']],
        ['para', ['ul', 'ol', 'paragraph']],
        ['table', ['table']],
        ['insert', ['link', 'picture', 'hr']],
        ['view', ['fullscreen', 'codeview']]
    ]
});
</script>
</body>
</html>

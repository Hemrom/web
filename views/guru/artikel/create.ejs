<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <link rel="icon" type="image/png" href="/assets/img/favicon.png?v=4">
    <link href="/assets/vendor/bootstrap5/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/vendor/fontawesome6/all.min.css" rel="stylesheet">
    <link href="/assets/vendor/summernote/summernote-bs4.min.css" rel="stylesheet">
    <style>body { background: #f1f5f9; font-family: 'Segoe UI', sans-serif; }</style>
</head>
<body>
<%- include('../partials/navbar') %>
<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h4 class="fw-bold mb-0">Tulis Artikel Baru</h4>
        <a href="/guru/artikel" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Kembali</a>
    </div>
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <form method="POST" action="/guru/artikel/create" enctype="multipart/form-data">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Judul Artikel *</label>
                            <input type="text" class="form-control" name="judul" required placeholder="Masukkan judul artikel...">
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Ringkasan</label>
                            <textarea class="form-control" name="ringkasan" rows="2" placeholder="Ringkasan singkat artikel (tampil di daftar artikel)..."></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Kategori</label>
                            <input type="text" class="form-control" name="kategori" value="Umum" placeholder="Umum, Pendidikan, Teknologi, dll">
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Konten Artikel *</label>
                            <textarea class="form-control" name="konten" id="editor" rows="12"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Gambar Cover</label>
                            <input type="file" class="form-control" name="gambar" accept="image/*">
                            <small class="text-muted">Format: JPG, PNG. Maks 2MB</small>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Status</label>
                            <select class="form-select" name="status">
                                <option value="draft">Draft (belum terbit)</option>
                                <option value="published">Published (langsung terbit)</option>
                            </select>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Simpan</button>
                            <a href="/guru/artikel" class="btn btn-outline-secondary">Batal</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3"><i class="fas fa-lightbulb text-warning me-2"></i>Tips Menulis</h6>
                    <ul class="small text-muted ps-3">
                        <li class="mb-2">Judul yang menarik meningkatkan pembaca</li>
                        <li class="mb-2">Isi ringkasan agar mudah ditemukan</li>
                        <li class="mb-2">Gunakan heading untuk struktur yang jelas</li>
                        <li class="mb-2">Tambahkan gambar untuk mempercantik artikel</li>
                        <li>Simpan sebagai Draft dulu untuk review</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="/assets/vendor/jquery/jquery.min.js"></script>
<script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/assets/vendor/summernote/summernote-bs4.min.js"></script>
<script>
$(document).ready(function() {
    $('#editor').summernote({
        height: 400,
        toolbar: [
            ['style', ['style']],
            ['font', ['bold', 'italic', 'underline', 'strikethrough', 'clear']],
            ['fontsize', ['fontsize']],
            ['color', ['color']],
            ['para', ['ul', 'ol', 'paragraph']],
            ['table', ['table']],
            ['insert', ['link', 'picture', 'hr']],
            ['view', ['fullscreen', 'codeview']]
        ],
        styleTags: ['p', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'blockquote'],
        fontSizes: ['10','11','12','13','14','16','18','20','24','28','32','36']
    });
});
</script>
</body>
</html>

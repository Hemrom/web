<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <link rel="icon" type="image/png" href="/assets/img/favicon.png?v=4">
    <link href="/assets/vendor/bootstrap5/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/vendor/fontawesome6/all.min.css" rel="stylesheet">
    <style>
        body { background: #f1f5f9; font-family: 'Segoe UI', sans-serif; }
        .card-form { border: none; border-radius: 14px; box-shadow: 0 2px 12px rgba(0,0,0,0.07); }
        .form-label { font-weight: 600; font-size: 0.85rem; color: #374151; }
        .form-control:focus { border-color: #0ea5e9; box-shadow: 0 0 0 0.2rem rgba(14,165,233,.2); }
    </style>
</head>
<body>
<%- include('partials/navbar') %>

<div class="container py-4" style="max-width:480px;">
    <div class="d-flex align-items-center mb-4 gap-2">
        <a href="/guru/dashboard" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
        <h5 class="fw-bold mb-0 text-dark">Ganti Password</h5>
    </div>

    <% if (success) { %>
    <div class="alert alert-success py-2"><i class="fas fa-check-circle me-1"></i><%= success %></div>
    <% } %>
    <% if (error) { %>
    <div class="alert alert-danger py-2"><i class="fas fa-exclamation-circle me-1"></i><%= error %></div>
    <% } %>

    <div class="card card-form">
        <div class="card-body p-4">
            <form method="POST" action="/guru/password">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="mb-3">
                    <label class="form-label">Password Lama</label>
                    <input type="password" name="password_lama" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Password Baru <span class="text-muted fw-normal">(min. 6 karakter)</span></label>
                    <input type="password" name="password_baru" class="form-control" required minlength="6">
                </div>
                <div class="mb-4">
                    <label class="form-label">Konfirmasi Password Baru</label>
                    <input type="password" name="password_konfirmasi" class="form-control" required>
                </div>
                <button type="submit" class="btn btn-primary w-100"><i class="fas fa-key me-1"></i>Ubah Password</button>
            </form>
        </div>
    </div>
</div>
</body>
</html>

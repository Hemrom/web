<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> - Portal Guru</title>
    <link rel="icon" type="image/png" href="/assets/img/favicon.png?v=4">
    <link href="/assets/vendor/bootstrap5/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/vendor/fontawesome6/all.min.css" rel="stylesheet">
    <style>
        body { background: #f1f5f9; font-family: 'Segoe UI', sans-serif; }
        .card-sk { border: none; border-radius: 14px; box-shadow: 0 2px 12px rgba(0,0,0,0.07); transition: box-shadow .2s, transform .15s; }
        .card-sk:hover { box-shadow: 0 6px 24px rgba(0,0,0,0.12); transform: translateY(-2px); }
        .sk-icon { width: 48px; height: 48px; border-radius: 12px; display:flex; align-items:center; justify-content:center; font-size: 1.25rem; color: white; flex-shrink: 0; }
        .badge-baru { animation: pulse 1.5s infinite; }
        @keyframes pulse { 0%,100%{opacity:1;} 50%{opacity:.6;} }
        .tab-pill { border-radius: 50px; padding: .4rem 1.2rem; font-size: .85rem; font-weight: 600; border: 2px solid transparent; cursor: pointer; transition: all .2s; }
        .tab-pill.active { border-color: #0ea5e9; background: #0ea5e9; color: white; }
        .tab-pill:not(.active) { border-color: #e2e8f0; color: #64748b; }
        .tab-pill:not(.active):hover { border-color: #0ea5e9; color: #0ea5e9; }
        .empty-state { text-align:center; padding: 3rem 1rem; color: #94a3b8; }
        .tipe-badge { display:inline-block; padding:.15rem .6rem; border-radius:4px; font-size:.7rem; font-weight:700; color:white; }
        .sk-row { display:flex; align-items:center; gap:1rem; padding:1rem; border-bottom:1px solid #f1f5f9; }
        .sk-row:last-child { border-bottom: none; }
        .sk-row:hover { background: #f8fafc; }
    </style>
</head>
<body>
<%- include('../partials/navbar') %>

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-1"><i class="fas fa-file-alt me-2 text-primary"></i>SK Saya</h4>
            <p class="text-muted small mb-0">Surat Keputusan yang ditujukan untuk Anda</p>
        </div>
        <div class="d-flex align-items-center gap-2 text-muted small">
            <i class="fas fa-user-circle text-primary"></i>
            <span><%= guru.nama %></span>
        </div>
    </div>

    <!-- Statistik ringkas -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card card-sk p-3 text-center">
                <div class="fw-bold fs-4 text-primary"><%= skList.length %></div>
                <div class="text-muted small">Total SK</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-sk p-3 text-center">
                <div class="fw-bold fs-4 text-success"><%= skMengajar.length %></div>
                <div class="text-muted small">SK Mengajar</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-sk p-3 text-center">
                <div class="fw-bold fs-4 text-warning"><%= skTugasTambahan.length %></div>
                <div class="text-muted small">SK Tugas Tambahan</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-sk p-3 text-center">
                <% const belumDownload = skList.filter(s => !s.dibaca).length; %>
                <div class="fw-bold fs-4 <%= belumDownload > 0 ? 'text-danger' : 'text-secondary' %>">
                    <%= belumDownload %>
                </div>
                <div class="text-muted small">Belum Didownload</div>
            </div>
        </div>
    </div>

    <!-- Tab filter -->
    <div class="d-flex gap-2 mb-3 flex-wrap">
        <button class="tab-pill active" data-tab="semua" onclick="filterTab(this, 'semua')">
            <i class="fas fa-layer-group me-1"></i>Semua (<%= skList.length %>)
        </button>
        <button class="tab-pill" data-tab="sk_mengajar" onclick="filterTab(this, 'sk_mengajar')">
            <i class="fas fa-chalkboard-teacher me-1"></i>SK Mengajar (<%= skMengajar.length %>)
        </button>
        <button class="tab-pill" data-tab="sk_tugas_tambahan" onclick="filterTab(this, 'sk_tugas_tambahan')">
            <i class="fas fa-briefcase me-1"></i>SK Tugas Tambahan (<%= skTugasTambahan.length %>)
        </button>
        <% if (skLainnya.length > 0) { %>
        <button class="tab-pill" data-tab="lainnya" onclick="filterTab(this, 'lainnya')">
            <i class="fas fa-file me-1"></i>Lainnya (<%= skLainnya.length %>)
        </button>
        <% } %>
    </div>

    <!-- Daftar SK -->
    <div class="card card-sk">
        <% if (!skList.length) { %>
        <div class="empty-state">
            <i class="fas fa-folder-open fa-3x mb-3 d-block"></i>
            <p class="mb-0">Belum ada SK yang ditujukan untuk Anda.</p>
        </div>
        <% } else { %>
        <div id="skContainer">
            <% skList.forEach(sk => { %>
            <%
                const jenisBadgeColor = {
                    sk_mengajar: '#3b82f6',
                    sk_tugas_tambahan: '#22c55e',
                    lainnya: '#6b7280'
                };
                const tipeColor = {
                    PDF: '#ef4444', DOC: '#3b82f6', DOCX: '#3b82f6',
                    XLS: '#22c55e', XLSX: '#22c55e',
                    PPT: '#f59e0b', PPTX: '#f59e0b',
                    ZIP: '#6b7280', RAR: '#6b7280'
                };
            %>
            <div class="sk-row" data-jenis="<%= sk.jenis %>">
                <!-- Ikon tipe file -->
                <div class="sk-icon flex-shrink-0" style="background:<%= tipeColor[sk.tipe_file] || '#0ea5e9' %>">
                    <i class="fas fa-file-<%= sk.tipe_file === 'PDF' ? 'pdf' : (sk.tipe_file && ['DOC','DOCX'].includes(sk.tipe_file) ? 'word' : (sk.tipe_file && ['XLS','XLSX'].includes(sk.tipe_file) ? 'excel' : (sk.tipe_file && ['PPT','PPTX'].includes(sk.tipe_file) ? 'powerpoint' : (sk.tipe_file && ['ZIP','RAR'].includes(sk.tipe_file) ? 'archive' : 'alt')))) %>"></i>
                </div>

                <!-- Info SK -->
                <div class="flex-grow-1 overflow-hidden">
                    <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                        <span class="fw-semibold text-dark" style="font-size:.95rem;">
                            <%= sk.judul %>
                        </span>
                        <% if (!sk.dibaca) { %>
                        <span class="badge bg-danger badge-baru" style="font-size:.7rem;">BARU</span>
                        <% } %>
                    </div>
                    <div class="d-flex gap-2 flex-wrap align-items-center">
                        <span class="tipe-badge" style="background:<%= jenisBadgeColor[sk.jenis] || '#6b7280' %>">
                            <%= jenisLabel[sk.jenis] || sk.jenis %>
                        </span>
                        <% if (sk.nomor_sk) { %>
                        <span class="text-muted small"><i class="fas fa-hashtag me-1"></i><%= sk.nomor_sk %></span>
                        <% } %>
                        <% if (sk.tahun_ajaran) { %>
                        <span class="text-muted small"><i class="fas fa-calendar me-1"></i><%= sk.tahun_ajaran %></span>
                        <% } %>
                        <span class="text-muted small">
                            <i class="fas fa-clock me-1"></i>
                            <%= new Date(sk.created_at).toLocaleDateString('id-ID', { day:'2-digit', month:'long', year:'numeric' }) %>
                        </span>
                        <span class="text-muted small"><%= sk.ukuran_file %></span>
                    </div>
                    <% if (sk.deskripsi) { %>
                    <div class="text-muted mt-1" style="font-size:.8rem;"><%= sk.deskripsi %></div>
                    <% } %>
                </div>

                <!-- Aksi download -->
                <div class="flex-shrink-0 d-flex flex-column align-items-end gap-1">
                    <a href="/guru/sk-saya/download/<%= sk.id %>"
                       class="btn btn-primary btn-sm"
                       title="Download SK">
                        <i class="fas fa-download me-1"></i>Download
                    </a>
                    <% if (sk.dibaca) { %>
                    <small class="text-success"><i class="fas fa-check-circle me-1"></i>Sudah didownload</small>
                    <% } else { %>
                    <small class="text-muted">Belum didownload</small>
                    <% } %>
                </div>
            </div>
            <% }) %>
        </div>
        <% } %>
    </div>

    <div class="mt-3 text-muted small text-center">
        <i class="fas fa-shield-alt me-1"></i>
        File SK hanya dapat diakses oleh Anda. Hubungi administrator jika ada pertanyaan.
    </div>
</div>

<script src="/assets/vendor/bootstrap5/bootstrap.bundle.min.js"></script>
<script>
function filterTab(btn, jenis) {
    document.querySelectorAll('.tab-pill').forEach(t => t.classList.remove('active'));
    btn.classList.add('active');

    document.querySelectorAll('#skContainer .sk-row').forEach(row => {
        if (jenis === 'semua' || row.getAttribute('data-jenis') === jenis) {
            row.style.display = '';
        } else {
            row.style.display = 'none';
        }
    });
}
</script>
</body>
</html>

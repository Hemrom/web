<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <link rel="icon" type="image/png" href="/assets/img/favicon.png?v=4">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body { background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 100%); min-height: 100vh; display: flex; align-items: center; }
        .login-card { background: white; border-radius: 16px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); padding: 2.5rem; max-width: 420px; width: 100%; }
        .login-logo { width: 72px; height: 72px; object-fit: contain; border-radius: 12px; }
        .btn-login { background: linear-gradient(135deg, #0ea5e9, #0369a1); border: none; padding: 0.75rem; font-weight: 600; }
        .btn-login:hover { background: linear-gradient(135deg, #0284c7, #075985); }
        .form-control:focus { border-color: #0ea5e9; box-shadow: 0 0 0 0.2rem rgba(14,165,233,.2); }
    </style>
</head>
<body>
<div class="container">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="login-card mx-auto">
                <div class="text-center mb-4">
                    <img src="/uploads/logo-sekolah.png" class="login-logo mb-3" alt="Logo" onerror="this.style.display='none'">
                    <h4 class="fw-bold text-dark mb-1">Portal Guru</h4>
                    <p class="text-muted small">SMKN 1 Kras — Masuk dengan akun guru Anda</p>
                </div>
                <% if (error) { %>
                <div class="alert alert-danger py-2 small"><i class="fas fa-exclamation-circle me-1"></i><%= error %></div>
                <% } %>
                <form method="POST" action="/guru/login">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Username</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-user text-muted"></i></span>
                            <input type="text" name="username" class="form-control" placeholder="Username guru" required autofocus>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold small">Password</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-lock text-muted"></i></span>
                            <input type="password" name="password" class="form-control" placeholder="Password" required>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-login btn-primary w-100 text-white">
                        <i class="fas fa-sign-in-alt me-2"></i>Masuk
                    </button>
                </form>
                <div class="text-center mt-3">
                    <a href="/" class="text-muted small"><i class="fas fa-arrow-left me-1"></i>Kembali ke Website</a>
                </div>
            </div>
        </div>
    </div>
</div>
</body>
</html>

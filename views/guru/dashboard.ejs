<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <link rel="icon" type="image/png" href="/assets/img/favicon.png?v=4">
    <link href="/assets/vendor/bootstrap5/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/vendor/fontawesome6/all.min.css" rel="stylesheet">
    <style>
        body { background: #f1f5f9; font-family: 'Segoe UI', sans-serif; }
        .avatar { width: 80px; height: 80px; border-radius: 50%; object-fit: cover; border: 3px solid #0ea5e9; cursor: zoom-in; transition: transform .15s; }
        .avatar:hover { transform: scale(1.08); }
        .avatar-placeholder { width: 80px; height: 80px; border-radius: 50%; background: linear-gradient(135deg,#0ea5e9,#0369a1); display:flex;align-items:center;justify-content:center;color:white;font-size:2rem; }
        /* Lightbox */
        .lb-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,.82); z-index:9999; align-items:center; justify-content:center; cursor:zoom-out; }
        .lb-overlay.show { display:flex; }
        .lb-overlay img { max-width:88vw; max-height:88vh; border-radius:12px; box-shadow:0 8px 40px rgba(0,0,0,.5); cursor:default; }
        .lb-close { position:absolute; top:18px; right:24px; color:#fff; font-size:2rem; cursor:pointer; line-height:1; }
        .card-stat { border: none; border-radius: 14px; box-shadow: 0 2px 12px rgba(0,0,0,0.07); }
        .info-label { font-size: 0.75rem; color: #64748b; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; }
        .info-value { font-size: 0.95rem; color: #1e293b; font-weight: 500; }
        .berita-item { border-left: 3px solid #0ea5e9; padding-left: 0.75rem; margin-bottom: 1rem; }
        .berita-item:last-child { margin-bottom: 0; }
        .quick-action { border: none; border-radius: 14px; box-shadow: 0 2px 12px rgba(0,0,0,0.07); transition: all 0.2s; text-decoration: none; display: block; }
        .quick-action:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,0.12); text-decoration: none; }
    </style>
</head>
<body>
<%- include('partials/navbar') %>

<div class="container py-4">
    <!-- Welcome -->
    <div class="card card-stat mb-4">
        <div class="card-body d-flex align-items-center gap-4 flex-wrap">
            <% if (guru.foto) { %>
            <img src="/uploads/<%= guru.foto %>" class="avatar" alt="<%= guru.nama %>" onclick="openLightbox(this.src)" title="Klik untuk perbesar">
            <% } else { %>
            <div class="avatar-placeholder"><i class="fas fa-user"></i></div>
            <% } %>
            <div>
                <h4 class="fw-bold mb-1 text-dark">Selamat datang, <%= guru.nama %>!</h4>
                <span class="badge bg-primary me-1"><%= guru.jabatan || 'Guru' %></span>
                <% if (guru.mata_pelajaran) { %><span class="badge bg-secondary"><%= guru.mata_pelajaran %></span><% } %>
                <p class="text-muted small mt-2 mb-0"><i class="fas fa-id-card me-1"></i>NIP: <%= guru.nip || '-' %></p>
            </div>
            <div class="ms-auto d-flex gap-2 flex-wrap">
                <a href="/guru/profil" class="btn btn-primary btn-sm"><i class="fas fa-user-edit me-1"></i>Edit Profil</a>
                <a href="/guru/password" class="btn btn-outline-secondary btn-sm"><i class="fas fa-key me-1"></i>Ganti Password</a>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Quick Actions -->
        <div class="col-12">
            <div class="row g-3">
                <div class="col-6 col-md-3">
                    <a href="/guru/artikel" class="quick-action card card-stat">
                        <div class="card-body text-center py-3">
                            <div style="width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,#0ea5e9,#0369a1);display:flex;align-items:center;justify-content:center;margin:0 auto 0.75rem;"><i class="fas fa-pen-nib text-white"></i></div>
                            <div class="fw-semibold text-dark" style="font-size:.9rem;">Artikel Saya</div>
                            <div class="text-muted" style="font-size:.75rem;">Tulis & kelola artikel</div>
                        </div>
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <a href="/guru/file-download" class="quick-action card card-stat">
                        <div class="card-body text-center py-3">
                            <div style="width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,#22c55e,#16a34a);display:flex;align-items:center;justify-content:center;margin:0 auto 0.75rem;"><i class="fas fa-download text-white"></i></div>
                            <div class="fw-semibold text-dark" style="font-size:.9rem;">File Download</div>
                            <div class="text-muted" style="font-size:.75rem;">Upload & kelola file</div>
                        </div>
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <a href="/guru/sk-saya" class="quick-action card card-stat">
                        <div class="card-body text-center py-3">
                            <div style="width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,#ef4444,#b91c1c);display:flex;align-items:center;justify-content:center;margin:0 auto 0.75rem;"><i class="fas fa-file-signature text-white"></i></div>
                            <div class="fw-semibold text-dark" style="font-size:.9rem;">SK Saya</div>
                            <div class="text-muted" style="font-size:.75rem;">SK Mengajar & Tugas</div>
                        </div>
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <a href="/guru/profil" class="quick-action card card-stat">
                        <div class="card-body text-center py-3">
                            <div style="width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,#f59e0b,#d97706);display:flex;align-items:center;justify-content:center;margin:0 auto 0.75rem;"><i class="fas fa-user-edit text-white"></i></div>
                            <div class="fw-semibold text-dark" style="font-size:.9rem;">Edit Profil</div>
                            <div class="text-muted" style="font-size:.75rem;">Perbarui data diri</div>
                        </div>
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <a href="/guru/password" class="quick-action card card-stat">
                        <div class="card-body text-center py-3">
                            <div style="width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,#8b5cf6,#7c3aed);display:flex;align-items:center;justify-content:center;margin:0 auto 0.75rem;"><i class="fas fa-key text-white"></i></div>
                            <div class="fw-semibold text-dark" style="font-size:.9rem;">Ganti Password</div>
                            <div class="text-muted" style="font-size:.75rem;">Keamanan akun</div>
                        </div>
                    </a>
                </div>
            </div>
        </div>

        <!-- Info Profil -->
        <div class="col-lg-5">
            <div class="card card-stat h-100">
                <div class="card-header bg-white border-0 pt-3 pb-0">
                    <h6 class="fw-bold text-dark mb-0"><i class="fas fa-info-circle text-primary me-2"></i>Informasi Saya</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="info-label">Nama Lengkap</div>
                            <div class="info-value"><%= guru.nama %></div>
                        </div>
                        <div class="col-6">
                            <div class="info-label">NIP</div>
                            <div class="info-value"><%= guru.nip || '-' %></div>
                        </div>
                        <div class="col-6">
                            <div class="info-label">Jabatan</div>
                            <div class="info-value"><%= guru.jabatan || '-' %></div>
                        </div>
                        <div class="col-6">
                            <div class="info-label">Mata Pelajaran</div>
                            <div class="info-value"><%= guru.mata_pelajaran || '-' %></div>
                        </div>
                        <div class="col-6">
                            <div class="info-label">Email</div>
                            <div class="info-value"><%= guru.email || '-' %></div>
                        </div>
                        <div class="col-6">
                            <div class="info-label">Telepon</div>
                            <div class="info-value"><%= guru.telepon || '-' %></div>
                        </div>
                        <div class="col-12">
                            <div class="info-label">Alamat</div>
                            <div class="info-value"><%= guru.alamat || '-' %></div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <a href="/guru/profil" class="btn btn-primary btn-sm w-100">
                            <i class="fas fa-edit me-1"></i>Perbarui Informasi
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Berita Terbaru -->
        <div class="col-lg-7">
            <div class="card card-stat h-100">
                <div class="card-header bg-white border-0 pt-3 pb-0">
                    <h6 class="fw-bold text-dark mb-0"><i class="fas fa-newspaper text-primary me-2"></i>Berita Terbaru Sekolah</h6>
                </div>
                <div class="card-body">
                    <% if (berita.length > 0) { %>
                    <% berita.forEach(function(b) { %>
                    <div class="berita-item">
                        <a href="/berita/<%= b.slug %>" target="_blank" class="text-dark text-decoration-none fw-semibold" style="font-size:.9rem;"><%= b.judul %></a>
                        <div class="text-muted" style="font-size:.75rem;">
                            <i class="fas fa-calendar-alt me-1"></i>
                            <%= new Date(b.created_at).toLocaleDateString('id-ID',{day:'2-digit',month:'long',year:'numeric'}) %>
                        </div>
                    </div>
                    <% }) %>
                    <% } else { %>
                    <p class="text-muted small">Belum ada berita.</p>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Agenda Mendatang -->
        <div class="col-12">
            <div class="card card-stat">
                <div class="card-header bg-white border-0 pt-3 pb-0 d-flex align-items-center justify-content-between">
                    <h6 class="fw-bold text-dark mb-0"><i class="fas fa-calendar-check text-success me-2"></i>Agenda Mendatang</h6>
                    <a href="/agenda" target="_blank" class="btn btn-outline-success btn-sm" style="font-size:.75rem;">
                        <i class="fas fa-external-link-alt me-1"></i>Lihat Semua
                    </a>
                </div>
                <div class="card-body">
                    <% if (agenda && agenda.length > 0) { %>
                    <% agenda.forEach(function(ag) { %>
                    <%
                        const tglMulai = new Date(ag.tanggal_mulai);
                        const bulan = ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];
                        const tglSelesai = ag.tanggal_selesai ? new Date(ag.tanggal_selesai) : null;
                        const hariIni = new Date();
                        hariIni.setHours(0,0,0,0);
                        const selisihHari = Math.ceil((tglMulai - hariIni) / (1000*60*60*24));
                    %>
                    <div class="d-flex gap-3 align-items-start mb-3 pb-3" style="border-bottom:1px solid #f1f5f9;">
                        <!-- Kalender mini -->
                        <div class="flex-shrink-0 text-center rounded-3 overflow-hidden" style="width:52px;box-shadow:0 2px 8px rgba(0,0,0,.1);">
                            <div class="fw-bold text-white py-1" style="font-size:.65rem;background:#22c55e;letter-spacing:.05em;">
                                <%= bulan[tglMulai.getMonth()] %> <%= tglMulai.getFullYear() %>
                            </div>
                            <div class="fw-bold text-dark" style="font-size:1.5rem;line-height:1.2;padding:.2rem 0;background:white;">
                                <%= tglMulai.getDate() %>
                            </div>
                        </div>
                        <!-- Detail -->
                        <div class="flex-grow-1">
                            <div class="fw-semibold text-dark" style="font-size:.9rem;line-height:1.3;">
                                <%= ag.judul %>
                            </div>
                            <div class="d-flex flex-wrap gap-2 mt-1">
                                <span class="text-muted" style="font-size:.75rem;">
                                    <i class="fas fa-calendar-alt me-1"></i>
                                    <%= tglMulai.toLocaleDateString('id-ID',{day:'2-digit',month:'long',year:'numeric'}) %>
                                    <% if (tglSelesai && tglSelesai.getTime() !== tglMulai.getTime()) { %>
                                    &ndash; <%= tglSelesai.toLocaleDateString('id-ID',{day:'2-digit',month:'long',year:'numeric'}) %>
                                    <% } %>
                                </span>
                                <% if (ag.waktu_mulai) { %>
                                <span class="text-muted" style="font-size:.75rem;">
                                    <i class="fas fa-clock me-1"></i><%= ag.waktu_mulai.substring(0,5) %>
                                </span>
                                <% } %>
                                <% if (ag.lokasi) { %>
                                <span class="text-muted" style="font-size:.75rem;">
                                    <i class="fas fa-map-marker-alt me-1"></i><%= ag.lokasi %>
                                </span>
                                <% } %>
                            </div>
                        </div>
                        <!-- Badge sisa hari -->
                        <div class="flex-shrink-0">
                            <% if (selisihHari === 0) { %>
                            <span class="badge bg-danger" style="font-size:.7rem;">Hari ini</span>
                            <% } else if (selisihHari === 1) { %>
                            <span class="badge bg-warning text-dark" style="font-size:.7rem;">Besok</span>
                            <% } else { %>
                            <span class="badge bg-light text-secondary" style="font-size:.7rem;"><%= selisihHari %> hari lagi</span>
                            <% } %>
                        </div>
                    </div>
                    <% }) %>
                    <% } else { %>
                    <div class="text-center py-3 text-muted small">
                        <i class="fas fa-calendar-times fa-2x mb-2 d-block text-muted" style="opacity:.4;"></i>
                        Tidak ada agenda mendatang.
                    </div>
                    <% } %>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Lightbox -->
<div class="lb-overlay" id="lbOverlay" onclick="closeLightbox()">
    <span class="lb-close" onclick="closeLightbox()">&times;</span>
    <img id="lbImg" src="" alt="Foto" onclick="event.stopPropagation()">
</div>
<script>
function openLightbox(src) {
    document.getElementById('lbImg').src = src;
    document.getElementById('lbOverlay').classList.add('show');
}
function closeLightbox() {
    document.getElementById('lbOverlay').classList.remove('show');
}
document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeLightbox(); });
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <link rel="icon" type="image/png" href="/assets/img/favicon.png?v=4">
    <link href="/assets/vendor/bootstrap5/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/vendor/fontawesome6/all.min.css" rel="stylesheet">
    <style>body { background: #f1f5f9; font-family: 'Segoe UI', sans-serif; }</style>
</head>
<body>
<%- include('../partials/navbar') %>
<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h4 class="fw-bold mb-0">Upload File Download</h4>
        <a href="/guru/file-download" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Kembali</a>
    </div>
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <form method="POST" action="/guru/file-download/create" enctype="multipart/form-data">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Judul File *</label>
                            <input type="text" class="form-control" name="judul" required placeholder="Contoh: Materi Matematika Kelas X">
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Deskripsi</label>
                            <textarea class="form-control" name="deskripsi" rows="3" placeholder="Keterangan singkat tentang file ini..."></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Kategori</label>
                            <input type="text" class="form-control" name="kategori" value="Materi" placeholder="Materi, Formulir, Pengumuman, dll">
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">File *</label>
                            <input type="file" class="form-control" name="file" required>
                            <small class="text-muted">Format: PDF, DOC, DOCX, XLS, XLSX, PPT, PPTX, ZIP, RAR. Maks 20MB</small>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Status</label>
                            <select class="form-select" name="status">
                                <option value="aktif">Aktif (bisa diunduh)</option>
                                <option value="nonaktif">Nonaktif</option>
                            </select>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary"><i class="fas fa-upload me-1"></i>Upload & Simpan</button>
                            <a href="/guru/file-download" class="btn btn-outline-secondary">Batal</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3"><i class="fas fa-info-circle text-primary me-2"></i>Format yang Didukung</h6>
                    <div class="row g-2 small">
                        <div class="col-6"><span class="badge" style="background:#ef4444">PDF</span> Dokumen PDF</div>
                        <div class="col-6"><span class="badge" style="background:#3b82f6">DOC/DOCX</span> Word</div>
                        <div class="col-6"><span class="badge" style="background:#22c55e">XLS/XLSX</span> Excel</div>
                        <div class="col-6"><span class="badge" style="background:#f59e0b">PPT/PPTX</span> PowerPoint</div>
                        <div class="col-6"><span class="badge bg-secondary">ZIP/RAR</span> Arsip</div>
                        <div class="col-6"><span class="badge bg-dark">TXT</span> Teks</div>
                    </div>
                    <hr>
                    <p class="small text-muted mb-0">Ukuran maksimal: <strong>20 MB</strong></p>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="/assets/vendor/bootstrap5/bootstrap.bundle.min.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <link rel="icon" type="image/png" href="/assets/img/favicon.png?v=4">
    <link href="/assets/vendor/bootstrap5/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/vendor/fontawesome6/all.min.css" rel="stylesheet">
    <style>body { background: #f1f5f9; font-family: 'Segoe UI', sans-serif; }</style>
</head>
<body>
<%- include('../partials/navbar') %>
<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h4 class="fw-bold mb-0">Edit File Download</h4>
        <a href="/guru/file-download" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Kembali</a>
    </div>
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <form method="POST" action="/guru/file-download/edit/<%= file.id %>" enctype="multipart/form-data">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Judul File *</label>
                            <input type="text" class="form-control" name="judul" value="<%= file.judul %>" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Deskripsi</label>
                            <textarea class="form-control" name="deskripsi" rows="3"><%= file.deskripsi || '' %></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Kategori</label>
                            <input type="text" class="form-control" name="kategori" value="<%= file.kategori %>">
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Ganti File (opsional)</label>
                            <div class="p-3 bg-light rounded mb-2 d-flex align-items-center gap-2">
                                <i class="fas fa-file text-primary"></i>
                                <span class="small"><%= file.nama_file %></span>
                                <span class="badge bg-secondary ms-auto"><%= file.tipe_file %></span>
                                <span class="text-muted small"><%= file.ukuran_file %></span>
                            </div>
                            <input type="file" class="form-control" name="file">
                            <small class="text-muted">Kosongkan jika tidak ingin mengganti file</small>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Status</label>
                            <select class="form-select" name="status">
                                <option value="aktif" <%= file.status === 'aktif' ? 'selected' : '' %>>Aktif</option>
                                <option value="nonaktif" <%= file.status === 'nonaktif' ? 'selected' : '' %>>Nonaktif</option>
                            </select>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Update</button>
                            <a href="/guru/file-download" class="btn btn-outline-secondary">Batal</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3"><i class="fas fa-chart-bar text-primary me-2"></i>Statistik</h6>
                    <p class="small mb-1"><strong>Total Download:</strong> <%= file.jumlah_download %>x</p>
                    <p class="small mb-1"><strong>Dibuat:</strong> <%= new Date(file.created_at).toLocaleDateString('id-ID') %></p>
                    <a href="/file-download/<%= file.id %>" target="_blank" class="btn btn-outline-info btn-sm mt-2 w-100">
                        <i class="fas fa-download me-1"></i>Test Download
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="/assets/vendor/bootstrap5/bootstrap.bundle.min.js"></script>
</body>
</html>

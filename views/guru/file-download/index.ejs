<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <link rel="icon" type="image/png" href="/assets/img/favicon.png?v=4">
    <link href="/assets/vendor/bootstrap5/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/vendor/fontawesome6/all.min.css" rel="stylesheet">
    <style>
        body { background: #f1f5f9; font-family: 'Segoe UI', sans-serif; }
        .card-stat { border: none; border-radius: 14px; box-shadow: 0 2px 12px rgba(0,0,0,0.07); }
        .file-icon { width: 40px; height: 40px; border-radius: 8px; display:flex; align-items:center; justify-content:center; font-size: 1.1rem; font-weight: 700; color: white; flex-shrink: 0; }
    </style>
</head>
<body>
<%- include('../partials/navbar') %>
<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="fw-bold mb-1">File Download Saya</h4>
            <p class="text-muted small mb-0">Kelola file yang Anda upload untuk diunduh</p>
        </div>
        <a href="/guru/file-download/create" class="btn btn-primary btn-sm"><i class="fas fa-upload me-1"></i>Upload File</a>
    </div>

    <div class="card card-stat">
        <div class="card-body p-0">
            <% if (!files.length) { %>
            <div class="text-center py-5">
                <i class="fas fa-folder-open fa-3x text-muted mb-3"></i>
                <p class="text-muted">Belum ada file. Upload file pertama Anda!</p>
                <a href="/guru/file-download/create" class="btn btn-primary btn-sm">Upload Sekarang</a>
            </div>
            <% } else { %>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>File</th>
                            <th>Kategori</th>
                            <th>Ukuran</th>
                            <th>Status</th>
                            <th>Download</th>
                            <th>Tanggal</th>
                            <th>Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% const tipeColor = { PDF: '#ef4444', DOC: '#3b82f6', DOCX: '#3b82f6', XLS: '#22c55e', XLSX: '#22c55e', PPT: '#f59e0b', PPTX: '#f59e0b', ZIP: '#6b7280', RAR: '#6b7280' }; %>
                        <% files.forEach(item => { %>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="file-icon" style="background:<%= tipeColor[item.tipe_file] || '#0ea5e9' %>">
                                        <%= item.tipe_file ? item.tipe_file.substring(0,3) : 'FILE' %>
                                    </div>
                                    <div>
                                        <div class="fw-semibold" style="max-width:250px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= item.judul %></div>
                                        <% if (item.deskripsi) { %><small class="text-muted"><%= item.deskripsi.substring(0,50) %>...</small><% } %>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge bg-light text-dark"><%= item.kategori %></span></td>
                            <td><small><%= item.ukuran_file %></small></td>
                            <td><span class="badge <%= item.status === 'aktif' ? 'bg-success' : 'bg-secondary' %>"><%= item.status %></span></td>
                            <td><span class="badge bg-dark"><%= item.jumlah_download %>x</span></td>
                            <td><%= new Date(item.created_at).toLocaleDateString('id-ID') %></td>
                            <td>
                                <a href="/file-download/<%= item.id %>" target="_blank" class="btn btn-outline-info btn-sm" title="Download"><i class="fas fa-download"></i></a>
                                <a href="/guru/file-download/edit/<%= item.id %>" class="btn btn-outline-warning btn-sm"><i class="fas fa-edit"></i></a>
                                <form action="/guru/file-download/delete/<%= item.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Hapus file ini?')">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="btn btn-outline-danger btn-sm"><i class="fas fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% } %>
        </div>
    </div>
</div>
<script src="/assets/vendor/bootstrap5/bootstrap.bundle.min.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title><%= title %> - Admin Panel</title>
    <link rel="icon" type="image/png" href="/assets/img/favicon.png?v=4">
    <link href="/assets/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">
    <link href="/assets/css/sb-admin-2.min.css" rel="stylesheet">
    <link href="/assets/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">
</head>
<body id="page-top">
    <div id="wrapper">
        <%- include('partials/sidebar') %>
        <div id="content-wrapper" class="d-flex flex-column">
            <div id="content">
                <%- include('partials/topbar', { user }) %>
                <div class="container-fluid">
                    <div class="d-sm-flex align-items-center justify-content-between mb-4">
                        <h1 class="h3 mb-0 text-gray-800">Kontak Masuk</h1>
                    </div>

                    <% if (query && query.success === 'deleted') { %>
                    <div class="alert alert-success alert-dismissible fade show">Pesan berhasil dihapus. <button type="button" class="close" data-dismiss="alert">&times;</button></div>
                    <% } %>
                    <% if (query && query.success === 'bulk_deleted') { %>
                    <div class="alert alert-success alert-dismissible fade show">Pesan terpilih berhasil dihapus. <button type="button" class="close" data-dismiss="alert">&times;</button></div>
                    <% } %>

                    <div class="card shadow mb-4">
                        <div class="card-header py-3 d-flex align-items-center justify-content-between">
                            <h6 class="m-0 font-weight-bold text-primary">Pesan dari Pengunjung</h6>
                            <div id="bulkActions" style="display:none;">
                                <form method="POST" action="/admin/kontak/bulk-delete" id="bulkDeleteForm" onsubmit="return confirm('Hapus semua pesan yang dipilih?')">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <div id="bulkIdsContainer"></div>
                                    <button type="submit" class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash mr-1"></i> Hapus Terpilih (<span id="selectedCount">0</span>)
                                    </button>
                                </form>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                                    <thead>
                                        <tr>
                                            <th style="width:40px;">
                                                <input type="checkbox" id="checkAll" title="Pilih Semua">
                                            </th>
                                            <th>No</th>
                                            <th>Tanggal</th>
                                            <th>Nama</th>
                                            <th>Email</th>
                                            <th>Subjek</th>
                                            <th>Pesan</th>
                                            <th>Status</th>
                                            <th>Aksi</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (kontak.length === 0) { %>
                                            <tr>
                                                <td colspan="9" class="text-center">Belum ada pesan masuk</td>
                                            </tr>
                                        <% } else { %>
                                            <% kontak.forEach((item, index) => { %>
                                                <tr>
                                                    <td>
                                                        <input type="checkbox" class="row-check" value="<%= item.id %>">
                                                    </td>
                                                    <td><%= index + 1 %></td>
                                                    <td><%= new Date(item.created_at).toLocaleDateString('id-ID') %></td>
                                                    <td><%= item.nama %></td>
                                                    <td><%= item.email %></td>
                                                    <td><%= item.subjek || '-' %></td>
                                                    <td>
                                                        <small><%= item.pesan.substring(0, 50) %>...</small>
                                                        <button type="button" class="btn btn-sm btn-link p-0" data-toggle="modal" data-target="#pesanModal<%= item.id %>">
                                                            Lihat
                                                        </button>
                                                    </td>
                                                    <td>
                                                        <span class="badge badge-<%= item.status === 'baru' ? 'primary' : item.status === 'dibaca' ? 'info' : 'success' %>">
                                                            <%= item.status %>
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <div class="dropdown">
                                                            <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" data-toggle="dropdown">
                                                                Aksi
                                                            </button>
                                                            <div class="dropdown-menu">
                                                                <h6 class="dropdown-header">Ubah Status</h6>
                                                                <% ['baru','dibaca','dibalas'].forEach(function(s) { %>
                                                                <form method="POST" action="/admin/kontak/update-status/<%= item.id %>">
                                                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                                    <input type="hidden" name="status" value="<%= s %>">
                                                                    <button type="submit" class="dropdown-item <%= item.status === s ? 'active' : '' %>">
                                                                        <%= s.charAt(0).toUpperCase() + s.slice(1) %>
                                                                    </button>
                                                                </form>
                                                                <% }) %>
                                                                <div class="dropdown-divider"></div>
                                                                <form method="POST" action="/admin/kontak/delete/<%= item.id %>" onsubmit="return confirm('Hapus pesan ini?')">
                                                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                                    <button type="submit" class="dropdown-item text-danger">
                                                                        <i class="fas fa-trash fa-sm mr-1"></i> Hapus
                                                                    </button>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>

                                                <!-- Modal -->
                                                <div class="modal fade" id="pesanModal<%= item.id %>" tabindex="-1" role="dialog">
                                                    <div class="modal-dialog" role="document">
                                                        <div class="modal-content">
                                                            <div class="modal-header">
                                                                <h5 class="modal-title">Pesan dari <%= item.nama %></h5>
                                                                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <p><strong>Email:</strong> <%= item.email %></p>
                                                                <p><strong>Subjek:</strong> <%= item.subjek || '-' %></p>
                                                                <p><strong>Tanggal:</strong> <%= new Date(item.created_at).toLocaleString('id-ID') %></p>
                                                                <hr>
                                                                <p><strong>Pesan:</strong></p>
                                                                <p><%= item.pesan %></p>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <a href="mailto:<%= item.email %>" class="btn btn-primary">Balas via Email</a>
                                                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Tutup</button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            <% }); %>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <%- include('partials/footer') %>
        </div>
    </div>
    <a class="scroll-to-top rounded" href="#page-top"><i class="fas fa-angle-up"></i></a>
    <script src="/assets/vendor/jquery/jquery.min.js"></script>
    <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/vendor/jquery-easing/jquery.easing.min.js"></script>
    <script src="/assets/js/sb-admin-2.min.js"></script>
    <script src="/assets/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="/assets/vendor/datatables/dataTables.bootstrap4.min.js"></script>
    <script>
        $(document).ready(function() { $('#dataTable').DataTable({ order: [] }); });

        // Check all
        document.getElementById('checkAll').addEventListener('change', function() {
            document.querySelectorAll('.row-check').forEach(cb => cb.checked = this.checked);
            updateBulkActions();
        });

        document.querySelectorAll('.row-check').forEach(cb => {
            cb.addEventListener('change', updateBulkActions);
        });

        function updateBulkActions() {
            const checked = document.querySelectorAll('.row-check:checked');
            const count = checked.length;
            document.getElementById('selectedCount').textContent = count;
            document.getElementById('bulkActions').style.display = count > 0 ? 'block' : 'none';

            // Update hidden inputs
            const container = document.getElementById('bulkIdsContainer');
            container.innerHTML = '';
            checked.forEach(cb => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'ids[]';
                input.value = cb.value;
                container.appendChild(input);
            });
        }
    </script>
</body>
</html>

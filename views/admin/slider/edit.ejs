<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title><%= title %> - Admin Panel</title>
    <link rel="icon" type="image/png" href="/assets/img/favicon.png?v=4">
    <link href="/assets/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">    <link href="/assets/css/sb-admin-2.min.css" rel="stylesheet">
</head>
<body id="page-top">
    <div id="wrapper">
        <%- include('../partials/sidebar') %>
        <div id="content-wrapper" class="d-flex flex-column">
            <div id="content">
                <%- include('../partials/topbar', { user }) %>
                <div class="container-fluid">
                    <div class="d-sm-flex align-items-center justify-content-between mb-4">
                        <h1 class="h3 mb-0 text-gray-800">Edit Slider</h1>
                        <a href="/admin/slider" class="d-none d-sm-inline-block btn btn-sm btn-secondary shadow-sm">
                            <i class="fas fa-arrow-left fa-sm text-white-50"></i> Kembali
                        </a>
                    </div>

                    <div class="row">
                        <div class="col-lg-8">
                            <div class="card shadow mb-4">
                                <div class="card-header py-3">
                                    <h6 class="m-0 font-weight-bold text-primary">Form Edit Slider</h6>
                                </div>
                                <div class="card-body">
                                    <form method="POST" action="/admin/slider/edit/<%= slider.id %>" enctype="multipart/form-data">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <div class="form-group">
                                            <label for="judul">Judul *</label>
                                            <input type="text" class="form-control" id="judul" name="judul" value="<%= slider.judul %>" required>
                                        </div>
                                        
                                        <div class="form-group">
                                            <label for="subjudul">Subjudul</label>
                                            <input type="text" class="form-control" id="subjudul" name="subjudul" value="<%= slider.subjudul || '' %>">
                                        </div>
                                        
                                        <div class="form-group">
                                            <label for="deskripsi">Deskripsi</label>
                                            <textarea class="form-control" id="deskripsi" name="deskripsi" rows="3"><%= slider.deskripsi || '' %></textarea>
                                        </div>
                                        
                                        <div class="form-group">
                                            <label for="gambar">Gambar Slider</label>
                                            <% if (slider.gambar) { %>
                                                <div class="mb-2">
                                                    <img src="/uploads/<%= slider.gambar %>" alt="Current Image" style="max-width: 300px; height: auto; border-radius: 5px;">
                                                </div>
                                            <% } %>
                                            <input type="file" class="form-control-file" id="gambar" name="gambar" accept="image/*">
                                            <small class="form-text text-muted">
                                                Kosongkan jika tidak ingin mengubah. Format: JPG/PNG. Maks 10MB.
                                                <strong class="text-danger">Ukuran ideal: 1920 x 860 px</strong>
                                                (lebar penuh, tinggi disesuaikan tampilan layar)
                                            </small>
                                        </div>
                                        
                                        <div class="form-group">
                                            <label for="link_url">URL Link (opsional)</label>
                                            <input type="url" class="form-control" id="link_url" name="link_url" value="<%= slider.link_url || '' %>" placeholder="https://example.com">
                                        </div>
                                        
                                        <div class="form-group">
                                            <label for="link_text">Teks Link (opsional)</label>
                                            <input type="text" class="form-control" id="link_text" name="link_text" value="<%= slider.link_text || '' %>" placeholder="Pelajari Lebih Lanjut">
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="posisi_teks">Posisi Teks</label>
                                                    <select class="form-control" id="posisi_teks" name="posisi_teks">
                                                        <option value="kiri" <%= (slider.posisi_teks || 'tengah') === 'kiri' ? 'selected' : '' %>>Kiri</option>
                                                        <option value="tengah" <%= (slider.posisi_teks || 'tengah') === 'tengah' ? 'selected' : '' %>>Tengah</option>
                                                        <option value="kanan" <%= slider.posisi_teks === 'kanan' ? 'selected' : '' %>>Kanan</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="animasi_teks">Animasi Teks & Tombol</label>
                                                    <select class="form-control" id="animasi_teks" name="animasi_teks">
                                                        <% animations.forEach(function(anim) { %>
                                                        <option value="<%= anim.value %>" <%= (slider.animasi_teks || 'slide-up') === anim.value ? 'selected' : '' %>><%= anim.label %></option>
                                                        <% }) %>
                                                    </select>
                                                    <small class="form-text text-muted" id="anim_desc"></small>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="form-group">
                                            <label for="urutan">Urutan</label>
                                            <input type="number" class="form-control" id="urutan" name="urutan" value="<%= slider.urutan %>" min="0">
                                            <small class="form-text text-muted">Semakin kecil angka, semakin awal ditampilkan</small>
                                        </div>
                                        
                                        <div class="form-group">
                                            <label for="status">Status</label>
                                            <select class="form-control" id="status" name="status">
                                                <option value="aktif" <%= slider.status === 'aktif' ? 'selected' : '' %>>Aktif</option>
                                                <option value="nonaktif" <%= slider.status === 'nonaktif' ? 'selected' : '' %>>Non-aktif</option>
                                            </select>
                                        </div>
                                        
                                        <button type="submit" class="btn btn-primary">Update</button>
                                        <a href="/admin/slider" class="btn btn-secondary">Batal</a>
                                    </form>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-lg-4">
                            <div class="card shadow mb-4">
                                <div class="card-header py-3">
                                    <h6 class="m-0 font-weight-bold text-primary">Panduan</h6>
                                </div>
                                <div class="card-body">
                                    <div class="alert alert-info py-2 px-3 mb-3" style="border-left:4px solid #17a2b8;">
                                        <i class="fas fa-ruler-combined mr-1"></i>
                                        <strong>Ukuran Gambar Slider yang Ideal:</strong>
                                        <div class="mt-2">
                                            <span class="badge badge-success">✓ 1920 x 860 px</span>
                                            <span class="badge badge-success ml-1">✓ 1600 x 720 px</span>
                                            <span class="badge badge-success ml-1">✓ 1280 x 575 px</span>
                                        </div>
                                        <small class="d-block mt-2 text-muted">Rasio lebar:tinggi ≈ <strong>2.23 : 1</strong> (lebih lebar dari 16:9 biasa)</small>
                                        <hr class="my-2">
                                        <small>
                                            <i class="fas fa-info-circle text-info mr-1"></i>
                                            Slider mengisi <strong>tinggi layar penuh</strong> dikurangi navbar (~56px) dan ticker (~44px).
                                            Di layar <strong>768px</strong> tinggi → slider ≈ <strong>668px</strong>.
                                            Di layar <strong>1080px</strong> tinggi → slider ≈ <strong>860px</strong> (maks).
                                        </small>
                                        <div class="mt-2">
                                            <small class="text-danger"><i class="fas fa-times mr-1"></i>Hindari rasio 1:1, 4:3, atau 16:9 — akan tampil terpotong atas-bawah.</small>
                                        </div>
                                    </div>
                                    <h6>Tips Lainnya:</h6>
                                    <ul class="small">
                                        <li>Format <strong>JPG</strong> lebih ringan dari PNG untuk foto</li>
                                        <li>Posisi <strong>Tengah</strong> direkomendasikan untuk tampilan modern</li>
                                        <li>Pilih animasi <strong>Bertahap</strong> untuk efek paling dramatis</li>
                                        <li>Judul singkat, deskripsi maksimal 2-3 kalimat</li>
                                        <li>Angka urutan kecil = tampil lebih awal</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="card shadow mb-4">
                                <div class="card-header py-3">
                                    <h6 class="m-0 font-weight-bold text-primary">Preview Animasi</h6>
                                </div>
                                <div class="card-body p-0">
                                    <div id="anim_preview" style="background:linear-gradient(135deg,#0c4a6e,#0369a1);min-height:160px;display:flex;align-items:center;justify-content:center;overflow:hidden;position:relative;">
                                        <div id="preview_content" style="text-align:center;color:#fff;padding:1rem;">
                                            <div class="preview-item" style="font-size:.75rem;opacity:.85;margin-bottom:.35rem;">Subjudul Contoh</div>
                                            <div class="preview-item" style="font-size:1rem;font-weight:700;margin-bottom:.5rem;">Judul Slider</div>
                                            <div class="preview-item" style="font-size:.8rem;opacity:.9;margin-bottom:.75rem;">Deskripsi singkat slider.</div>
                                            <div class="preview-item"><span style="background:#fff;color:#0369a1;padding:.35rem .9rem;border-radius:50px;font-size:.75rem;font-weight:600;">Tombol</span></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <%- include('../partials/footer') %>
        </div>
    </div>
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>
    <script src="/assets/vendor/jquery/jquery.min.js"></script>
    <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/vendor/jquery-easing/jquery.easing.min.js"></script>
    <script src="/assets/js/sb-admin-2.min.js"></script>
    <style>
        @keyframes prevSlideUp { from { opacity:0; transform:translateY(24px); } to { opacity:1; transform:translateY(0); } }
        @keyframes prevBounce { 0%{opacity:0;transform:translateY(28px)} 70%{opacity:1;transform:translateY(-4px)} 100%{opacity:1;transform:translateY(0)} }
        @keyframes prevZoom { from { opacity:0; transform:translateY(20px) scale(.9); } to { opacity:1; transform:translateY(0) scale(1); } }
        @keyframes prevBlur { from { opacity:0; transform:translateY(18px); filter:blur(6px); } to { opacity:1; transform:translateY(0); filter:blur(0); } }
        @keyframes prevElastic { 0%{opacity:0;transform:translateY(30px)} 60%{opacity:1;transform:translateY(-6px)} 80%{transform:translateY(3px)} 100%{opacity:1;transform:translateY(0)} }
        @keyframes prevFast { from { opacity:0; transform:translateY(14px); } to { opacity:1; transform:translateY(0); } }
        @keyframes prevFlip { from { opacity:0; transform:perspective(400px) rotateX(30deg) translateY(20px); } to { opacity:1; transform:perspective(400px) rotateX(0) translateY(0); } }
        @keyframes prevLong { from { opacity:0; transform:translateY(40px); } to { opacity:1; transform:translateY(0); } }
    </style>
    <script>
    (function() {
        var animList = <%- JSON.stringify(animations) %>;
        var animMap = {
            'slide-up': { anim: 'prevSlideUp', dur: '.7s' },
            'slide-up-bounce': { anim: 'prevBounce', dur: '.8s' },
            'zoom-up': { anim: 'prevZoom', dur: '.75s' },
            'blur-up': { anim: 'prevBlur', dur: '.75s' },
            'elastic-up': { anim: 'prevElastic', dur: '.9s' },
            'fade-up-fast': { anim: 'prevFast', dur: '.45s' },
            'stagger-up': { anim: 'prevSlideUp', dur: '.7s' },
            'flip-up': { anim: 'prevFlip', dur: '.8s' },
            'slide-up-long': { anim: 'prevLong', dur: '.9s' }
        };
        var delays = { normal: [0,.12,.24,.36], stagger: [0,.25,.5,.75] };
        function playPreview() {
            var val = document.getElementById('animasi_teks').value;
            var cfg = animMap[val] || animMap['slide-up'];
            var meta = animList.find(function(a) { return a.value === val; }) || animList[0];
            document.getElementById('anim_desc').textContent = meta.desc;
            var items = document.querySelectorAll('#preview_content .preview-item');
            var ds = val === 'stagger-up' ? delays.stagger : delays.normal;
            items.forEach(function(el, i) {
                el.style.animation = 'none';
                void el.offsetHeight;
                el.style.animation = cfg.anim + ' ' + cfg.dur + ' ease ' + ds[i] + 's both';
            });
            var align = document.getElementById('posisi_teks').value;
            document.getElementById('preview_content').style.textAlign = align === 'kanan' ? 'right' : (align === 'kiri' ? 'left' : 'center');
        }
        document.getElementById('animasi_teks').addEventListener('change', playPreview);
        document.getElementById('posisi_teks').addEventListener('change', playPreview);
        playPreview();
    })();
    </script>
</body>
</html>
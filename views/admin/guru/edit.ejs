<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title><%= title %> - Admin Panel</title>
    <link rel="icon" type="image/png" href="/assets/img/favicon.png?v=4">
    <link href="/assets/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">    <link href="/assets/css/sb-admin-2.min.css" rel="stylesheet">
</head>
<body id="page-top">
    <div id="wrapper">
        <%- include('../partials/sidebar') %>
        <div id="content-wrapper" class="d-flex flex-column">
            <div id="content">
                <%- include('../partials/topbar', { user }) %>
                <div class="container-fluid">
                    <div class="d-sm-flex align-items-center justify-content-between mb-4">
                        <h1 class="h3 mb-0 text-gray-800">Edit Guru</h1>
                        <a href="/admin/data-sekolah?tab=guru" class="d-none d-sm-inline-block btn btn-sm btn-secondary shadow-sm">
                            <i class="fas fa-arrow-left fa-sm text-white-50"></i> Kembali
                        </a>
                    </div>

                    <% if (success === 'foto_hapus') { %>
                    <div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle mr-1"></i>Foto berhasil dihapus. <button type="button" class="close" data-dismiss="alert">&times;</button></div>
                    <% } %>

                    <div class="row">
                        <div class="col-lg-8">
                            <div class="card shadow mb-4">
                                <div class="card-header py-3">
                                    <h6 class="m-0 font-weight-bold text-primary">Form Edit Guru</h6>
                                </div>
                                <div class="card-body">
                                    <form method="POST" action="/admin/guru/edit/<%= guru.id %>" enctype="multipart/form-data">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <div class="form-group">
                                            <label for="nip">NIP</label>
                                            <input type="text" class="form-control" id="nip" name="nip" value="<%= guru.nip || '' %>">
                                        </div>
                                        
                                        <div class="form-group">
                                            <label for="nama">Nama Lengkap *</label>
                                            <input type="text" class="form-control" id="nama" name="nama" value="<%= guru.nama %>" required>
                                        </div>
                                        
                                        <div class="form-group">
                                            <label for="mata_pelajaran">Mata Pelajaran</label>
                                            <input type="text" class="form-control" id="mata_pelajaran" name="mata_pelajaran" value="<%= guru.mata_pelajaran || '' %>">
                                        </div>
                                        
                                        <div class="form-group">
                                            <label for="jabatan">Jabatan</label>
                                            <input type="text" class="form-control" id="jabatan" name="jabatan" value="<%= guru.jabatan || '' %>" placeholder="Contoh: Guru, Kepala Sekolah, Wakil Kepala">
                                        </div>

                                        <div class="form-group">
                                            <label for="jenis_kelamin">Jenis Kelamin</label>
                                            <select class="form-control" id="jenis_kelamin" name="jenis_kelamin">
                                                <option value="">-- Pilih --</option>
                                                <option value="L" <%= guru.jenis_kelamin === 'L' ? 'selected' : '' %>>Laki-laki</option>
                                                <option value="P" <%= guru.jenis_kelamin === 'P' ? 'selected' : '' %>>Perempuan</option>
                                            </select>
                                        </div>
                                        
                                        <div class="form-group">
                                            <label for="email">Email</label>
                                            <input type="email" class="form-control" id="email" name="email" value="<%= guru.email || '' %>">
                                        </div>
                                        
                                        <div class="form-group">
                                            <label for="telepon">Telepon</label>
                                            <input type="text" class="form-control" id="telepon" name="telepon" value="<%= guru.telepon || '' %>">
                                        </div>

                                        <div class="form-group">
                                            <label for="alamat">Alamat</label>
                                            <textarea class="form-control" id="alamat" name="alamat" rows="3" placeholder="Alamat lengkap guru"><%= guru.alamat || '' %></textarea>
                                        </div>

                                        <hr>
                                        <h6 class="font-weight-bold text-primary mb-3"><i class="fas fa-key mr-1"></i> Akun Login Portal Guru</h6>
                                        <div class="form-group">
                                            <label for="guru_username">Username Login</label>
                                            <input type="hidden" name="guru_username_lama" value="<%= guru.guru_username || '' %>">
                                            <input type="text" class="form-control" id="guru_username" name="guru_username" value="<%= guru.guru_username || '' %>" placeholder="Kosongkan jika tidak ingin mengubah">
                                            <small class="form-text text-muted">Username saat ini: <strong><%= guru.guru_username || '(belum diset)' %></strong></small>
                                        </div>
                                        <div class="form-group">
                                            <label for="guru_password">Password Baru</label>
                                            <input type="password" class="form-control" id="guru_password" name="guru_password" minlength="6" placeholder="Kosongkan jika tidak ingin mengubah password">
                                            <small class="form-text text-muted">Isi hanya jika ingin reset password guru.</small>
                                        </div>
                                        
                                        <div class="form-group">
                                            <label for="foto">Foto</label>
                                            <% if (guru.foto) { %>
                                                <div class="mb-2 d-flex align-items-center gap-2">
                                                    <img src="/uploads/<%= guru.foto %>" alt="<%= guru.nama %>" style="width: 120px; height: 120px; object-fit: cover; border-radius: 10px; border: 2px solid #e3e6f0;">
                                                    <form method="POST" action="/admin/guru/delete-foto/<%= guru.id %>" style="display:inline;" onsubmit="return confirm('Hapus foto ini?')">
                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                        <button type="submit" class="btn btn-danger btn-sm ml-2">
                                                            <i class="fas fa-trash mr-1"></i> Hapus Foto
                                                        </button>
                                                    </form>
                                                </div>
                                            <% } else { %>
                                                <div class="mb-2 text-muted small"><i class="fas fa-image mr-1"></i>Belum ada foto</div>
                                            <% } %>
                                            <input type="file" class="form-control-file" id="foto" name="foto" accept=".jpg,.jpeg,.png,.webp">
                                            <small class="form-text text-muted">Format: JPG, PNG, WebP. Ukuran maksimal: 10MB. <%= guru.foto ? 'Pilih file baru untuk mengganti foto.' : '' %></small>
                                        </div>
                                        
                                        <button type="submit" class="btn btn-primary">Update</button>
                                        <a href="/admin/data-sekolah?tab=guru" class="btn btn-secondary">Batal</a>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <%- include('../partials/footer') %>
        </div>
    </div>
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>
    <script src="/assets/vendor/jquery/jquery.min.js"></script>
    <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/vendor/jquery-easing/jquery.easing.min.js"></script>
    <script src="/assets/js/sb-admin-2.min.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Edit Jurusan - Admin Panel</title>
    <link rel="icon" type="image/png" href="/assets/img/favicon.png?v=4">    <link href="/assets/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="/assets/css/sb-admin-2.min.css" rel="stylesheet">
</head>

<body id="page-top">
    <div id="wrapper">
        <%- include('../partials/sidebar') %>
        
        <div id="content-wrapper" class="d-flex flex-column">
            <div id="content">
                <%- include('../partials/topbar', { user }) %>
                
                <div class="container-fluid">
                    <!-- Page Heading -->
                    <div class="d-sm-flex align-items-center justify-content-between mb-4">
                        <h1 class="h3 mb-0 text-gray-800">Edit Jurusan</h1>
                        <a href="/admin/data-sekolah?tab=jurusan" class="btn btn-secondary btn-sm">
                            <i class="fas fa-arrow-left"></i> Kembali
                        </a>
                    </div>

                    <div class="row">
                        <div class="col-lg-8">
                            <div class="card shadow mb-4">
                                <div class="card-header py-3">
                                    <h6 class="m-0 font-weight-bold text-primary">Form Edit Jurusan</h6>
                                </div>
                                <div class="card-body">
                                    <form action="/admin/jurusan/edit/<%= jurusan.id %>" method="POST">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label>Kode Jurusan <span class="text-danger">*</span></label>
                                                    <input type="text" class="form-control" id="kode" name="kode" value="<%= jurusan.kode %>" required maxlength="10">
                                                </div>
                                            </div>
                                            <div class="col-md-8">
                                                <div class="form-group">
                                                    <label>Nama Jurusan <span class="text-danger">*</span></label>
                                                    <input type="text" class="form-control" name="nama" value="<%= jurusan.nama %>" required maxlength="100">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label>Deskripsi</label>
                                            <textarea class="form-control" name="deskripsi" rows="3"><%= jurusan.deskripsi || '' %></textarea>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label>Kepala Jurusan</label>
                                                    <input type="text" class="form-control" name="kepala_jurusan" value="<%= jurusan.kepala_jurusan || '' %>" maxlength="100">
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label>Status</label>
                                                    <select class="form-control" name="status">
                                                        <option value="aktif" <%= jurusan.status === 'aktif' ? 'selected' : '' %>>Aktif</option>
                                                        <option value="nonaktif" <%= jurusan.status === 'nonaktif' ? 'selected' : '' %>>Nonaktif</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label>Icon <small class="text-muted">(Font Awesome class)</small></label>
                                                    <input type="text" class="form-control" name="icon" value="<%= jurusan.icon || 'fas fa-graduation-cap' %>" placeholder="fas fa-graduation-cap">
                                                    <small class="text-muted">Contoh: fas fa-network-wired, fas fa-car, fas fa-utensils</small>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label>Warna Kartu</label>
                                                    <select class="form-control" name="warna">
                                                        <option value="linear-gradient(135deg,#0ea5e9,#0369a1)" <%= (jurusan.warna||'').includes('#0ea5e9') ? 'selected' : '' %>>Biru</option>
                                                        <option value="linear-gradient(135deg,#f59e0b,#d97706)" <%= (jurusan.warna||'').includes('#f59e0b') ? 'selected' : '' %>>Kuning/Oranye</option>
                                                        <option value="linear-gradient(135deg,#ef4444,#dc2626)" <%= (jurusan.warna||'').includes('#ef4444') ? 'selected' : '' %>>Merah</option>
                                                        <option value="linear-gradient(135deg,#10b981,#059669)" <%= (jurusan.warna||'').includes('#10b981') ? 'selected' : '' %>>Hijau</option>
                                                        <option value="linear-gradient(135deg,#8b5cf6,#7c3aed)" <%= (jurusan.warna||'').includes('#8b5cf6') ? 'selected' : '' %>>Ungu</option>
                                                        <option value="linear-gradient(135deg,#ec4899,#db2777)" <%= (jurusan.warna||'').includes('#ec4899') ? 'selected' : '' %>>Pink</option>
                                                        <option value="linear-gradient(135deg,#6366f1,#4f46e5)" <%= (jurusan.warna||'').includes('#6366f1') ? 'selected' : '' %>>Indigo</option>
                                                        <option value="linear-gradient(135deg,#14b8a6,#0d9488)" <%= (jurusan.warna||'').includes('#14b8a6') ? 'selected' : '' %>>Teal</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>

                                        <hr>
                                        <button type="submit" class="btn btn-primary">
                                            <i class="fas fa-save"></i> Simpan Perubahan
                                        </button>
                                        <a href="/admin/data-sekolah?tab=jurusan" class="btn btn-secondary ml-2">
                                            <i class="fas fa-times"></i> Batal
                                        </a>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="card shadow mb-4">
                                <div class="card-header py-3">
                                    <h6 class="m-0 font-weight-bold text-info">
                                        <i class="fas fa-info-circle"></i> Informasi Jurusan
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <table class="table table-sm table-borderless">
                                        <tr>
                                            <td><strong>ID:</strong></td>
                                            <td><%= jurusan.id %></td>
                                        </tr>
                                        <tr>
                                            <td><strong>Jumlah Siswa:</strong></td>
                                            <td><span class="badge badge-info"><%= jumlahSiswa %> siswa</span></td>
                                        </tr>
                                        <tr>
                                            <td><strong>Dibuat:</strong></td>
                                            <td><%= new Date(jurusan.created_at).toLocaleDateString('id-ID') %></td>
                                        </tr>
                                        <tr>
                                            <td><strong>Diperbarui:</strong></td>
                                            <td><%= new Date(jurusan.updated_at).toLocaleDateString('id-ID') %></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <% if (jumlahSiswa > 0) { %>
                            <div class="card shadow mb-4 border-left-warning">
                                <div class="card-body">
                                    <div class="text-warning small">
                                        <i class="fas fa-exclamation-triangle"></i>
                                        <strong>Perhatian:</strong> Jurusan ini memiliki <%= jumlahSiswa %> siswa. Perubahan nama jurusan akan mempengaruhi data siswa.
                                    </div>
                                </div>
                            </div>
                            <% } %>

                            <div class="card shadow mb-4">
                                <div class="card-header py-3">
                                    <h6 class="m-0 font-weight-bold text-success">
                                        <i class="fas fa-users"></i> Siswa Jurusan Ini
                                    </h6>
                                </div>
                                <div class="card-body text-center">
                                    <% if (jumlahSiswa > 0) { %>
                                        <h3 class="text-success"><%= jumlahSiswa %></h3>
                                        <p class="small text-muted">Siswa aktif</p>
                                        <a href="/admin/siswa?jurusan=<%= encodeURIComponent(jurusan.nama) %>" class="btn btn-sm btn-success">
                                            <i class="fas fa-eye"></i> Lihat Siswa
                                        </a>
                                    <% } else { %>
                                        <i class="fas fa-users fa-3x text-muted mb-2"></i>
                                        <p class="small text-muted">Belum ada siswa</p>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <%- include('../partials/footer') %>
        </div>
    </div>

    <!-- Scripts -->
    <script src="/assets/vendor/jquery/jquery.min.js"></script>
    <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/vendor/jquery-easing/jquery.easing.min.js"></script>
    <script src="/assets/js/sb-admin-2.min.js"></script>

    <script>
    // Auto uppercase kode
    document.getElementById('kode').addEventListener('input', function(e) {
        this.value = this.value.toUpperCase();
    });
    </script>
</body>
</html>
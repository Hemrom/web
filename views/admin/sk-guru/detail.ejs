<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title><%= title %> - Admin Panel</title>
    <link rel="icon" type="image/png" href="/assets/img/favicon.png?v=4">
    <link href="/assets/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">
    <link href="/assets/css/sb-admin-2.min.css" rel="stylesheet">
    <link href="/assets/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">
    <style>
        .guru-avatar { width:40px; height:40px; border-radius:50%; object-fit:cover; }
        .guru-avatar-placeholder { width:40px; height:40px; border-radius:50%; background:linear-gradient(135deg,#4e73df,#224abe); display:flex; align-items:center; justify-content:center; color:white; font-weight:700; font-size:.95rem; }
        .info-row { display:flex; gap:.5rem; align-items:baseline; margin-bottom:.5rem; }
        .info-row .label { min-width:130px; font-size:.8rem; color:#6b7280; font-weight:600; text-transform:uppercase; letter-spacing:.04em; }
        .info-row .value { font-size:.95rem; color:#1e293b; }
    </style>
</head>
<body id="page-top">
<div id="wrapper">
    <%- include('../partials/sidebar') %>
    <div id="content-wrapper" class="d-flex flex-column">
        <div id="content">
            <%- include('../partials/topbar', { user }) %>
            <div class="container-fluid">

                <div class="d-sm-flex align-items-center justify-content-between mb-4">
                    <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-file-alt mr-2 text-primary"></i>Detail SK Guru</h1>
                    <div>
                        <a href="/admin/sk-guru/edit/<%= sk.id %>" class="btn btn-sm btn-warning shadow-sm mr-2">
                            <i class="fas fa-edit mr-1"></i>Edit SK
                        </a>
                        <a href="/admin/sk-guru" class="btn btn-sm btn-secondary shadow-sm">
                            <i class="fas fa-arrow-left mr-1"></i>Kembali
                        </a>
                    </div>
                </div>

                <div class="row">
                    <!-- Info SK -->
                    <div class="col-lg-5">
                        <div class="card shadow mb-4">
                            <div class="card-header py-3">
                                <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-info-circle mr-2"></i>Informasi SK</h6>
                            </div>
                            <div class="card-body">
                                <% const jenisColor = { sk_mengajar: 'primary', sk_tugas_tambahan: 'success', lainnya: 'secondary' }; %>
                                <div class="mb-3">
                                    <span class="badge badge-<%= jenisColor[sk.jenis] || 'secondary' %> badge-pill px-3 py-2" style="font-size:.85rem;">
                                        <% if (sk.jenis === 'sk_mengajar') { %><i class="fas fa-chalkboard-teacher mr-1"></i>
                                        <% } else if (sk.jenis === 'sk_tugas_tambahan') { %><i class="fas fa-briefcase mr-1"></i>
                                        <% } else { %><i class="fas fa-file mr-1"></i><% } %>
                                        <%= jenisLabel[sk.jenis] || sk.jenis %>
                                    </span>
                                    <span class="badge badge-<%= sk.status === 'aktif' ? 'success' : 'secondary' %> badge-pill px-3 py-2 ml-2" style="font-size:.85rem;">
                                        <%= sk.status %>
                                    </span>
                                </div>

                                <h5 class="font-weight-bold text-dark mb-3"><%= sk.judul %></h5>

                                <div class="info-row">
                                    <span class="label">Nomor SK</span>
                                    <span class="value"><%= sk.nomor_sk || '-' %></span>
                                </div>
                                <div class="info-row">
                                    <span class="label">Tahun Ajaran</span>
                                    <span class="value"><%= sk.tahun_ajaran || '-' %></span>
                                </div>
                                <div class="info-row">
                                    <span class="label">Tanggal SK</span>
                                    <span class="value">
                                        <% if (sk.tanggal_sk) { %>
                                        <%= new Date(sk.tanggal_sk).toLocaleDateString('id-ID', { day:'2-digit', month:'long', year:'numeric' }) %>
                                        <% } else { %>-<% } %>
                                    </span>
                                </div>
                                <div class="info-row">
                                    <span class="label">Dibuat oleh</span>
                                    <span class="value"><%= sk.nama_pembuat || 'Admin' %></span>
                                </div>
                                <div class="info-row">
                                    <span class="label">Upload tanggal</span>
                                    <span class="value">
                                        <%= new Date(sk.created_at).toLocaleDateString('id-ID', { day:'2-digit', month:'long', year:'numeric', hour:'2-digit', minute:'2-digit' }) %>
                                    </span>
                                </div>
                                <% if (sk.deskripsi) { %>
                                <hr>
                                <p class="text-muted small"><%= sk.deskripsi %></p>
                                <% } %>

                                <hr>
                                <div class="d-flex align-items-center gap-2">
                                    <% const tipeColor = { PDF:'danger', DOC:'primary', DOCX:'primary', XLS:'success', XLSX:'success', PPT:'warning', PPTX:'warning', ZIP:'secondary', RAR:'secondary' }; %>
                                    <span class="badge badge-<%= tipeColor[sk.tipe_file] || 'info' %> px-3 py-2" style="font-size:.85rem;">
                                        <i class="fas fa-file mr-1"></i><%= sk.tipe_file %>
                                    </span>
                                    <span class="text-muted small"><%= sk.ukuran_file %></span>
                                    <span class="text-muted small flex-grow-1 text-truncate"><%= sk.nama_file_asli || sk.nama_file %></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Daftar Penerima -->
                    <div class="col-lg-7">
                        <div class="card shadow mb-4">
                            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                                <h6 class="m-0 font-weight-bold text-primary">
                                    <i class="fas fa-users mr-2"></i>Daftar Penerima
                                </h6>
                                <div>
                                    <span class="badge badge-primary badge-pill mr-2"><%= penerima.length %> guru</span>
                                    <% const sudahBaca = penerima.filter(p => p.dibaca).length; %>
                                    <span class="badge badge-success badge-pill" title="Sudah download">
                                        <i class="fas fa-download mr-1"></i><%= sudahBaca %> sudah download
                                    </span>
                                </div>
                            </div>
                            <div class="card-body p-0">
                                <% if (!penerima.length) { %>
                                <div class="text-center py-5 text-muted">
                                    <i class="fas fa-user-slash fa-3x mb-3 d-block"></i>
                                    SK ini belum ditugaskan ke guru manapun.<br>
                                    <a href="/admin/sk-guru/edit/<%= sk.id %>" class="btn btn-sm btn-primary mt-2">
                                        <i class="fas fa-user-plus mr-1"></i>Tambah Penerima
                                    </a>
                                </div>
                                <% } else { %>
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0" id="tabelPenerima">
                                        <thead class="thead-light">
                                            <tr>
                                                <th>Guru</th>
                                                <th>Jabatan</th>
                                                <th>NIP</th>
                                                <th>Status Download</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% penerima.forEach(p => { %>
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <% if (p.foto) { %>
                                                        <img src="/uploads/<%= p.foto %>" class="guru-avatar" alt="<%= p.nama %>">
                                                        <% } else { %>
                                                        <div class="guru-avatar-placeholder"><%= p.nama.charAt(0) %></div>
                                                        <% } %>
                                                        <span class="font-weight-bold" style="font-size:.9rem;"><%= p.nama %></span>
                                                    </div>
                                                </td>
                                                <td><small><%= p.jabatan || '-' %></small></td>
                                                <td><small class="text-muted"><%= p.nip || '-' %></small></td>
                                                <td>
                                                    <% if (p.dibaca) { %>
                                                    <span class="badge badge-success">
                                                        <i class="fas fa-check-circle mr-1"></i>Sudah download
                                                    </span>
                                                    <br>
                                                    <small class="text-muted">
                                                        <%= new Date(p.tanggal_dibaca).toLocaleDateString('id-ID', { day:'2-digit', month:'short', year:'numeric' }) %>
                                                    </small>
                                                    <% } else { %>
                                                    <span class="badge badge-secondary">
                                                        <i class="fas fa-clock mr-1"></i>Belum download
                                                    </span>
                                                    <% } %>
                                                </td>
                                            </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        <%- include('../partials/footer') %>
    </div>
</div>
<a class="scroll-to-top rounded" href="#page-top"><i class="fas fa-angle-up"></i></a>
<script src="/assets/vendor/jquery/jquery.min.js"></script>
<script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/assets/vendor/datatables/jquery.dataTables.min.js"></script>
<script src="/assets/vendor/datatables/dataTables.bootstrap4.min.js"></script>
<script src="/assets/js/sb-admin-2.min.js"></script>
<script>
$(document).ready(function() {
    if ($('#tabelPenerima tbody tr').length > 5) {
        $('#tabelPenerima').DataTable({
            pageLength: 10,
            language: { url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/id.json' }
        });
    }
});
</script>
</body>
</html>

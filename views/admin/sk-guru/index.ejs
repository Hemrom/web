<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title><%= title %> - Admin Panel</title>
    <link rel="icon" type="image/png" href="/assets/img/favicon.png?v=4">
    <link href="/assets/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">
    <link href="/assets/css/sb-admin-2.min.css" rel="stylesheet">
    <link href="/assets/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">
</head>
<body id="page-top">
<div id="wrapper">
    <%- include('../partials/sidebar') %>
    <div id="content-wrapper" class="d-flex flex-column">
        <div id="content">
            <%- include('../partials/topbar', { user }) %>
            <div class="container-fluid">

                <div class="d-sm-flex align-items-center justify-content-between mb-4">
                    <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-file-alt mr-2 text-primary"></i>Kelola SK Guru</h1>
                    <a href="/admin/sk-guru/create" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
                        <i class="fas fa-upload fa-sm text-white-50 mr-1"></i>Upload SK Baru
                    </a>
                </div>

                <% if (success) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <% if (success === 'created') { %><i class="fas fa-check-circle mr-1"></i>SK berhasil diupload dan dikirim ke guru.
                    <% } else if (success === 'updated') { %><i class="fas fa-check-circle mr-1"></i>SK berhasil diperbarui.
                    <% } else if (success === 'deleted') { %><i class="fas fa-check-circle mr-1"></i>SK berhasil dihapus.
                    <% } %>
                    <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                </div>
                <% } %>

                <!-- Statistik ringkas -->
                <div class="row mb-4">
                    <div class="col-md-4 col-sm-6 mb-3">
                        <div class="card border-left-primary shadow h-100 py-2">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">SK Mengajar</div>
                                        <div class="h5 mb-0 font-weight-bold text-gray-800">
                                            <%= skList.filter(s => s.jenis === 'sk_mengajar').length %>
                                        </div>
                                    </div>
                                    <div class="col-auto"><i class="fas fa-chalkboard-teacher fa-2x text-gray-300"></i></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 col-sm-6 mb-3">
                        <div class="card border-left-success shadow h-100 py-2">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">SK Tugas Tambahan</div>
                                        <div class="h5 mb-0 font-weight-bold text-gray-800">
                                            <%= skList.filter(s => s.jenis === 'sk_tugas_tambahan').length %>
                                        </div>
                                    </div>
                                    <div class="col-auto"><i class="fas fa-briefcase fa-2x text-gray-300"></i></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 col-sm-6 mb-3">
                        <div class="card border-left-info shadow h-100 py-2">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Total SK</div>
                                        <div class="h5 mb-0 font-weight-bold text-gray-800"><%= skList.length %></div>
                                    </div>
                                    <div class="col-auto"><i class="fas fa-file-alt fa-2x text-gray-300"></i></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card shadow mb-4">
                    <div class="card-header py-3 d-flex justify-content-between align-items-center">
                        <h6 class="m-0 font-weight-bold text-primary">Daftar SK Guru</h6>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                                <thead class="thead-light">
                                    <tr>
                                        <th width="40">No</th>
                                        <th>Judul SK</th>
                                        <th>Jenis</th>
                                        <th>Nomor SK</th>
                                        <th>Tahun Ajaran</th>
                                        <th>Penerima</th>
                                        <th>Tipe</th>
                                        <th>Status</th>
                                        <th>Tanggal Upload</th>
                                        <th width="140">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (!skList.length) { %>
                                    <tr><td colspan="10" class="text-center text-muted py-4">
                                        <i class="fas fa-inbox fa-2x mb-2 d-block"></i>Belum ada SK yang diupload
                                    </td></tr>
                                    <% } else { %>
                                    <% skList.forEach((sk, i) => { %>
                                    <tr>
                                        <td><%= i + 1 %></td>
                                        <td>
                                            <a href="/admin/sk-guru/detail/<%= sk.id %>" class="text-dark font-weight-bold">
                                                <%= sk.judul %>
                                            </a>
                                            <% if (sk.deskripsi) { %>
                                            <br><small class="text-muted"><%= sk.deskripsi.substring(0, 60) %><%= sk.deskripsi.length > 60 ? '...' : '' %></small>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% const jenisColor = { sk_mengajar: 'primary', sk_tugas_tambahan: 'success', lainnya: 'secondary' }; %>
                                            <span class="badge badge-<%= jenisColor[sk.jenis] || 'secondary' %>">
                                                <%= jenisLabel[sk.jenis] || sk.jenis %>
                                            </span>
                                        </td>
                                        <td><small><%= sk.nomor_sk || '-' %></small></td>
                                        <td><small><%= sk.tahun_ajaran || '-' %></small></td>
                                        <td>
                                            <a href="/admin/sk-guru/detail/<%= sk.id %>" class="badge badge-info" title="Lihat penerima">
                                                <i class="fas fa-users mr-1"></i><%= sk.jumlah_penerima %> guru
                                            </a>
                                        </td>
                                        <td>
                                            <% const tipeColor = { PDF:'danger', DOC:'primary', DOCX:'primary', XLS:'success', XLSX:'success', PPT:'warning', PPTX:'warning', ZIP:'secondary', RAR:'secondary' }; %>
                                            <span class="badge badge-<%= tipeColor[sk.tipe_file] || 'info' %>">
                                                <%= sk.tipe_file || '-' %>
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge badge-<%= sk.status === 'aktif' ? 'success' : 'secondary' %>">
                                                <%= sk.status %>
                                            </span>
                                        </td>
                                        <td><small><%= new Date(sk.created_at).toLocaleDateString('id-ID', { day:'2-digit', month:'short', year:'numeric' }) %></small></td>
                                        <td>
                                            <a href="/admin/sk-guru/detail/<%= sk.id %>" class="btn btn-info btn-sm mb-1" title="Detail & Penerima">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="/admin/sk-guru/edit/<%= sk.id %>" class="btn btn-warning btn-sm mb-1" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form action="/admin/sk-guru/delete/<%= sk.id %>" method="POST" style="display:inline;"
                                                  onsubmit="return confirm('Yakin hapus SK ini? File akan ikut terhapus.')">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" class="btn btn-danger btn-sm mb-1" title="Hapus">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                    <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        <%- include('../partials/footer') %>
    </div>
</div>
<a class="scroll-to-top rounded" href="#page-top"><i class="fas fa-angle-up"></i></a>
<script src="/assets/vendor/jquery/jquery.min.js"></script>
<script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/assets/vendor/datatables/jquery.dataTables.min.js"></script>
<script src="/assets/vendor/datatables/dataTables.bootstrap4.min.js"></script>
<script src="/assets/js/sb-admin-2.min.js"></script>
<script>
$(document).ready(function() {
    $('#dataTable').DataTable({
        order: [[8, 'desc']],
        language: {
            url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/id.json'
        }
    });
});
</script>
</body>
</html>

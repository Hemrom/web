<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title><%= title %> - Admin Panel</title>
    <link href="/assets/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">
    <link href="/assets/css/sb-admin-2.min.css" rel="stylesheet">
</head>
<body id="page-top">
    <div id="wrapper">
        <%- include('../partials/sidebar') %>
        <div id="content-wrapper" class="d-flex flex-column">
            <div id="content">
                <%- include('../partials/topbar', { user }) %>
                <div class="container-fluid">
                    <div class="d-sm-flex align-items-center justify-content-between mb-4">
                        <h1 class="h3 mb-0 text-gray-800">Kelola Galeri</h1>
                        <a href="/admin/galeri/create" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
                            <i class="fas fa-plus fa-sm text-white-50"></i> Tambah Foto
                        </a>
                    </div>

                    <div class="row">
                        <% if (galeri.length === 0) { %>
                            <div class="col-12">
                                <div class="alert alert-info">Belum ada foto di galeri</div>
                            </div>
                        <% } else { %>
                            <% galeri.forEach(item => { %>
                                <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                                    <div class="card shadow">
                                        <img src="/uploads/<%= item.gambar %>" class="card-img-top" alt="<%= item.judul %>" style="height: 200px; object-fit: cover;">
                                        <div class="card-body">
                                            <h6 class="card-title"><%= item.judul %></h6>
                                            <p class="card-text small text-muted"><%= item.deskripsi || '-' %></p>
                                            <% if (item.kategori) { %>
                                                <span class="badge badge-info"><%= item.kategori %></span>
                                            <% } %>
                                            <div class="mt-2">
                                                <form method="POST" action="/admin/galeri/delete/<%= item.id %>" 
                                                      style="display: inline;" 
                                                      onsubmit="return confirm('Yakin ingin menghapus foto ini?')">
                                                    <button type="submit" class="btn btn-danger btn-sm">
                                                        <i class="fas fa-trash"></i> Hapus
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        <% } %>
                    </div>
                </div>
            </div>
            <%- include('../partials/footer') %>
        </div>
    </div>
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>
    <script src="/assets/vendor/jquery/jquery.min.js"></script>
    <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/vendor/jquery-easing/jquery.easing.min.js"></script>
    <script src="/assets/js/sb-admin-2.min.js"></script>
</body>
</html>

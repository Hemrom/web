<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title><%= title %> - Admin Panel</title>
    <link rel="icon" type="image/png" href="/assets/img/favicon.png?v=4">
    <link href="/assets/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">    <link href="/assets/css/sb-admin-2.min.css" rel="stylesheet">
    <style>
        .nav-tabs .nav-link { color: #6c757d; font-weight: 500; }
        .nav-tabs .nav-link.active { color: #4e73df; font-weight: 600; border-bottom: 2px solid #4e73df; }
        #btnResetMassal { display: none; }
        .guru-checkbox { cursor: pointer; }
        tr.selected-row td { background-color: #fff8e1 !important; }
    </style>
</head>
<body id="page-top">
<div id="wrapper">
    <%- include('partials/sidebar') %>
    <div id="content-wrapper" class="d-flex flex-column">
        <div id="content">
            <%- include('partials/topbar', { user }) %>
            <div class="container-fluid">
                <h1 class="h3 mb-4 text-gray-800">Data Sekolah</h1>

                <% if (success == 1) { %>
                <div class="alert alert-success alert-dismissible fade show">
                    Data berhasil disimpan.
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                </div>
                <% } %>

                <div class="card shadow mb-4">
                    <div class="card-header p-0">
                        <ul class="nav nav-tabs">
                            <li class="nav-item">
                                <a class="nav-link <%= activeTab === 'guru' ? 'active' : '' %>" href="?tab=guru">
                                    <i class="fas fa-users mr-1"></i> Guru &amp; Staff
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link <%= activeTab === 'siswa' ? 'active' : '' %>" href="?tab=siswa">
                                    <i class="fas fa-user-graduate mr-1"></i> Data Siswa
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link <%= activeTab === 'jurusan' ? 'active' : '' %>" href="?tab=jurusan">
                                    <i class="fas fa-graduation-cap mr-1"></i> Data Jurusan
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link <%= activeTab === 'alumni' ? 'active' : '' %>" href="?tab=alumni">
                                    <i class="fas fa-user-graduate mr-1"></i> Data Alumni
                                    <% if (typeof alumniStats !== 'undefined' && alumniStats && alumniStats.pending > 0) { %>
                                    <span class="badge badge-warning ml-1"><%= alumniStats.pending %></span>
                                    <% } %>
                                </a>
                            </li>
                        </ul>
                    </div>
                    <div class="card-body">

                        <!-- Tab: Guru & Staff -->
                        <% if (activeTab === 'guru') { %>
                        <% const guruMsg = typeof message !== 'undefined' && message ? message : null; %>
                        <% if (guruMsg) { %>
                        <div class="alert alert-<%= guruMsg.type === 'success' ? 'success' : 'danger' %> alert-dismissible fade show">
                            <%= guruMsg.text %>
                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                        <% } %>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0">Guru &amp; Staff
                                <small id="infoSeleksi" class="text-muted font-weight-normal ml-2" style="display:none; font-size:0.8rem;">
                                    — <span id="jumlahDipilih">0</span> dipilih
                                </small>
                            </h5>
                            <div>
                                <!-- Tombol reset muncul saat ada yang dipilih -->
                                <button type="button" id="btnResetMassal"
                                    class="btn btn-warning btn-sm mr-1"
                                    data-toggle="modal" data-target="#modalResetPassword">
                                    <i class="fas fa-key"></i> Reset Password (<span id="jumlahDipilih2">0</span>)
                                </button>
                                <!-- Import -->
                                <button class="btn btn-success btn-sm mr-1" onclick="document.getElementById('importForm').style.display=document.getElementById('importForm').style.display==='none'?'block':'none'">
                                    <i class="fas fa-file-import"></i> Import Excel
                                </button>
                                <!-- Export -->
                                <a href="/admin/guru/export" class="btn btn-warning btn-sm mr-1">
                                    <i class="fas fa-file-export"></i> Export Excel
                                </a>
                                <a href="/admin/guru/sync-cbt" class="btn btn-info btn-sm mr-1">
                                    <i class="fas fa-sync"></i> Sync CBT
                                </a>
                                <a href="/admin/guru/create" class="btn btn-primary btn-sm">
                                    <i class="fas fa-plus"></i> Tambah Guru
                                </a>
                            </div>
                        </div>
                        <!-- Form Import -->
                        <div id="importForm" style="display:none;" class="card border-left-success shadow-sm mb-3">
                            <div class="card-body py-3">
                                <p class="mb-2 small font-weight-bold text-success"><i class="fas fa-info-circle mr-1"></i> Format kolom: NIP, Nama, Mata Pelajaran, Jabatan, Email, Telepon</p>
                                <a href="/admin/guru/template" class="btn btn-outline-secondary btn-sm mb-2">
                                    <i class="fas fa-download mr-1"></i> Download Template
                                </a>
                                <form method="POST" action="/admin/guru/import" enctype="multipart/form-data" class="d-flex align-items-center">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="file" name="file" accept=".xlsx,.xls" class="form-control-file mr-2" required>
                                    <button type="submit" class="btn btn-success btn-sm">Upload &amp; Import</button>
                                </form>
                            </div>
                        </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover">
                                <thead class="thead-light">
                                    <tr>
                                        <th style="width:36px; text-align:center;">
                                            <input type="checkbox" id="selectAllGuru" title="Pilih semua">
                                        </th>
                                        <th>#</th>
                                        <th>Foto</th>
                                        <th>NIP</th>
                                        <th>Nama</th>
                                        <th>Mata Pelajaran</th>
                                        <th>Jabatan</th>
                                        <th>Status Login</th>
                                        <th>Aksi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (!guru || guru.length === 0) { %>
                                    <tr><td colspan="9" class="text-center">Belum ada data guru</td></tr>
                                    <% } else { %>
                                    <% guru.forEach((g, i) => { %>
                                    <tr>
                                        <td style="text-align:center; vertical-align:middle;">
                                            <input type="checkbox" class="guru-checkbox" value="<%= g.id %>" data-nama="<%= g.nama %>">
                                        </td>
                                        <td><%= i+1 %></td>
                                        <td>
                                            <% if (g.foto) { %>
                                            <img src="/uploads/<%= g.foto %>" style="width:40px;height:40px;object-fit:cover;border-radius:50%;">
                                            <% } else { %>
                                            <div style="width:40px;height:40px;background:#e2e8f0;border-radius:50%;display:flex;align-items:center;justify-content:center;">
                                                <i class="fas fa-user text-muted"></i>
                                            </div>
                                            <% } %>
                                        </td>
                                        <td><%= g.nip || '-' %></td>
                                        <td><%= g.nama %></td>
                                        <td><%= g.mata_pelajaran || '-' %></td>
                                        <td><%= g.jabatan || '-' %></td>
                                        <td style="text-align:center;">
                                            <% if (g.guru_username) { %>
                                            <span class="badge badge-success" title="Username: <%= g.guru_username %>">
                                                <i class="fas fa-check mr-1"></i>Ada akun
                                            </span>
                                            <% } else { %>
                                            <span class="badge badge-secondary">
                                                <i class="fas fa-times mr-1"></i>Belum ada
                                            </span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <a href="/admin/guru/edit/<%= g.id %>" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i></a>
                                            <form method="POST" action="/admin/guru/delete/<%= g.id %>" style="display:inline" onsubmit="return confirm('Hapus guru ini?')">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                    <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                        <!-- Modal Reset Password Massal -->
                        <div class="modal fade" id="modalResetPassword" tabindex="-1" role="dialog" aria-labelledby="modalResetPasswordLabel" aria-hidden="true">
                            <div class="modal-dialog" role="document">
                                <div class="modal-content">
                                    <form method="POST" action="/admin/guru/reset-password-massal" id="formResetMassal">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <div id="hiddenIds"></div>
                                        <div class="modal-header" style="background:#f6c23e;">
                                            <h5 class="modal-title" id="modalResetPasswordLabel">
                                                <i class="fas fa-key mr-2"></i>Reset Password Massal
                                            </h5>
                                            <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="alert alert-info py-2 small mb-3">
                                                <i class="fas fa-info-circle mr-1"></i>
                                                Password akan direset untuk <strong><span id="modalJumlah">0</span> guru</strong> yang dipilih.
                                            </div>
                                            <div class="mb-3">
                                                <label class="small font-weight-bold text-muted">Guru yang dipilih:</label>
                                                <div id="daftarNamaGuru" class="border rounded p-2 bg-light small"
                                                     style="max-height:130px; overflow-y:auto;"></div>
                                            </div>
                                            <div class="form-group mb-1">
                                                <label for="password_baru" class="font-weight-bold">Password Baru</label>
                                                <div class="input-group">
                                                    <input type="text" class="form-control" id="password_baru" name="password_baru"
                                                           value="Guru@1234" minlength="6" required placeholder="Min. 6 karakter">
                                                    <div class="input-group-append">
                                                        <button type="button" class="btn btn-outline-secondary"
                                                                onclick="document.getElementById('password_baru').value='Guru@1234'"
                                                                title="Reset ke default">
                                                            <i class="fas fa-undo"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                                <small class="text-muted">Default: <code>Guru@1234</code> &mdash; atau isi password custom.</small>
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Batal</button>
                                            <button type="submit" class="btn btn-warning"
                                                    onclick="return confirm('Yakin reset password semua guru yang dipilih?')">
                                                <i class="fas fa-key mr-1"></i>Reset Password
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- Tab: Siswa -->
                        <% } else if (activeTab === 'siswa') { %>
                        <% const siswaMsg = typeof message !== 'undefined' && message ? message : null; %>
                        <% if (siswaMsg) { %>
                        <div class="alert alert-<%= siswaMsg.type === 'success' ? 'success' : 'danger' %> alert-dismissible fade show">
                            <%= siswaMsg.text %>
                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                        <% } %>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0">Data Siswa</h5>
                            <div>
                                <!-- Import -->
                                <button class="btn btn-success btn-sm mr-1" onclick="toggleImportSiswa()">
                                    <i class="fas fa-file-import"></i> Import Excel
                                </button>
                                <!-- Export -->
                                <a href="/admin/siswa/export" class="btn btn-warning btn-sm mr-1">
                                    <i class="fas fa-file-export"></i> Export Excel
                                </a>
                                <!-- Tambah manual -->
                                <a href="/admin/siswa/create" class="btn btn-primary btn-sm">
                                    <i class="fas fa-plus"></i> Tambah Siswa
                                </a>
                            </div>
                        </div>

                        <!-- Panel Import Excel -->
                        <div id="importSiswaPanel" style="display:none;" class="card border-left-success shadow-sm mb-3">
                            <div class="card-body py-3">
                                <h6 class="font-weight-bold text-success mb-2"><i class="fas fa-info-circle mr-1"></i> Panduan Import Excel Siswa</h6>
                                <p class="small mb-1">Kolom yang tersedia (nama kolom harus persis sama):</p>
                                <div class="table-responsive mb-2">
                                    <table class="table table-sm table-bordered small mb-2" style="font-size:0.78rem;">
                                        <thead class="thead-light">
                                            <tr>
                                                <th>Kolom</th><th>Keterangan</th><th>Wajib</th><th>Contoh</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr><td>NIS</td><td>Nomor Induk Siswa</td><td><span class="badge badge-warning">Opsional</span></td><td>12345</td></tr>
                                            <tr><td>Nama</td><td>Nama lengkap siswa</td><td><span class="badge badge-danger">Wajib</span></td><td>Budi Santoso</td></tr>
                                            <tr><td>Jenis Kelamin (L/P)</td><td>Gunakan L atau P</td><td><span class="badge badge-warning">Opsional</span></td><td>L</td></tr>
                                            <tr><td>Tempat Lahir</td><td>Kota/kabupaten tempat lahir</td><td><span class="badge badge-warning">Opsional</span></td><td>Kediri</td></tr>
                                            <tr><td>Tanggal Lahir (YYYY-MM-DD)</td><td>Format: tahun-bulan-tanggal</td><td><span class="badge badge-warning">Opsional</span></td><td>2008-05-15</td></tr>
                                            <tr><td>Alamat</td><td>Alamat lengkap</td><td><span class="badge badge-warning">Opsional</span></td><td>Jl. Merdeka No.1, Kras</td></tr>
                                            <tr><td>Telepon / No HP</td><td>Nomor HP siswa/wali</td><td><span class="badge badge-warning">Opsional</span></td><td>08123456789</td></tr>
                                            <tr><td>Kelas</td><td>Tingkat kelas (X, XI, XII)</td><td><span class="badge badge-warning">Opsional</span></td><td>XI</td></tr>
                                            <tr><td>Jurusan</td><td>Nama/kode jurusan</td><td><span class="badge badge-warning">Opsional</span></td><td>TKJ</td></tr>
                                            <tr><td>Tahun Masuk</td><td>Tahun pertama masuk sekolah</td><td><span class="badge badge-warning">Opsional</span></td><td>2023</td></tr>
                                            <tr><td>Status (aktif/nonaktif)</td><td>Status siswa</td><td><span class="badge badge-warning">Opsional</span></td><td>aktif</td></tr>
                                        </tbody>
                                    </table>
                                </div>
                                <p class="small text-muted mb-2"><i class="fas fa-lightbulb text-warning"></i> Jika NIS sudah ada di database, data siswa tersebut akan <strong>diperbarui</strong>. Jika belum ada, akan <strong>ditambahkan</strong> sebagai data baru.</p>
                                <a href="/admin/siswa/template" class="btn btn-outline-secondary btn-sm mb-2">
                                    <i class="fas fa-download mr-1"></i> Download Template Excel
                                </a>
                                <form method="POST" action="/admin/siswa/import" enctype="multipart/form-data" class="d-flex align-items-center flex-wrap gap-2 mt-1">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="file" name="file" accept=".xlsx,.xls" class="form-control-file mr-2" required style="max-width:300px;">
                                    <button type="submit" class="btn btn-success btn-sm">
                                        <i class="fas fa-upload mr-1"></i> Upload &amp; Import
                                    </button>
                                </form>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover">
                                <thead class="thead-light">
                                    <tr><th>#</th><th>NIS</th><th>Nama</th><th>Kelas</th><th>Jurusan</th><th>Status</th><th>Aksi</th></tr>
                                </thead>
                                <tbody>
                                    <% if (!siswa || siswa.length === 0) { %>
                                    <tr><td colspan="7" class="text-center">Belum ada data siswa</td></tr>
                                    <% } else { %>
                                    <% siswa.forEach((s, i) => { %>
                                    <tr>
                                        <td><%= i+1 %></td>
                                        <td><%= s.nis %></td>
                                        <td><%= s.nama %></td>
                                        <td><%= s.kelas || '-' %></td>
                                        <td><%= s.jurusan || '-' %></td>
                                        <td><span class="badge badge-<%= s.status === 'aktif' ? 'success' : 'secondary' %>"><%= s.status %></span></td>
                                        <td>
                                            <a href="/admin/siswa/edit/<%= s.id %>" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i></a>
                                            <form method="POST" action="/admin/siswa/delete/<%= s.id %>" style="display:inline" onsubmit="return confirm('Hapus siswa ini?')">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                    <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                        <!-- Tab: Jurusan -->
                        <% } else if (activeTab === 'jurusan') { %>
                        <% if (error === 'has_students') { %>
                        <div class="alert alert-danger alert-dismissible fade show">
                            Jurusan tidak bisa dihapus karena masih memiliki data siswa.
                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                        <% } %>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0">Data Jurusan / Program Keahlian</h5>
                            <a href="/admin/jurusan/create" class="btn btn-primary btn-sm">
                                <i class="fas fa-plus"></i> Tambah Jurusan
                            </a>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover">
                                <thead class="thead-light">
                                    <tr><th>#</th><th>Tampilan</th><th>Kode</th><th>Nama Jurusan</th><th>Kepala Jurusan</th><th>Status</th><th>Aksi</th></tr>
                                </thead>
                                <tbody>
                                    <% if (!jurusan || jurusan.length === 0) { %>
                                    <tr><td colspan="7" class="text-center">Belum ada data jurusan</td></tr>
                                    <% } else { %>
                                    <% jurusan.forEach((j, i) => { %>
                                    <tr>
                                        <td><%= i+1 %></td>
                                        <td>
                                            <div style="width:40px;height:40px;border-radius:8px;background:<%= j.warna || 'linear-gradient(135deg,#0ea5e9,#0369a1)' %>;display:flex;align-items:center;justify-content:center;">
                                                <i class="<%= j.icon || 'fas fa-graduation-cap' %>" style="color:white;font-size:1.1rem;"></i>
                                            </div>
                                        </td>
                                        <td><strong><%= j.kode %></strong></td>
                                        <td><%= j.nama %></td>
                                        <td><%= j.kepala_jurusan || '-' %></td>
                                        <td><span class="badge badge-<%= j.status === 'aktif' ? 'success' : 'secondary' %>"><%= j.status %></span></td>
                                        <td>
                                            <a href="/admin/jurusan/edit/<%= j.id %>" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i></a>
                                            <form method="POST" action="/admin/jurusan/delete/<%= j.id %>" style="display:inline" onsubmit="return confirm('Hapus jurusan <%= j.nama %>?')">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                    <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                        <small class="text-muted"><i class="fas fa-info-circle"></i> Data jurusan akan tampil otomatis di section "Program Keahlian" pada halaman beranda website.</small>

                        <!-- Tab: Alumni -->
                        <% } else if (activeTab === 'alumni') { %>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0">Data Alumni</h5>
                            <div>
                                <% if (typeof alumniStats !== 'undefined' && alumniStats) { %>
                                <span class="badge badge-warning mr-2">Pending: <%= alumniStats.pending %></span>
                                <span class="badge badge-success mr-2">Disetujui: <%= alumniStats.disetujui %></span>
                                <% } %>
                                <a href="/admin/alumni" class="btn btn-primary btn-sm"><i class="fas fa-external-link-alt mr-1"></i>Kelola Alumni Lengkap</a>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover">
                                <thead class="thead-light">
                                    <tr><th>Foto</th><th>Nama</th><th>Lulus</th><th>Jurusan</th><th>Pekerjaan</th><th>Status</th><th>Aksi</th></tr>
                                </thead>
                                <tbody>
                                <% if (!alumni || alumni.length === 0) { %>
                                <tr><td colspan="7" class="text-center text-muted py-3">Belum ada data alumni</td></tr>
                                <% } else { alumni.slice(0,20).forEach(a=>{ %>
                                <tr>
                                    <td style="width:50px;">
                                        <% if (a.foto) { %>
                                        <img src="/uploads/<%= a.foto %>" style="width:40px;height:40px;border-radius:50%;object-fit:cover;">
                                        <% } else { %>
                                        <div style="width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,#4e73df,#224abe);display:flex;align-items:center;justify-content:center;"><i class="fas fa-user text-white small"></i></div>
                                        <% } %>
                                    </td>
                                    <td><strong><%= a.nama %></strong><% if(a.email){%><br><small class="text-muted"><%= a.email %></small><% } %></td>
                                    <td><%= a.tahun_lulus||'-' %></td>
                                    <td><%= a.jurusan||'-' %></td>
                                    <td><%= a.pekerjaan||'-' %><% if(a.perusahaan){%><br><small class="text-muted"><%= a.perusahaan %></small><% } %></td>
                                    <td>
                                        <% if (a.status==='disetujui') { %><span class="badge badge-success">Disetujui</span>
                                        <% } else if (a.status==='pending') { %><span class="badge badge-warning">Pending</span>
                                        <% } else { %><span class="badge badge-danger">Ditolak</span><% } %>
                                    </td>
                                    <td>
                                        <% if (a.status==='pending') { %>
                                        <form method="POST" action="/admin/alumni/setujui/<%= a.id %>" style="display:inline">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button class="btn btn-success btn-sm" title="Setujui"><i class="fas fa-check"></i></button>
                                        </form>
                                        <% } %>
                                        <a href="/admin/alumni/edit/<%= a.id %>" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i></a>
                                    </td>
                                </tr>
                                <% }) } %>
                                </tbody>
                            </table>
                        </div>
                        <% if (alumni && alumni.length > 20) { %>
                        <div class="text-center mt-2">
                            <a href="/admin/alumni" class="btn btn-outline-primary btn-sm">Lihat Semua <%= alumni.length %> Alumni</a>
                        </div>
                        <% } %>
                        <% } %>

                    </div>
                </div>
            </div>
        </div>
        <%- include('partials/footer') %>
    </div>
</div>
<script src="/assets/vendor/jquery/jquery.min.js"></script>
<script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/assets/vendor/jquery-easing/jquery.easing.min.js"></script>
<script src="/assets/js/sb-admin-2.min.js"></script>
<script>
function toggleImportSiswa() {
    const panel = document.getElementById('importSiswaPanel');
    panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
}

// ── Reset Password Massal ─────────────────────────────────────────────────────
(function () {
    const selectAll = document.getElementById('selectAllGuru');
    if (!selectAll) return; // hanya aktif di tab guru

    function updateSeleksi() {
        const dipilih = document.querySelectorAll('.guru-checkbox:checked');
        const jumlah = dipilih.length;

        document.querySelectorAll('#jumlahDipilih, #jumlahDipilih2').forEach(el => el.textContent = jumlah);

        const btnReset = document.getElementById('btnResetMassal');
        const infoSeleksi = document.getElementById('infoSeleksi');
        if (jumlah > 0) {
            btnReset.style.display = 'inline-block';
            infoSeleksi.style.display = 'inline';
        } else {
            btnReset.style.display = 'none';
            infoSeleksi.style.display = 'none';
            selectAll.checked = false;
        }

        // Highlight baris
        document.querySelectorAll('.guru-checkbox').forEach(function (cb) {
            const row = cb.closest('tr');
            if (cb.checked) row.classList.add('selected-row');
            else row.classList.remove('selected-row');
        });
    }

    // Pilih semua
    selectAll.addEventListener('change', function () {
        document.querySelectorAll('.guru-checkbox').forEach(cb => cb.checked = this.checked);
        updateSeleksi();
    });

    // Checkbox individual
    document.addEventListener('change', function (e) {
        if (e.target.classList.contains('guru-checkbox')) updateSeleksi();
    });

    // Isi modal sebelum tampil
    const modal = document.getElementById('modalResetPassword');
    if (modal) {
        modal.addEventListener('show.bs.modal', function () {
            const dipilih = document.querySelectorAll('.guru-checkbox:checked');
            const hiddenIds = document.getElementById('hiddenIds');
            hiddenIds.innerHTML = '';
            let html = '';
            dipilih.forEach(function (cb) {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'ids[]';
                input.value = cb.value;
                hiddenIds.appendChild(input);
                html += '<div><i class="fas fa-user-circle mr-1 text-muted"></i>' + cb.dataset.nama + '</div>';
            });
            document.getElementById('daftarNamaGuru').innerHTML = html || '<em class="text-muted">Tidak ada guru dipilih</em>';
            document.getElementById('modalJumlah').textContent = dipilih.length;
        });
    }

    // Cegah submit kosong
    const form = document.getElementById('formResetMassal');
    if (form) {
        form.addEventListener('submit', function (e) {
            if (!document.querySelector('#hiddenIds input')) {
                e.preventDefault();
                alert('Tidak ada guru yang dipilih.');
            }
        });
    }
})();
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Galeri Pecinta Alam - Admin Panel</title>
    <link rel="icon" type="image/png" href="/assets/img/favicon.png?v=4">
    <link href="/assets/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">
    <link href="/assets/css/sb-admin-2.min.css" rel="stylesheet">
</head>
<body id="page-top">
<div id="wrapper">
    <%- include('./_sidebar') %>
    <div id="content-wrapper" class="d-flex flex-column">
        <div id="content">
            <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">
                <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3"><i class="fa fa-bars"></i></button>
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item"><span class="nav-link text-gray-600 small"><i class="fas fa-user mr-1"></i><%= user.nama || user.username %></span></li>
                    <li class="nav-item"><a class="nav-link" href="/admin/logout"><i class="fas fa-sign-out-alt"></i></a></li>
                </ul>
            </nav>
            <div class="container-fluid">
                <div class="d-sm-flex align-items-center justify-content-between mb-4">
                    <h1 class="h3 mb-0 text-gray-800">Galeri Pecinta Alam</h1>
                </div>
                <% if (success==1) { %><div class="alert alert-success alert-dismissible fade show">Foto berhasil diupload.<button type="button" class="close" data-dismiss="alert">&times;</button></div><% } %>
                <% if (success==3) { %><div class="alert alert-danger alert-dismissible fade show">Foto berhasil dihapus.<button type="button" class="close" data-dismiss="alert">&times;</button></div><% } %>
                <% if (typeof query !== 'undefined' && query && query.error) { %><div class="alert alert-danger"><%= query.error %></div><% } %>
                <div class="card shadow mb-4">
                    <div class="card-header py-3"><h6 class="m-0 font-weight-bold" style="color:#78350f;">Upload Foto Galeri</h6></div>
                    <div class="card-body">
                        <form method="POST" action="/admin/pecinta-alam/galeri/upload" enctype="multipart/form-data">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="form-group"><label>Judul Album</label><input type="text" class="form-control" name="judul" placeholder="Contoh: Pendakian Gunung 2026" required></div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group"><label>Keterangan (opsional)</label><input type="text" class="form-control" name="keterangan" placeholder="Keterangan singkat"></div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group"><label>Pilih Foto (bisa banyak)</label><input type="file" class="form-control-file" name="gambar" accept=".jpg,.jpeg,.png,.webp" multiple required id="fotoInput"></div>
                                </div>
                            </div>
                            <div id="preview" class="row mt-2 mb-3"></div>
                            <button type="submit" class="btn" style="background:#78350f;color:white;"><i class="fas fa-upload mr-1"></i>Upload Foto</button>
                        </form>
                    </div>
                </div>
                <div class="card shadow mb-4">
                    <div class="card-header py-3"><h6 class="m-0 font-weight-bold" style="color:#78350f;">Foto Galeri (<%= galeri.length %> foto)</h6></div>
                    <div class="card-body">
                        <% if (!galeri||galeri.length===0) { %>
                        <p class="text-muted text-center py-3">Belum ada foto galeri. Upload foto di atas.</p>
                        <% } else { %>
                        <div class="row">
                            <% galeri.forEach(function(g){ %>
                            <div class="col-md-3 col-sm-4 col-6 mb-3">
                                <div class="card border-0 shadow-sm h-100">
                                    <img src="/uploads/<%= g.gambar %>" class="card-img-top" style="height:140px;object-fit:cover;" onerror="this.src='/assets/img/undraw_posting_photo.svg'">
                                    <div class="card-body p-2">
                                        <p class="small mb-1 font-weight-bold text-truncate"><%= g.judul %></p>
                                        <% if (g.keterangan) { %><p class="small text-muted mb-1"><%= g.keterangan %></p><% } %>
                                        <form method="POST" action="/admin/pecinta-alam/galeri/delete/<%= g.id %>" onsubmit="return confirm('Hapus foto ini?')">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button class="btn btn-danger btn-sm btn-block"><i class="fas fa-trash"></i> Hapus</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                        </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
        <footer class="sticky-footer bg-white">
            <div class="container my-auto"><div class="copyright text-center my-auto"><span>Portal Pecinta Alam &copy; <%= new Date().getFullYear() %></span></div></div>
        </footer>
    </div>
</div>
<script src="/assets/vendor/jquery/jquery.min.js"></script>
<script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/assets/vendor/jquery-easing/jquery.easing.min.js"></script>
<script src="/assets/js/sb-admin-2.min.js"></script>
<script>
document.getElementById('fotoInput').addEventListener('change', function() {
    var preview = document.getElementById('preview');
    preview.innerHTML = '';
    Array.from(this.files).forEach(function(file) {
        var reader = new FileReader();
        reader.onload = function(e) {
            preview.innerHTML += '<div class="col-md-2 col-3 mb-2"><img src="' + e.target.result + '" style="width:100%;height:80px;object-fit:cover;border-radius:6px;"></div>';
        };
        reader.readAsDataURL(file);
    });
});
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title><%= title %> - Admin Panel</title>
    <link rel="icon" type="image/png" href="/assets/img/favicon.png?v=4">
    <link href="/assets/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">    <link href="/assets/css/sb-admin-2.min.css" rel="stylesheet">
</head>
<body id="page-top">
<div id="wrapper">
    <%- include('../partials/sidebar') %>
    <div id="content-wrapper" class="d-flex flex-column">
        <div id="content">
            <%- include('../partials/topbar', { user }) %>
            <div class="container-fluid">
                <div class="d-sm-flex align-items-center justify-content-between mb-4">
                    <h1 class="h3 mb-0 text-gray-800">Tambah Prestasi</h1>
                    <a href="/admin/prestasi" class="btn btn-sm btn-secondary"><i class="fas fa-arrow-left fa-sm"></i> Kembali</a>
                </div>
                <div class="card shadow mb-4">
                    <div class="card-body">
                        <form method="POST" action="/admin/prestasi/create" enctype="multipart/form-data">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <div class="row">
                                <div class="col-md-8">
                                    <div class="form-group"><label>Judul Prestasi *</label><input type="text" class="form-control" name="judul" required></div>
                                    <div class="form-group"><label>Deskripsi</label><textarea class="form-control" name="deskripsi" rows="5"></textarea></div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group"><label>Kategori</label>
                                        <select class="form-control" name="kategori">
                                            <% ['akademik','non-akademik','olahraga','seni','teknologi','lainnya'].forEach(k=>{ %><option value="<%= k %>"><%= k %></option><% }) %>
                                        </select>
                                    </div>
                                    <div class="form-group"><label>Tingkat</label>
                                        <select class="form-control" name="tingkat">
                                            <% ['sekolah','kecamatan','kabupaten','provinsi','nasional','internasional'].forEach(t=>{ %><option value="<%= t %>"><%= t %></option><% }) %>
                                        </select>
                                    </div>
                                    <div class="form-group"><label>Tahun</label><input type="number" class="form-control" name="tahun" value="<%= new Date().getFullYear() %>" min="2000" max="2099"></div>
                                    <div class="form-group"><label>Jurusan (opsional)</label><input type="text" class="form-control" name="jurusan" placeholder="TKJ / TKRO / Kuliner / TPTUP"></div>
                                    <div class="form-group"><label>Status</label>
                                        <select class="form-control" name="status">
                                            <option value="published">Published</option>
                                            <option value="draft">Draft</option>
                                        </select>
                                    </div>
                                    <div class="form-group"><label>Foto</label><input type="file" class="form-control-file" name="gambar" accept=".jpg,.jpeg,.png,.webp"></div>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i>Simpan</button>
                            <a href="/admin/prestasi" class="btn btn-secondary ml-2">Batal</a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <%- include('../partials/footer') %>
    </div>
</div>
<script src="/assets/vendor/jquery/jquery.min.js"></script>
<script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/assets/vendor/jquery-easing/jquery.easing.min.js"></script>
<script src="/assets/js/sb-admin-2.min.js"></script>
</body>
</html>

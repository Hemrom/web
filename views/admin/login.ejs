<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title><%= title %></title>
    <link rel="icon" type="image/png" href="/assets/img/favicon.png?v=4">
    <link href="/assets/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">
    <link href="/assets/css/sb-admin-2.min.css" rel="stylesheet">
    <style>
        body { background: linear-gradient(135deg, #4e73df 0%, #224abe 100%); min-height: 100vh; }
        .login-card { border-radius: 20px; overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,0.25); }
        .logo-side {
            background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
            display: flex; align-items: center; justify-content: center;
            padding: 3rem 2rem; min-height: 300px;
        }
        .logo-box {
            background: white; border-radius: 20px; padding: 2rem 1.5rem;
            text-align: center; width: 100%; max-width: 280px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        }
        .logo-box img { width: 90px; height: 90px; object-fit: contain; border-radius: 10px; margin-bottom: 1rem; }
        .logo-fallback { width: 90px; height: 90px; background: linear-gradient(135deg,#4e73df,#224abe); border-radius: 10px; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; color: white; font-size: 2.5rem; }
        .school-name { font-size: 1.1rem; font-weight: 700; color: #4e73df; margin-bottom: .25rem; }
        .school-sub { font-size: .8rem; color: #858796; margin-bottom: .75rem; }
        .admin-badge { background: linear-gradient(45deg,#4e73df,#224abe); color: white; padding: .35rem .9rem; border-radius: 20px; font-size: .75rem; font-weight: 600; }

        /* Mobile logo strip */
        .mobile-logo { display: none; background: linear-gradient(135deg,#4e73df,#224abe); padding: 1.5rem; text-align: center; }
        .mobile-logo img { width: 60px; height: 60px; object-fit: contain; border-radius: 10px; margin-bottom: .5rem; }
        .mobile-logo-fallback { width: 60px; height: 60px; background: rgba(255,255,255,.2); border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; color: white; font-size: 1.8rem; margin-bottom: .5rem; }
        @media (max-width: 991px) {
            .logo-side { display: none !important; }
            .mobile-logo { display: block; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center" style="min-height:100vh;align-items:center;">
            <div class="col-xl-9 col-lg-11 col-md-10 col-sm-12 py-4">
                <div class="card login-card border-0">
                    <!-- Mobile logo (tampil di HP) -->
                    <div class="mobile-logo">
                        <img src="/uploads/logo-sekolah.png" alt="Logo" onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex';">
                        <div class="mobile-logo-fallback" style="display:none;"><i class="fas fa-school"></i></div>
                        <div style="color:white;font-weight:700;font-size:1rem;">SMK Negeri 1 Kras</div>
                        <div style="color:rgba(255,255,255,.75);font-size:.75rem;">Admin Panel</div>
                    </div>
                    <div class="card-body p-0">
                        <div class="row no-gutters">
                            <!-- Kiri: Logo (desktop) -->
                            <div class="col-lg-5 logo-side">
                                <div class="logo-box">
                                    <img src="/uploads/logo-sekolah.png" alt="Logo" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
                                    <div class="logo-fallback" style="display:none;"><i class="fas fa-school"></i></div>
                                    <div class="school-name">SMK Negeri 1 Kras</div>
                                    <div class="school-sub">Kediri, Jawa Timur</div>
                                    <span class="admin-badge"><i class="fas fa-shield-alt mr-1"></i>ADMIN PANEL</span>
                                </div>
                            </div>
                            <!-- Kanan: Form login -->
                            <div class="col-lg-7">
                                <div class="p-5">
                                    <div class="text-center mb-4">
                                        <h1 class="h4 text-gray-900 mb-1">Login Admin</h1>
                                        <p class="text-muted small">Masuk dengan akun administrator</p>
                                    </div>
                                    <% if (error) { %>
                                    <div class="alert alert-danger py-2 small"><i class="fas fa-exclamation-circle mr-1"></i><%= error %></div>
                                    <% } %>
                                    <form method="POST" action="/admin/login">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <div class="form-group">
                                            <label class="small font-weight-bold">Username</label>
                                            <input type="text" class="form-control form-control-user" name="username" placeholder="Masukkan username" required autofocus>
                                        </div>
                                        <div class="form-group">
                                            <label class="small font-weight-bold">Password</label>
                                            <input type="password" class="form-control form-control-user" name="password" placeholder="Masukkan password" required>
                                        </div>
                                        <button type="submit" class="btn btn-primary btn-user btn-block">
                                            <i class="fas fa-sign-in-alt mr-2"></i>Login
                                        </button>
                                    </form>
                                    <hr>
                                    <div class="text-center">
                                        <a href="/" class="small text-muted"><i class="fas fa-arrow-left mr-1"></i>Kembali ke Website</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="/assets/vendor/jquery/jquery.min.js"></script>
    <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/js/sb-admin-2.min.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title><%= title %></title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
    <link rel="alternate icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><circle cx='16' cy='16' r='16' fill='%230ea5e9'/><rect x='8' y='18' width='16' height='3' rx='1' fill='white'/><polygon points='6,18 22,18 20,14 8,14' fill='white'/><circle cx='20' cy='16' r='1' fill='%230284c7'/><line x1='20' y1='17' x2='20' y2='22' stroke='%230284c7' stroke-width='1'/><circle cx='20' cy='22' r='1.5' fill='%230284c7'/><text x='16' y='28' text-anchor='middle' font-family='Arial' font-size='5' font-weight='bold' fill='white'>SMK</text></svg>">
    
    <link href="/assets/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">
    <link href="/assets/css/sb-admin-2.min.css" rel="stylesheet">
    
    <style>
        .logo-container {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100%;
            background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
            padding: 2rem;
            position: relative;
        }
        .logo-wrapper {
            text-align: center;
            background: white;
            padding: 3rem 2rem;
            border-radius: 20px;
            box-shadow: 0 15px 50px rgba(0,0,0,0.15);
            max-width: 350px;
            width: 100%;
        }
        .logo-wrapper img {
            max-width: 120px;
            height: 120px;
            object-fit: contain;
            margin-bottom: 1.5rem;
            border-radius: 10px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }
        .school-name {
            font-size: 1.4rem;
            font-weight: 700;
            color: #4e73df;
            text-align: center;
            margin-bottom: 0.5rem;
            line-height: 1.3;
        }
        .school-tagline {
            font-size: 0.85rem;
            color: #858796;
            text-align: center;
            margin-bottom: 1rem;
        }
        .admin-badge {
            background: linear-gradient(45deg, #4e73df, #224abe);
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            display: inline-block;
            margin-top: 0.5rem;
        }
        .logo-fallback {
            width: 120px;
            height: 120px;
            background: linear-gradient(135deg, #4e73df, #224abe);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
            color: white;
            font-size: 2rem;
            font-weight: bold;
        }
    </style>
</head>
<body class="bg-gradient-primary">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-10 col-lg-12 col-md-9">
                <div class="card o-hidden border-0 shadow-lg my-5">
                    <div class="card-body p-0">
                        <div class="row">
                            <div class="col-lg-6 d-none d-lg-block">
                                <div class="logo-container">
                                    <div class="logo-wrapper">
                                        <img src="/uploads/logo-sekolah.png" alt="Logo SMK Negeri 1 Kras" 
                                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                        <div class="logo-fallback" style="display: none;">
                                            <i class="fas fa-school"></i>
                                        </div>
                                        <h3 class="school-name">SMK Negeri 1 Kras</h3>
                                        <p class="school-tagline">Kediri, Jawa Timur</p>
                                        <div class="admin-badge">
                                            <i class="fas fa-shield-alt"></i> ADMIN PANEL
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="p-5">
                                    <div class="text-center">
                                        <h1 class="h4 text-gray-900 mb-4">Login Admin</h1>
                                    </div>
                                    <% if (error) { %>
                                        <div class="alert alert-danger"><%= error %></div>
                                    <% } %>
                                    <form class="user" method="POST" action="/admin/login">
                                        <div class="form-group">
                                            <input type="text" class="form-control form-control-user" name="username" placeholder="Username" required>
                                        </div>
                                        <div class="form-group">
                                            <input type="password" class="form-control form-control-user" name="password" placeholder="Password" required>
                                        </div>
                                        <button type="submit" class="btn btn-primary btn-user btn-block">Login</button>
                                    </form>
                                    <hr>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="/assets/vendor/jquery/jquery.min.js"></script>
    <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/js/sb-admin-2.min.js"></script>
</body>
</html>
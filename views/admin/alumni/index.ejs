<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title><%= title %> - Admin Panel</title>
    <link rel="icon" type="image/png" href="/assets/img/favicon.png?v=4">
    <link href="/assets/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">
    <link href="/assets/css/sb-admin-2.min.css" rel="stylesheet">
    <link href="/assets/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">
</head>
<body id="page-top">
<div id="wrapper">
    <%- include('../partials/sidebar') %>
    <div id="content-wrapper" class="d-flex flex-column">
        <div id="content">
            <%- include('../partials/topbar', { user }) %>
            <div class="container-fluid">
                <div class="d-sm-flex align-items-center justify-content-between mb-4">
                    <h1 class="h3 mb-0 text-gray-800">Data Alumni</h1>
                    <a href="/alumni/daftar" target="_blank" class="btn btn-sm btn-info shadow-sm">
                        <i class="fas fa-external-link-alt fa-sm"></i> Lihat Form Registrasi
                    </a>
                </div>

                <% if (success == 2) { %><div class="alert alert-success alert-dismissible fade show">Data alumni berhasil diperbarui. <button type="button" class="close" data-dismiss="alert">&times;</button></div>
                <% } else if (success == 3) { %><div class="alert alert-success alert-dismissible fade show">Alumni berhasil disetujui dan ditampilkan di website. <button type="button" class="close" data-dismiss="alert">&times;</button></div>
                <% } else if (success == 4) { %><div class="alert alert-warning alert-dismissible fade show">Alumni ditolak. <button type="button" class="close" data-dismiss="alert">&times;</button></div>
                <% } else if (success == 5) { %><div class="alert alert-danger alert-dismissible fade show">Alumni berhasil dihapus. <button type="button" class="close" data-dismiss="alert">&times;</button></div>
                <% } %>

                <!-- Stats Cards -->
                <div class="row mb-4">
                    <div class="col-xl-3 col-md-6 mb-3">
                        <div class="card border-left-primary shadow h-100 py-2">
                            <div class="card-body"><div class="row no-gutters align-items-center">
                                <div class="col mr-2"><div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Alumni</div><div class="h5 mb-0 font-weight-bold text-gray-800"><%= stats.total %></div></div>
                                <div class="col-auto"><i class="fas fa-user-graduate fa-2x text-gray-300"></i></div>
                            </div></div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 mb-3">
                        <div class="card border-left-warning shadow h-100 py-2">
                            <div class="card-body"><div class="row no-gutters align-items-center">
                                <div class="col mr-2"><div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Menunggu Verifikasi</div><div class="h5 mb-0 font-weight-bold text-gray-800"><%= stats.pending %></div></div>
                                <div class="col-auto"><i class="fas fa-clock fa-2x text-gray-300"></i></div>
                            </div></div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 mb-3">
                        <div class="card border-left-success shadow h-100 py-2">
                            <div class="card-body"><div class="row no-gutters align-items-center">
                                <div class="col mr-2"><div class="text-xs font-weight-bold text-success text-uppercase mb-1">Disetujui</div><div class="h5 mb-0 font-weight-bold text-gray-800"><%= stats.disetujui %></div></div>
                                <div class="col-auto"><i class="fas fa-check-circle fa-2x text-gray-300"></i></div>
                            </div></div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 mb-3">
                        <div class="card border-left-danger shadow h-100 py-2">
                            <div class="card-body"><div class="row no-gutters align-items-center">
                                <div class="col mr-2"><div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Ditolak</div><div class="h5 mb-0 font-weight-bold text-gray-800"><%= stats.ditolak %></div></div>
                                <div class="col-auto"><i class="fas fa-times-circle fa-2x text-gray-300"></i></div>
                            </div></div>
                        </div>
                    </div>
                </div>

                <!-- Filter Tabs -->
                <div class="card shadow mb-4">
                    <div class="card-header p-0">
                        <ul class="nav nav-tabs">
                            <% ['semua','pending','disetujui','ditolak'].forEach(function(s) { %>
                            <li class="nav-item">
                                <a class="nav-link <%= filter === s ? 'active font-weight-bold' : '' %>" href="?status=<%= s %>">
                                    <% if(s==='semua') { %><i class="fas fa-list mr-1"></i>Semua
                                    <% } else if(s==='pending') { %><i class="fas fa-clock mr-1 text-warning"></i>Pending
                                    <% } else if(s==='disetujui') { %><i class="fas fa-check mr-1 text-success"></i>Disetujui
                                    <% } else { %><i class="fas fa-times mr-1 text-danger"></i>Ditolak<% } %>
                                </a>
                            </li>
                            <% }) %>
                        </ul>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover" id="dataTable">
                                <thead class="thead-light">
                                    <tr><th>Foto</th><th>Nama</th><th>Lulus</th><th>Jurusan</th><th>Pekerjaan</th><th>Status</th><th>Tgl Daftar</th><th>Aksi</th></tr>
                                </thead>
                                <tbody>
                                <% if (!alumni || alumni.length === 0) { %>
                                <tr><td colspan="8" class="text-center text-muted py-4">Belum ada data alumni</td></tr>
                                <% } else { %>
                                <% alumni.forEach(function(a) { %>
                                <tr>
                                    <td style="width:60px;">
                                        <% if (a.foto) { %>
                                        <img src="/uploads/<%= a.foto %>" style="width:45px;height:45px;border-radius:50%;object-fit:cover;object-position:top;">
                                        <% } else { %>
                                        <div style="width:45px;height:45px;border-radius:50%;background:linear-gradient(135deg,#4e73df,#224abe);display:flex;align-items:center;justify-content:center;">
                                            <i class="fas fa-user text-white"></i>
                                        </div>
                                        <% } %>
                                    </td>
                                    <td>
                                        <strong><%= a.nama %></strong>
                                        <% if (a.email) { %><br><small class="text-muted"><%= a.email %></small><% } %>
                                    </td>
                                    <td><%= a.tahun_lulus || '-' %></td>
                                    <td><%= a.jurusan || '-' %></td>
                                    <td>
                                        <%= a.pekerjaan || '-' %>
                                        <% if (a.perusahaan) { %><br><small class="text-muted"><%= a.perusahaan %></small><% } %>
                                    </td>
                                    <td>
                                        <% if (a.status === 'disetujui') { %>
                                        <span class="badge badge-success">Disetujui</span>
                                        <% } else if (a.status === 'pending') { %>
                                        <span class="badge badge-warning">Pending</span>
                                        <% } else { %>
                                        <span class="badge badge-danger">Ditolak</span>
                                        <% } %>
                                    </td>
                                    <td><small><%= new Date(a.created_at).toLocaleDateString('id-ID') %></small></td>
                                    <td>
                                        <div class="btn-group-vertical btn-group-sm">
                                        <% if (a.status === 'pending') { %>
                                        <form method="POST" action="/admin/alumni/setujui/<%= a.id %>" style="display:inline">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button class="btn btn-success btn-sm mb-1" title="Setujui"><i class="fas fa-check"></i> Setujui</button>
                                        </form>
                                        <form method="POST" action="/admin/alumni/tolak/<%= a.id %>" style="display:inline">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button class="btn btn-warning btn-sm mb-1" title="Tolak"><i class="fas fa-times"></i> Tolak</button>
                                        </form>
                                        <% } else if (a.status === 'ditolak') { %>
                                        <form method="POST" action="/admin/alumni/setujui/<%= a.id %>" style="display:inline">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button class="btn btn-success btn-sm mb-1"><i class="fas fa-check"></i> Setujui</button>
                                        </form>
                                        <% } else { %>
                                        <form method="POST" action="/admin/alumni/tolak/<%= a.id %>" style="display:inline">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button class="btn btn-warning btn-sm mb-1"><i class="fas fa-eye-slash"></i> Sembunyikan</button>
                                        </form>
                                        <% } %>
                                        <a href="/admin/alumni/edit/<%= a.id %>" class="btn btn-primary btn-sm mb-1"><i class="fas fa-edit"></i> Edit</a>
                                        <form method="POST" action="/admin/alumni/delete/<%= a.id %>" onsubmit="return confirm('Hapus alumni ini?')">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button class="btn btn-danger btn-sm"><i class="fas fa-trash"></i> Hapus</button>
                                        </form>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                                <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <%- include('../partials/footer') %>
    </div>
</div>
<script src="/assets/vendor/jquery/jquery.min.js"></script>
<script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/assets/vendor/jquery-easing/jquery.easing.min.js"></script>
<script src="/assets/js/sb-admin-2.min.js"></script>
<script src="/assets/vendor/datatables/jquery.dataTables.min.js"></script>
<script src="/assets/vendor/datatables/dataTables.bootstrap4.min.js"></script>
<script>$(document).ready(function(){ $('#dataTable').DataTable({ order:[[6,'desc']], language:{ url:'//cdn.datatables.net/plug-ins/1.13.6/i18n/id.json' } }); });</script>
</body>
</html>
